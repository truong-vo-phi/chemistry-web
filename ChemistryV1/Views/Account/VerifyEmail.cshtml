<div class="flex justify-between gap-2 sm:gap-4" id="otp-container">
<input class="otp-input w-full aspect-square text-center font-display-lg text-[32px] rounded-lg border-2 border-primary/20 bg-surface focus:border-primary focus:outline-none transition-all duration-200 text-primary" maxlength="1" required type="text" inputmode="numeric" />
<input class="otp-input w-full aspect-square text-center font-display-lg text-[32px] rounded-lg border-2 border-primary/20 bg-surface focus:border-primary focus:outline-none transition-all duration-200 text-primary" maxlength="1" required type="text" inputmode="numeric" />
<input class="otp-input w-full aspect-square text-center font-display-lg text-[32px] rounded-lg border-2 border-primary/20 bg-surface focus:border-primary focus:outline-none transition-all duration-200 text-primary" maxlength="1" required type="text" inputmode="numeric" />
<input class="otp-input w-full aspect-square text-center font-display-lg text-[32px] rounded-lg border-2 border-primary/20 bg-surface focus:border-primary focus:outline-none transition-all duration-200 text-primary" maxlength="1" required type="text" inputmode="numeric" />
<input class="otp-input w-full aspect-square text-center font-display-lg text-[32px] rounded-lg border-2 border-primary/20 bg-surface focus:border-primary focus:outline-none transition-all duration-200 text-primary" maxlength="1" required type="text" inputmode="numeric" />
<input class="otp-input w-full aspect-square text-center font-display-lg text-[32px] rounded-lg border-2 border-primary/20 bg-surface focus:border-primary focus:outline-none transition-all duration-200 text-primary" maxlength="1" required type="text" inputmode="numeric" />
</div>
<span asp-validation-for="Code" class="text-xs text-error block text-center"></span>
<div class="text-center">
<p class="font-label-sm text-label-sm text-on-surface-variant">
                            Không nhận được mã? <br class="sm:hidden"/>
<span class="text-tertiary-container font-bold inline-flex items-center gap-1">
<span class="material-symbols-outlined text-[18px]">timer</span>
