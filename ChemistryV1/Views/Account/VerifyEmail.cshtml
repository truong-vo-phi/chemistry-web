                            </span>
</p>
</div>
<button class="squishy-btn w-full bg-primary hover:bg-primary-container text-on-primary py-4 rounded-full font-headline-md shadow-[0_4px_0_0_#004395] hover:shadow-[0_6px_0_0_#004395] transition-all flex items-center justify-center gap-3" type="submit">
<span>Xác nhận &amp; Bắt đầu</span>
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">rocket_launch</span>
</button>
</form>
<div class="mt-4 flex items-center justify-center gap-3">
<form asp-action="ResendVerification" asp-controller="Account" method="post" id="resend-form" class="inline-flex items-center">
@Html.AntiForgeryToken()
<input type="hidden" name="userId" value="@Model.UserId" />
<input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
<button type="submit" class="font-label-sm text-label-sm text-primary hover:underline flex items-center justify-center gap-1 group" id="resend-button" disabled>
<span class="material-symbols-outlined text-[18px] group-hover:-translate-x-1 transition-transform">mail</span>
                        Gửi lại mã
                    </button>
</form>
<a class="font-label-sm text-label-sm text-primary hover:underline flex items-center justify-center gap-1 group" asp-action="Register" asp-controller="Account">
<span class="material-symbols-outlined text-[18px] group-hover:-translate-x-1 transition-transform">arrow_back</span>
                        Quay lại đăng ký
                    </a>
</div>
</div>
</div>
<div class="absolute -bottom-12 w-full text-center">
<p class="font-label-sm text-label-sm text-on-surface-variant opacity-60">© 2024 Học viện ChemLab. Trải nghiệm học tập đắm chìm.</p>
</div>
</main>
<script>
        const inputs = document.querySelectorAll('.otp-input');
        const hiddenCode = document.getElementById('code-hidden');
        const resendButton = document.getElementById('resend-button');
        let timeLeft = Number(document.getElementById('timer').textContent || '0');

        const syncCode = () => {
            hiddenCode.value = Array.from(inputs).map(input => input.value.trim()).join('');
        };

        inputs.forEach((input, index) => {
            input.addEventListener('input', (e) => {
                const value = e.target.value.replace(/\D/g, '').slice(0, 1);
                e.target.value = value;
                syncCode();
                if (value.length === 1 && index < inputs.length - 1) {
                    inputs[index + 1].focus();
                }
            });

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && e.target.value === '' && index > 0) {
                    inputs[index - 1].focus();
                }
            });
        });

        const timerElement = document.getElementById('timer');
        const timerInterval = setInterval(() => {
            timeLeft--;
            timerElement.textContent = Math.max(0, timeLeft);
            if (timeLeft <= 0) {
                clearInterval(timerInterval);
                resendButton.disabled = false;
                const wrapper = resendButton.closest('span');
                if (wrapper) {
                    wrapper.textContent = 'Gửi lại mã ngay';
                    wrapper.classList.add('cursor-pointer', 'underline');
                }
            }
        }, 1000);

        document.getElementById('otp-form').addEventListener('submit', (e) => {
            syncCode();
        });
    </script>
</body></html>