<style>
        body {
            background-color: #FFFDF5;
            overflow-x: hidden;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .otp-input:focus {
            box-shadow: 0 0 0 3px rgba(0, 88, 190, 0.2);
            transform: scale(1.05);
        }
        .squishy-btn:active {
            transform: translateY(2px);
            box-shadow: none !important;
        }
        .floating-element {
            animation: float 6s ease-in-out infinite;
        }
        @@keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(5deg); }
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .motion-ring {
            position: absolute;
            border-radius: 9999px;
            border: 1px dashed rgba(0, 88, 190, 0.18);
            pointer-events: none;
        }
        .orbit-one {
            animation: orbit-one 22s linear infinite;
        }
        @@keyframes orbit-one {
            0% { transform: rotate(0deg) translateX(0) rotate(0deg); }
            100% { transform: rotate(360deg) translateX(0) rotate(-360deg); }
        }
        .orbit-two {
            animation: orbit-two 30s linear infinite reverse;
        }
        @@keyframes orbit-two {
            0% { transform: rotate(0deg) translateX(0) rotate(0deg); }
            100% { transform: rotate(360deg) translateX(0) rotate(-360deg); }
        }
        .chem-float {
            animation: chem-float 11s ease-in-out infinite;
        }
        @@keyframes chem-float {
            0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
            50% { transform: translate3d(0, -16px, 0) scale(1.05); }
        }
        .drift-left {
            animation: drift-left 16s ease-in-out infinite;
        }
        @@keyframes drift-left {
            0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
            50% { transform: translate3d(-18px, -10px, 0) rotate(-6deg); }
        }
        .drift-right {
            animation: drift-right 18s ease-in-out infinite;
        }
        @@keyframes drift-right {
            0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
            50% { transform: translate3d(18px, 12px, 0) rotate(7deg); }
        }
    </style>
</head>
