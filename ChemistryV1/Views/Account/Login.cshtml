<style>
        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 8px 32px 0 rgba(0, 88, 190, 0.08), 0 1px 2px 0 rgba(0, 0, 0, 0.02);
        }
        .animate-float {
            animation: float 6s ease-in-out infinite;
        }
        @@keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(2deg); }
        }
        .soft-glow {
            filter: blur(60px);
            opacity: 0.4;
            pointer-events: none;
        }
        .motion-ring {
            position: absolute;
            border-radius: 9999px;
            border: 1px dashed rgba(0, 88, 190, 0.22);
            pointer-events: none;
        }
        .orbit-one {
            animation: orbit-one 20s linear infinite;
        }
        @@keyframes orbit-one {
            0% { transform: rotate(0deg) translateX(0) rotate(0deg); }
            100% { transform: rotate(360deg) translateX(0) rotate(-360deg); }
        }
        .orbit-two {
            animation: orbit-two 28s linear infinite reverse;
        }
        @@keyframes orbit-two {
            0% { transform: rotate(0deg) translateX(0) rotate(0deg); }
            100% { transform: rotate(360deg) translateX(0) rotate(-360deg); }
        }
        .chem-float {
            animation: chem-float 12s ease-in-out infinite;
        }
        @@keyframes chem-float {
            0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
            50% { transform: translate3d(0, -18px, 0) scale(1.04); }
        }
        .slow-drift {
            animation: slow-drift 22s ease-in-out infinite;
        }
        @@keyframes slow-drift {
            0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
            50% { transform: translate3d(24px, -10px, 0) rotate(8deg); }
        }
        .pulse-ring {
            animation: pulse-ring 8s ease-in-out infinite;
        }
        @@keyframes pulse-ring {
            0%, 100% { transform: scale(1); opacity: 0.18; }
            50% { transform: scale(1.06); opacity: 0.26; }
        }
        .input-focus-ring:focus-within {
            box-shadow: 0 0 0 4px rgba(0, 88, 190, 0.1);
        }
        .gradient-btn {
            background: linear-gradient(135deg, #0058be 0%, #2170e4 100%);
            transition: all 0.3s ease;
        }
        .gradient-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px -10px rgba(0, 88, 190, 0.5);
        }
        .particle {
            position: absolute;
            pointer-events: none;
            opacity: 0.15;
            z-index: 0;
        }
    </style>
</head>
<body class="bg-surface font-body-md text-on-surface min-h-screen flex items-center justify-center p-2 md:p-4 relative overflow-hidden">
<!-- Background Decorations -->
<div class="fixed inset-0 z-0 overflow-hidden">
<div class="absolute top-[-10%] left-[-5%] w-[40%] h-[40%] bg-primary rounded-full soft-glow"></div>
<div class="absolute bottom-[-10%] right-[-5%] w-[40%] h-[40%] bg-secondary rounded-full soft-glow"></div>
<div class="motion-ring orbit-one" style="width: 26rem; height: 26rem; left: -6rem; top: 18%; opacity: 0.3;"></div>
<div class="motion-ring orbit-two" style="width: 18rem; height: 18rem; right: 8%; top: 10%; opacity: 0.22;"></div>
<div class="motion-ring pulse-ring" style="width: 14rem; height: 14rem; left: 44%; top: 58%; opacity: 0.18;"></div>
<div class="absolute left-[18%] top-[18%] text-primary/15 chem-float" style="font-size: 84px;">
<span class="material-symbols-outlined">science</span>
</div>
<div class="absolute right-[12%] bottom-[16%] text-secondary/15 drift-right" style="font-size: 88px;">
<span class="material-symbols-outlined">biotech</span>
</div>
<div class="absolute left-[9%] bottom-[14%] text-tertiary/15 drift-left" style="font-size: 72px;">
<span class="material-symbols-outlined">bubble_chart</span>
</div>
<div class="absolute right-[26%] top-[26%] orb w-4 h-4 bg-primary chem-float"></div>
<div class="absolute left-[28%] bottom-[22%] orb w-3 h-3 bg-secondary drift-left"></div>
<div class="absolute right-[30%] top-[60%] text-primary/12 slow-drift" style="font-size: 60px;">
<span class="material-symbols-outlined">flare</span>
</div>
<div id="particle-container"></div>
</div>
<!-- Main Container -->
<main class="relative z-10 w-full max-w-[1060px]">
<div class="glass-card rounded-[30px] overflow-hidden flex flex-col lg:flex-row shadow-2xl">
<!-- Left Column: Hero/Branding -->
<div class="lg:w-1/2 bg-surface-container-low px-3 py-3 md:px-6 md:py-5 flex flex-col justify-center items-center text-center relative overflow-hidden">
<div class="relative z-10">
<img alt="Nhà khoa học Alchemist 3D" class="w-full max-w-[165px] md:max-w-[180px] mx-auto animate-float drop-shadow-xl" src="https://lh3.googleusercontent.com/aida/ADBb0ui2iaGG6_23do1n6bnN5VXTZYYFqVsN2LRpfsGcQX_aKZBzNuF7MzAsXvEgxuoFGvF0vy6Vfd2BHQbQc8LxtKp_nrokhiyvBhyo__uOGZoxs8p7SB_uD4KDge_w0dVOM9lGKQzzjAuUi8FGnqHRmVkWEHWqhq4xTd0Wa5N_coZaq2wVR4bmVC-aSVRRshyrmuXgcyBoeKVy1brE3BAVqyYRr0FQ_1EIUV_F2s93b4pLHJLzIF7F92_IFRc">
<div class="mt-2 space-y-1.5 md:space-y-2">
<h2 class="font-display-lg text-[18px] md:text-[22px] text-primary leading-tight">
                            Bắt đầu hành trình <br> chinh phục tri thức
                        </h2>
<p class="text-sm md:text-base text-on-surface-variant font-body-md max-w-sm mx-auto">
                            Khám phá thế giới hóa học kỳ diệu qua những thí nghiệm 3D sống động nhất.
                        </p>
</div>
</div>
<!-- Decorative Elements for Left Column -->
<div class="absolute top-0 right-0 p-4 opacity-10">
<span class="material-symbols-outlined text-[120px]">science</span>
</div>
</div>
<!-- Right Column: Login Form -->
<div class="lg:w-1/2 px-3 py-3 md:px-6 md:py-5 flex flex-col justify-center bg-white/40">
<div class="max-w-[300px] mx-auto w-full">
<header class="mb-2 md:mb-3">
<h1 class="font-headline-md text-primary mb-1 text-[18px] md:text-[20px]">Chào mừng Alchemist!</h1>
<p class="text-on-surface-variant font-body-md">
                            Đăng nhập để tiếp tục thu thập XP và chinh phục các nguyên tố mới.
                        </p>
</header>
<div class="relative mb-1.5">
    <div class="min-h-[48px] md:min-h-[56px]"></div>
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="absolute inset-x-0 top-0 rounded-2xl bg-error-container p-3 text-error text-sm font-semibold border border-error/20 z-10">
            <div asp-validation-summary="All" class="list-none"></div>
        </div>
    }
</div>
<form asp-action="Login" method="post" class="space-y-2 md:space-y-2.5">
@Html.AntiForgeryToken()
<input asp-for="ReturnUrl" type="hidden" />
<!-- User Input -->
<div class="space-y-1.5">
<label asp-for="Identity" class="font-label-sm text-on-surface-variant ml-1"></label>
<div class="relative input-focus-ring rounded-full transition-all duration-300">
<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">person</span>
<input asp-for="Identity" class="w-full pl-12 pr-4 py-1.5 rounded-full border-outline-variant bg-white focus:border-primary focus:ring-0 transition-all font-body-md text-on-surface" placeholder="alchemist@chemlab.edu.vn" type="text">
</div>
<span asp-validation-for="Identity" class="text-xs text-error ml-1"></span>
</div>
<!-- Password Input -->
<div class="space-y-1.5">
<div class="flex justify-between items-center px-1">
<label asp-for="Password" class="font-label-sm text-on-surface-variant"></label>
<a class="text-label-sm text-primary hover:underline font-semibold" href="#">Quên mật khẩu?</a>
</div>
<div class="relative input-focus-ring rounded-full transition-all duration-300">
<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">lock</span>
<input asp-for="Password" class="w-full pl-12 pr-12 py-1.5 rounded-full border-outline-variant bg-white focus:border-primary focus:ring-0 transition-all font-body-md text-on-surface" placeholder="••••••••" type="password">
<button class="absolute right-4 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors" type="button">
<span class="material-symbols-outlined">visibility</span>
</button>
</div>
<span asp-validation-for="Password" class="text-xs text-error ml-1"></span>
</div>
<!-- Submit Button -->
<button class="gradient-btn w-full text-on-primary font-headline-md py-1.5 rounded-full mt-1.5" type="submit">
                            Đăng Nhập Ngay
                        </button>
</form>
<!-- Divider -->
<div class="flex items-center gap-4 my-2.5 md:my-3">
<div class="h-[1px] flex-1 bg-outline-variant"></div>
<span class="text-label-sm text-outline font-medium uppercase tracking-wider">Hoặc tiếp tục với</span>
<div class="h-[1px] flex-1 bg-outline-variant"></div>
</div>
<!-- Social Login -->
<div class="flex gap-3 mb-2.5 md:mb-3">
<button class="flex-1 py-1.5 px-3 rounded-full bg-white border border-outline-variant hover:bg-surface-container-low transition-all flex items-center justify-center gap-3">
<img alt="Google" class="w-5 h-5" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB1QZaJ8YeoDJeOvj2z53BUNY-B5C5sVlTiPVvDIoFspnzdq_lkI2UrozKZeE4RBwSUzy9uIH-lWoJ33vvSTd8Y5MWVLwah-lhrBKksFT62KyWFYOkYVdcIzM2ExTEW9aSIeT3htYYTx2ugu4kZ0pSqn3g6Hsj2ZOvmRW3BjPW1VjAq7IxbVektknjaRBvYT8MNFMBOTW4s9BNdUGkoea3PvYOLXc9GurCbJMXovK_9HCSmSp-_-DkVHqXLqBfT18b9pt69kuDR1ok">
<span class="font-label-sm text-on-surface">Google</span>
</button>
<button class="flex-1 py-1.5 px-4 rounded-full bg-white border border-outline-variant hover:bg-surface-container-low transition-all flex items-center justify-center gap-3" type="button">
<span class="material-symbols-outlined text-primary" style="font-size: 20px;">school</span>
<span class="font-label-sm text-on-surface">Hệ thống</span>
</button>
</div>
<!-- Footer Info -->
<footer class="flex flex-col items-center gap-1.5 md:gap-2">
<p class="font-body-md text-on-surface-variant">
                            Chưa có tài khoản? 
                            <a class="text-primary font-bold hover:underline" asp-action="Register" asp-controller="Account">Đăng ký ngay</a>
</p>
<!-- Badge -->
<div class="hidden">
<span class="material-symbols-outlined text-[18px]">groups</span>
<span class="font-label-sm">Tham gia cùng 5,000+ học viên</span>
</div>
</footer>
</div>
</div>
</div>
</main>
<script>
        // Atmospheric particles effect - Floating molecules vibe
        const container = document.getElementById('particle-container');
        const icons = ['molecule', 'science', 'bubble_chart', 'auto_awesome'];
        
        function createParticle() {
            const particle = document.createElement('div');
            particle.classList.add('particle');
            
            const icon = icons[Math.floor(Math.random() * icons.length)];
            const span = document.createElement('span');
            span.classList.add('material-symbols-outlined');
            span.textContent = icon;
            
            const size = Math.random() * 40 + 20;
            span.style.fontSize = `${size}px`;
            
            particle.appendChild(span);
            
            particle.style.left = `${Math.random() * 100}vw`;
            particle.style.top = `${Math.random() * 100}vh`;
            
            container.appendChild(particle);
            
            const duration = Math.random() * 20000 + 20000;
            particle.animate([
                { transform: 'translate(0, 0) rotate(0deg)', opacity: 0 },
                { transform: `translate(${Math.random() * 100 - 50}px, ${Math.random() * -150}px) rotate(${Math.random() * 360}deg)`, opacity: 0.2, offset: 0.5 },
                { transform: `translate(${Math.random() * 200 - 100}px, ${Math.random() * -300}px) rotate(${Math.random() * 720}deg)`, opacity: 0 }
            ], {
                duration: duration,
                iterations: Infinity,
                easing: 'linear'
            });
        }

        // Initialize particles
        for(let i = 0; i < 15; i++) {
            createParticle();
        }
    </script>
</body>
</html>
