@model ChemistryV1.ViewModels.LoginViewModel
@{
    Layout = "_UserFlowLayout";
    ViewData["Title"] = "Welcome Alchemist | ChemLab";
    ViewData["Description"] = "Login to continue collecting XP and conquering new elements.";
}

<!-- Login Card -->
<div class="glass-card premium-shadow p-8 md:p-10">
    <div class="text-center mb-8">
        <div class="w-20 h-20 mx-auto mb-6 bg-primary/10 rounded-full flex items-center justify-center animate-float">
            <span class="material-symbols-outlined text-4xl text-primary">science</span>
        </div>
        <h1 class="text-2xl md:text-3xl font-bold text-on-background mb-3 font-display">Welcome Alchemist!</h1>
        <p class="text-slate-500">Login to continue collecting XP and conquering new elements.</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="mb-6 rounded-2xl bg-red-50 border border-red-200 p-4 text-red-700 font-bold text-sm">
            <div asp-validation-summary="All" class="list-none"></div>
        </div>
    }

    <form asp-action="Login" method="post" class="space-y-5">
        @Html.AntiForgeryToken()
        <input asp-for="ReturnUrl" type="hidden" />

        <!-- Username/Email -->
        <div class="space-y-2">
            <label asp-for="Identity" class="text-sm font-bold text-slate-600 uppercase tracking-wider block"></label>
            <div class="relative">
                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">person</span>
                <input asp-for="Identity" class="w-full pl-12 pr-4 py-4 rounded-2xl border border-slate-200 bg-white focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-on-background outline-none" placeholder="alchemist@chemlab.edu.vn" type="text">
            </div>
            <span asp-validation-for="Identity" class="text-xs text-red-500 ml-1"></span>
        </div>

        <!-- Password -->
        <div class="space-y-2">
            <div class="flex justify-between items-center">
                <label asp-for="Password" class="text-sm font-bold text-slate-600 uppercase tracking-wider block"></label>
                <a class="text-sm text-primary hover:underline font-semibold" href="#">Forgot password?</a>
            </div>
            <div class="relative">
                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">lock</span>
                <input asp-for="Password" class="w-full pl-12 pr-12 py-4 rounded-2xl border border-slate-200 bg-white focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-on-background outline-none" placeholder="••••••••" type="password">
                <button class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-primary transition-colors" type="button">
                    <span class="material-symbols-outlined">visibility</span>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-xs text-red-500 ml-1"></span>
        </div>

        <!-- Submit Button -->
        <button class="w-full bg-primary text-white font-bold py-4 rounded-2xl btn-glow hover:scale-[1.02] active:scale-[0.98] transition-all" type="submit">
            Login Now
        </button>
    </form>

    <!-- Divider -->
    <div class="flex items-center gap-4 my-8">
        <div class="h-px flex-1 bg-slate-200"></div>
        <span class="text-sm text-slate-400 font-medium uppercase tracking-wider">Or continue with</span>
        <div class="h-px flex-1 bg-slate-200"></div>
    </div>

    <!-- Social Login -->
    <div class="flex gap-4">
        <button class="flex-1 py-3 px-4 rounded-2xl bg-white border border-slate-200 hover:border-primary/30 hover:bg-slate-50 transition-all flex items-center justify-center gap-3">
            <img alt="Google" class="w-5 h-5" src="https://www.google.com/favicon.ico">
            <span class="font-semibold text-sm text-slate-700">Google</span>
        </button>
        <button class="flex-1 py-3 px-4 rounded-2xl bg-white border border-slate-200 hover:border-primary/30 hover:bg-slate-50 transition-all flex items-center justify-center gap-3" type="button">
            <span class="material-symbols-outlined text-primary">school</span>
            <span class="font-semibold text-sm text-slate-700">System</span>
        </button>
    </div>

    <!-- Footer -->
    <div class="mt-8 text-center">
        <p class="text-slate-500">
            Don't have an account? 
            <a class="text-primary font-bold hover:underline" asp-action="Register" asp-controller="Account">Register now</a>
        </p>
    </div>
</div>
