@model ChemistryV1.ViewModels.RegisterViewModel
@{
    Layout = "_UserFlowLayout";
    ViewData["Title"] = "Tạo tài khoản | ChemLab";
    ViewData["Description"] = "Tham gia học viện hóa học kỳ diệu và bắt đầu hành trình học tập của bạn.";
}

<!-- Register Card -->
<div class="glass-card premium-shadow p-8 md:p-10">
    <div class="text-center mb-8">
        <div class="w-20 h-20 mx-auto mb-6 bg-primary/10 rounded-full flex items-center justify-center animate-float">
            <span class="material-symbols-outlined text-4xl text-primary">school</span>
        </div>
        <h1 class="text-2xl md:text-3xl font-bold text-on-background mb-3 font-display">Tạo tài khoản mới</h1>
        <p class="text-slate-500">Trở thành thành viên của học viện hóa học kỳ diệu.</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="mb-6 rounded-2xl bg-red-50 border border-red-200 p-4 text-red-700 font-bold text-sm">
            <div asp-validation-summary="All" class="list-none"></div>
        </div>
    }

    <form asp-action="Register" asp-controller="Account" method="post" class="space-y-5">
        @Html.AntiForgeryToken()

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <!-- Full Name -->
            <div class="space-y-2">
                <label asp-for="FullName" class="text-sm font-bold text-slate-600 uppercase tracking-wider block"></label>
                <input asp-for="FullName" class="w-full px-4 py-4 rounded-2xl border border-slate-200 bg-white focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-on-background outline-none" placeholder="Nguyễn Văn A" type="text">
                <span asp-validation-for="FullName" class="text-xs text-red-500 ml-1"></span>
            </div>

            <!-- Username -->
            <div class="space-y-2">
                <label asp-for="Username" class="text-sm font-bold text-slate-600 uppercase tracking-wider block"></label>
                <input asp-for="Username" class="w-full px-4 py-4 rounded-2xl border border-slate-200 bg-white focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-on-background outline-none" placeholder="chemist_pro" type="text">
                <span asp-validation-for="Username" class="text-xs text-red-500 ml-1"></span>
            </div>
        </div>

        <!-- Email -->
        <div class="space-y-2">
            <label asp-for="Email" class="text-sm font-bold text-slate-600 uppercase tracking-wider block"></label>
            <input asp-for="Email" class="w-full px-4 py-4 rounded-2xl border border-slate-200 bg-white focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-on-background outline-none" placeholder="example@chemlab.vn" type="email">
            <span asp-validation-for="Email" class="text-xs text-red-500 ml-1"></span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <!-- Password -->
            <div class="space-y-2">
                <label asp-for="Password" class="text-sm font-bold text-slate-600 uppercase tracking-wider block"></label>
                <input asp-for="Password" class="w-full px-4 py-4 rounded-2xl border border-slate-200 bg-white focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-on-background outline-none" placeholder="••••••••" type="password">
                <span asp-validation-for="Password" class="text-xs text-red-500 ml-1"></span>
            </div>

            <!-- Confirm Password -->
            <div class="space-y-2">
                <label asp-for="ConfirmPassword" class="text-sm font-bold text-slate-600 uppercase tracking-wider block"></label>
                <input asp-for="ConfirmPassword" class="w-full px-4 py-4 rounded-2xl border border-slate-200 bg-white focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-on-background outline-none" placeholder="••••••••" type="password">
                <span asp-validation-for="ConfirmPassword" class="text-xs text-red-500 ml-1"></span>
            </div>
        </div>

        <!-- Avatar Selection -->
        <div class="space-y-3">
            <label class="text-sm font-bold text-slate-600 uppercase tracking-wider block">Chọn avatar của bạn</label>
            <div class="flex items-center gap-3 overflow-x-auto pb-2">
                <input checked class="hidden avatar-radio" id="av1" name="AvatarUrl" value="https://lh3.googleusercontent.com/aida-public/AB6AXuDiRX57plp08FtbOQ35Krw6D6zYYYiBzS7_XkLETOQVHeqgkBkKDfF1zURT_oeAlOtg2yVx7y7lGL0lL3lKc0E-VmuZxQgWt4BHZes3ZGL6Bh2cRhK96-fy65pnmTRnutdtSdm2wQ7LllOfWorqhOw11NkpV7M07J8eHy0ygUukmxaKen7g_WdJZM0AaGzA-p9pdBhjvZCLgUQ1mAdqW5i2PEGgUNujw_sMrud2nVgfRgRSekXerKtppbAwZTb-BuEn1KqyKrqc3HQ" type="radio">
                <label class="avatar-option flex-shrink-0 w-12 h-12 rounded-full border-2 border-slate-200 overflow-hidden p-0.5 bg-white shadow-sm cursor-pointer transition-all hover:border-primary" for="av1">
                    <img alt="Avatar 1" class="w-full h-full object-cover rounded-full" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDiRX57plp08FtbOQ35Krw6D6zYYYiBzS7_XkLETOQVHeqgkBkKDfF1zURT_oeAlOtg2yVx7y7lGL0lL3lKc0E-VmuZxQgWt4BHZes3ZGL6Bh2cRhK96-fy65pnmTRnutdtSdm2wQ7LllOfWorqhOw11NkpV7M07J8eHy0ygUukmxaKen7g_WdJZM0AaGzA-p9pdBhjvZCLgUQ1mAdqW5i2PEGgUNujw_sMrud2nVgfRgRSekXerKtppbAwZTb-BuEn1KqyKrqc3HQ">
                </label>
                <input class="hidden avatar-radio" id="av2" name="AvatarUrl" value="https://lh3.googleusercontent.com/aida-public/AB6AXuDc-GWYiP558vwvr7MKan9dC_CZUUAAPrQtLkMzd9UfdVz-KVLKOK0Fl5DLOONrqGbxfMRAfKl0fSXAQ5FKY-U0BkfYpY4dylvryM4NR935qrE17o1Yfw9HTKl7T81_g0JWESGbARfneAyuyxwrMupCWUHMldRnqbWuS-aOipO61TbhpAOBPUsDLseH1lefh4yKygux7szjWAcLPhdMq3_sChP2zWXWk0GWda5tF56qvZyfB-kmelvHKePEZ857tpRX7T6uNEc03eI" type="radio">
                <label class="avatar-option flex-shrink-0 w-12 h-12 rounded-full border-2 border-slate-200 overflow-hidden p-0.5 bg-white shadow-sm cursor-pointer transition-all hover:border-primary" for="av2">
                    <img alt="Avatar 2" class="w-full h-full object-cover rounded-full" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDc-GWYiP558vwvr7MKan9dC_CZUUAAPrQtLkMzd9UfdVz-KVLKOK0Fl5DLOONrqGbxfMRAfKl0fSXAQ5FKY-U0BkfYpY4dylvryM4NR935qrE17o1Yfw9HTKl7T81_g0JWESGbARfneAyuyxwrMupCWUHMldRnqbWuS-aOipO61TbhpAOBPUsDLseH1lefh4yKygux7szjWAcLPhdMq3_sChP2zWXWk0GWda5tF56qvZyfB-kmelvHKePEZ857tpRX7T6uNEc03eI">
                </label>
                <input class="hidden avatar-radio" id="av3" name="AvatarUrl" value="https://lh3.googleusercontent.com/aida-public/AB6AXuBFIYDvvBL9T8bspaMRnKaEArBhCg7Thtd9hEOTvj-h-8Qwv-P7FCs4jlQpN10mGDLr5QCUosOnkqB-ZC0MkWoctyznNHkf4HubmakfTv2T9xCEbfp1vdZuYC4vT2FZTpM6386n37Ar74BJ0dDlF1_yj3sIw8_47pkfDBYgL9-1vaFuhjoNPeFqWtcQX35VOekVQd0IYUigF9NreL28N71XoSZ2u66_gxQIvndluOIyqlyqlP9g_gpB9j4aYmkhrraLMDJ5u59VvtQ" type="radio">
                <label class="avatar-option flex-shrink-0 w-12 h-12 rounded-full border-2 border-slate-200 overflow-hidden p-0.5 bg-white shadow-sm cursor-pointer transition-all hover:border-primary" for="av3">
                    <img alt="Avatar 3" class="w-full h-full object-cover rounded-full" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBFIYDvvBL9T8bspaMRnKaEArBhCg7Thtd9hEOTvj-h-8Qwv-P7FCs4jlQpN10mGDLr5QCUosOnkqB-ZC0MkWoctyznNHkf4HubmakfTv2T9xCEbfp1vdZuYC4vT2FZTpM6386n37Ar74BJ0dDlF1_yj3sIw8_47pkfDBYgL9-1vaFuhjoNPeFqWtcQX35VOekVQd0IYUigF9NreL28N71XoSZ2u66_gxQIvndluOIyqlyqlP9g_gpB9j4aYmkhrraLMDJ5u59VvtQ">
                </label>
                <input class="hidden avatar-radio" id="av4" name="AvatarUrl" value="https://lh3.googleusercontent.com/aida-public/AB6AXuCuz2Qzqle1Hf-a7_AyhqyPyZ7eOh4EySMmTZ1pUDQWnuadPYm9jhcAc9kVOWa4XkaGjiUUJ1BDJsvesAsXdVUGV0JW8ip3UaHz0SVbIXD3RrCWrg_zxho-lFpeIwUrZwIhGp6AD8BHBCAiLLds3qJNUZ36-D5EYzQT_TuTEx6Xaeo3KQZ_JfUHBHTG05QeGwSzmRcjp9KxRzAdKW8MV0gZsPH5nJ7ZlX7SsoA-C9_pHhyM44zrlEHwmJhKLNvUB3kuFBuJ9ssCAAU" type="radio">
                <label class="avatar-option flex-shrink-0 w-12 h-12 rounded-full border-2 border-slate-200 overflow-hidden p-0.5 bg-white shadow-sm cursor-pointer transition-all hover:border-primary" for="av4">
                    <img alt="Avatar 4" class="w-full h-full object-cover rounded-full" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCuz2Qzqle1Hf-a7_AyhqyPyZ7eOh4EySMmTZ1pUDQWnuadPYm9jhcAc9kVOWa4XkaGjiUUJ1BDJsvesAsXdVUGV0JW8ip3UaHz0SVbIXD3RrCWrg_zxho-lFpeIwUrZwIhGp6AD8BHBCAiLLds3qJNUZ36-D5EYzQT_TuTEx6Xaeo3KQZ_JfUHBHTG05QeGwSzmRcjp9KxRzAdKW8MV0gZsPH5nJ7ZlX7SsoA-C9_pHhyM44zrlEHwmJhKLNvUB3kuFBuJ9ssCAAU">
                </label>
            </div>
        </div>

        <!-- Role Selection -->
        <div class="space-y-2">
            <label class="text-sm font-bold text-slate-600 uppercase tracking-wider block">Bạn là ai?</label>
            <div class="relative">
                <select class="w-full px-4 py-4 rounded-2xl border border-slate-200 bg-white focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-on-background cursor-pointer outline-none appearance-none" disabled>
                    <option value="student">Học sinh (Mặc định)</option>
                </select>
                <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400">expand_more</span>
            </div>
        </div>

        <!-- Terms Checkbox -->
        <div class="flex items-start gap-3">
            <input class="w-5 h-5 mt-0.5 rounded border-2 border-slate-300 text-primary focus:ring-primary/20 transition-all cursor-pointer bg-white checked:bg-primary checked:border-primary appearance-none" id="terms" type="checkbox">
            <label class="text-sm text-slate-600 cursor-pointer select-none" for="terms">
                Tôi đồng ý với <span class="text-primary font-bold hover:underline">Điều khoản & Điều kiện</span>
            </label>
        </div>

        <!-- Submit Button -->
        <button class="w-full bg-primary text-white font-bold py-4 rounded-2xl btn-glow hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2" type="submit">
            <span>Bắt đầu hành trình</span>
            <span class="material-symbols-outlined">rocket_launch</span>
        </button>

        <!-- Footer -->
        <div class="text-center">
            <p class="text-slate-500">
                Đã có tài khoản? 
                <a class="text-primary font-bold hover:underline" asp-action="Login" asp-controller="Account">Đăng nhập ngay</a>
            </p>
        </div>
    </form>
</div>

@section Head {
    <style>
        .avatar-radio:checked + label {
            border-color: #0058be;
            background-color: rgba(0, 88, 190, 0.05);
            transform: scale(1.1);
            box-shadow: 0 0 20px rgba(0, 88, 190, 0.25);
        }
    </style>
}