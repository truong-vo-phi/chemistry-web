<style>
        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.08);
        }
        
        .avatar-option {
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            cursor: pointer;
        }
        
        .avatar-radio:checked + label {
            border-color: #0058be;
            background-color: rgba(0, 88, 190, 0.05);
            transform: scale(1.1);
            box-shadow: 0 0 20px rgba(0, 88, 190, 0.25);
        }

        .glow-button {
            transition: all 0.3s ease;
            box-shadow: 0 10px 20px -5px rgba(0, 88, 190, 0.3);
        }
        
        .glow-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 30px -5px rgba(0, 88, 190, 0.4);
        }

        .particle {
            position: absolute;
            background: rgba(0, 88, 190, 0.1);
            border-radius: 50%;
            pointer-events: none;
            animation: float-particle 15s linear infinite;
        }

        @@keyframes float-particle {
            0% { transform: translateY(0) translateX(0); opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { transform: translateY(-100vh) translateX(50px); opacity: 0; }
        }

        .floating-char {
            animation: float-char 6s ease-in-out infinite;
        }

        @@keyframes float-char {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }

        .float-slow {
            animation: float-slow 9s ease-in-out infinite;
        }

        @@keyframes float-slow {
            0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
            50% { transform: translate3d(0, -14px, 0) rotate(3deg); }
        }

        .drift-left {
            animation: drift-left 14s ease-in-out infinite;
        }

        @@keyframes drift-left {
            0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
            50% { transform: translate3d(-16px, -8px, 0) rotate(-4deg); }
        }

        .drift-right {
            animation: drift-right 16s ease-in-out infinite;
        }

        @@keyframes drift-right {
            0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
            50% { transform: translate3d(16px, 10px, 0) rotate(5deg); }
        }

        .orb {
            position: absolute;
            border-radius: 9999px;
            filter: blur(2px);
            opacity: 0.18;
        }

        .chem-icon {
            position: absolute;
            color: rgba(0, 88, 190, 0.18);
            font-size: 72px;
            pointer-events: none;
        }

        .motion-ring {
            position: absolute;
            border-radius: 9999px;
            border: 1px dashed rgba(0, 88, 190, 0.18);
            pointer-events: none;
        }

        .orbit-one {
            animation: orbit-one 24s linear infinite;
        }

        @@keyframes orbit-one {
            0% { transform: rotate(0deg) translateX(0) rotate(0deg); }
            100% { transform: rotate(360deg) translateX(0) rotate(-360deg); }
        }

        .orbit-two {
            animation: orbit-two 34s linear infinite reverse;
        }

        @@keyframes orbit-two {
            0% { transform: rotate(0deg) translateX(0) rotate(0deg); }
            100% { transform: rotate(360deg) translateX(0) rotate(-360deg); }
        }

        .drift-diagonal {
            animation: drift-diagonal 18s ease-in-out infinite;
        }

        @@keyframes drift-diagonal {
            0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
            50% { transform: translate3d(18px, -12px, 0) rotate(6deg); }
        }

        .pulse-ring {
            animation: pulse-ring 10s ease-in-out infinite;
        }

        @@keyframes pulse-ring {
            0%, 100% { transform: scale(1); opacity: 0.14; }
            50% { transform: scale(1.05); opacity: 0.22; }
        }

        .slow-drift {
            animation: slow-drift 24s ease-in-out infinite;
        }

        @@keyframes slow-drift {
            0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
            50% { transform: translate3d(-18px, 14px, 0) rotate(-7deg); }
        }

        .custom-checkbox:checked {
            background-image: url("data:image/svg+xml,%3csvg viewBox='0 0 16 16' fill='white' xmlns='http://www.w3.org/2000/svg'%3e%3cpath d='M12.207 4.793a1 1 0 010 1.414l-5 5a1 1 0 01-1.414 0l-2-2a1 1 0 011.414-1.414L6.5 9.086l4.293-4.293a1 1 0 011.414 0z'/%3e%3c/svg%3e");
        }
    </style>
</head>
<body class="bg-background min-h-screen flex items-center justify-center p-0.5 md:p-2 font-body-md text-on-background relative overflow-hidden">
<!-- Background Elements -->
<div class="fixed inset-0 pointer-events-none overflow-hidden">
<div class="absolute top-[-12%] left-[-12%] w-[42%] h-[42%] bg-primary/5 rounded-full blur-[120px] float-slow"></div>
<div class="absolute bottom-[-12%] right-[-12%] w-[42%] h-[42%] bg-secondary/5 rounded-full blur-[120px] drift-right"></div>
<div class="absolute top-[18%] right-[12%] w-56 h-56 rounded-full bg-tertiary/5 blur-[80px] drift-left"></div>
<div class="motion-ring orbit-one" style="width: 30rem; height: 30rem; left: -10rem; top: 14%; opacity: 0.22;"></div>
<div class="motion-ring orbit-two" style="width: 20rem; height: 20rem; right: -4rem; bottom: 12%; opacity: 0.18;"></div>
<div class="motion-ring pulse-ring" style="width: 16rem; height: 16rem; left: 42%; top: 20%; opacity: 0.16;"></div>
<div class="absolute left-[8%] top-[32%] orb w-3 h-3 bg-primary drift-right"></div>
<div class="absolute left-[14%] top-[28%] orb w-2 h-2 bg-secondary float-slow"></div>
<div class="absolute right-[18%] top-[16%] chem-icon floating-char">
<span class="material-symbols-outlined">science</span>
</div>
<div class="absolute right-[6%] top-[42%] chem-icon drift-left" style="font-size: 64px; opacity: 0.14;">
<span class="material-symbols-outlined">biotech</span>
</div>
<div class="absolute left-[6%] bottom-[18%] chem-icon drift-right" style="font-size: 58px; opacity: 0.12;">
<span class="material-symbols-outlined">bubble_chart</span>
</div>
<div class="absolute right-[24%] bottom-[14%] orb w-4 h-4 bg-tertiary drift-left"></div>
<div class="absolute left-[32%] top-[10%] orb w-5 h-5 bg-secondary/80 float-slow"></div>
<div class="absolute left-[22%] bottom-[30%] chem-icon drift-diagonal" style="font-size: 60px; opacity: 0.12;">
<span class="material-symbols-outlined">biotech</span>
</div>
<div class="absolute right-[34%] top-[34%] chem-icon float-slow" style="font-size: 54px; opacity: 0.12;">
<span class="material-symbols-outlined">bubble_chart</span>
</div>
<div class="absolute right-[14%] top-[58%] text-primary/12 slow-drift" style="font-size: 62px;">
<span class="material-symbols-outlined">flare</span>
</div>
</div>
<!-- Main Registration Card -->
<main class="w-full max-w-[780px] glass-card rounded-[22px] overflow-hidden flex flex-col relative z-10">
<!-- Right Column: Form -->
<div class="flex-1 p-3 md:p-4 lg:p-5">
<div class="mb-2.5 md:mb-3">
<div class="flex items-center gap-2 mb-2">
<div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white shadow-lg">
<span class="material-symbols-outlined text-[17px]">school</span>
</div>
<span class="font-display-lg text-[16px] md:text-[17px] text-primary tracking-tight">ChemLab</span>
</div>
<h1 class="font-display-lg text-[18px] md:text-[20px] text-on-surface mb-1">Tạo tài khoản mới</h1>
<p class="text-body-md text-on-surface-variant">Trở thành một phần của học viên hóa học ma thuật.</p>
</div>
@if (!ViewData.ModelState.IsValid)
{
<div class="mb-2.5 rounded-2xl bg-error-container p-2 text-error text-sm font-bold border border-error/20">
<div asp-validation-summary="All" class="list-none"></div>
</div>
}
