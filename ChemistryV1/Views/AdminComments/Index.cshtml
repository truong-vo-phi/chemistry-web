@model List<Comment>

@{
    ViewData["Title"] = "Quản Lý Bình Luận Vi Phạm";
    var filterBy = ViewData["FilterBy"]?.ToString() ?? "all";
    var search = ViewData["Search"]?.ToString() ?? "";
    var totalReported = ViewData["TotalReported"] ?? 0;
}

<div class="space-y-8">
    <!-- Header -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-red-50 via-orange-50 to-transparent border border-red-200/60 p-8 md:p-12">
        <div class="relative z-10">
            <div class="flex items-center gap-4 mb-4">
                <span class="material-symbols-outlined text-5xl text-red-600 fill-1">report</span>
                <div>
                    <h1 class="text-4xl md:text-5xl font-bold text-on-background mb-2">Quản Lý Bình Luận</h1>
                    <p class="text-slate-600 text-lg">@totalReported bình luận bị báo cáo cần xử lý</p>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 rounded-2xl p-4 text-green-700 flex items-center gap-3">
            <span class="material-symbols-outlined">check_circle</span>
            <span>@TempData["Success"]</span>
        </div>
    }

    <!-- Filter Tabs -->
    <div class="flex flex-wrap gap-2">
        <a href="@Url.Action("Index", "AdminComments", new { filterBy = "all" })" 
           class="px-4 py-2 rounded-lg font-semibold transition-all @(filterBy == "all" ? "bg-primary text-white" : "bg-white/60 border border-white/80 text-slate-600 hover:bg-white")">
            <span class="inline-flex items-center gap-2">
                <span class="material-symbols-outlined text-lg">list</span>
                Tất cả
            </span>
        </a>
        <a href="@Url.Action("Index", "AdminComments", new { filterBy = "reported" })" 
           class="px-4 py-2 rounded-lg font-semibold transition-all @(filterBy == "reported" ? "bg-red-600 text-white" : "bg-white/60 border border-white/80 text-slate-600 hover:bg-white")">
            <span class="inline-flex items-center gap-2">
                <span class="material-symbols-outlined text-lg">warning</span>
                Bị báo cáo
            </span>
        </a>
        <a href="@Url.Action("Index", "AdminComments", new { filterBy = "warnings" })" 
           class="px-4 py-2 rounded-lg font-semibold transition-all @(filterBy == "warnings" ? "bg-yellow-600 text-white" : "bg-white/60 border border-white/80 text-slate-600 hover:bg-white")">
            <span class="inline-flex items-center gap-2">
                <span class="material-symbols-outlined text-lg">mail</span>
                Cảnh báo
            </span>
        </a>
        <a href="@Url.Action("Index", "AdminComments", new { filterBy = "deleted" })" 
           class="px-4 py-2 rounded-lg font-semibold transition-all @(filterBy == "deleted" ? "bg-red-700 text-white" : "bg-white/60 border border-white/80 text-slate-600 hover:bg-white")">
            <span class="inline-flex items-center gap-2">
                <span class="material-symbols-outlined text-lg">delete</span>
                Đã xóa
            </span>
        </a>
        <a href="@Url.Action("Index", "AdminComments", new { filterBy = "hidden" })" 
           class="px-4 py-2 rounded-lg font-semibold transition-all @(filterBy == "hidden" ? "bg-slate-600 text-white" : "bg-white/60 border border-white/80 text-slate-600 hover:bg-white")">
            <span class="inline-flex items-center gap-2">
                <span class="material-symbols-outlined text-lg">visibility_off</span>
                Ẩn
            </span>
        </a>
    </div>

    <!-- Search -->
    <form method="get" class="flex gap-2">
        <input type="hidden" name="filterBy" value="@filterBy" />
        <input type="text" name="search" placeholder="Tìm theo username, tên hoặc nội dung..." 
               value="@search" class="flex-1 px-4 py-3 rounded-xl border border-white/80 bg-white/60" />
        <button type="submit" class="px-6 py-3 rounded-xl bg-primary text-white font-semibold hover:bg-primary/90 transition-all">
            Tìm kiếm
        </button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a href="@Url.Action("Index", "AdminComments", new { filterBy })" 
               class="px-6 py-3 rounded-xl bg-slate-300 text-slate-700 font-semibold hover:bg-slate-400 transition-all">
                Xóa
            </a>
        }
    </form>

    <!-- Comments List -->
    <div class="space-y-4">
        @if (Model.Any())
        {
            @foreach (var comment in Model)
            {
                var hasAction = !string.IsNullOrEmpty(comment.AdminAction);
                var actionColor = comment.AdminAction switch
                {
                    "warning" => "bg-yellow-50 border-yellow-200",
                    "delete" => "bg-red-50 border-red-200",
                    "hidden" => "bg-slate-50 border-slate-200",
                    _ => "bg-white/60 border-white/80"
                };
                
                var statusBadge = comment.AdminAction switch
                {
                    "warning" => "bg-yellow-100 text-yellow-800",
                    "delete" => "bg-red-100 text-red-800",
                    "hidden" => "bg-slate-100 text-slate-800",
                    _ => comment.IsReported ? "bg-red-100 text-red-800" : "bg-slate-100 text-slate-800"
                };

                <div class="@actionColor border rounded-2xl p-6 transition-all hover:shadow-md">
                    <div class="flex items-start justify-between gap-4 mb-4">
                        <div class="flex items-start gap-4 flex-1">
                            <!-- User Avatar -->
                            <div class="flex-shrink-0">
                                <img src="@(comment.User?.AvatarUrl ?? "https://api.dicebear.com/7.x/adventurer/svg?seed=user")" 
                                     alt="@comment.User?.FullName" 
                                     class="w-12 h-12 rounded-full object-cover border-2 border-primary/20" />
                            </div>

                            <!-- User Info -->
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <h4 class="font-bold text-on-background">@comment.User?.FullName</h4>
                                    <span class="text-sm text-slate-500">@comment.User?.Username</span>
                                </div>
                                @if (comment.LessonId.HasValue)
                                {
                                    <p class="text-sm text-slate-600">📚 <strong>Bài học:</strong> @comment.Lesson?.Title</p>
                                }
                                else if (comment.MissionId.HasValue)
                                {
                                    <p class="text-sm text-slate-600">🎯 <strong>Mission:</strong> @comment.Mission?.Title</p>
                                }
                                <p class="text-xs text-slate-500 mt-1">📅 @comment.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                        </div>

                        <!-- Status Badge -->
                        <div class="flex-shrink-0">
                            @if (comment.AdminAction != null)
                            {
                                <span class="@statusBadge px-3 py-1 rounded-full text-sm font-semibold">
                                    @(comment.AdminAction switch {
                                        "warning" => "⚠️ Cảnh báo",
                                        "delete" => "🗑️ Đã xóa",
                                        "hidden" => "👁️ Ẩn",
                                        _ => "?"
                                    })
                                </span>
                            }
                            else if (comment.IsReported)
                            {
                                <span class="bg-red-100 text-red-800 px-3 py-1 rounded-full text-sm font-semibold">
                                    🚩 Báo cáo (x@comment.ReportCount)
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Content -->
                    <div class="bg-white/50 rounded-xl p-4 mb-4 border border-white/80">
                        <p class="text-slate-700">@comment.Content</p>
                    </div>

                    <!-- Report Info -->
                    @if (comment.IsReported && !hasAction)
                    {
                        <div class="bg-red-50 border border-red-200 rounded-lg p-3 mb-4">
                            <p class="text-sm text-red-800"><strong>Lý do báo cáo:</strong> @comment.ReportReason</p>
                            <p class="text-xs text-red-700 mt-1">📤 Báo cáo lúc: @comment.ReportedAt?.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    }

                    <!-- Action Info -->
                    @if (hasAction)
                    {
                        <div class="bg-blue-50 border border-blue-200 rounded-lg p-3 mb-4">
                            <p class="text-sm text-blue-800"><strong>Hành động:</strong> @comment.AdminActionReason</p>
                            <p class="text-xs text-blue-700 mt-1">⏰ Thời gian: @comment.ActionTakenAt?.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    }

                    <!-- Action Buttons -->
                    @if (!hasAction)
                    {
                        <div class="flex flex-wrap gap-2">
                            <!-- Warning Button -->
                            <button type="button" class="px-4 py-2 bg-yellow-500 text-white rounded-lg font-semibold hover:bg-yellow-600 transition-all flex items-center gap-2"
                                    onclick="showActionModal(@comment.Id, 'warning', '⚠️ Cảnh báo')">
                                <span class="material-symbols-outlined text-lg">mail</span>
                                Cảnh báo
                            </button>

                            <!-- Delete Button -->
                            <button type="button" class="px-4 py-2 bg-red-600 text-white rounded-lg font-semibold hover:bg-red-700 transition-all flex items-center gap-2"
                                    onclick="showActionModal(@comment.Id, 'delete', '🗑️ Xóa')">
                                <span class="material-symbols-outlined text-lg">delete</span>
                                Xóa
                            </button>

                            <!-- Hide Button -->
                            <button type="button" class="px-4 py-2 bg-slate-600 text-white rounded-lg font-semibold hover:bg-slate-700 transition-all flex items-center gap-2"
                                    onclick="showActionModal(@comment.Id, 'hidden', '👁️ Ẩn')">
                                <span class="material-symbols-outlined text-lg">visibility_off</span>
                                Ẩn
                            </button>

                            <!-- Clear Report -->
                            @if (comment.IsReported)
                            {
                                <form method="post" action="@Url.Action("ClearReport", "AdminComments")" style="display: inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="commentId" value="@comment.Id" />
                                    <button type="submit" class="px-4 py-2 bg-cyan-500 text-white rounded-lg font-semibold hover:bg-cyan-600 transition-all flex items-center gap-2"
                                            onclick="return confirm('Xoá báo cáo này?')">
                                        <span class="material-symbols-outlined text-lg">thumb_up</span>
                                        Xóa báo cáo
                                    </button>
                                </form>
                            }
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="text-center py-16">
                <span class="material-symbols-outlined text-6xl text-slate-300 mb-4 block">done_all</span>
                <p class="text-xl text-slate-500">Không có bình luận nào cần xử lý</p>
            </div>
        }
    </div>
</div>

<!-- Action Modal -->
<div id="actionModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4" onclick="closeActionModal()">
    <div class="bg-white rounded-2xl p-8 max-w-md w-full" onclick="event.stopPropagation()">
        <h3 id="actionTitle" class="text-2xl font-bold mb-4"></h3>
        
        <form id="actionForm" method="post" action="@Url.Action("TakeAction", "AdminComments")">
            @Html.AntiForgeryToken()
            <input type="hidden" id="commentId" name="commentId" />
            <input type="hidden" id="action" name="action" />
            
            <div class="mb-4">
                <label class="block text-sm font-semibold mb-2">Lý do:</label>
                <textarea name="reason" class="w-full px-4 py-2 border border-slate-300 rounded-lg" rows="4" placeholder="Nhập lý do hành động..." required></textarea>
            </div>

            <div class="flex gap-2">
                <button type="submit" class="flex-1 px-4 py-2 bg-primary text-white rounded-lg font-semibold hover:bg-primary/90 transition-all">
                    Xác nhận
                </button>
                <button type="button" class="flex-1 px-4 py-2 bg-slate-300 text-slate-700 rounded-lg font-semibold hover:bg-slate-400 transition-all" 
                        onclick="closeActionModal()">
                    Hủy
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function showActionModal(commentId, action, title) {
        document.getElementById('commentId').value = commentId;
        document.getElementById('action').value = action;
        document.getElementById('actionTitle').textContent = title;
        document.getElementById('actionModal').classList.remove('hidden');
    }

    function closeActionModal() {
        document.getElementById('actionModal').classList.add('hidden');
        document.getElementById('actionForm').reset();
    }
</script>
