@model ChemistryV1.ViewModels.AdminUsersViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User Management | ChemLab";
    ViewData["Description"] = "Manage user accounts, lock/unlock, and assign roles.";
}

<!-- Page Header -->
<div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8">
    <div>
        <p class="text-xs uppercase tracking-[0.3em] text-slate-500 font-bold">Admin System</p>
        <h1 class="text-3xl md:text-4xl font-bold text-on-background font-display">User Management</h1>
        <p class="text-slate-500 mt-2 max-w-2xl">Manage user accounts, lock/unlock, and assign roles.</p>
    </div>
</div>

@if (TempData["UserActionMessage"] != null)
{
    <div class="mb-6 glass-card border border-emerald-200 text-emerald-700 px-4 py-3 rounded-2xl font-bold shadow-sm">
        @TempData["UserActionMessage"]
    </div>
}

<!-- Search -->
<form method="get" class="mb-6">
    <div class="relative max-w-md">
        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">search</span>
        <input name="search" value="@Model.Search" class="w-full bg-white border-2 border-slate-200 rounded-2xl pl-12 pr-4 py-3 text-sm outline-none transition-all focus:border-primary" placeholder="Search by name, username, email..." />
    </div>
</form>

<!-- Stats -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
    <div class="glass-card p-5">
        <p class="text-xs uppercase tracking-wider text-slate-500 font-bold">Total Users</p>
        <p class="text-3xl font-bold mt-2 text-on-background">@Model.Users.Count</p>
    </div>
    <div class="glass-card p-5">
        <p class="text-xs uppercase tracking-wider text-slate-500 font-bold">Admin</p>
        <p class="text-3xl font-bold mt-2 text-on-background">@Model.Users.Count(u => u.Role == "Admin")</p>
    </div>
    <div class="glass-card p-5">
        <p class="text-xs uppercase tracking-wider text-slate-500 font-bold">Active</p>
        <p class="text-3xl font-bold mt-2 text-on-background">@Model.Users.Count(u => u.IsActive == true)</p>
    </div>
</div>

<!-- Users Table -->
<div class="glass-card overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-5 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-600">User</th>
                    <th class="px-5 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-600">Role</th>
                    <th class="px-5 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-600">Status</th>
                    <th class="px-5 py-4 text-right text-xs font-bold uppercase tracking-wider text-slate-600">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
                @foreach (var user in Model.Users)
                {
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-5 py-4">
                            <div class="flex items-center gap-3">
                                <img class="w-11 h-11 rounded-full object-cover border border-slate-200" src="@(user.AvatarUrl ?? "https://via.placeholder.com/44")" alt="@user.Username" />
                                <div>
                                    <p class="font-bold text-on-background">@(user.FullName ?? user.Username ?? "Unknown")</p>
                                    <p class="text-xs text-slate-500">@user.Email</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-5 py-4">
                            <form asp-action="UpdateRole" method="post" class="flex items-center gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.Id" />
                                <select name="role" class="rounded-full border border-slate-300 bg-white px-3 py-2 text-sm font-semibold outline-none focus:border-primary">
                                    <option value="Student" selected="@(user.Role == "Student")">Student</option>
                                    <option value="Admin" selected="@(user.Role == "Admin")">Admin</option>
                                </select>
                                <button type="submit" class="px-3 py-2 rounded-full bg-slate-900 text-white text-sm font-semibold hover:bg-black transition-colors">Save</button>
                            </form>
                        </td>
                        <td class="px-5 py-4">
                            @if (user.IsActive == true)
                            {
                                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-200">
                                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Active
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-50 text-rose-700 text-xs font-bold border border-rose-200">
                                    <span class="w-2 h-2 rounded-full bg-rose-500"></span> Locked
                                </span>
                            }
                        </td>
                        <td class="px-5 py-4 text-right">
                            <form asp-action="ToggleActive" method="post" class="inline-block">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="px-3 py-2 rounded-full border border-slate-300 bg-white text-sm font-semibold hover:border-slate-900 transition-colors">
                                    @(user.IsActive == true ? "Lock" : "Unlock")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>