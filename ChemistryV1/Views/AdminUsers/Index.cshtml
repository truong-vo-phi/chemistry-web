@model ChemistryV1.ViewModels.AdminUsersViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Management | ChemLab</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&family=Quicksand:wght@400;500;600;700&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <style>
        body { font-family: "Quicksand", sans-serif; background: linear-gradient(180deg, #fbf9f1 0%, #f3f1e8 100%); }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; vertical-align: middle; }
        .glass { background: rgba(255,255,255,0.78); backdrop-filter: blur(18px); }
    </style>
</head>
<body class="min-h-screen text-slate-800">
    <div class="max-w-7xl mx-auto px-4 md:px-8 py-8 md:py-10">
        <div class="flex flex-col gap-6 mb-8">
            <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
                <div>
                    <p class="text-xs uppercase tracking-[0.3em] text-slate-500 font-bold">Admin System</p>
                    <h1 class="text-3xl md:text-4xl font-bold text-slate-900" style="font-family:Lexend,sans-serif;">User Management</h1>
                    <p class="text-slate-600 mt-2 max-w-2xl">Quản lý tài khoản, khóa/mở khóa và phân quyền người dùng. Teacher đã được gộp vào Admin.</p>
                </div>
                <div class="flex gap-3">
                    <a asp-controller="Dashboard" asp-action="Index" class="px-4 py-3 rounded-2xl bg-white border border-slate-200 font-semibold hover:border-primary hover:text-primary transition-colors">Dashboard</a>
                    <a asp-controller="Home" asp-action="Index" class="px-4 py-3 rounded-2xl bg-slate-900 text-white font-semibold hover:bg-slate-800 transition-colors">Back to Home</a>
                </div>
            </div>

            @if (TempData["UserActionMessage"] != null)
            {
                <div class="glass border border-emerald-200 text-emerald-800 px-4 py-3 rounded-2xl font-semibold shadow-sm">
                    @TempData["UserActionMessage"]
                </div>
            }

            <form method="get" class="flex items-center gap-3 glass border border-slate-200 rounded-2xl px-4 py-3 shadow-sm">
                <span class="material-symbols-outlined text-slate-500">search</span>
                <input name="search" value="@Model.Search" class="w-full bg-transparent outline-none text-sm" placeholder="Tìm theo tên, username, email..." />
            </form>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
            <div class="glass border border-slate-200 rounded-3xl p-5 shadow-sm">
                <p class="text-xs uppercase tracking-wider text-slate-500 font-bold">Tổng người dùng</p>
                <p class="text-3xl font-bold mt-2 text-slate-900">@Model.Users.Count</p>
            </div>
            <div class="glass border border-slate-200 rounded-3xl p-5 shadow-sm">
                <p class="text-xs uppercase tracking-wider text-slate-500 font-bold">Admin</p>
                <p class="text-3xl font-bold mt-2 text-slate-900">@Model.Users.Count(u => u.Role == "Admin")</p>
            </div>
            <div class="glass border border-slate-200 rounded-3xl p-5 shadow-sm">
                <p class="text-xs uppercase tracking-wider text-slate-500 font-bold">Đang hoạt động</p>
                <p class="text-3xl font-bold mt-2 text-slate-900">@Model.Users.Count(u => u.IsActive == true)</p>
            </div>
        </div>

        <div class="overflow-hidden rounded-3xl border border-slate-200 glass shadow-xl">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200">
                    <thead class="bg-white/60">
                        <tr>
                            <th class="px-5 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-500">User</th>
                            <th class="px-5 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-500">Role</th>
                            <th class="px-5 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-500">Status</th>
                            <th class="px-5 py-4 text-right text-xs font-bold uppercase tracking-wider text-slate-500">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 bg-white/40">
                        @foreach (var user in Model.Users)
                        {
                            <tr class="hover:bg-white/60 transition-colors">
                                <td class="px-5 py-4">
                                    <div class="flex items-center gap-3">
                                        <img class="w-11 h-11 rounded-full object-cover border border-slate-200" src="@(user.AvatarUrl ?? "https://via.placeholder.com/44")" alt="@user.Username" />
                                        <div>
                                            <p class="font-bold text-slate-900">@(user.FullName ?? user.Username ?? "Unknown")</p>
                                            <p class="text-xs text-slate-500">@user.Email</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-5 py-4">
                                    <form asp-action="UpdateRole" method="post" class="flex items-center gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <select name="role" class="rounded-full border border-slate-300 bg-white px-3 py-2 text-sm font-semibold">
                                            <option value="Student" selected="@(user.Role == "Student")">Student</option>
                                            <option value="Admin" selected="@(user.Role == "Admin")">Admin</option>
                                        </select>
                                        <button type="submit" class="px-3 py-2 rounded-full bg-slate-900 text-white text-sm font-semibold hover:bg-black transition-colors">Save</button>
                                    </form>
                                </td>
                                <td class="px-5 py-4">
                                    @if (user.IsActive == true)
                                    {
                                        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-200">
                                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-50 text-rose-700 text-xs font-bold border border-rose-200">
                                            <span class="w-2 h-2 rounded-full bg-rose-500"></span> Locked
                                        </span>
                                    }
                                </td>
                                <td class="px-5 py-4 text-right">
                                    <form asp-action="ToggleActive" method="post" class="inline-block">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <button type="submit" class="px-3 py-2 rounded-full border border-slate-300 bg-white text-sm font-semibold hover:border-slate-900 transition-colors">
                                            @(user.IsActive == true ? "Lock" : "Unlock")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>