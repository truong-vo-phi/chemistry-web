@model LeaderboardViewModel

@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Leaderboard - Bảng Xếp Hạng";
    var sortBy = Model.SortBy ?? "xp";
}

<div class="space-y-8">
    <!-- Header -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-primary/10 via-secondary/5 to-transparent border border-white/60 p-8 md:p-12">
        <div class="relative z-10">
            <div class="flex items-center gap-4 mb-4">
                <span class="material-symbols-outlined text-5xl text-primary fill-1">emoji_events</span>
                <div>
                    <h1 class="text-4xl md:text-5xl font-bold text-on-background mb-2">Bảng Xếp Hạng</h1>
                    <p class="text-slate-600 text-lg">Xem thứ hạng của các học sinh xuất sắc</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Tabs -->
    <div class="flex flex-wrap gap-3">
        <a href="@Url.Action("Index", "Leaderboard", new { sortBy = "xp" })" 
           class="flex items-center gap-2 px-6 py-3 rounded-xl font-semibold transition-all @(sortBy == "xp" ? "bg-primary text-white shadow-lg" : "bg-white/60 text-slate-600 border border-white/60 hover:bg-white")">
            <span class="material-symbols-outlined">bolt</span>
            <span>XP</span>
        </a>
        <a href="@Url.Action("Index", "Leaderboard", new { sortBy = "level" })" 
           class="flex items-center gap-2 px-6 py-3 rounded-xl font-semibold transition-all @(sortBy == "level" ? "bg-primary text-white shadow-lg" : "bg-white/60 text-slate-600 border border-white/60 hover:bg-white")">
            <span class="material-symbols-outlined">trending_up</span>
            <span>Level</span>
        </a>
        <a href="@Url.Action("Index", "Leaderboard", new { sortBy = "missions" })" 
           class="flex items-center gap-2 px-6 py-3 rounded-xl font-semibold transition-all @(sortBy == "missions" ? "bg-primary text-white shadow-lg" : "bg-white/60 text-slate-600 border border-white/60 hover:bg-white")">
            <span class="material-symbols-outlined">assignment_turned_in</span>
            <span>Missions</span>
        </a>
        <a href="@Url.Action("Index", "Leaderboard", new { sortBy = "streak" })" 
           class="flex items-center gap-2 px-6 py-3 rounded-xl font-semibold transition-all @(sortBy == "streak" ? "bg-primary text-white shadow-lg" : "bg-white/60 text-slate-600 border border-white/60 hover:bg-white")">
            <span class="material-symbols-outlined">local_fire_department</span>
            <span>Streak</span>
        </a>
        <a href="@Url.Action("Index", "Leaderboard", new { sortBy = "score" })" 
           class="flex items-center gap-2 px-6 py-3 rounded-xl font-semibold transition-all @(sortBy == "score" ? "bg-primary text-white shadow-lg" : "bg-white/60 text-slate-600 border border-white/60 hover:bg-white")">
            <span class="material-symbols-outlined">stars</span>
            <span>Score</span>
        </a>
    </div>

    <!-- Leaderboard Table -->
    <div class="space-y-4">
        @if (Model.Users.Any())
        {
            @for (int i = 0; i < Model.Users.Count; i++)
            {
                var user = Model.Users[i];
                var medalColor = user.Rank switch
                {
                    1 => "text-yellow-500",
                    2 => "text-slate-400",
                    3 => "text-orange-600",
                    _ => "text-slate-300"
                };

                var rankBgColor = user.Rank switch
                {
                    1 => "bg-yellow-50 border-yellow-200",
                    2 => "bg-slate-50 border-slate-200",
                    3 => "bg-orange-50 border-orange-200",
                    _ => "bg-white/60 border-white/80"
                };

                <div class="@rankBgColor border rounded-2xl p-6 transition-all hover:shadow-lg hover:scale-[1.02] cursor-default">
                    <div class="flex items-center gap-6">
                        <!-- Rank Medal -->
                        <div class="flex-shrink-0 text-center">
                            @if (user.Rank == 1)
                            {
                                <span class="material-symbols-outlined text-6xl fill-1 text-yellow-500">military_tech</span>
                            }
                            else if (user.Rank == 2)
                            {
                                <span class="material-symbols-outlined text-6xl fill-1 text-slate-400">military_tech</span>
                            }
                            else if (user.Rank == 3)
                            {
                                <span class="material-symbols-outlined text-6xl fill-1 text-orange-600">military_tech</span>
                            }
                            else
                            {
                                <div class="text-4xl font-bold text-slate-400 font-display">@user.Rank</div>
                            }
                        </div>

                        <!-- User Profile -->
                        <div class="flex-shrink-0">
                            <img src="@user.AvatarUrl" alt="@user.FullName" class="w-16 h-16 rounded-full object-cover border-4 border-white shadow-md" />
                        </div>

                        <!-- User Info -->
                        <div class="flex-1 min-w-0">
                            <h3 class="text-xl font-bold text-on-background truncate">@user.FullName</h3>
                            <p class="text-sm text-slate-500">@user.Username</p>
                        </div>

                        <!-- Stats Grid -->
                        <div class="hidden sm:grid grid-cols-4 gap-4 flex-shrink-0">
                            <!-- XP -->
                            <div class="text-center">
                                <div class="flex items-center justify-center gap-1 text-primary font-bold text-lg mb-1">
                                    <span class="material-symbols-outlined text-xl">bolt</span>
                                    @user.Xp
                                </div>
                                <p class="text-xs text-slate-500 font-semibold">XP</p>
                            </div>

                            <!-- Level -->
                            <div class="text-center">
                                <div class="flex items-center justify-center gap-1 text-secondary font-bold text-lg mb-1">
                                    <span class="material-symbols-outlined text-xl">trending_up</span>
                                    @user.Level
                                </div>
                                <p class="text-xs text-slate-500 font-semibold">LVL</p>
                            </div>

                            <!-- Missions -->
                            <div class="text-center">
                                <div class="flex items-center justify-center gap-1 text-cyan-600 font-bold text-lg mb-1">
                                    <span class="material-symbols-outlined text-xl">assignment_turned_in</span>
                                    @user.CompletedMissions
                                </div>
                                <p class="text-xs text-slate-500 font-semibold">MISSIONS</p>
                            </div>

                            <!-- Streak -->
                            <div class="text-center">
                                <div class="flex items-center justify-center gap-1 text-orange-500 font-bold text-lg mb-1">
                                    <span class="material-symbols-outlined text-xl">local_fire_department</span>
                                    @user.Streak
                                </div>
                                <p class="text-xs text-slate-500 font-semibold">STREAK</p>
                            </div>
                        </div>

                        <!-- Stats Mobile -->
                        <div class="sm:hidden flex gap-3">
                            <div class="text-center">
                                <div class="text-primary font-bold">@user.Xp</div>
                                <p class="text-xs text-slate-500">XP</p>
                            </div>
                            <div class="text-center">
                                <div class="text-secondary font-bold">@user.Level</div>
                                <p class="text-xs text-slate-500">LVL</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-16">
                <span class="material-symbols-outlined text-6xl text-slate-300 mb-4 block">groups</span>
                <p class="text-xl text-slate-500">Chưa có học sinh nào</p>
            </div>
        }
    </div>

    <!-- Legend -->
    <div class="bg-white/60 border border-white/80 rounded-2xl p-8">
        <h3 class="text-lg font-bold text-on-background mb-6">Hệ Thống Xếp Hạng</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <div>
                <div class="flex items-center gap-3 mb-3">
                    <span class="material-symbols-outlined text-primary">bolt</span>
                    <span class="font-semibold text-on-background">XP (Experience Points)</span>
                </div>
                <p class="text-sm text-slate-600">Điểm kinh nghiệm thu được từ hoàn thành bài học, mission và quiz</p>
            </div>
            <div>
                <div class="flex items-center gap-3 mb-3">
                    <span class="material-symbols-outlined text-secondary">trending_up</span>
                    <span class="font-semibold text-on-background">Level (Cấp độ)</span>
                </div>
                <p class="text-sm text-slate-600">Cấp độ hiện tại dựa trên tổng số XP đã tích lũy</p>
            </div>
            <div>
                <div class="flex items-center gap-3 mb-3">
                    <span class="material-symbols-outlined text-cyan-600">assignment_turned_in</span>
                    <span class="font-semibold text-on-background">Missions (Nhiệm vụ)</span>
                </div>
                <p class="text-sm text-slate-600">Số lượng mission đã hoàn thành thành công</p>
            </div>
            <div>
                <div class="flex items-center gap-3 mb-3">
                    <span class="material-symbols-outlined text-orange-500">local_fire_department</span>
                    <span class="font-semibold text-on-background">Streak (Chuỗi)</span>
                </div>
                <p class="text-sm text-slate-600">Số ngày liên tiếp hoàn thành hoạt động</p>
            </div>
        </div>
    </div>
</div>
