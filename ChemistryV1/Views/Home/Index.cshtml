@model ChemistryV1.ViewModels.HomeDashboardViewModel
@{
    Layout = null;
    var goalPercent = Model.NextGoalTarget <= 0 ? 0 : Math.Min(100, (int)Math.Round(Model.NextGoalCurrent * 100.0 / Model.NextGoalTarget));
    var controller = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLowerInvariant() ?? "";
}
<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>ChemLab | Futuristic Academy Dashboard</title>
    <meta name="description" content="Bảng điều khiển học tập ChemLab - theo dõi tiến độ, nhiệm vụ và thành tích của bạn." />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#3b82f6",
                        "secondary": "#10b981",
                        "tertiary": "#f59e0b",
                        "background": "#fdfcf8",
                        "on-background": "#1e293b",
                        "surface": "rgba(255,255,255,0.7)",
                        "surface-variant": "#f1f5f9",
                        "outline": "#cbd5e1",
                        "error": "#ef4444"
                    },
                    borderRadius: {
                        DEFAULT: "1rem",
                        lg: "2rem",
                        xl: "2.5rem",
                        "2xl": "32px",
                        full: "9999px"
                    },
                    spacing: {
                        gutter: "32px",
                        "margin-mobile": "20px",
                        unit: "8px",
                        "margin-desktop": "48px",
                        "container-max": "1300px"
                    },
                    fontFamily: {
                        display: ["Lexend", "sans-serif"],
                        body: ["Lexend", "sans-serif"]
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #fdfcf8; font-family: 'Lexend', sans-serif; color: #1e293b; overflow-x: hidden; position: relative; }
        body::before { content: ""; position: fixed; top: 0; left: 0; width: 100%; height: 100%; opacity: 0.03; z-index: 100; pointer-events: none; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E"); }
        .blob { position: fixed; width: 600px; height: 600px; background: radial-gradient(circle, rgba(59,130,246,0.08) 0%, transparent 70%); border-radius: 50%; z-index: -1; filter: blur(60px); }
        .glass-card { background: rgba(255,255,255,0.65); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.8); box-shadow: 0 10px 40px -10px rgba(0,0,0,0.04); border-radius: 32px; }
        .premium-shadow { box-shadow: 0 20px 50px -15px rgba(59,130,246,0.15); }
        .xp-glow { box-shadow: 0 0 20px rgba(59,130,246,0.4); }
        .btn-glow { box-shadow: 0 8px 25px -5px rgba(59,130,246,0.5); }
        .collectible-border { border: 1px solid rgba(0,0,0,0.05); background: linear-gradient(135deg, rgba(255,255,255,1) 0%, rgba(248,250,252,1) 100%); transition: all 0.3s cubic-bezier(0.34,1.56,0.64,1); }
        .collectible-border:hover { transform: translateY(-5px) scale(1.02); border-color: rgba(59,130,246,0.3); box-shadow: 0 12px 30px -10px rgba(0,0,0,0.1); }
        .sidebar-active { background: linear-gradient(90deg, rgba(59,130,246,0.1) 0%, transparent 100%); border-right: 3px solid #3b82f6; }
        .custom-scrollbar::-webkit-scrollbar { height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
        @@keyframes float { 0% { transform: translateY(0px); } 50% { transform: translateY(-10px); } 100% { transform: translateY(0px); } }
        .animate-float { animation: float 4s ease-in-out infinite; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .material-symbols-outlined.fill-1 { font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        /* Mobile sidebar overlay */
        #mobile-sidebar-overlay { display: none; }
        #mobile-sidebar-overlay.active { display: block; }
        #mobile-sidebar.open { transform: translateX(0); }
    </style>
</head>
<body class="min-h-screen">
    <!-- Atmospheric Blobs -->
    <div class="blob -top-48 -left-48"></div>
    <div class="blob top-1/2 -right-48"></div>
    <div class="blob -bottom-48 left-1/3"></div>

    <!-- Mobile Sidebar Overlay -->
    <div id="mobile-sidebar-overlay" class="fixed inset-0 bg-black/30 z-40 backdrop-blur-sm lg:hidden" onclick="closeMobileSidebar()"></div>

    <!-- SideNavBar -->
    <aside id="mobile-sidebar" class="flex flex-col w-72 fixed left-0 top-0 h-full bg-white/70 backdrop-blur-xl border-r border-white/60 z-50 lg:flex py-10 px-8 shadow-xl transition-transform duration-300 -translate-x-full lg:translate-x-0">
        <div class="mb-10">
            <a asp-controller="Home" asp-action="Index" class="text-3xl font-bold text-primary tracking-tight font-display block">ChemLab</a>
        </div>

        <!-- User Profile Card -->
        <div class="flex items-center gap-4 p-4 mb-8 bg-white/60 rounded-2xl border border-white/80 shadow-sm">
            <div class="relative flex-shrink-0">
                <img alt="@Model.UserName" class="w-12 h-12 rounded-full object-cover border-2 border-primary/20" src="@Model.AvatarUrl" />
                <div class="absolute bottom-0 right-0 w-3 h-3 bg-secondary border-2 border-white rounded-full"></div>
            </div>
            <div class="min-w-0">
                <p class="font-bold text-sm text-on-background leading-none mb-1 truncate">@Model.UserName</p>
                <p class="text-[10px] text-slate-500 uppercase font-semibold tracking-widest">@Model.Role</p>
            </div>
        </div>

        <nav class="flex-1 space-y-1">
            <a class="sidebar-active flex items-center gap-4 p-4 text-primary transition-all duration-300 rounded-l-xl" asp-controller="Home" asp-action="Index">
                <span class="material-symbols-outlined fill-1">science</span>
                <span class="font-semibold text-sm">Lab Bench</span>
            </a>
            <a class="text-slate-500 hover:text-primary flex items-center gap-4 p-4 transition-all hover:translate-x-2 rounded-l-xl hover:bg-primary/5" asp-controller="Courses" asp-action="Library">
                <span class="material-symbols-outlined">apps</span>
                <span class="font-medium text-sm">Curriculum</span>
            </a>
            <a class="text-slate-500 hover:text-primary flex items-center gap-4 p-4 transition-all hover:translate-x-2 rounded-l-xl hover:bg-primary/5" asp-controller="Profile" asp-action="Index">
                <span class="material-symbols-outlined">stars</span>
                <span class="font-medium text-sm">My Progress</span>
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a class="text-slate-500 hover:text-primary flex items-center gap-4 p-4 transition-all hover:translate-x-2 rounded-l-xl hover:bg-primary/5" asp-controller="Dashboard" asp-action="Index">
                    <span class="material-symbols-outlined">dashboard</span>
                    <span class="font-medium text-sm">Admin Dashboard</span>
                </a>
                <a class="text-slate-500 hover:text-primary flex items-center gap-4 p-4 transition-all hover:translate-x-2 rounded-l-xl hover:bg-primary/5" asp-controller="TeacherCourses" asp-action="Index">
                    <span class="material-symbols-outlined">auto_stories</span>
                    <span class="font-medium text-sm">Manage Courses</span>
                </a>
            }
        </nav>

        <div class="mt-4 space-y-3">
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="w-full text-slate-500 hover:text-error flex items-center gap-3 p-3 rounded-2xl hover:bg-red-50 transition-all text-sm font-semibold">
                    <span class="material-symbols-outlined text-lg">logout</span>
                    Đăng xuất
                </button>
            </form>
            <a asp-controller="Courses" asp-action="Library" class="w-full bg-primary text-white font-bold text-sm py-4 rounded-2xl flex items-center justify-center gap-3 transition-all hover:scale-[1.02] active:scale-[0.98] btn-glow">
                <span class="material-symbols-outlined text-xl">add_circle</span>
                New Experiment
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="lg:ml-72 px-margin-mobile md:px-margin-desktop pt-8 pb-32 max-w-[1600px] mx-auto">
        <!-- TopAppBar -->
        <header class="flex justify-between items-center w-full mb-12">
            <div class="flex items-center gap-6">
                <!-- Mobile menu toggle -->
                <button onclick="openMobileSidebar()" class="p-3 bg-white rounded-2xl border border-slate-100 shadow-sm lg:hidden">
                    <span class="material-symbols-outlined text-primary">menu</span>
                </button>
                <!-- Search -->
                <form asp-controller="Courses" asp-action="Library" method="get" class="hidden lg:flex items-center gap-3 bg-white/60 backdrop-blur-sm px-5 py-3 rounded-2xl border border-white w-[400px] focus-within:ring-2 focus-within:ring-primary/20 transition-all">
                    <span class="material-symbols-outlined text-slate-400">search</span>
                    <input name="search" class="border-none focus:ring-0 bg-transparent text-sm w-full font-medium outline-none" placeholder="Tìm thí nghiệm, bài học, nguyên tố..." type="text" />
                </form>
            </div>
            <div class="flex items-center gap-4">
                <button class="relative p-3 bg-white/60 backdrop-blur-sm rounded-2xl border border-white text-slate-500 hover:text-primary transition-colors" title="Thông báo">
                    <span class="material-symbols-outlined">notifications</span>
                    @if (Model.DayStreak > 0)
                    {
                        <span class="absolute top-3 right-3 w-2 h-2 bg-secondary rounded-full border-2 border-white"></span>
                    }
                </button>
                <a asp-controller="Profile" asp-action="Index" class="flex items-center gap-3 bg-white p-1.5 pr-5 rounded-full border border-slate-100 shadow-sm hover:shadow-md transition-shadow cursor-pointer">
                    <img alt="@Model.UserName" class="w-10 h-10 rounded-full object-cover shadow-sm" src="@Model.AvatarUrl" />
                    <span class="font-bold text-sm hidden sm:block text-slate-700">@Model.UserName</span>
                </a>
            </div>
        </header>

        <!-- Hero Section & Stats Bento -->
        <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 mb-12">
            <!-- Hero Card -->
            <section class="xl:col-span-8 glass-card premium-shadow p-10 relative overflow-hidden flex flex-col md:flex-row items-center gap-12 group">
                <div class="absolute -top-24 -right-24 w-64 h-64 bg-primary/10 rounded-full blur-3xl"></div>
                <div class="absolute -bottom-12 -left-12 w-48 h-48 bg-secondary/5 rounded-full blur-2xl"></div>
                <!-- Avatar float -->
                <div class="relative z-10 w-full max-w-[200px] flex-shrink-0 animate-float">
                    <div class="w-40 h-40 mx-auto rounded-full overflow-hidden border-4 border-white shadow-2xl bg-primary/10 flex items-center justify-center">
                        <img alt="@Model.UserName" class="w-full h-full object-cover" src="@Model.AvatarUrl" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
                        <span class="material-symbols-outlined text-6xl text-primary hidden">person</span>
                    </div>
                    <div class="mt-3 text-center">
                        <span class="inline-block px-4 py-1.5 bg-tertiary/10 text-tertiary rounded-full text-[11px] font-bold uppercase tracking-widest border border-tertiary/20">
                            @Model.Role
                        </span>
                    </div>
                </div>
                <!-- Hero Text -->
                <div class="relative z-10 flex-1 w-full text-center md:text-left">
                    <h2 class="text-4xl font-bold text-on-background mb-4 font-display leading-tight">
                        Chào mừng, <span class="text-primary">@Model.UserName.Split(' ').FirstOrDefault()</span>!
                    </h2>
                    @{
                        var xpToNext = Model.NextGoalTarget - Model.NextGoalCurrent;
                    }
                    <p class="text-slate-500 text-lg mb-8 leading-relaxed font-medium">
                        @if (xpToNext > 0)
                        {
                            <span>Bạn chỉ còn <span class="text-primary font-bold">@xpToNext.ToString("N0") XP</span> để đạt mục tiêu "<strong>@Model.NextGoalLabel</strong>". Hãy bắt đầu nào!</span>
                        }
                        else
                        {
                            <span>Xuất sắc! Bạn đã đạt mục tiêu <strong>@Model.NextGoalLabel</strong>. Tiếp tục phá đảo! 🎉</span>
                        }
                    </p>
                    <!-- XP Bar -->
                    <div class="space-y-3">
                        <div class="flex justify-between font-bold text-xs text-slate-400 px-1">
                            <span>@Model.NextGoalCurrent.ToString("N0") XP</span>
                            <span class="text-primary">Mục tiêu: @Model.NextGoalTarget.ToString("N0") XP</span>
                        </div>
                        <div class="w-full bg-slate-100 h-4 rounded-full overflow-hidden border border-white relative shadow-inner">
                            <div class="bg-gradient-to-r from-primary to-blue-400 h-full rounded-full xp-glow transition-all duration-1000" style="width:@goalPercent%;"></div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Quick Stats -->
            <section class="xl:col-span-4 grid grid-cols-2 gap-4">
                <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm flex flex-col justify-between hover:border-primary/30 transition-all group hover:scale-[1.02]">
                    <div class="w-12 h-12 bg-blue-50 rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                        <span class="material-symbols-outlined text-primary">menu_book</span>
                    </div>
                    <div>
                        <p class="text-3xl font-bold text-on-background">@Model.TotalCompletedLessons</p>
                        <p class="text-xs text-slate-500 font-bold uppercase tracking-wider mt-1">Bài Đã Học</p>
                    </div>
                </div>
                <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm flex flex-col justify-between hover:border-secondary/30 transition-all group hover:scale-[1.02]">
                    <div class="w-12 h-12 bg-emerald-50 rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                        <span class="material-symbols-outlined text-secondary">fact_check</span>
                    </div>
                    <div>
                        <p class="text-3xl font-bold text-on-background">@Model.TotalQuizResults</p>
                        <p class="text-xs text-slate-500 font-bold uppercase tracking-wider mt-1">Bài Kiểm Tra</p>
                    </div>
                </div>
                <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm flex flex-col justify-between hover:border-tertiary/30 transition-all group hover:scale-[1.02]">
                    <div class="w-12 h-12 bg-amber-50 rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                        <span class="material-symbols-outlined text-tertiary">local_fire_department</span>
                    </div>
                    <div>
                        <p class="text-3xl font-bold text-on-background">@Model.DayStreak</p>
                        <p class="text-xs text-slate-500 font-bold uppercase tracking-wider mt-1">Ngày Liên Tiếp</p>
                    </div>
                </div>
                <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm flex flex-col justify-between hover:border-primary/30 transition-all group hover:scale-[1.02]">
                    <div class="w-12 h-12 bg-blue-50 rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                        <span class="material-symbols-outlined text-primary">military_tech</span>
                    </div>
                    <div>
                        <p class="text-3xl font-bold text-on-background">@Model.TotalXp.ToString("N0")</p>
                        <p class="text-xs text-slate-500 font-bold uppercase tracking-wider mt-1">Tổng XP</p>
                    </div>
                </div>
            </section>
        </div>

        <!-- Missions and Learning Grid -->
        <div class="grid grid-cols-1 xl:grid-cols-12 gap-10 mb-12">
            <!-- Daily Mission Panel -->
            <section class="xl:col-span-4 flex flex-col">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="text-xl font-bold text-on-background font-display">Nhiệm Vụ Hôm Nay</h3>
                    <div class="flex items-center gap-1.5 px-3 py-1 bg-secondary/10 text-secondary rounded-full text-[11px] font-bold">
                        <span class="material-symbols-outlined text-sm">schedule</span>
                        @{ var hoursLeft = 23 - DateTime.Now.Hour; }
                        @hoursLeft giờ còn lại
                    </div>
                </div>
                <div class="glass-card p-8 border-primary/10 shadow-xl flex-1 flex flex-col relative overflow-hidden">
                    <div class="absolute -right-12 -bottom-12 opacity-[0.03] text-primary rotate-12">
                        <span class="material-symbols-outlined text-[200px]">assignment</span>
                    </div>
                    <div class="space-y-4 mb-8 relative z-10">
                        @foreach (var mission in Model.Missions)
                        {
                            if (mission.Completed)
                            {
                                <div class="flex items-center gap-5 bg-white/80 p-5 rounded-2xl border border-slate-100 cursor-pointer shadow-sm">
                                    <div class="w-10 h-10 rounded-xl bg-secondary text-white flex items-center justify-center shadow-lg shadow-secondary/20 flex-shrink-0">
                                        <span class="material-symbols-outlined text-xl">check</span>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="font-bold text-sm text-slate-700">@mission.Title</p>
                                        <p class="text-[11px] text-secondary font-bold tracking-wide">@mission.RewardText ✓</p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="flex items-center gap-5 bg-white/40 p-5 rounded-2xl border border-dashed border-slate-200 hover:border-primary transition-all cursor-pointer group">
                                    <div class="w-10 h-10 rounded-xl border-2 border-slate-200 flex items-center justify-center text-slate-300 group-hover:border-primary group-hover:text-primary transition-all flex-shrink-0">
                                        <span class="material-symbols-outlined text-xl">radio_button_unchecked</span>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="font-bold text-sm text-slate-500 group-hover:text-slate-700 transition-colors">@mission.Title</p>
                                        <p class="text-[11px] text-slate-400 font-bold tracking-wide">@mission.RewardText &nbsp;(@mission.Current/@mission.Target)</p>
                                        <div class="mt-2 h-1.5 bg-slate-100 rounded-full overflow-hidden">
                                            <div class="h-full bg-primary/40 rounded-full transition-all" style="width:@mission.ProgressPercent%;"></div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        @if (!Model.Missions.Any())
                        {
                            <div class="text-center py-8 text-slate-400">
                                <span class="material-symbols-outlined text-4xl mb-2 block">assignment</span>
                                <p class="text-sm">Không có nhiệm vụ hôm nay.</p>
                            </div>
                        }
                    </div>
                    <a asp-controller="Courses" asp-action="Library" class="w-full bg-gradient-to-r from-primary to-blue-600 text-white py-5 rounded-2xl font-bold text-sm flex items-center justify-center gap-3 transition-all hover:scale-[1.03] active:scale-[0.98] btn-glow shadow-xl shadow-primary/30 mt-auto">
                        Bắt Đầu Ngay
                        <span class="material-symbols-outlined">bolt</span>
                    </a>
                </div>
            </section>

            <!-- Continue Learning -->
            <section class="xl:col-span-8">
                <h3 class="text-xl font-bold text-on-background font-display mb-6">Tiếp Tục Học</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <!-- Main Progress Card -->
                    @if (Model.ContinueCourse != null)
                    {
                        <div class="bg-white rounded-[32px] p-8 border border-slate-100 shadow-sm flex flex-col hover:border-primary/20 transition-all group">
                            <div class="flex justify-between items-start mb-8">
                                <div>
                                    <p class="text-slate-400 font-bold uppercase tracking-[0.2em] text-[10px] mb-2">Đang học</p>
                                    <h4 class="text-2xl font-bold text-on-background leading-tight line-clamp-2">@Model.ContinueCourse.Title</h4>
                                    @if (!string.IsNullOrEmpty(Model.ContinueCourse.TeacherName))
                                    {
                                        <p class="text-slate-400 text-xs mt-1">Quản lý: @Model.ContinueCourse.TeacherName</p>
                                    }
                                </div>
                                <div class="w-16 h-16 rounded-3xl bg-blue-50 flex items-center justify-center text-primary shadow-inner border border-white flex-shrink-0">
                                    <span class="material-symbols-outlined text-3xl">bubble_chart</span>
                                </div>
                            </div>
                            <div class="flex-1 mb-8 space-y-3">
                                <div class="flex justify-between text-xs font-bold text-slate-600 px-1">
                                    <span>Tiến độ khóa học</span>
                                    <span class="text-primary">@Model.ContinueCourse.ProgressPercent%</span>
                                </div>
                                <div class="h-3.5 bg-slate-100 rounded-full overflow-hidden border border-white shadow-inner">
                                    <div class="bg-primary h-full rounded-full xp-glow transition-all duration-700" style="width:@Model.ContinueCourse.ProgressPercent%;"></div>
                                </div>
                            </div>
                            <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.ContinueCourse.Id" class="bg-primary text-white py-4 px-8 rounded-2xl font-bold text-sm transition-all hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-2 btn-glow">
                                Học tiếp
                                <span class="material-symbols-outlined">play_arrow</span>
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="bg-white rounded-[32px] p-8 border border-slate-100 shadow-sm flex flex-col items-center justify-center text-center hover:border-primary/20 transition-all">
                            <span class="material-symbols-outlined text-5xl text-slate-200 mb-4">school</span>
                            <h4 class="text-lg font-bold text-slate-400 mb-2">Chưa có khóa học</h4>
                            <p class="text-sm text-slate-400 mb-6">Đăng ký khóa học đầu tiên của bạn</p>
                            <a asp-controller="Courses" asp-action="Library" class="bg-primary text-white py-3 px-6 rounded-2xl font-bold text-sm btn-glow">
                                Khám phá
                            </a>
                        </div>
                    }

                    <!-- Recommended Next -->
                    <div class="grid grid-rows-3 gap-4">
                        @foreach (var course in Model.RecentCourses.Take(3))
                        {
                            var difficultyLabel = course.ProgressPercent == 0 ? "Mới" : course.ProgressPercent >= 75 ? "Gần xong" : "Đang học";
                            var diffColor = course.ProgressPercent == 0 ? "error" : course.ProgressPercent >= 75 ? "secondary" : "tertiary";
                            var borderColor = diffColor == "error" ? "border-l-red-400" : diffColor == "secondary" ? "border-l-emerald-400" : "border-l-amber-400";
                            var iconName = diffColor == "error" ? "priority_high" : diffColor == "secondary" ? "check_circle" : "hourglass_empty";
                            var bgColor = diffColor == "error" ? "bg-red-50 text-red-500" : diffColor == "secondary" ? "bg-emerald-50 text-emerald-600" : "bg-amber-50 text-amber-600";
                            var textColor = diffColor == "error" ? "text-red-500" : diffColor == "secondary" ? "text-emerald-600" : "text-amber-600";

                            <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id" class="bg-white/60 backdrop-blur-sm rounded-2xl p-4 border border-white flex items-center gap-5 hover:bg-white hover:shadow-md transition-all group cursor-pointer border-l-4 @borderColor no-underline">
                                <div class="w-12 h-12 rounded-2xl @bgColor flex items-center justify-center flex-shrink-0">
                                    <span class="material-symbols-outlined">@iconName</span>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="font-bold text-sm text-slate-700 truncate">@course.Title</p>
                                    <p class="text-[10px] @textColor font-bold uppercase tracking-wider mt-0.5">@difficultyLabel • @course.ProgressPercent%</p>
                                </div>
                                <span class="material-symbols-outlined text-slate-300 group-hover:text-primary group-hover:translate-x-1 transition-all flex-shrink-0">chevron_right</span>
                            </a>
                        }
                        @if (!Model.RecentCourses.Any())
                        {
                            <div class="col-span-1 row-span-3 bg-white/60 rounded-2xl p-6 border border-white flex flex-col items-center justify-center text-center gap-3">
                                <span class="material-symbols-outlined text-4xl text-slate-300">school</span>
                                <p class="text-sm text-slate-400">Chưa có gợi ý khóa học</p>
                                <a asp-controller="Courses" asp-action="Library" class="text-primary text-sm font-bold hover:underline">Khám phá ngay</a>
                            </div>
                        }
                    </div>
                </div>
            </section>
        </div>

        <!-- Visual Element Banner -->
        <section class="mb-16 glass-card p-10 md:p-12 flex flex-col md:flex-row items-center justify-between gap-10 relative overflow-hidden border-blue-100 shadow-xl shadow-blue-500/[0.03]">
            <div class="absolute left-0 top-0 w-full h-full bg-gradient-to-br from-blue-50/50 to-transparent pointer-events-none"></div>
            <div class="relative z-10 max-w-xl text-center md:text-left">
                <h3 class="text-3xl md:text-4xl font-bold text-on-background mb-6 font-display leading-tight">Nắm Vững Các Nguyên Tố</h3>
                <p class="text-slate-500 text-base md:text-lg mb-10 leading-relaxed font-medium">
                    Khám phá bí ẩn của vũ trụ thông qua hóa học thực tế ảo. Mỗi thí nghiệm hoàn thành sẽ giúp bạn tiến gần hơn tới danh hiệu "Gold Alchemist".
                </p>
                <div class="flex flex-wrap justify-center md:justify-start gap-6">
                    <a asp-controller="Courses" asp-action="Library" class="flex items-center gap-3 font-bold text-sm text-primary group cursor-pointer">
                        <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center group-hover:scale-110 transition-transform">
                            <span class="material-symbols-outlined">explore</span>
                        </div>
                        Khám Phá Lab Ảo
                    </a>
                    <a asp-controller="Profile" asp-action="Index" class="flex items-center gap-3 font-bold text-sm text-tertiary group cursor-pointer">
                        <div class="w-10 h-10 rounded-xl bg-tertiary/10 flex items-center justify-center group-hover:scale-110 transition-transform">
                            <span class="material-symbols-outlined">auto_fix_high</span>
                        </div>
                        Xem Thành Tích
                    </a>
                </div>
            </div>
            <div class="relative z-10 w-full max-w-[300px]">
                <div class="w-64 h-64 mx-auto rounded-full bg-gradient-to-br from-primary/20 to-blue-200/30 flex items-center justify-center animate-float shadow-2xl">
                    <span class="material-symbols-outlined text-[8rem] text-primary/40">science</span>
                </div>
            </div>
        </section>

        <!-- Achievements & Collection -->
        <div class="grid grid-cols-1 xl:grid-cols-12 gap-10">
            <!-- Achievements full width -->
            <section class="xl:col-span-12">
                <div class="flex items-center justify-between mb-8">
                    <h3 class="text-xl font-bold text-on-background font-display">Thành Tích Gần Đây</h3>
                    <a asp-controller="Profile" asp-action="Index" class="text-primary font-bold text-sm hover:underline underline-offset-8">Xem Bộ Sưu Tập</a>
                </div>
                <div class="flex gap-6 overflow-x-auto pb-6 custom-scrollbar px-1">
                    @foreach (var achievement in Model.Achievements)
                    {
                        if (achievement.Earned)
                        {
                            var achBg = achievement.ColorClass == "tertiary" ? "bg-tertiary/10 text-tertiary" : achievement.ColorClass == "secondary" ? "bg-secondary/10 text-secondary" : "bg-blue-50 text-primary";
                            <div class="flex-shrink-0 w-36 h-48 rounded-[2rem] collectible-border flex flex-col items-center justify-center p-6 cursor-pointer">
                                <div class="w-16 h-16 rounded-full @achBg flex items-center justify-center mb-4 shadow-sm">
                                    <span class="material-symbols-outlined text-3xl">@achievement.Icon</span>
                                </div>
                                <p class="font-bold text-xs text-center text-slate-700 leading-tight">@achievement.Title</p>
                                <p class="text-[9px] text-slate-400 mt-2 font-bold uppercase tracking-widest">@achievement.Tier</p>
                            </div>
                        }
                        else
                        {
                            <div class="flex-shrink-0 w-36 h-48 rounded-[2rem] bg-slate-50/50 border border-dashed border-slate-200 flex flex-col items-center justify-center p-6 opacity-60">
                                <div class="w-16 h-16 rounded-full bg-white flex items-center justify-center mb-4 border border-slate-100 shadow-sm">
                                    <span class="material-symbols-outlined text-3xl text-slate-300">lock</span>
                                </div>
                                <p class="font-bold text-xs text-center text-slate-400 leading-tight">@achievement.Title</p>
                                <p class="text-[9px] text-slate-300 mt-2 font-bold uppercase tracking-widest">Khóa</p>
                            </div>
                        }
                    }
                </div>
            </section>

            <!-- Recent Activity -->
            <section class="xl:col-span-12">
                <h3 class="text-xl font-bold text-on-background font-display mb-6">Hoạt Động Gần Đây</h3>
                <div class="bg-white/60 backdrop-blur-sm rounded-[32px] p-8 border border-white space-y-5 shadow-sm">
                    @foreach (var item in Model.RecentActivity)
                    {
                        var barColor = item.ColorClass == "secondary" ? "bg-secondary" : item.ColorClass == "tertiary" ? "bg-tertiary" : item.ColorClass == "outline" ? "bg-slate-400" : "bg-primary";
                        <div class="flex items-start gap-5 group">
                            <div class="w-1.5 h-12 @barColor rounded-full group-hover:scale-y-110 transition-transform origin-top flex-shrink-0"></div>
                            <div class="flex-1 min-w-0">
                                <p class="font-bold text-sm text-slate-700 mb-1 truncate">@item.Title</p>
                                <p class="text-[11px] text-slate-400 font-bold">@item.Detail</p>
                            </div>
                        </div>
                    }
                    @if (!Model.RecentActivity.Any())
                    {
                        <div class="text-center py-8 text-slate-400">
                            <span class="material-symbols-outlined text-4xl mb-2 block">history</span>
                            <p class="text-sm">Chưa có hoạt động nào. Hãy bắt đầu học!</p>
                        </div>
                    }
                </div>
            </section>
        </div>
    </main>

    <!-- Mobile Navigation Bottom Bar -->
    <nav class="lg:hidden fixed bottom-6 left-6 right-6 bg-white/80 backdrop-blur-xl border border-white shadow-2xl rounded-[2rem] p-3 flex justify-around items-center z-50">
        <a asp-controller="Home" asp-action="Index" class="flex flex-col items-center p-3 text-primary transition-transform active:scale-90">
            <span class="material-symbols-outlined fill-1">science</span>
            <span class="text-[9px] font-bold uppercase tracking-wider mt-1">Lab</span>
        </a>
        <a asp-controller="Courses" asp-action="Library" class="flex flex-col items-center p-3 text-slate-400 transition-transform active:scale-90">
            <span class="material-symbols-outlined">apps</span>
            <span class="text-[9px] font-bold uppercase tracking-wider mt-1">Khóa học</span>
        </a>
        <a asp-controller="Courses" asp-action="Library" class="flex flex-col items-center p-4 bg-primary text-white rounded-2xl -mt-16 shadow-xl shadow-primary/40 border-4 border-white transition-transform active:scale-95">
            <span class="material-symbols-outlined text-2xl">add</span>
        </a>
        <a asp-controller="Profile" asp-action="Index" class="flex flex-col items-center p-3 text-slate-400 transition-transform active:scale-90">
            <span class="material-symbols-outlined">stars</span>
            <span class="text-[9px] font-bold uppercase tracking-wider mt-1">Tiến độ</span>
        </a>
        <form asp-controller="Account" asp-action="Logout" method="post" class="flex flex-col items-center">
            @Html.AntiForgeryToken()
            <button type="submit" class="flex flex-col items-center p-3 text-slate-400 transition-transform active:scale-90">
                <span class="material-symbols-outlined">logout</span>
                <span class="text-[9px] font-bold uppercase tracking-wider mt-1">Thoát</span>
            </button>
        </form>
    </nav>

    <!-- Footer -->
    <footer class="lg:ml-72 bg-white/50 backdrop-blur-md border-t border-slate-100 py-12 px-margin-mobile md:px-margin-desktop">
        <div class="max-w-container-max mx-auto flex flex-col md:flex-row justify-between items-center gap-8">
            <div class="text-2xl font-bold text-primary font-display">ChemLab</div>
            <div class="flex flex-wrap justify-center gap-8">
                <a class="text-slate-500 hover:text-primary transition-all font-bold text-xs uppercase tracking-widest" href="#">Hướng Dẫn An Toàn</a>
                <a asp-controller="Courses" asp-action="Library" class="text-slate-500 hover:text-primary transition-all font-bold text-xs uppercase tracking-widest">Chương Trình</a>
                <a asp-controller="Profile" asp-action="Index" class="text-slate-500 hover:text-primary transition-all font-bold text-xs uppercase tracking-widest">Hồ Sơ</a>
            </div>
            <div class="text-slate-400 font-bold text-[10px] uppercase tracking-widest">© 2024 ChemLab Academy</div>
        </div>
    </footer>

    <script>
        function openMobileSidebar() {
            document.getElementById('mobile-sidebar').classList.add('open');
            document.getElementById('mobile-sidebar-overlay').classList.add('active');
        }
        function closeMobileSidebar() {
            document.getElementById('mobile-sidebar').classList.remove('open');
            document.getElementById('mobile-sidebar-overlay').classList.remove('active');
        }
    </script>
</body>
</html>