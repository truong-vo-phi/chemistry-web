@{
    Layout = null;
}
<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>ChemLab 3D - Magical Alchemical Academy</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;600;700&amp;family=Quicksand:wght@500;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "surface-variant": "#e4e3db",
                        surface: "#fbf9f1",
                        tertiary: "#825100",
                        "surface-container-high": "#eae8e0",
                        "on-background": "#1b1c17",
                        "inverse-on-surface": "#f3f1e9",
                        "surface-tint": "#005ac2",
                        "surface-container-lowest": "#ffffff",
                        "on-surface": "#1b1c17",
                        "on-error": "#ffffff",
                        "tertiary-container": "#a36700",
                        "on-primary": "#ffffff",
                        "surface-container": "#f0eee6",
                        "secondary-container": "#6cf8bb",
                        "on-secondary-container": "#00714d",
                        secondary: "#006c49",
                        "inverse-surface": "#30312c",
                        "primary-fixed-dim": "#adc6ff",
                        "on-primary-container": "#fefcff",
                        "surface-dim": "#dcdad2",
                        "on-secondary-fixed": "#002113",
                        "on-error-container": "#93000a",
                        "secondary-fixed": "#6ffbbe",
                        "on-primary-fixed-variant": "#004395",
                        "primary-fixed": "#d8e2ff",
                        "surface-bright": "#fbf9f1",
                        primary: "#0058be",
                        "on-surface-variant": "#424754",
                        "on-tertiary-fixed-variant": "#653e00",
                        "on-primary-fixed": "#001a42",
                        "inverse-primary": "#adc6ff",
                        "on-secondary-fixed-variant": "#005236",
                        "surface-container-low": "#f5f4ec",
                        "error-container": "#ffdad6",
                        "primary-container": "#2170e4",
                        background: "#fbf9f1",
                        "secondary-fixed-dim": "#4edea3",
                        outline: "#727785",
                        "on-tertiary-fixed": "#2a1700",
                        "tertiary-fixed-dim": "#ffb95f",
                        "on-tertiary-container": "#fffbff",
                        "on-secondary": "#ffffff",
                        "outline-variant": "#c2c6d6",
                        "tertiary-fixed": "#ffddb8",
                        "surface-container-highest": "#e4e3db",
                        "on-tertiary": "#ffffff",
                        error: "#ba1a1a"
                    },
                    borderRadius: {
                        DEFAULT: "1rem",
                        lg: "2rem",
                        xl: "3rem",
                        full: "9999px"
                    },
                    fontFamily: {
                        "label-sm": ["Lexend"],
                        "display-lg": ["Lexend"],
                        "headline-md": ["Lexend"],
                        "body-md": ["Quicksand"],
                        "display-lg-mobile": ["Lexend"],
                        "body-lg": ["Quicksand"]
                    }
                }
            }
        }
    </script>
    <style>
        .magical-float {
            animation: float 6s ease-in-out infinite;
        }
        @@keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }
        .squishy-btn {
            transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 6px 0 0 rgba(0, 0, 0, 0.1);
        }
        .squishy-btn:active {
            transform: translateY(4px);
            box-shadow: 0 2px 0 0 rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body class="bg-surface text-on-surface font-body-md overflow-x-hidden">
    <header class="fixed top-0 left-0 w-full h-20 bg-surface/80 backdrop-blur-md z-50 border-b-2 border-primary/10 flex justify-between items-center px-8 shadow-sm">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center text-white">
                <span class="material-symbols-outlined">science</span>
            </div>
            <h1 class="font-headline-md text-2xl font-bold text-primary">ChemLab 3D</h1>
        </div>
        <nav class="hidden md:flex items-center gap-8">
            <a class="font-label-sm text-on-surface-variant hover:text-primary transition-colors" asp-controller="Courses" asp-action="Library">Library</a>
            @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Teacher")))
            {
                <a class="font-label-sm text-on-surface-variant hover:text-primary transition-colors" asp-controller="TeacherCourses" asp-action="Index">Dashboard</a>
            }
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="flex items-center gap-3">
                    <img alt="User profile avatar" class="w-10 h-10 rounded-full border-2 border-primary object-cover" src="@User.FindFirst("AvatarUrl")?.Value" />
                    <div class="text-left hidden lg:block">
                        <p class="text-xs font-bold text-on-surface leading-tight">@User.Identity.Name</p>
                        <p class="text-[9px] uppercase font-bold text-primary tracking-wider leading-none">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</p>
                    </div>
                    <a class="text-xs font-bold text-error hover:bg-error-container/20 px-3 py-1.5 rounded-full border border-error/20 transition-all ml-2" asp-controller="Account" asp-action="Logout">Đăng xuất</a>
                </div>
            }
            else
            {
                <a class="bg-primary text-on-primary px-6 py-2 rounded-full font-bold squishy-btn" asp-controller="Account" asp-action="Login">Đăng nhập</a>
            }
        </nav>
    </header>

    <main class="pt-40 pb-20 px-8 flex flex-col items-center text-center max-w-5xl mx-auto">
        <div class="magical-float mb-12">
            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBuzYyPxBIHzRjakSddvr7Be3JXTj0TYC5S788E-VUztNu3Nt-hmAarj4bpimXojbWkrNtU6aITXLcp8Y9JpAYftz9Kmyq4d6kU3pp6NUC3jBrreJykkinIpFuNi1s3hsMBWKx-TZuyXviHS2oI5lRNWBT0k4NYvWCEPof-41uWCG-9MUhyu4f513AaxsrBuBJeYeFNP-jNXbUH5xwrWJLHo7yYd2wKUqU-movkTsueZ_cIVAgQMnDkDEv2P5iqNFL3kyGP7X0VCSg" class="w-64 md:w-80 rounded-3xl shadow-2xl border-4 border-white/50" />
        </div>
        
        <h2 class="font-display-lg text-5xl md:text-7xl text-primary mb-6 tracking-tight">Master the Elements in 3D</h2>
        <p class="font-body-lg text-xl text-on-surface-variant mb-12 max-w-2xl leading-relaxed">
            Welcome to the Magical Alchemical Academy. Discover the secrets of chemistry through interactive 3D simulations and expert-led theory courses.
        </p>

        <div class="flex flex-col sm:flex-row gap-6">
            <a class="bg-primary text-on-primary px-10 py-5 rounded-full font-bold text-xl squishy-btn flex items-center gap-3 shadow-lg shadow-primary/30" asp-controller="Courses" asp-action="Library">
                <span class="material-symbols-outlined">rocket_launch</span>
                Explore Courses
            </a>
            <a class="bg-white text-primary border-2 border-primary px-10 py-5 rounded-full font-bold text-xl squishy-btn flex items-center gap-3 shadow-lg" asp-controller="TeacherCourses" asp-action="Index">
                <span class="material-symbols-outlined">school</span>
                Teacher Portal
            </a>
        </div>

        <section class="mt-32 grid grid-cols-1 md:grid-cols-3 gap-12 w-full">
            <div class="flex flex-col items-center">
                <div class="w-16 h-16 bg-secondary-container text-on-secondary-container rounded-2xl flex items-center justify-center mb-6 shadow-md border-2 border-secondary">
                    <span class="material-symbols-outlined text-3xl">view_in_ar</span>
                </div>
                <h3 class="font-headline-md text-2xl mb-3">Interactive 3D</h3>
                <p class="text-on-surface-variant">Experience molecules like never before with our cutting-edge 3D lab environment.</p>
            </div>
            <div class="flex flex-col items-center">
                <div class="w-16 h-16 bg-tertiary-container text-on-tertiary-container rounded-2xl flex items-center justify-center mb-6 shadow-md border-2 border-tertiary">
                    <span class="material-symbols-outlined text-3xl">auto_stories</span>
                </div>
                <h3 class="font-headline-md text-2xl mb-3">Expert Theory</h3>
                <p class="text-on-surface-variant">Comprehensive alchemical lessons designed by the world's leading chemical sorcerers.</p>
            </div>
            <div class="flex flex-col items-center">
                <div class="w-16 h-16 bg-primary-container text-on-primary-container rounded-2xl flex items-center justify-center mb-6 shadow-md border-2 border-primary">
                    <span class="material-symbols-outlined text-3xl">military_tech</span>
                </div>
                <h3 class="font-headline-md text-2xl mb-3">Earn Badges</h3>
                <p class="text-on-surface-variant">Track your progress and earn unique alchemist crests for your achievements.</p>
            </div>
        </section>
    </main>

    <footer class="mt-20 py-12 border-t-2 border-outline-variant/30 text-center bg-surface-container-low">
        <p class="font-label-sm text-on-surface-variant opacity-60">© 2024 ChemLab 3D Magical Academy. All alchemical secrets preserved.</p>
    </footer>
</body>
</html>
