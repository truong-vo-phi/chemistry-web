@model ChemistryV1.ViewModels.AchievementDashboardViewModel
@{
    Layout = null;
    var estimatedHours = Math.Round(Model.EstimatedStudyMinutes / 60.0, 1);
    var patternMax = Math.Max(1, Model.LearningPattern.Any() ? Model.LearningPattern.Max(point => point.ActivityCount) : 1);

    string ToneText(string tone) => tone switch
    {
        "secondary" => "text-secondary",
        "tertiary" => "text-tertiary",
        "outline" => "text-on-surface-variant",
        _ => "text-primary"
    };

    string ToneBg(string tone) => tone switch
    {
        "secondary" => "bg-secondary/10",
        "tertiary" => "bg-tertiary/10",
        "outline" => "bg-surface-container-low",
        _ => "bg-primary/10"
    };

    string ToneProgress(string tone) => tone switch
    {
        "secondary" => "bg-secondary",
        "tertiary" => "bg-tertiary",
        "outline" => "bg-on-surface-variant",
        _ => "bg-primary"
    };
}
<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Achievements | ChemLab</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel="stylesheet" href="~/css/academy.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&amp;family=Quicksand:wght@500;600;700&amp;family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        error: "#ba1a1a",
                        "surface-variant": "#e4e3db",
                        background: "#fbf9f1",
                        surface: "#fbf9f1",
                        "on-tertiary-container": "#fffbff",
                        "on-tertiary": "#ffffff",
                        "on-secondary-container": "#00714d",
                        "on-surface": "#1b1c17",
                        "surface-container-lowest": "#ffffff",
                        "surface-bright": "#fbf9f1",
                        secondary: "#006c49",
                        "surface-tint": "#005ac2",
                        "on-tertiary-fixed-variant": "#653e00",
                        "on-secondary-fixed-variant": "#005236",
                        outline: "#727785",
                        "primary-fixed-dim": "#adc6ff",
                        "surface-container-highest": "#e4e3db",
                        "surface-container-high": "#eae8e0",
                        "error-container": "#ffdad6",
                        "on-secondary-fixed": "#002113",
                        "on-secondary": "#ffffff",
                        "primary-fixed": "#d8e2ff",
                        "outline-variant": "#c2c6d6",
                        "on-primary-fixed": "#001a42",
                        "on-primary-container": "#fefcff",
                        "on-primary": "#ffffff",
                        "inverse-primary": "#adc6ff",
                        "on-error-container": "#93000a",
                        "on-background": "#1b1c17",
                        "surface-container-low": "#f5f4ec",
                        "inverse-surface": "#30312c",
                        "surface-container": "#f0eee6",
                        "secondary-fixed-dim": "#4edea3",
                        "on-primary-fixed-variant": "#004395",
                        "on-error": "#ffffff",
                        "surface-dim": "#dcdad2",
                        primary: "#0058be",
                        "secondary-fixed": "#6ffbbe",
                        "tertiary-container": "#a36700",
                        "on-tertiary-fixed": "#2a1700",
                        "on-surface-variant": "#424754",
                        "inverse-on-surface": "#f3f1e9",
                        "primary-container": "#2170e4",
                        "tertiary-fixed-dim": "#ffb95f",
                        "tertiary-fixed": "#ffddb8",
                        "secondary-container": "#6cf8bb",
                        tertiary: "#825100"
                    },
                    borderRadius: {
                        DEFAULT: "1rem",
                        lg: "2rem",
                        xl: "3rem",
                        full: "9999px"
                    },
                    spacing: {
                        gutter: "24px",
                        "margin-mobile": "16px",
                        unit: "8px",
                        "container-max": "1200px",
                        "margin-desktop": "48px"
                    },
                    fontFamily: {
                        "label-sm": ["Lexend"],
                        "display-lg-mobile": ["Lexend"],
                        "body-md": ["Quicksand"],
                        "body-lg": ["Quicksand"],
                        "display-lg": ["Lexend"],
                        "headline-md": ["Lexend"]
                    },
                    fontSize: {
                        "label-sm": ["14px", { lineHeight: "1.2", fontWeight: "600" }],
                        "display-lg-mobile": ["32px", { lineHeight: "1.2", fontWeight: "700" }],
                        "body-md": ["16px", { lineHeight: "1.6", fontWeight: "500" }],
                        "body-lg": ["18px", { lineHeight: "1.6", fontWeight: "500" }],
                        "display-lg": ["48px", { lineHeight: "1.2", letterSpacing: "-0.02em", fontWeight: "700" }],
                        "headline-md": ["24px", { lineHeight: "1.4", fontWeight: "600" }]
                    }
                }
            }
        };
    </script>
    <style>
        .mission-progress {
            stroke-dashoffset: 0;
        }
        .progress-card {
            border: 2px solid rgba(194, 198, 214, 0.45);
            background: #fff;
            box-shadow: 0 8px 24px rgba(0, 88, 190, 0.06);
        }
    </style>
</head>
<body class="academy-shell bg-background text-on-surface">
    <div class="flex min-h-screen">
        <partial name="_AcademySidebar" />
        <main class="flex-1 flex flex-col min-w-0 md:ml-64 overflow-x-hidden">
            <header class="academy-topbar w-full top-0 sticky z-30 border-b-2 border-surface-variant shadow-sm">
                <div class="flex justify-between items-center px-gutter py-4 w-full max-w-container-max mx-auto">
                    <div class="flex items-center gap-4">
                        <span class="font-display-lg text-display-lg-mobile text-primary">ChemLab</span>
                        <span class="hidden md:inline text-label-sm text-on-surface-variant font-label-sm">Learning Analytics Dashboard</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <img alt="@Model.UserName" class="w-10 h-10 rounded-full object-cover border-2 border-primary" src="@Model.AvatarUrl" />
                        <div class="hidden md:block">
                            <p class="text-xs font-bold leading-tight text-on-surface">@Model.UserName</p>
                            <p class="text-[9px] uppercase font-bold text-primary tracking-wider leading-none">@Model.Role</p>
                        </div>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="Account" asp-action="Logout" method="post" class="ml-1">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="text-xs font-bold text-error hover:bg-error-container/20 px-3 py-1.5 rounded-full border border-error/20 transition-all">
                                    Đăng xuất
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </header>

            <div class="p-gutter max-w-container-max mx-auto w-full min-w-0">
                <section class="academy-panel p-6 md:p-8 mb-gutter">
                    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">
                        <div>
                            <p class="text-xs uppercase tracking-[0.18em] font-bold text-primary">Achievement Analytics</p>
                            <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg mt-2 text-primary">Learning Analytics Dashboard</h1>
                            <p class="text-body-md font-body-md text-on-surface-variant mt-3 max-w-3xl">
                                Dashboard phân tích tiến độ học tập cá nhân theo dữ liệu thật: mission, kỹ năng, thời gian học và learning pattern hàng tuần.
                            </p>
                        </div>
                        <div class="grid grid-cols-2 gap-3 min-w-[240px]">
                            <div class="rounded-2xl bg-primary/10 border-2 border-primary/20 px-4 py-3">
                                <p class="text-xs text-on-surface-variant font-bold uppercase">Total XP</p>
                                <p class="text-2xl font-bold text-primary">@Model.TotalXp.ToString("N0")</p>
                            </div>
                            <div class="rounded-2xl bg-secondary/10 border-2 border-secondary/20 px-4 py-3">
                                <p class="text-xs text-on-surface-variant font-bold uppercase">Streak</p>
                                <p class="text-2xl font-bold text-secondary">@Model.DayStreak ngày</p>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="grid grid-cols-1 xl:grid-cols-12 gap-gutter">
                    <div class="xl:col-span-8 flex flex-col gap-gutter">
                        <section class="academy-card p-6 md:p-7">
                            <div class="flex items-center justify-between mb-6">
                                <h2 class="font-headline-md text-headline-md flex items-center gap-2 text-on-surface">
                                    <span class="material-symbols-outlined text-primary">task_alt</span>
                                    Tỷ lệ hoàn thành mission
                                </h2>
                                <span class="text-xs font-bold uppercase px-3 py-1 rounded-full bg-surface-container-low text-on-surface-variant border border-outline-variant/40">
                                    @Model.CompletedMissions/@Model.TotalMissions completed
                                </span>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-5 items-center">
                                <div class="md:col-span-1 flex justify-center">
                                    <div class="relative w-32 h-32">
                                        <svg viewBox="0 0 100 100" class="w-full h-full -rotate-90">
                                            <circle cx="50" cy="50" r="40" fill="none" stroke="#e4e3db" stroke-width="12"></circle>
                                            @{
                                                var dashVal = (int)(2.51327 * Model.MissionCompletionRate);
                                                var gapVal = 251 - dashVal;
                                            }
                                            <circle class="mission-progress" cx="50" cy="50" r="40" fill="none" stroke="#0058be" stroke-width="12" stroke-linecap="round" stroke-dasharray="@dashVal @gapVal"></circle>
                                        </svg>
                                        <div class="absolute inset-0 flex flex-col items-center justify-center">
                                            <span class="text-3xl font-bold text-primary font-display-lg">@Model.MissionCompletionRate%</span>
                                            <span class="text-[10px] uppercase tracking-wider text-on-surface-variant font-bold">Mission Rate</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="md:col-span-2 grid grid-cols-3 gap-3">
                                    <div class="progress-card rounded-2xl p-4 text-center">
                                        <p class="text-xs text-on-surface-variant font-bold uppercase">Lessons</p>
                                        <p class="text-2xl font-bold">@Model.TotalCompletedLessons</p>
                                    </div>
                                    <div class="progress-card rounded-2xl p-4 text-center">
                                        <p class="text-xs text-on-surface-variant font-bold uppercase">Quizzes</p>
                                        <p class="text-2xl font-bold">@Model.TotalQuizResults</p>
                                    </div>
                                    <div class="progress-card rounded-2xl p-4 text-center">
                                        <p class="text-xs text-on-surface-variant font-bold uppercase">Active 7d</p>
                                        <p class="text-2xl font-bold">@Model.ActiveDaysLast7</p>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="grid grid-cols-1 lg:grid-cols-2 gap-gutter">
                            <div class="academy-card p-6">
                                <h3 class="font-headline-md text-headline-md mb-4 flex items-center gap-2 text-on-surface">
                                    <span class="material-symbols-outlined text-secondary">workspace_premium</span>
                                    Điểm mạnh
                                </h3>
                                <div class="space-y-4">
                                    @foreach (var item in Model.Strengths)
                                    {
                                        <div class="rounded-2xl bg-white border-2 border-outline-variant/40 p-4">
                                            <div class="flex items-center justify-between mb-2">
                                                <p class="font-bold text-on-surface">@item.Title</p>
                                                <span class="text-sm font-bold @ToneText(item.Tone)">@item.ScorePercent%</span>
                                            </div>
                                            <p class="text-sm text-on-surface-variant mb-3">@item.Detail</p>
                                            <div class="h-2 bg-surface-container-low rounded-full overflow-hidden">
                                                <div class="h-full @ToneProgress(item.Tone) rounded-full" style="width:@item.ScorePercent%;"></div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="academy-card p-6">
                                <h3 class="font-headline-md text-headline-md mb-4 flex items-center gap-2 text-on-surface">
                                    <span class="material-symbols-outlined text-tertiary">warning</span>
                                    Điểm cần cải thiện
                                </h3>
                                <div class="space-y-4">
                                    @foreach (var item in Model.Weaknesses)
                                    {
                                        <div class="rounded-2xl bg-white border-2 border-outline-variant/40 p-4">
                                            <div class="flex items-center justify-between mb-2">
                                                <p class="font-bold text-on-surface">@item.Title</p>
                                                <span class="text-sm font-bold @ToneText(item.Tone)">@item.ScorePercent%</span>
                                            </div>
                                            <p class="text-sm text-on-surface-variant mb-3">@item.Detail</p>
                                            <div class="h-2 bg-surface-container-low rounded-full overflow-hidden">
                                                <div class="h-full @ToneProgress(item.Tone) rounded-full" style="width:@item.ScorePercent%;"></div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </section>

                        <section class="academy-card p-6">
                            <h2 class="font-headline-md text-headline-md mb-4 flex items-center gap-2 text-on-surface">
                                <span class="material-symbols-outlined text-primary">monitoring</span>
                                Learning pattern
                            </h2>
                            <p class="text-sm text-on-surface-variant mb-5">Tần suất hoạt động học tập trong 7 ngày gần nhất.</p>
                            <div class="h-44 flex items-end gap-3 border-b-2 border-outline-variant/35 pb-3">
                                @foreach (var point in Model.LearningPattern)
                                {
                                    var barHeight = point.ActivityCount <= 0 ? 10 : Math.Max(12, (int)Math.Round(point.ActivityCount * 100.0 / patternMax));
                                    <div class="flex-1 min-w-0 flex flex-col items-center gap-2">
                                        <div class="w-full bg-primary/20 hover:bg-primary/40 rounded-t-xl transition-colors relative group" style="height:@barHeight%;">
                                            <span class="absolute -top-7 left-1/2 -translate-x-1/2 text-[10px] font-bold px-2 py-0.5 rounded bg-on-surface text-white opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">@point.ActivityCount activities</span>
                                        </div>
                                        <span class="text-[11px] font-bold text-on-surface-variant uppercase">@point.DayLabel</span>
                                    </div>
                                }
                            </div>
                        </section>
                    </div>

                    <div class="xl:col-span-4 flex flex-col gap-gutter">
                        <section class="academy-card p-6">
                            <h2 class="font-headline-md text-headline-md mb-4 flex items-center gap-2 text-on-surface">
                                <span class="material-symbols-outlined text-primary">timer</span>
                                Thời gian học tập
                            </h2>
                            <div class="space-y-4">
                                <div class="rounded-2xl bg-white border-2 border-outline-variant/40 p-4 flex items-center justify-between">
                                    <div>
                                        <p class="text-xs uppercase font-bold text-on-surface-variant">Estimated Hours</p>
                                        <p class="text-2xl font-bold text-primary">@estimatedHours giờ</p>
                                    </div>
                                    <span class="material-symbols-outlined text-primary text-3xl">schedule</span>
                                </div>
                                <div class="rounded-2xl bg-white border-2 border-outline-variant/40 p-4 flex items-center justify-between">
                                    <div>
                                        <p class="text-xs uppercase font-bold text-on-surface-variant">Avg / Active day</p>
                                        <p class="text-2xl font-bold text-secondary">@Model.AverageStudyMinutesPerDay phút</p>
                                    </div>
                                    <span class="material-symbols-outlined text-secondary text-3xl">pace</span>
                                </div>
                            </div>
                        </section>

                        <section class="academy-card p-6">
                            <h2 class="font-headline-md text-headline-md mb-4 flex items-center gap-2 text-on-surface">
                                <span class="material-symbols-outlined text-secondary">neurology</span>
                                Kỹ năng học sinh
                            </h2>
                            <div class="space-y-4">
                                @foreach (var skill in Model.Skills)
                                {
                                    <div class="rounded-2xl bg-white border-2 border-outline-variant/40 p-4">
                                        <div class="flex items-center justify-between mb-2">
                                            <div class="flex items-center gap-2">
                                                <span class="material-symbols-outlined @ToneText(skill.Tone)">@skill.Icon</span>
                                                <p class="font-bold text-sm text-on-surface">@skill.Name</p>
                                            </div>
                                            <span class="text-[11px] uppercase font-bold @ToneText(skill.Tone)">@skill.LevelText</span>
                                        </div>
                                        <div class="h-2 bg-surface-container-low rounded-full overflow-hidden">
                                            <div class="h-full rounded-full @ToneProgress(skill.Tone)" style="width:@skill.ProgressPercent%;"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </section>

                        <section class="academy-card p-6">
                            <h2 class="font-headline-md text-headline-md mb-4 flex items-center gap-2 text-on-surface">
                                <span class="material-symbols-outlined text-tertiary">auto_awesome</span>
                                AI phân tích tiến độ
                            </h2>
                            <div class="rounded-2xl @ToneBg("tertiary") p-4 border-2 border-tertiary/25">
                                <p class="text-sm leading-relaxed text-on-surface">@Model.AiAnalysis</p>
                            </div>
                            <div class="mt-4 rounded-2xl bg-white border-2 border-outline-variant/40 p-4">
                                <p class="text-xs uppercase font-bold text-on-surface-variant mb-1">Đề xuất tiếp theo</p>
                                <p class="text-sm font-semibold text-on-surface">@Model.NextRecommendation</p>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
