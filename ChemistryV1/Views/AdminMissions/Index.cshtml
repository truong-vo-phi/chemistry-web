@model ChemistryV1.ViewModels.AdminMissionsViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mission Management | ChemLab</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&family=Quicksand:wght@400;500;600;700&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <style>
        body { font-family: "Quicksand", sans-serif; background: linear-gradient(180deg, #fbf9f1 0%, #f3f1e8 100%); }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; vertical-align: middle; }
        .glass { background: rgba(255,255,255,0.78); backdrop-filter: blur(18px); }
    </style>
</head>
<body class="min-h-screen text-slate-800">
    <div class="max-w-7xl mx-auto px-4 md:px-8 py-8 md:py-10">
        <div class="flex flex-col gap-6 mb-8">
            <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
                <div>
                    <p class="text-xs uppercase tracking-[0.3em] text-slate-500 font-bold">Admin System</p>
                    <h1 class="text-3xl md:text-4xl font-bold text-slate-900" style="font-family:Lexend,sans-serif;">Mission Management</h1>
                    <p class="text-slate-600 mt-2 max-w-2xl">Tạo và điều chỉnh Daily Mission cho homepage và profile. Mỗi mission sẽ tự tính tiến độ theo dữ liệu thật.</p>
                </div>
                <div class="flex gap-3">
                    <a asp-controller="Dashboard" asp-action="Index" class="px-4 py-3 rounded-2xl bg-white border border-slate-200 font-semibold hover:border-primary hover:text-primary transition-colors">Dashboard</a>
                    <a asp-controller="AdminUsers" asp-action="Index" class="px-4 py-3 rounded-2xl bg-slate-900 text-white font-semibold hover:bg-slate-800 transition-colors">Users</a>
                </div>
            </div>

            @if (TempData["MissionMessage"] != null)
            {
                <div class="glass border border-emerald-200 text-emerald-800 px-4 py-3 rounded-2xl font-semibold shadow-sm">
                    @TempData["MissionMessage"]
                </div>
            }

            <form method="get" class="flex items-center gap-3 glass border border-slate-200 rounded-2xl px-4 py-3 shadow-sm">
                <span class="material-symbols-outlined text-slate-500">search</span>
                <input name="search" value="@Model.Search" class="w-full bg-transparent outline-none text-sm" placeholder="Tìm mission theo title hoặc metric..." />
            </form>
        </div>

        <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
            <div class="xl:col-span-1 glass border border-slate-200 rounded-3xl p-6 shadow-xl h-fit sticky top-6">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-xl font-bold text-slate-900" style="font-family:Lexend,sans-serif;">@(Model.Form.Id.HasValue ? "Edit Mission" : "New Mission")</h2>
                    @if (Model.Form.Id.HasValue)
                    {
                        <a asp-action="Index" class="text-sm font-semibold text-slate-500 hover:text-slate-900">Reset</a>
                    }
                </div>

                <form asp-action="Upsert" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Form.Id" />
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Title</label>
                        <input asp-for="Form.Title" class="w-full rounded-2xl border-slate-300 bg-white px-4 py-3 text-sm" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Reward</label>
                        <input asp-for="Form.RewardText" class="w-full rounded-2xl border-slate-300 bg-white px-4 py-3 text-sm" placeholder="+150 XP" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Metric Key</label>
                        <input asp-for="Form.MetricKey" class="w-full rounded-2xl border-slate-300 bg-white px-4 py-3 text-sm" placeholder="lessons_completed" />
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Target</label>
                            <input asp-for="Form.TargetValue" type="number" min="1" class="w-full rounded-2xl border-slate-300 bg-white px-4 py-3 text-sm" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Order</label>
                            <input asp-for="Form.SortOrder" type="number" class="w-full rounded-2xl border-slate-300 bg-white px-4 py-3 text-sm" />
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Icon</label>
                            <input asp-for="Form.Icon" class="w-full rounded-2xl border-slate-300 bg-white px-4 py-3 text-sm" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Color</label>
                            <input asp-for="Form.ColorClass" class="w-full rounded-2xl border-slate-300 bg-white px-4 py-3 text-sm" placeholder="primary" />
                        </div>
                    </div>
                    <label class="flex items-center gap-3 rounded-2xl bg-white border border-slate-200 px-4 py-3 cursor-pointer">
                        <input asp-for="Form.IsActive" type="checkbox" class="rounded border-slate-300 text-primary focus:ring-primary" />
                        <span class="font-semibold text-sm">Active</span>
                    </label>
                    <button type="submit" class="w-full rounded-2xl bg-slate-900 text-white font-bold py-3 hover:bg-slate-800 transition-colors">Save Mission</button>
                </form>
            </div>

            <div class="xl:col-span-2">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                    <div class="glass border border-slate-200 rounded-3xl p-5 shadow-sm">
                        <p class="text-xs uppercase tracking-wider text-slate-500 font-bold">Total</p>
                        <p class="text-3xl font-bold mt-2 text-slate-900">@Model.Missions.Count</p>
                    </div>
                    <div class="glass border border-slate-200 rounded-3xl p-5 shadow-sm">
                        <p class="text-xs uppercase tracking-wider text-slate-500 font-bold">Active</p>
                        <p class="text-3xl font-bold mt-2 text-slate-900">@Model.Missions.Count(m => m.IsActive)</p>
                    </div>
                    <div class="glass border border-slate-200 rounded-3xl p-5 shadow-sm">
                        <p class="text-xs uppercase tracking-wider text-slate-500 font-bold">Inactive</p>
                        <p class="text-3xl font-bold mt-2 text-slate-900">@Model.Missions.Count(m => !m.IsActive)</p>
                    </div>
                </div>

                <div class="overflow-hidden rounded-3xl border border-slate-200 glass shadow-xl">
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-slate-200">
                            <thead class="bg-white/60">
                                <tr>
                                    <th class="px-5 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-500">Mission</th>
                                    <th class="px-5 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-500">Progress</th>
                                    <th class="px-5 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-500">State</th>
                                    <th class="px-5 py-4 text-right text-xs font-bold uppercase tracking-wider text-slate-500">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-200 bg-white/40">
                                @foreach (var mission in Model.Missions)
                                {
                                    <tr class="hover:bg-white/60 transition-colors">
                                        <td class="px-5 py-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-10 h-10 rounded-2xl bg-primary/10 flex items-center justify-center text-primary">
                                                    <span class="material-symbols-outlined">@mission.Icon</span>
                                                </div>
                                                <div>
                                                    <p class="font-bold text-slate-900">@mission.Title</p>
                                                    <p class="text-xs text-slate-500">@mission.MetricKey • Target @mission.TargetValue • @mission.RewardText</p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-5 py-4 text-sm text-slate-700">Order @mission.SortOrder</td>
                                        <td class="px-5 py-4">
                                            @if (mission.IsActive)
                                            {
                                                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-200">Active</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-50 text-rose-700 text-xs font-bold border border-rose-200">Inactive</span>
                                            }
                                        </td>
                                        <td class="px-5 py-4 text-right">
                                            <div class="flex items-center justify-end gap-2">
                                                <a asp-action="Index" asp-route-editId="@mission.Id" class="px-3 py-2 rounded-full border border-slate-300 bg-white text-sm font-semibold hover:border-slate-900 transition-colors">Edit</a>
                                                <form asp-action="ToggleActive" method="post" class="inline-block">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@mission.Id" />
                                                    <button type="submit" class="px-3 py-2 rounded-full border border-slate-300 bg-white text-sm font-semibold hover:border-slate-900 transition-colors">@(mission.IsActive ? "Disable" : "Enable")</button>
                                                </form>
                                                <form asp-action="Delete" method="post" class="inline-block" onsubmit="return confirm('Delete this mission?')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@mission.Id" />
                                                    <button type="submit" class="px-3 py-2 rounded-full border border-rose-300 bg-white text-sm font-semibold text-rose-700 hover:border-rose-600 transition-colors">Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>