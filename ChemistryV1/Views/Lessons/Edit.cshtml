@model ChemistryV1.ViewModels.LessonEditorViewModel
@{
    Layout = null;
    var chapters = Model.Chapters.OrderBy(c => c.OrderIndex).ToList();
    var activeChapterId = Model.Lesson.ChapterId ?? chapters.FirstOrDefault()?.Id;
}
<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Trình Biên Soạn Sách Phép - ChemLab 3D</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;600;700&amp;family=Quicksand:wght@500;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        background: "#fbf9f1",
                        "inverse-primary": "#adc6ff",
                        secondary: "#006c49",
                        "secondary-container": "#6cf8bb",
                        "surface-dim": "#dcdad2",
                        "on-surface-variant": "#424754",
                        "tertiary-fixed-dim": "#ffb95f",
                        "outline-variant": "#c2c6d6",
                        primary: "#0058be",
                        "on-tertiary-fixed-variant": "#653e00",
                        "surface-tint": "#005ac2",
                        "on-primary": "#ffffff",
                        "on-tertiary-fixed": "#2a1700",
                        outline: "#727785",
                        "surface-variant": "#e4e3db",
                        "on-primary-container": "#fefcff",
                        "surface-container-high": "#eae8e0",
                        "on-secondary-container": "#00714d",
                        "on-background": "#1b1c17",
                        "surface-container-lowest": "#ffffff",
                        "on-tertiary": "#ffffff",
                        "error-container": "#ffdad6",
                        "inverse-on-surface": "#f3f1e9",
                        error: "#ba1a1a",
                        "surface-container": "#f0eee6",
                        "on-primary-fixed": "#001a42",
                        "surface-container-low": "#f5f4ec",
                        "on-tertiary-container": "#fffbff",
                        "on-error-container": "#93000a",
                        "inverse-surface": "#30312c",
                        "on-secondary": "#ffffff",
                        "primary-fixed": "#d8e2ff",
                        "on-surface": "#1b1c17",
                        "on-secondary-fixed": "#002113",
                        "primary-fixed-dim": "#adc6ff",
                        "surface-container-highest": "#e4e3db",
                        "secondary-fixed-dim": "#4edea3",
                        tertiary: "#825100",
                        "surface-bright": "#fbf9f1",
                        "primary-container": "#2170e4",
                        "on-primary-fixed-variant": "#004395",
                        "secondary-fixed": "#6ffbbe",
                        "tertiary-fixed": "#ffddb8",
                        "tertiary-container": "#a36700",
                        "on-secondary-fixed-variant": "#005236",
                        surface: "#fbf9f1",
                        "on-error": "#ffffff"
                    },
                    borderRadius: {
                        DEFAULT: "1rem",
                        lg: "2rem",
                        xl: "3rem",
                        full: "9999px"
                    },
                    spacing: {
                        gutter: "24px",
                        unit: "8px",
                        "margin-desktop": "48px",
                        "container-max": "1200px",
                        "margin-mobile": "16px"
                    },
                    fontFamily: {
                        "body-lg": ["Quicksand"],
                        "headline-md": ["Lexend"],
                        "display-lg-mobile": ["Lexend"],
                        "display-lg": ["Lexend"],
                        "body-md": ["Quicksand"],
                        "label-sm": ["Lexend"]
                    },
                    fontSize: {
                        "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "500" }],
                        "headline-md": ["24px", { "lineHeight": "1.4", "fontWeight": "600" }],
                        "display-lg-mobile": ["32px", { "lineHeight": "1.2", "fontWeight": "700" }],
                        "display-lg": ["48px", { "lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "body-md": ["16px", { "lineHeight": "1.6", "fontWeight": "500" }],
                        "label-sm": ["14px", { "lineHeight": "1.2", "fontWeight": "600" }]
                    }
                },
            },
        }
    </script>
    <style>
        body { background-color: #fbf9f1; overflow: hidden; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #c2c6d6; border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #727785; }
    </style>
</head>
<body class="font-body-md text-on-surface bg-background flex h-screen overflow-hidden">
    <nav class="h-full w-20 md:w-64 flex-shrink-0 bg-surface-container border-r-2 border-primary/10 flex flex-col py-6 z-50">
        <div class="px-6 mb-10 flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-primary-container flex items-center justify-center border-2 border-primary overflow-hidden">
                <img alt="Avatar" class="w-full h-full object-cover" src="https://via.placeholder.com/80" />
            </div>
            <div class="hidden md:block overflow-hidden">
                <h1 class="font-headline-md text-lg font-bold text-primary truncate">ChemLab 3D</h1>
                <span class="text-xs text-on-surface-variant">Pháp Sư Tập Sự</span>
            </div>
        </div>
        <div class="flex-1 flex flex-col gap-2 px-2 overflow-y-auto custom-scrollbar">
            <a class="flex items-center gap-3 text-on-surface-variant hover:bg-surface-variant rounded-full p-3 transition-all" asp-controller="Dashboard" asp-action="Index">
                <span class="material-symbols-outlined">science</span>
                <span class="hidden md:block">Phòng Thí Nghiệm</span>
            </a>
            <a class="flex items-center gap-3 text-on-surface-variant hover:bg-surface-variant rounded-full p-3 transition-all" asp-controller="TeacherCourses" asp-action="Index">
                <span class="material-symbols-outlined">auto_awesome</span>
                <span class="hidden md:block">Nhiệm Vụ</span>
            </a>
            <a class="flex items-center gap-3 text-on-surface-variant hover:bg-surface-variant rounded-full p-3 transition-all" asp-controller="Courses" asp-action="Library">
                <span class="material-symbols-outlined">grid_view</span>
                <span class="hidden md:block">Thư Viện Phép Thuật</span>
            </a>
            <a class="flex items-center gap-3 text-on-surface-variant hover:bg-surface-variant rounded-full p-3 transition-all" asp-controller="Categories" asp-action="Index">
                <span class="material-symbols-outlined">menu_book</span>
                <span class="hidden md:block">Danh Mục</span>
            </a>
        </div>
        <div class="px-4 mt-auto pt-6 border-t border-outline-variant">
            <button class="w-full bg-primary text-on-primary font-label-sm py-3 rounded-full hover:brightness-110 transition-all flex items-center justify-center gap-2 mb-4 shadow-lg shadow-primary/20">
                <span class="material-symbols-outlined text-sm">play_arrow</span>
                <span class="hidden md:block">Bắt Đầu Thí Nghiệm</span>
            </button>
        </div>
    </nav>
    <div class="flex-1 flex flex-col min-w-0">
        <header class="h-16 flex-shrink-0 bg-surface/80 backdrop-blur-md border-b border-outline-variant flex items-center justify-between px-6 z-40">
            <div class="flex items-center gap-4">
                <a class="p-2 hover:bg-surface-variant rounded-full transition-colors" asp-controller="TeacherCourses" asp-action="Content" asp-route-id="@Model.Course.Id">
                    <span class="material-symbols-outlined">arrow_back</span>
                </a>
                <div class="flex flex-col">
                    <h2 class="font-bold text-on-surface">Trình Biên Soạn Sách Phép</h2>
                    <span class="text-xs text-on-surface-variant">Lưu lần cuối 2 phút trước</span>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <button class="px-5 py-2 text-on-surface font-label-sm rounded-full border-2 border-outline-variant hover:bg-surface-variant transition-all">Xem trước</button>
                <button form="lesson-form" class="px-5 py-2 bg-primary text-on-primary font-label-sm rounded-full hover:shadow-lg transition-all" type="submit">Xuất bản</button>
            </div>
        </header>
        <div class="flex-1 flex overflow-hidden">
            <aside class="w-80 flex-shrink-0 bg-surface-container-low border-r border-outline-variant flex flex-col">
                <div class="p-5 border-b border-outline-variant flex justify-between items-center bg-surface-bright">
                    <h3 class="font-bold text-on-surface">Chương trình học</h3>
                    <a class="p-1.5 bg-secondary text-on-secondary rounded-full hover:brightness-110 transition-all shadow-sm" asp-controller="Chapters" asp-action="Create" asp-route-courseId="@Model.Course.Id">
                        <span class="material-symbols-outlined">add</span>
                    </a>
                </div>
                <div class="flex-1 overflow-y-auto p-4 flex flex-col gap-4 custom-scrollbar">
                    @foreach (var chapter in chapters)
                    {
                        <div class="space-y-2">
                            <div class="flex items-center gap-2 group">
                                <span class="material-symbols-outlined text-outline cursor-grab active:cursor-grabbing hover:text-primary">drag_indicator</span>
                                <div class="flex-1 bg-surface-container-highest rounded-xl p-3 flex justify-between items-center border border-transparent hover:border-primary/30 transition-all">
                                    <span class="font-bold text-sm">@chapter.Title</span>
                                    <span class="material-symbols-outlined text-sm text-outline">expand_more</span>
                                </div>
                            </div>
                            <div class="ml-8 space-y-2 border-l-2 border-outline-variant pl-4 py-1">
                                @foreach (var lesson in chapter.Lessons.OrderBy(l => l.OrderIndex))
                                {
                                    var isActive = lesson.Id == Model.Lesson.Id;
                                    <a class="flex items-center gap-2 group @(isActive ? "bg-primary/10 text-primary border border-primary/20" : "hover:bg-surface-variant text-on-surface-variant") rounded-xl p-3 transition-all cursor-pointer" asp-controller="Lessons" asp-action="Edit" asp-route-id="@lesson.Id">
                                        <span class="material-symbols-outlined text-sm">science</span>
                                        <span class="text-sm font-semibold">@lesson.Title</span>
                                    </a>
                                }
                                <a class="flex items-center gap-2 text-xs font-bold text-primary p-2 hover:underline" asp-controller="Lessons" asp-action="Create" asp-route-chapterId="@chapter.Id">
                                    <span class="material-symbols-outlined text-sm">add_circle</span> Thêm bài học
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </aside>
            <main class="flex-1 bg-white overflow-y-auto custom-scrollbar p-10 flex flex-col items-center">
                @{
                    var formAction = Model.Lesson.Id == 0 ? "Create" : "Edit";
                }
                <form id="lesson-form" asp-action="@formAction" asp-route-id="@(Model.Lesson.Id == 0 ? null : Model.Lesson.Id)" method="post" class="w-full max-w-4xl space-y-8">
                    <input type="hidden" asp-for="Lesson.Id" />
                    <input type="hidden" asp-for="Lesson.ChapterId" />
                    <div class="space-y-4">
                        <div class="flex items-center gap-2 text-primary font-bold text-sm tracking-widest uppercase">
                            <span class="material-symbols-outlined text-sm">auto_stories</span>
                            @Model.Course.Title
                        </div>
                        <input asp-for="Lesson.Title" class="font-display-lg text-on-surface outline-none focus:ring-0 w-full text-3xl" placeholder="Lesson title" />
                        <input asp-for="Lesson.ContentType" class="text-on-surface-variant text-body-lg w-full" placeholder="theory / video / quiz" />
                    </div>
                    <div class="space-y-6">
                        <div class="group relative bg-surface-container-lowest rounded-2xl border-2 border-transparent hover:border-primary/20 p-6 transition-all hover:shadow-xl hover:shadow-primary/5">
                            <div class="prose prose-on-surface max-w-none">
                                <textarea asp-for="Lesson.DocumentContent" class="w-full min-h-[200px] outline-none bg-transparent text-body-md" placeholder="Nội dung lý thuyết..."></textarea>
                            </div>
                        </div>
                        <div class="group relative bg-surface-container-low rounded-2xl border-2 border-dashed border-outline-variant p-6 flex flex-col items-center justify-center min-h-[200px] hover:border-primary/50 transition-all">
                            <span class="material-symbols-outlined text-4xl text-outline mb-2">video_library</span>
                            <h4 class="font-bold text-on-surface-variant">Thêm Video Bài Giảng</h4>
                            <input asp-for="Lesson.VideoUrl" class="mt-4 w-full bg-white border border-outline-variant rounded-full text-sm font-bold px-4 py-2" placeholder="https://..." />
                        </div>
                    </div>
                </form>
            </main>
            <aside class="w-80 flex-shrink-0 bg-surface border-l border-outline-variant hidden xl:flex flex-col">
                <div class="p-5 border-b border-outline-variant bg-surface-bright">
                    <h3 class="font-bold text-on-surface">Cài đặt bài học</h3>
                </div>
                <div class="p-6 space-y-8 overflow-y-auto custom-scrollbar">
                    <div class="space-y-4">
                        <label class="text-xs font-bold text-outline uppercase tracking-widest">Preview</label>
                        <select asp-for="Lesson.IsPreview" class="w-full bg-surface-container-low border-outline-variant rounded-xl text-sm focus:ring-primary focus:border-primary" form="lesson-form">
                            <option value="false">Locked</option>
                            <option value="true">Preview</option>
                        </select>
                    </div>
                    <div class="space-y-4">
                        <label class="text-xs font-bold text-outline uppercase tracking-widest">Order</label>
                        <input asp-for="Lesson.OrderIndex" class="w-full bg-surface-container-low border-outline-variant rounded-xl text-sm focus:ring-primary focus:border-primary px-3 py-2" type="number" form="lesson-form" />
                    </div>
                    <div class="space-y-4">
                        <label class="text-xs font-bold text-outline uppercase tracking-widest">Đọc trực tuyến (PDF URL)</label>
                        <input asp-for="Lesson.PdfPath" class="w-full bg-surface-container-low border-outline-variant rounded-xl text-sm focus:ring-primary focus:border-primary px-3 py-2" type="text" form="lesson-form" placeholder="https://..." />
                    </div>
                    <div class="space-y-4">
                        <label class="text-xs font-bold text-outline uppercase tracking-widest">Tài liệu đính kèm (URL)</label>
                        <input asp-for="Lesson.AttachmentPath" class="w-full bg-surface-container-low border-outline-variant rounded-xl text-sm focus:ring-primary focus:border-primary px-3 py-2" type="text" form="lesson-form" placeholder="https://..." />
                    </div>
                    <div class="pt-10 space-y-4">
                        <a class="w-full py-3 text-error bg-error-container/30 border border-error/20 rounded-full font-bold text-sm hover:bg-error-container transition-all flex justify-center" asp-controller="Lessons" asp-action="Delete" asp-route-id="@Model.Lesson.Id">Xóa bài học này</a>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</body>
</html>
