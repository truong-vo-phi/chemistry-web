@model ChemistryV1.ViewModels.LessonEditorViewModel
@{
    Layout = null;
    var chapters = Model.Chapters.OrderBy(c => c.OrderIndex).ToList();
    var activeChapterId = Model.Lesson.ChapterId ?? chapters.FirstOrDefault()?.Id;
}
<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Spellbook Editor - ChemLab 3D</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;600;700&amp;family=Quicksand:wght@500;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "surface-variant": "#e4e3db",
                        surface: "#fbf9f1",
                        tertiary: "#825100",
                        "surface-container-high": "#eae8e0",
                        "on-background": "#1b1c17",
                        "inverse-on-surface": "#f3f1e9",
                        "surface-tint": "#005ac2",
                        "surface-container-lowest": "#ffffff",
                        "on-surface": "#1b1c17",
                        "on-error": "#ffffff",
                        "tertiary-container": "#a36700",
                        "on-primary": "#ffffff",
                        "surface-container": "#f0eee6",
                        "secondary-container": "#6cf8bb",
                        "on-secondary-container": "#00714d",
                        secondary: "#006c49",
                        "inverse-surface": "#30312c",
                        "primary-fixed-dim": "#adc6ff",
                        "on-primary-container": "#fefcff",
                        "surface-dim": "#dcdad2",
                        "on-secondary-fixed": "#002113",
                        "on-error-container": "#93000a",
                        "secondary-fixed": "#6ffbbe",
                        "on-primary-fixed-variant": "#004395",
                        "primary-fixed": "#d8e2ff",
                        "surface-bright": "#fbf9f1",
                        primary: "#0058be",
                        "on-surface-variant": "#424754",
                        "on-tertiary-fixed-variant": "#653e00",
                        "on-primary-fixed": "#001a42",
                        "inverse-primary": "#adc6ff",
                        "on-secondary-fixed-variant": "#005236",
                        "surface-container-low": "#f5f4ec",
                        "error-container": "#ffdad6",
                        "primary-container": "#2170e4",
                        background: "#fbf9f1",
                        "secondary-fixed-dim": "#4edea3",
                        outline: "#727785",
                        "on-tertiary-fixed": "#2a1700",
                        "tertiary-fixed-dim": "#ffb95f",
                        "on-tertiary-container": "#fffbff",
                        "on-secondary": "#ffffff",
                        "outline-variant": "#c2c6d6",
                        "tertiary-fixed": "#ffddb8",
                        "surface-container-highest": "#e4e3db",
                        "on-tertiary": "#ffffff",
                        error: "#ba1a1a"
                    },
                    borderRadius: {
                        DEFAULT: "1rem",
                        lg: "2rem",
                        xl: "3rem",
                        full: "9999px"
                    },
                    spacing: {
                        gutter: "24px",
                        unit: "8px",
                        "margin-desktop": "48px",
                        "container-max": "1200px",
                        "margin-mobile": "16px"
                    },
                    fontFamily: {
                        "body-lg": ["Quicksand"],
                        "headline-md": ["Lexend"],
                        "display-lg-mobile": ["Lexend"],
                        "display-lg": ["Lexend"],
                        "body-md": ["Quicksand"],
                        "label-sm": ["Lexend"]
                    },
                    fontSize: {
                        "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "500" }],
                        "headline-md": ["24px", { "lineHeight": "1.4", "fontWeight": "600" }],
                        "display-lg-mobile": ["32px", { "lineHeight": "1.2", "fontWeight": "700" }],
                        "display-lg": ["48px", { "lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "body-md": ["16px", { "lineHeight": "1.6", "fontWeight": "500" }],
                        "label-sm": ["14px", { "lineHeight": "1.2", "fontWeight": "600" }]
                    }
                },
            },
        }
    </script>
    <style>
        body { background-color: #fbf9f1; }
        .squishy-btn:active {
            transform: translateY(2px);
            box-shadow: none !important;
        }
        .editor-scroll::-webkit-scrollbar {
            width: 8px;
        }
        .editor-scroll::-webkit-scrollbar-track {
            background: transparent;
        }
        .editor-scroll::-webkit-scrollbar-thumb {
            background-color: #dcdad2;
            border-radius: 20px;
        }
    </style>
</head>
<body class="font-body-md text-body-md text-on-surface bg-background flex h-screen overflow-hidden">
    <partial name="_AcademySidebar" />
    <div class="flex-1 md:ml-64 flex flex-col h-full bg-surface min-w-0">
        <header class="h-16 flex-shrink-0 z-40 bg-surface/80 backdrop-blur-md border-b-2 border-outline-variant/30 flex justify-between items-center px-6">
            <div class="flex items-center gap-2 text-sm font-label-sm">
                <a class="text-on-surface-variant hover:text-primary transition-colors flex items-center gap-1" asp-controller="TeacherCourses" asp-action="Index">
                    <span class="material-symbols-outlined text-[18px]">menu_book</span> Library
                </a>
                <span class="material-symbols-outlined text-outline text-[16px]">chevron_right</span>
                <a class="text-on-surface-variant hover:text-primary transition-colors flex items-center gap-1" asp-controller="TeacherCourses" asp-action="Content" asp-route-id="@Model.Course.Id">
                    <span class="material-symbols-outlined text-[18px]">edit_document</span> Spellbook Editor
                </a>
                <span class="material-symbols-outlined text-outline text-[16px]">chevron_right</span>
                <span class="text-primary font-bold flex items-center gap-1">
                    <span class="material-symbols-outlined text-[18px]">edit</span> Edit Lesson
                </span>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-xs text-on-surface-variant flex items-center gap-1 mr-2">
                    <span class="material-symbols-outlined text-[14px]">cloud_done</span> Saved just now
                </span>
                <a class="px-5 py-2 bg-surface text-on-surface font-label-sm rounded-full border-2 border-outline-variant hover:bg-surface-variant transition-colors squishy-btn text-sm shadow-[0_2px_0_0_rgba(114,119,133,0.3)]" asp-controller="Lessons" asp-action="Details" asp-route-id="@Model.Lesson.Id">
                    Preview
                </a>
                <button form="lesson-form" class="px-5 py-2 bg-secondary text-on-secondary font-label-sm rounded-full border-2 border-secondary-fixed hover:brightness-110 transition-all squishy-btn text-sm shadow-[0_4px_0_0_rgba(0,108,73,0.3)] flex items-center gap-2" type="submit">
                    <span class="material-symbols-outlined text-[18px]">save</span> Save
                </button>
            </div>
        </header>
        <main class="flex-1 overflow-hidden flex p-6 gap-6">
            <!-- 1. Curriculum Card (Left Column) -->
            <div class="w-1/3 max-w-[400px] flex flex-col bg-surface-container-lowest rounded-[2rem] border-2 border-outline-variant/30 shadow-sm overflow-hidden relative">
                <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-primary-fixed/30 rounded-full blur-3xl pointer-events-none"></div>
                <div class="p-5 border-b border-surface-variant flex justify-between items-center bg-surface-container-lowest/80 backdrop-blur-sm z-10">
                    <h2 class="font-headline-md text-xl text-on-surface flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">view_timeline</span> Curriculum
                    </h2>
                    <a class="w-8 h-8 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center border-2 border-secondary shadow-[0_2px_0_0_rgba(0,108,73,0.3)] hover:brightness-105 squishy-btn transition-all" title="Add Chapter" asp-controller="Chapters" asp-action="Create" asp-route-courseId="@Model.Course.Id">
                        <span class="material-symbols-outlined text-[18px]">add</span>
                    </a>
                </div>
                <div class="flex-1 overflow-y-auto editor-scroll p-5 z-10">
                    @foreach (var chapter in chapters)
                    {
                        <div class="mb-6 relative">
                            <div class="flex items-center gap-3 mb-3 group">
                                <span class="material-symbols-outlined text-outline opacity-0 group-hover:opacity-100 transition-opacity text-[18px] -ml-2">drag_indicator</span>
                                <div class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold text-sm z-10 border-2 border-surface-container-lowest shadow-sm">
                                    @chapter.OrderIndex
                                </div>
                                <h4 class="font-label-sm text-label-sm flex-1">@chapter.Title</h4>
                                <a class="text-outline hover:text-primary" asp-controller="Chapters" asp-action="Edit" asp-route-id="@chapter.Id" title="Edit Chapter">
                                    <span class="material-symbols-outlined text-[18px]">edit</span>
                                </a>
                                <a class="text-outline hover:text-error ml-1" asp-controller="Chapters" asp-action="Delete" asp-route-id="@chapter.Id" title="Delete Chapter">
                                    <span class="material-symbols-outlined text-[18px]">delete</span>
                                </a>
                            </div>
                            <div class="ml-10 flex flex-col gap-2">
                                @foreach (var lesson in chapter.Lessons.OrderBy(l => l.OrderIndex))
                                {
                                    var isActive = Model.Lesson.Id == lesson.Id;
                                    <a class="flex items-center gap-3 @(isActive ? "bg-primary-fixed/40 border-2 border-primary/20" : "hover:bg-surface-variant/50 border-2 border-transparent") rounded-xl p-2 cursor-pointer transition-colors group relative" asp-controller="Lessons" asp-action="Edit" asp-route-id="@lesson.Id">
                                        <div class="w-8 h-8 rounded-lg bg-surface flex items-center justify-center text-primary shadow-sm border border-primary/10">
                                            <span class="material-symbols-outlined text-[18px]">article</span>
                                        </div>
                                        <div class="flex-1">
                                            <span class="font-label-sm text-sm text-on-surface block">@lesson.Title</span>
                                            <span class="text-xs text-on-surface-variant block">@lesson.ContentType</span>
                                        </div>
                                    </a>
                                }
                                <a class="flex items-center gap-2 text-xs font-label-sm text-primary mt-1 p-2 rounded-lg hover:bg-primary-fixed/50 transition-colors w-fit border border-dashed border-primary/30" asp-controller="Lessons" asp-action="Create" asp-route-chapterId="@chapter.Id">
                                    <span class="material-symbols-outlined text-[16px]">add</span> Add Lesson
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- 2. Editor Card (Middle Column) -->
            <div class="flex-1 flex flex-col bg-surface-container-lowest rounded-[2rem] border-2 border-outline-variant/30 shadow-sm overflow-hidden relative">
                <div class="absolute top-0 right-0 w-64 h-64 bg-secondary-container/10 rounded-full blur-3xl pointer-events-none"></div>
                
                @{
                    var formAction = Model.Lesson.Id == 0 ? "Create" : "Edit";
                }
                
                <form id="lesson-form" asp-action="@formAction" asp-route-id="@(Model.Lesson.Id == 0 ? null : Model.Lesson.Id)" method="post" enctype="multipart/form-data" class="flex flex-col h-full m-0">
                    <input type="hidden" asp-for="Lesson.Id" />
                    <input type="hidden" asp-for="Lesson.ChapterId" />

                    <!-- Editor Header -->
                    <div class="p-6 border-b border-surface-variant relative z-10 bg-surface-container-lowest/90 backdrop-blur-sm">
                        <div class="flex justify-between items-start">
                            <div class="w-full">
                                <span class="inline-block px-3 py-1 bg-primary-fixed text-primary rounded-full text-xs font-bold mb-2 border border-primary/30 uppercase tracking-wider flex items-center gap-1 w-fit">
                                    <span class="material-symbols-outlined text-[14px]">edit_document</span> Lesson Editor
                                </span>
                                <div class="flex flex-col gap-2 w-full mt-1">
                                    <input asp-for="Lesson.Title" class="w-full bg-transparent font-headline-md text-2xl text-on-surface outline-none border-b-2 border-transparent hover:border-outline-variant/30 focus:border-primary/50 transition-colors py-1 font-bold" placeholder="Lesson Title" />
                                    <div class="flex items-center gap-2 mt-1">
                                        <span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Type:</span>
                                        <span id="lessonTypeBadge" class="bg-surface-container-low text-xs text-on-surface-variant border border-outline-variant/30 rounded-lg px-3 py-1.5 w-48 font-medium uppercase">@Model.Lesson.ContentType</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Editor Body -->
                    <div class="flex-1 overflow-y-auto editor-scroll p-6 bg-surface/50 z-10 flex flex-col gap-6">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="All" class="text-error font-bold bg-error-container/20 p-4 rounded-xl border border-error/20 text-sm"></div>
                        }

                        <!-- Document Content (Theory) -->
                        <div class="bg-surface-container-lowest rounded-2xl border-2 border-surface-variant p-6 shadow-sm flex flex-col">
                            <div class="flex items-center gap-2 text-on-surface-variant mb-4">
                                <span class="material-symbols-outlined text-[18px]">format_align_left</span>
                                <span class="text-xs font-bold uppercase tracking-wider">Lesson Content (Theory)</span>
                            </div>
                            <textarea asp-for="Lesson.DocumentContent" class="w-full min-h-[250px] outline-none bg-surface/30 p-4 rounded-xl border border-outline-variant/30 text-body-md focus:border-primary/50 focus:bg-surface-container-lowest transition-colors" placeholder="Write theory content here..."></textarea>
                        </div>

                        <!-- Video URL & File Upload -->
                        <div class="space-y-4">
                            <!-- Loại bài giảng -->
                            <div>
                                <label class="block text-sm font-semibold text-on-surface mb-2">Loại bài giảng</label>
                                <select asp-for="Lesson.ContentType" id="lessonTypeSelect" class="w-full bg-surface-container rounded-xl border border-outline-variant px-4 py-3 text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/50 transition-shadow">
                                    <option value="video">Lý thuyết / Video</option>
                                    <option value="virtual_lab">Thực hành ảo (Virtual Lab)</option>
                                </select>
                            </div>
                            <!-- Video URL -->
                            <div id="videoUrlGroup">
                                <label asp-for="Lesson.VideoUrl" class="block text-sm font-semibold text-on-surface mb-2">URL Video (Youtube/Drive)</label>
                                <input asp-for="Lesson.VideoUrl" class="w-full bg-surface-container rounded-xl border border-outline-variant px-4 py-3 text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/50 transition-shadow" placeholder="https://..." />
                            </div>
                            <!-- Khung chọn Game (Chỉ hiện khi chọn Virtual Lab) -->
                            <div id="virtualLabGroup" style="display: none;">
                                <label asp-for="Lesson.VirtualLabId" class="block text-sm font-semibold text-on-surface mb-2">Chọn Game Thực Hành</label>
                                <select asp-for="Lesson.VirtualLabId" class="w-full bg-surface-container rounded-xl border border-outline-variant px-4 py-3 text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/50 transition-shadow">
                                    <option value="">-- Chọn một bài thực hành từ kho --</option>
                                    @if (Model.AvailableVirtualLabs != null)
                                    {
                                        foreach (var lab in Model.AvailableVirtualLabs)
                                        {
                                            <option value="@lab.Id">@lab.Title</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <!-- 3. Settings Card (Right Column) -->
            <div class="w-80 hidden xl:flex flex-col bg-surface-container-lowest rounded-[2rem] border-2 border-outline-variant/30 shadow-sm overflow-hidden relative">
                <div class="p-5 border-b border-surface-variant bg-surface-container-lowest/80 backdrop-blur-sm z-10">
                    <h2 class="font-headline-md text-xl text-on-surface flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">settings</span> Lesson Settings
                    </h2>
                </div>
                <div class="flex-1 overflow-y-auto editor-scroll p-5 bg-surface/30 z-10 flex flex-col gap-6">
                    <!-- Access Setting -->
                    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 p-4 shadow-xs">
                        <label class="text-xs font-bold text-on-surface-variant uppercase tracking-widest block mb-2">Lesson Access</label>
                        <select asp-for="Lesson.IsPreview" class="w-full bg-surface border border-outline-variant/40 rounded-xl text-sm focus:border-primary focus:ring-0 px-3 py-2.5 outline-none" form="lesson-form">
                            <option value="false">🔒 Locked (Enrolled Only)</option>
                            <option value="true">🔓 Preview (Free Access)</option>
                        </select>
                    </div>

                    <!-- Order Setting -->
                    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 p-4 shadow-xs">
                        <label class="text-xs font-bold text-on-surface-variant uppercase tracking-widest block mb-2">Display Order</label>
                        <input asp-for="Lesson.OrderIndex" class="w-full bg-surface border border-outline-variant/40 rounded-xl text-sm focus:border-primary px-3 py-2 outline-none" type="number" form="lesson-form" />
                    </div>

                    <!-- Discussion Forum Setting -->
                    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 p-4 shadow-xs flex items-center justify-between">
                        <div>
                            <label class="text-xs font-bold text-on-surface-variant uppercase tracking-widest block">Thảo luận bài học</label>
                            <span class="text-[10px] text-outline font-bold block">Cho phép học sinh hỏi đáp</span>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="Lesson_CommentsEnabled" name="Lesson.CommentsEnabled" value="true" @(Model.Lesson.CommentsEnabled != false ? "checked" : "") class="sr-only peer" form="lesson-form">
                            <input type="hidden" name="Lesson.CommentsEnabled" value="false" form="lesson-form" />
                            <div class="w-11 h-6 bg-surface-variant rounded-full peer peer-focus:ring-0 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
                        </label>
                    </div>

                    <!-- PDF Setting -->
                    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 p-4 shadow-xs flex flex-col gap-3">
                        <label class="text-xs font-bold text-on-surface-variant uppercase tracking-widest block">Read Online (PDF URL)</label>
                        <input asp-for="Lesson.PdfPath" class="w-full bg-surface border border-outline-variant/40 rounded-xl text-sm focus:border-primary px-3 py-2 outline-none" type="text" form="lesson-form" placeholder="https://..." />
                        <div class="text-[10px] text-outline font-bold text-center">— OR UPLOAD PDF —</div>
                        <input type="file" name="pdfFile" accept="application/pdf" class="w-full text-xs font-bold text-on-surface-variant" form="lesson-form" />
                    </div>

                    <!-- Attachment Setting -->
                    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 p-4 shadow-xs flex flex-col gap-3">
                        <label class="text-xs font-bold text-on-surface-variant uppercase tracking-widest block">Attached Document (URL)</label>
                        <input asp-for="Lesson.AttachmentPath" class="w-full bg-surface border border-outline-variant/40 rounded-xl text-sm focus:border-primary px-3 py-2 outline-none" type="text" form="lesson-form" placeholder="https://..." />
                        <div class="text-[10px] text-outline font-bold text-center">— OR UPLOAD ATTACHMENT —</div>
                        <input type="file" name="attachmentFile" class="w-full text-xs font-bold text-on-surface-variant" form="lesson-form" />
                    </div>

                    <!-- Delete button -->
                    @if (Model.Lesson.Id != 0)
                    {
                        <div class="pt-4 mt-auto">
                            <a class="w-full py-3 text-error bg-error-container/20 border-2 border-dashed border-error/30 hover:border-error rounded-full font-bold text-xs hover:bg-error-container transition-all flex justify-center items-center gap-1 squishy-btn shadow-xs" asp-controller="Lessons" asp-action="Delete" asp-route-id="@Model.Lesson.Id">
                                <span class="material-symbols-outlined text-[16px]">delete</span> Delete lesson
                            </a>
                        </div>
                    }
                </div>
            </div>
        </main>
    </div>

    <script>
        // JS Ẩn/hiện khung
        document.addEventListener("DOMContentLoaded", function() {
            const typeSelect = document.getElementById('lessonTypeSelect');
            const videoGroup = document.getElementById('videoUrlGroup');
            const labGroup = document.getElementById('virtualLabGroup');
            function toggleFields() {
                const badge = document.getElementById('lessonTypeBadge');
                if (badge) badge.textContent = typeSelect.value;
                if (typeSelect.value === 'virtual_lab') {
                    videoGroup.style.display = 'none'; labGroup.style.display = 'block';
                } else {
                    videoGroup.style.display = 'block'; labGroup.style.display = 'none';
                }
            }

            typeSelect.addEventListener('change', toggleFields);
            toggleFields();
        });
    </script>

</body>
</html>
