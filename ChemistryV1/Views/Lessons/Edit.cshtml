@model ChemistryV1.ViewModels.LessonEditorViewModel
@{
    Layout = null;
    var chapters = Model.Chapters.OrderBy(c => c.OrderIndex).ToList();
    var activeChapterId = Model.Lesson.ChapterId ?? chapters.FirstOrDefault()?.Id;
}
<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Spellbook Editor - ChemLab 3D</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;600;700&amp;family=Quicksand:wght@500;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "surface-variant": "#e4e3db",
                        surface: "#fbf9f1",
                        tertiary: "#825100",
                        "surface-container-high": "#eae8e0",
                        "on-background": "#1b1c17",
                        "inverse-on-surface": "#f3f1e9",
                        "surface-tint": "#005ac2",
                        "surface-container-lowest": "#ffffff",
                        "on-surface": "#1b1c17",
                        "on-error": "#ffffff",
                        "tertiary-container": "#a36700",
                        "on-primary": "#ffffff",
                        "surface-container": "#f0eee6",
                        "secondary-container": "#6cf8bb",
                        "on-secondary-container": "#00714d",
                        secondary: "#006c49",
                        "inverse-surface": "#30312c",
                        "primary-fixed-dim": "#adc6ff",
                        "on-primary-container": "#fefcff",
                        "surface-dim": "#dcdad2",
                        "on-secondary-fixed": "#002113",
                        "on-error-container": "#93000a",
                        "secondary-fixed": "#6ffbbe",
                        "on-primary-fixed-variant": "#004395",
                        "primary-fixed": "#d8e2ff",
                        "surface-bright": "#fbf9f1",
                        primary: "#0058be",
                        "on-surface-variant": "#424754",
                        "on-tertiary-fixed-variant": "#653e00",
                        "on-primary-fixed": "#001a42",
                        "inverse-primary": "#adc6ff",
                        "on-secondary-fixed-variant": "#005236",
                        "surface-container-low": "#f5f4ec",
                        "error-container": "#ffdad6",
                        "primary-container": "#2170e4",
                        background: "#fbf9f1",
                        "secondary-fixed-dim": "#4edea3",
                        outline: "#727785",
                        "on-tertiary-fixed": "#2a1700",
                        "tertiary-fixed-dim": "#ffb95f",
                        "on-tertiary-container": "#fffbff",
                        "on-secondary": "#ffffff",
                        "outline-variant": "#c2c6d6",
                        "tertiary-fixed": "#ffddb8",
                        "surface-container-highest": "#e4e3db",
                        "on-tertiary": "#ffffff",
                        error: "#ba1a1a"
                    },
                    borderRadius: {
                        DEFAULT: "1rem",
                        lg: "2rem",
                        xl: "3rem",
                        full: "9999px"
                    },
                    spacing: {
                        gutter: "24px",
                        unit: "8px",
                        "margin-desktop": "48px",
                        "container-max": "1200px",
                        "margin-mobile": "16px"
                    },
                    fontFamily: {
                        "body-lg": ["Quicksand"],
                        "headline-md": ["Lexend"],
                        "display-lg-mobile": ["Lexend"],
                        "display-lg": ["Lexend"],
                        "body-md": ["Quicksand"],
                        "label-sm": ["Lexend"]
                    },
                    fontSize: {
                        "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "500" }],
                        "headline-md": ["24px", { "lineHeight": "1.4", "fontWeight": "600" }],
                        "display-lg-mobile": ["32px", { "lineHeight": "1.2", "fontWeight": "700" }],
                        "display-lg": ["48px", { "lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "body-md": ["16px", { "lineHeight": "1.6", "fontWeight": "500" }],
                        "label-sm": ["14px", { "lineHeight": "1.2", "fontWeight": "600" }]
                    }
                },
            },
        }
    </script>
    <style>
        body { background-color: #fbf9f1; overflow: hidden; }
        .squishy-btn:active {
            transform: translateY(2px);
            box-shadow: none !important;
        }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #dcdad2; border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #c2c6d6; }
    </style>
</head>
<body class="font-body-md text-on-surface bg-background flex h-screen overflow-hidden">
    <partial name="_AcademySidebar" />
    <div class="flex-1 md:ml-64 flex flex-col min-w-0">
        <header class="h-16 flex-shrink-0 bg-surface/80 backdrop-blur-md border-b-2 border-outline-variant/30 flex items-center justify-between px-6 z-40">
            <div class="flex items-center gap-4">
                <a class="p-2 hover:bg-surface-variant rounded-full transition-colors" asp-controller="TeacherCourses" asp-action="Content" asp-route-id="@Model.Course.Id">
                    <span class="material-symbols-outlined">arrow_back</span>
                </a>
                <div class="flex flex-col">
                    <h2 class="font-bold text-on-surface">Spellbook Editor</h2>
                    <span class="text-xs text-on-surface-variant">Last saved 2 minutes ago</span>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <a class="px-5 py-2 bg-surface text-on-surface font-label-sm rounded-full border-2 border-outline-variant hover:bg-surface-variant transition-all squishy-btn shadow-[0_2px_0_0_rgba(114,119,133,0.3)]" asp-controller="Lessons" asp-action="Details" asp-route-id="@Model.Lesson.Id">Preview</a>
                <button form="lesson-form" class="px-5 py-2 bg-secondary text-on-secondary font-label-sm rounded-full border-2 border-secondary-fixed hover:brightness-110 transition-all squishy-btn shadow-[0_4px_0_0_rgba(0,108,73,0.28)]" type="submit">Save</button>
            </div>
        </header>
        <div class="flex-1 flex overflow-hidden">
            <aside class="w-80 flex-shrink-0 bg-surface-container-lowest border-r-2 border-outline-variant/30 flex flex-col">
                <div class="p-5 border-b border-surface-variant flex justify-between items-center bg-surface-container-lowest/90 backdrop-blur-sm">
                    <h3 class="font-bold text-on-surface">Curriculum</h3>
                    <a class="w-8 h-8 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center border-2 border-secondary shadow-[0_2px_0_0_rgba(0,108,73,0.3)] hover:brightness-105 squishy-btn transition-all" asp-controller="Chapters" asp-action="Create" asp-route-courseId="@Model.Course.Id">
                        <span class="material-symbols-outlined">add</span>
                    </a>
                </div>
                <div class="flex-1 overflow-y-auto p-4 flex flex-col gap-4 custom-scrollbar">
                    @foreach (var chapter in chapters)
                    {
                        <div class="space-y-2">
                            <div class="flex items-center gap-2 group">
                                <span class="material-symbols-outlined text-outline cursor-grab active:cursor-grabbing hover:text-primary">drag_indicator</span>
                                <div class="flex-1 bg-surface-container-highest rounded-xl p-3 flex justify-between items-center border border-transparent hover:border-primary/30 transition-all">
                                    <span class="font-bold text-sm">@chapter.Title</span>
                                    <span class="material-symbols-outlined text-sm text-outline">expand_more</span>
                                </div>
                            </div>
                            <div class="ml-8 space-y-2 border-l-2 border-outline-variant pl-4 py-1">
                                @foreach (var lesson in chapter.Lessons.OrderBy(l => l.OrderIndex))
                                {
                                    var isActive = lesson.Id == Model.Lesson.Id;
                                    <a class="flex items-center gap-3 @(isActive ? "bg-primary-fixed/40 border-2 border-primary/20 text-on-surface" : "hover:bg-surface-variant/50 border-2 border-transparent text-on-surface-variant") rounded-xl p-2 transition-colors cursor-pointer" asp-controller="Lessons" asp-action="Edit" asp-route-id="@lesson.Id">
                                        <div class="w-8 h-8 rounded-lg bg-surface flex items-center justify-center text-primary shadow-sm border border-primary/10">
                                            <span class="material-symbols-outlined text-[18px]">article</span>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <span class="text-sm font-semibold block truncate">@lesson.Title</span>
                                            <span class="text-xs text-on-surface-variant block truncate">@(string.IsNullOrWhiteSpace(lesson.ContentType) ? "Lesson" : lesson.ContentType)</span>
                                        </div>
                                    </a>
                                }
                                <a class="flex items-center gap-2 text-xs font-label-sm text-primary mt-1 p-2 rounded-lg hover:bg-primary-fixed/50 transition-colors w-fit border border-dashed border-primary/30" asp-controller="Lessons" asp-action="Create" asp-route-chapterId="@chapter.Id">
                                    <span class="material-symbols-outlined text-[16px]">add</span> Add Lesson
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </aside>
            <main class="flex-1 bg-surface/50 overflow-y-auto custom-scrollbar p-8 md:p-10 flex flex-col items-center">
                @{
                    var formAction = Model.Lesson.Id == 0 ? "Create" : "Edit";
                }
                <form id="lesson-form" asp-action="@formAction" asp-route-id="@(Model.Lesson.Id == 0 ? null : Model.Lesson.Id)" method="post" enctype="multipart/form-data" class="w-full max-w-4xl space-y-8">
                    <input type="hidden" asp-for="Lesson.Id" />
                    <input type="hidden" asp-for="Lesson.ChapterId" />
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="text-error font-bold mb-4 bg-error-container/20 p-4 rounded-xl border border-error/20 text-sm"></div>
                    }
                    <div class="bg-surface-container-lowest rounded-2xl border-2 border-outline-variant/30 p-6 shadow-sm space-y-4">
                        <div class="flex items-center gap-2 text-primary font-bold text-sm tracking-widest uppercase">
                            <span class="material-symbols-outlined text-sm">auto_stories</span>
                            @Model.Course.Title
                        </div>
                        <input asp-for="Lesson.Title" class="w-full bg-surface border-2 border-outline-variant/40 rounded-xl px-4 py-3 text-3xl font-headline-md text-on-surface outline-none focus:border-primary/40" placeholder="Lesson title" />
                        <input asp-for="Lesson.ContentType" class="w-full bg-surface border border-outline-variant/40 rounded-xl px-4 py-3 text-on-surface-variant text-body-md outline-none focus:border-primary/30" placeholder="theory / video / quiz" />
                    </div>
                    <div class="space-y-6">
                        <div class="group relative bg-surface-container-lowest rounded-2xl border-2 border-surface-variant p-6 transition-all hover:border-primary/20 shadow-sm hover:shadow-md">
                            <div class="prose prose-on-surface max-w-none">
                                <textarea asp-for="Lesson.DocumentContent" class="w-full min-h-[200px] outline-none bg-transparent text-body-md" placeholder="Theory content..."></textarea>
                            </div>
                        </div>
                        <div class="group relative bg-surface-container-low rounded-2xl border-2 border-dashed border-outline-variant p-6 flex flex-col items-center justify-center min-h-[200px] hover:border-primary/50 transition-all shadow-sm">
                            <span class="material-symbols-outlined text-4xl text-outline mb-2">video_library</span>
                            <h4 class="font-bold text-on-surface-variant">Add Lecture Video</h4>
                            <input asp-for="Lesson.VideoUrl" class="mt-4 w-full bg-surface-container-lowest border border-outline-variant rounded-full text-sm font-bold px-4 py-2" placeholder="Video URL (https://...)" />
                            <div class="mt-3 text-xs text-outline font-bold">OR UPLOAD FILE</div>
                            <input type="file" name="videoFile" accept="video/*" class="mt-2 text-xs font-bold text-on-surface-variant bg-surface-container-high rounded-full border border-outline-variant/30 px-4 py-2" />
                        </div>
                    </div>
                </form>
            </main>
            <aside class="w-80 flex-shrink-0 bg-surface-container-lowest border-l-2 border-outline-variant/30 hidden xl:flex flex-col">
                <div class="p-5 border-b border-surface-variant bg-surface-container-lowest/90 backdrop-blur-sm">
                    <h3 class="font-bold text-on-surface">Lesson Settings</h3>
                </div>
                <div class="p-6 space-y-8 overflow-y-auto custom-scrollbar">
                    <div class="space-y-4">
                        <label class="text-xs font-bold text-outline uppercase tracking-widest">Preview</label>
                        <select asp-for="Lesson.IsPreview" class="w-full bg-surface border border-outline-variant rounded-xl text-sm focus:ring-primary focus:border-primary" form="lesson-form">
                            <option value="false">Locked</option>
                            <option value="true">Preview</option>
                        </select>
                    </div>
                    <div class="space-y-4">
                        <label class="text-xs font-bold text-outline uppercase tracking-widest">Order</label>
                        <input asp-for="Lesson.OrderIndex" class="w-full bg-surface border border-outline-variant rounded-xl text-sm focus:ring-primary focus:border-primary px-3 py-2" type="number" form="lesson-form" />
                    </div>
                    <div class="space-y-4">
                        <label class="text-xs font-bold text-outline uppercase tracking-widest">Read Online (PDF URL)</label>
                        <input asp-for="Lesson.PdfPath" class="w-full bg-surface border border-outline-variant rounded-xl text-sm focus:ring-primary focus:border-primary px-3 py-2" type="text" form="lesson-form" placeholder="https://..." />
                        <div class="mt-1 text-[10px] text-outline font-bold">OR UPLOAD PDF</div>
                        <input type="file" name="pdfFile" accept="application/pdf" class="w-full text-xs font-bold text-on-surface-variant mt-1" form="lesson-form" />
                    </div>
                    <div class="space-y-4">
                        <label class="text-xs font-bold text-outline uppercase tracking-widest">Attached Document (URL)</label>
                        <input asp-for="Lesson.AttachmentPath" class="w-full bg-surface border border-outline-variant rounded-xl text-sm focus:ring-primary focus:border-primary px-3 py-2" type="text" form="lesson-form" placeholder="https://..." />
                        <div class="mt-1 text-[10px] text-outline font-bold">OR UPLOAD ATTACHMENT</div>
                        <input type="file" name="attachmentFile" class="w-full text-xs font-bold text-on-surface-variant mt-1" form="lesson-form" />
                    </div>
                    <div class="pt-10 space-y-4">
                        <a class="w-full py-3 text-error bg-error-container/30 border border-error/20 rounded-full font-bold text-sm hover:bg-error-container transition-all flex justify-center" asp-controller="Lessons" asp-action="Delete" asp-route-id="@Model.Lesson.Id">Delete this lesson</a>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</body>
</html>
