@model ChemistryV1.ViewModels.LessonViewerViewModel
@{
    Layout = null;
    var chapters = Model.Chapters.OrderBy(c => c.OrderIndex).ToList();
}
<!DOCTYPE html>
<html class="h-full" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>ChemLab 3D - @Model.Lesson.Title</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;600;700&amp;family=Quicksand:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "surface-variant": "#e4e3db",
                        surface: "#fbf9f1",
                        tertiary: "#825100",
                        "surface-container-high": "#eae8e0",
                        "on-background": "#1b1c17",
                        "inverse-on-surface": "#f3f1e9",
                        "surface-tint": "#005ac2",
                        "surface-container-lowest": "#ffffff",
                        "on-surface": "#1b1c17",
                        "on-error": "#ffffff",
                        "tertiary-container": "#a36700",
                        "on-primary": "#ffffff",
                        "surface-container": "#f0eee6",
                        "secondary-container": "#6cf8bb",
                        "on-secondary-container": "#00714d",
                        secondary: "#006c49",
                        "inverse-surface": "#30312c",
                        "primary-fixed-dim": "#adc6ff",
                        "on-primary-container": "#fefcff",
                        "surface-dim": "#dcdad2",
                        "on-secondary-fixed": "#002113",
                        "on-error-container": "#93000a",
                        "secondary-fixed": "#6ffbbe",
                        "on-primary-fixed-variant": "#004395",
                        "primary-fixed": "#d8e2ff",
                        "surface-bright": "#fbf9f1",
                        primary: "#0058be",
                        "on-surface-variant": "#424754",
                        "on-tertiary-fixed-variant": "#653e00",
                        "on-primary-fixed": "#001a42",
                        "inverse-primary": "#adc6ff",
                        "on-secondary-fixed-variant": "#005236",
                        "surface-container-low": "#f5f4ec",
                        "error-container": "#ffdad6",
                        "primary-container": "#2170e4",
                        background: "#fbf9f1",
                        "secondary-fixed-dim": "#4edea3",
                        outline: "#727785",
                        "on-tertiary-fixed": "#2a1700",
                        "tertiary-fixed-dim": "#ffb95f",
                        "on-tertiary-container": "#fffbff",
                        "on-secondary": "#ffffff",
                        "outline-variant": "#c2c6d6",
                        "tertiary-fixed": "#ffddb8",
                        "surface-container-highest": "#e4e3db",
                        "on-tertiary": "#ffffff",
                        error: "#ba1a1a"
                    },
                    borderRadius: {
                        DEFAULT: "1rem",
                        lg: "2rem",
                        xl: "3rem",
                        full: "9999px"
                    },
                    spacing: {
                        "margin-desktop": "48px",
                        gutter: "24px",
                        "margin-mobile": "16px",
                        "container-max": "1200px",
                        unit: "8px"
                    },
                    fontFamily: {
                        "label-sm": ["Lexend"],
                        "display-lg": ["Lexend"],
                        "headline-md": ["Lexend"],
                        "body-md": ["Quicksand"],
                        "display-lg-mobile": ["Lexend"],
                        "body-lg": ["Quicksand"]
                    },
                    fontSize: {
                        "label-sm": ["14px", { "lineHeight": "1.2", "fontWeight": "600" }],
                        "display-lg": ["48px", { "lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "headline-md": ["24px", { "lineHeight": "1.4", "fontWeight": "600" }],
                        "body-md": ["16px", { "lineHeight": "1.6", "fontWeight": "500" }],
                        "display-lg-mobile": ["32px", { "lineHeight": "1.2", "fontWeight": "700" }],
                        "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "500" }]
                    }
                }
            }
        }
    </script>
    <style>
        .squishy-btn {
            transition: all 0.15s ease-in-out;
            box-shadow: 0 4px 0 0 var(--tw-shadow-color);
        }
        .squishy-btn:active {
            transform: translateY(4px);
            box-shadow: 0 0 0 0 var(--tw-shadow-color);
        }
        .layer-1-card {
            box-shadow: 0 4px 12px rgba(0, 88, 190, 0.08);
            border: 2px solid rgba(0, 88, 190, 0.15);
        }
    </style>
</head>
<body class="bg-surface text-on-surface h-full flex flex-col md:flex-row overflow-hidden relative">
    <nav class="w-full md:w-80 h-auto md:h-full bg-surface-container-lowest border-r-2 border-primary/10 flex flex-col flex-shrink-0 z-20 layer-1-card rounded-r-xl" id="course-outline">
        <div class="p-6 border-b-2 border-surface-variant flex justify-between items-center bg-surface/50 backdrop-blur-sm">
            <div>
                <h2 class="font-headline-md text-headline-md text-primary mb-1">@Model.Course.Title</h2>
                <p class="font-label-sm text-label-sm text-on-surface-variant">Lesson Viewer</p>
            </div>
        </div>
        <div class="flex-1 overflow-y-auto px-4 pb-6 space-y-2">
            @foreach (var chapter in chapters)
            {
                <div class="mt-4 text-xs uppercase tracking-widest text-on-surface-variant">@chapter.Title</div>
                @foreach (var lesson in chapter.Lessons.OrderBy(l => l.OrderIndex))
                {
                    var isActive = lesson.Id == Model.Lesson.Id;
                    <a class="flex items-center gap-3 @(isActive ? "bg-primary-container/10 text-primary border-2 border-primary/30 layer-1-card" : "text-on-surface-variant hover:bg-surface-variant border-2 border-transparent") rounded-lg p-3 cursor-pointer transition-colors" asp-controller="Lessons" asp-action="Details" asp-route-id="@lesson.Id">
                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">@(isActive ? "play_circle" : "article")</span>
                        <span class="font-body-md text-body-md flex-1">@lesson.Title</span>
                    </a>
                }
            }
        </div>
        <div class="p-4 border-t-2 border-surface-variant bg-surface/50">
            <a class="w-full flex items-center justify-center gap-2 p-3 text-on-surface-variant hover:bg-error-container hover:text-on-error-container rounded-lg transition-colors font-label-sm text-label-sm border-2 border-transparent hover:border-error/20" asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Course.Id">
                <span class="material-symbols-outlined">logout</span>
                Exit to Lab
            </a>
        </div>
    </nav>
    <main class="flex-1 flex flex-col h-full bg-surface relative overflow-y-auto">
        <header class="flex justify-between items-center p-margin-mobile md:px-margin-desktop md:py-6 bg-surface/90 backdrop-blur-md sticky top-0 z-10">
            <div class="flex items-center gap-4">
                <button class="md:hidden p-2 bg-surface-container rounded-full text-primary border-2 border-primary/20 shadow-sm" onclick="document.getElementById('course-outline').classList.toggle('-translate-x-full')">
                    <span class="material-symbols-outlined">menu</span>
                </button>
            </div>
            <div class="flex items-center gap-3">
                <button class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-on-surface hover:bg-surface-variant transition-colors border-2 border-surface-variant">
                    <span class="material-symbols-outlined">help_outline</span>
                </button>
            </div>
        </header>
        <div class="flex-1 px-margin-mobile md:px-margin-desktop pb-24 max-w-container-max mx-auto w-full flex flex-col justify-center">
            <div class="bg-surface-container-lowest rounded-xl layer-1-card p-6 md:p-10 mb-8 relative overflow-hidden">
                <div class="absolute top-0 left-0 right-0 h-2 bg-gradient-to-r from-primary to-secondary-container"></div>
                <h1 class="font-display-lg text-display-lg text-on-background mb-6">@Model.Lesson.Title</h1>
                <p class="font-body-lg text-body-lg text-on-surface-variant mb-8 max-w-3xl">@Model.Lesson.ContentType</p>
                @if (!string.IsNullOrWhiteSpace(Model.Lesson.VideoUrl))
                {
                    <div class="w-full aspect-video bg-surface-container rounded-lg border-2 border-primary/20 flex items-center justify-center relative overflow-hidden group cursor-pointer">
                        <div class="absolute inset-0 bg-primary/10 group-hover:bg-primary/20 transition-colors"></div>
                        <a class="w-20 h-20 bg-surface-container-lowest rounded-full flex items-center justify-center text-primary z-10 layer-1-card squishy-btn shadow-primary" href="@Model.Lesson.VideoUrl" target="_blank">
                            <span class="material-symbols-outlined" style="font-size: 40px; font-variation-settings: 'FILL' 1;">play_arrow</span>
                        </a>
                    </div>
                }
                <div class="mt-8 prose max-w-none text-on-surface">
                    <p>@Model.Lesson.DocumentContent</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Lesson.PdfPath))
                {
                    <div class="mt-10 border-2 border-primary/10 rounded-2xl overflow-hidden bg-surface-container-low shadow-sm">
                        <div class="bg-primary/5 px-6 py-4 border-b border-primary/10 flex items-center justify-between">
                            <h4 class="font-bold text-primary flex items-center gap-2 m-0 text-sm">
                                <span class="material-symbols-outlined">picture_as_pdf</span>
                                Tài liệu đọc trực tuyến (PDF)
                            </h4>
                            <a href="@Model.Lesson.PdfPath" target="_blank" class="text-xs bg-white text-primary border border-primary/30 px-3 py-1.5 rounded-full hover:bg-primary-container transition-all flex items-center gap-1 font-semibold">
                                <span class="material-symbols-outlined text-xs">open_in_new</span> Mở tab mới
                            </a>
                        </div>
                        <div class="w-full h-[600px] bg-white">
                            <iframe src="@Model.Lesson.PdfPath" class="w-full h-full border-none" type="application/pdf"></iframe>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Lesson.AttachmentPath))
                {
                    <div class="mt-8 bg-secondary-container/10 border-2 border-secondary/20 rounded-2xl p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-xl bg-secondary-container flex items-center justify-center text-on-secondary-container shadow-inner">
                                <span class="material-symbols-outlined text-3xl">download</span>
                            </div>
                            <div>
                                <h4 class="font-bold text-on-secondary-container m-0 text-sm">Tài liệu học tập đính kèm</h4>
                                <p class="text-xs text-on-surface-variant m-0">Tải xuống các tệp đính kèm và bài tập về máy để thực hành</p>
                            </div>
                        </div>
                        <a href="@Model.Lesson.AttachmentPath" download class="w-full sm:w-auto px-6 py-3 bg-secondary text-on-secondary rounded-full font-bold shadow-md hover:brightness-110 active:translate-y-0.5 transition-all text-center flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-sm">download_for_offline</span>
                            Tải tài liệu về máy
                        </a>
                    </div>
                }
            </div>
        </div>
        <div class="bg-surface-container-lowest border-t-2 border-surface-variant p-4 md:p-6 sticky bottom-0 z-10 w-full">
            <div class="max-w-container-max mx-auto flex justify-between items-center gap-4">
                <a class="px-6 py-3 bg-surface rounded-full text-on-surface-variant border-2 border-outline-variant hover:bg-surface-variant transition-colors flex items-center gap-2 font-label-sm text-label-sm squishy-btn shadow-outline" asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Course.Id">
                    <span class="material-symbols-outlined">arrow_back</span>
                    <span class="hidden md:inline">Back to Course</span>
                </a>
                <button class="flex-1 md:flex-none px-8 py-3 bg-primary text-on-primary rounded-full border-2 border-primary-container hover:bg-primary-container transition-colors flex items-center justify-center gap-2 font-label-sm text-label-sm squishy-btn shadow-primary font-bold">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                    Mark as Complete
                </button>
            </div>
        </div>
    </main>
</body>
</html>
