@model ChemistryV1.ViewModels.LessonViewerViewModel
@{
    Layout = "_LessonLayout";
    ViewData["Title"] = "ChemLab";
    ViewData["Description"] = "Học hóa học với các bài học tương tác và phòng thí nghiệm ảo.";
    ViewData["CourseTitle"] = Model.Course.Title;
    var isTeacherOrAdmin = User.IsInRole("Admin") || User.IsInRole("Teacher");
    ViewData["CourseDetailsUrl"] = isTeacherOrAdmin 
        ? Url.Action("Content", "TeacherCourses", new { id = Model.Course.Id }) 
        : Url.Action("Details", "Courses", new { id = Model.Course.Id });
    ViewData["IsLessonCompleted"] = Model.CompletedLessonIds.Contains(Model.Lesson.Id);
    ViewData["LessonId"] = Model.Lesson.Id;
    var chapters = Model.Chapters.OrderBy(c => c.OrderIndex).ToList();
}

@section LessonOutline {
    <div class="space-y-1">
    @{
        var isFirstChapter = true;
    }
    @foreach (var chapter in chapters)
    {
        <div class="@(isFirstChapter ? "pt-0" : "pt-3") pb-1 text-[10px] uppercase tracking-widest text-on-surface-variant font-label font-bold px-1">@chapter.Title</div>
        {
            isFirstChapter = false;
        }
        @foreach (var lesson in chapter.Lessons.OrderBy(l => l.OrderIndex))
        {
            var isActive = lesson.Id == Model.Lesson.Id;
            var isCompleted = Model.CompletedLessonIds.Contains(lesson.Id);
            <a class="lesson-outline-item flex items-center gap-2 min-h-[2.75rem] @(isActive ? "lesson-outline-item--active bg-primary/15 text-primary border border-primary/40 shadow-neon-blue" : "text-on-surface-variant hover:bg-surface-container-high border border-transparent hover:border-outline/40") rounded-lg px-2.5 py-2 cursor-pointer transition-colors" asp-controller="Lessons" asp-action="Details" asp-route-id="@lesson.Id">
                <span class="material-symbols-outlined text-[20px] shrink-0 fill-1">@(isActive ? "play_circle" : "article")</span>
                <span class="text-xs leading-snug flex-1 min-w-0 font-semibold line-clamp-2">@lesson.Title</span>
                @if (isCompleted)
                {
                    <span class="material-symbols-outlined text-secondary text-[18px] shrink-0 fill-1">check_circle</span>
                }
            </a>
        }
    }
    </div>
}

<!-- Lesson Content Card -->
<div class="glass-card p-6 md:p-10 mb-8 relative overflow-hidden">
    <div class="absolute top-0 left-0 right-0 h-2 bg-gradient-to-r from-primary to-secondary"></div>
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-on-background font-display">@Model.Lesson.Title</h1>
        <p class="text-lg text-slate-500 mt-2 max-w-3xl">@Model.Lesson.ContentType</p>
    </div>

    @if (Model.Lesson.ContentType == "virtual_lab" && Model.Lesson.VirtualLabId.HasValue)
    {
        <div class="relative group">
            <button onclick="toggleFullScreen('lab-iframe')" class="absolute top-4 right-4 z-10 w-10 h-10 bg-black/50 hover:bg-black/80 text-white rounded-lg flex items-center justify-center backdrop-blur-sm transition-all opacity-0 group-hover:opacity-100 shadow-md" title="Phóng to toàn màn hình">
                <span class="material-symbols-outlined text-[24px]">fullscreen</span>
            </button>
            <div class="w-full aspect-video bg-surface-container rounded-xl border border-primary/30 flex items-center justify-center relative overflow-hidden">
                <iframe id="lab-iframe" src="@Model.Lesson.VirtualLab.Url"
                        class="absolute inset-0 w-full h-full border-0"
                        allowfullscreen="true" webkitallowfullscreen="true" mozallowfullscreen="true"></iframe>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.Lesson.VideoUrl))
    {
        <div class="w-full aspect-video bg-slate-100 rounded-2xl border-2 border-primary/20 flex items-center justify-center relative overflow-hidden group cursor-pointer">
            <div class="absolute inset-0 bg-primary/10 group-hover:bg-primary/20 transition-colors"></div>
            <a class="w-20 h-20 bg-white rounded-full flex items-center justify-center text-primary z-10 glass-card btn-glow shadow-primary"
               href="@Model.Lesson.VideoUrl" target="_blank">
                <span class="material-symbols-outlined fill-1 text-5xl">play_arrow</span>
            </a>
        </div>
    }

    @if (Model.HighestScore.HasValue)
    {
        <div class="mt-6 p-4 bg-primary/10 border-2 border-primary/20 rounded-xl flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center text-white font-bold">
                    <span class="material-symbols-outlined text-[20px]">emoji_events</span>
                </div>
                <div>
                    <h4 class="font-bold text-primary m-0 text-sm">Điểm số thực hành cao nhất</h4>
                    <p class="text-xs text-slate-500 m-0">Điểm số đã được lưu vào hệ thống</p>
                </div>
            </div>
            <div class="text-2xl font-black text-primary drop-shadow-sm">
                @Model.HighestScore.Value <span class="text-sm font-bold text-primary/70 uppercase">điểm</span>
            </div>
        </div>
    }

    <div class="mt-8 prose max-w-none text-on-background">
        <p>@Model.Lesson.DocumentContent</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Lesson.PdfPath))
    {
        <div class="mt-10 border-2 border-primary/10 rounded-2xl overflow-hidden bg-slate-50 shadow-sm">
            <div class="bg-primary/5 px-6 py-4 border-b border-primary/10 flex items-center justify-between">
                <h4 class="font-bold text-primary flex items-center gap-2 m-0 text-sm">
                    <span class="material-symbols-outlined">picture_as_pdf</span>
                    PDF Document
                </h4>
                <a href="@Model.Lesson.PdfPath" target="_blank" class="text-xs bg-white text-primary border border-primary/30 px-3 py-1.5 rounded-full hover:bg-primary/10 transition-all flex items-center gap-1 font-semibold">
                    <span class="material-symbols-outlined text-xs">open_in_new</span> Open in new tab
                </a>
            </div>
            <div class="w-full h-[600px] bg-white">
                <iframe src="@Model.Lesson.PdfPath" class="w-full h-full border-none" type="application/pdf"></iframe>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Lesson.AttachmentPath))
    {
        <div class="mt-8 bg-secondary/10 border-2 border-secondary/20 rounded-2xl p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-secondary flex items-center justify-center text-white shadow-inner">
                    <span class="material-symbols-outlined text-3xl">download</span>
                </div>
                <div>
                    <h4 class="font-bold text-secondary m-0 text-sm">Downloadable Materials</h4>
                    <p class="text-xs text-slate-500 m-0">Download attached files and exercises for practice</p>
                </div>
            </div>
            <a href="@Model.Lesson.AttachmentPath" download class="w-full sm:w-auto px-6 py-3 bg-secondary text-white rounded-full font-bold shadow-md hover:bg-secondary/90 active:translate-y-0.5 transition-all text-center flex items-center justify-center gap-2 btn-glow">
                <span class="material-symbols-outlined text-sm">download_for_offline</span>
                Download
            </a>
        </div>
    }
</div>

<!-- Discussion Board Section -->
<div class="glass-card p-6 md:p-10 mb-8 relative overflow-hidden">
    <div class="absolute top-0 left-0 right-0 h-2 bg-gradient-to-r from-secondary to-primary"></div>
    
    <!-- Feedback Alerts -->
    @if (TempData["CommentError"] != null)
    {
        <div class="mb-6 p-4 bg-red-50 border border-red-200 text-red-700 font-bold text-sm rounded-xl flex items-center gap-2">
            <span class="material-symbols-outlined">error</span>
            @TempData["CommentError"]
        </div>
    }
    @if (TempData["CommentSuccess"] != null)
    {
        <div class="mb-6 p-4 bg-secondary/10 border border-secondary/20 text-secondary font-bold text-sm rounded-xl flex items-center gap-2">
            <span class="material-symbols-outlined">check_circle</span>
            @TempData["CommentSuccess"]
        </div>
    }

    @if (Model.Lesson.CommentsEnabled == false)
    {
        <!-- Comments Disabled -->
        <div class="py-10 text-center flex flex-col items-center justify-center">
            <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 mb-4 border border-slate-200 shadow-inner">
                <span class="material-symbols-outlined text-3xl">lock</span>
            </div>
            <h3 class="text-xl text-on-background mb-2 font-bold font-display">Discussion Closed</h3>
            <p class="text-sm text-slate-500 max-w-md">The discussion for this lesson has been closed by the administrator.</p>
        </div>
    }
    else
    {
        <!-- Active Comments Section -->
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl text-on-background flex items-center gap-2 font-bold font-display">
                <span class="material-symbols-outlined text-primary">forum</span>
                Discussion
            </h2>
            @{
                var totalComments = Model.Lesson.Comments?.Count ?? 0;
            }
            <span class="px-3 py-1 bg-primary/10 text-primary rounded-full text-xs font-bold border border-primary/20 shadow-xs">
                @totalComments comments
            </span>
        </div>

        <!-- New Comment Form -->
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-controller="Comments" asp-action="Create" method="post" class="mb-8 p-5 bg-slate-50 rounded-2xl border border-slate-200 flex flex-col gap-3">
                <input type="hidden" name="lessonId" value="@Model.Lesson.Id" />
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px] text-primary">create</span>
                    <label class="text-xs font-bold text-slate-600 uppercase tracking-wider block">Đặt câu hỏi hoặc chia sẻ suy nghĩ của bạn</label>
                </div>
                <textarea name="content" rows="3" class="w-full bg-white border border-slate-200 focus:border-primary/50 focus:ring-0 rounded-xl text-sm p-4 font-medium outline-none resize-none transition-all" placeholder="Nhập câu hỏi hoặc nội dung thảo luận của bạn ở đây..."></textarea>
                <button type="submit" class="px-5 py-2.5 bg-primary text-white rounded-full border-2 border-primary/30 hover:bg-primary/90 transition-all btn-glow text-sm self-end flex items-center gap-2 font-bold">
                    <span class="material-symbols-outlined text-[18px]">send</span> Gửi
                </button>
            </form>
        }
        else
        {
            <div class="mb-8 p-6 bg-slate-100 rounded-2xl text-center border border-slate-200">
                <p class="text-sm text-slate-500 font-medium mb-3">Vui lòng đăng nhập để tham gia thảo luận.</p>
                <a class="px-5 py-2 bg-primary text-white rounded-full border-2 border-primary/30 hover:bg-primary/90 transition-all btn-glow text-sm inline-flex items-center gap-2 font-bold" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">
                    <span class="material-symbols-outlined text-[18px]">login</span> Đăng nhập ngay
                </a>
            </div>
        }

        <!-- Comments Thread -->
        <div class="space-y-4">
            @{
                var topLevelComments = Model.Lesson.Comments?.Where(c => c.ParentId == null).OrderByDescending(c => c.CreatedAt).ToList() ?? new List<Comment>();
            }
            @if (!topLevelComments.Any())
            {
                <div class="text-center py-12 text-slate-400 font-medium">
                    <span class="material-symbols-outlined text-4xl block mb-2 opacity-50">forum</span>
                    No discussions yet. Be the first to start one!
                </div>
            }
            else
            {
                <div class="flex flex-col gap-2">
                    @foreach (var comment in topLevelComments)
                    {
                        <partial name="_CommentThread" model="comment" />
                    }
                </div>
            }
        </div>
    }
</div>

@section Head {
    <style>
        .squishy-btn {
            transition: all 0.15s ease-in-out;
            box-shadow: 0 4px 0 0 var(--tw-shadow-color);
        }
        .squishy-btn:active {
            transform: translateY(4px);
            box-shadow: 0 0 0 0 var(--tw-shadow-color);
        }
    </style>
}

@section Scripts {
    @functions {
        public static string GetTimeAgo(DateTime dateTime)
        {
            var timeSpan = DateTime.Now - dateTime;
            if (timeSpan <= TimeSpan.FromSeconds(60))
            {
                return "Just now";
            }
            if (timeSpan <= TimeSpan.FromMinutes(60))
            {
                return timeSpan.Minutes > 1 ? $"{timeSpan.Minutes} minutes ago" : "1 minute ago";
            }
            if (timeSpan <= TimeSpan.FromHours(24))
            {
                return timeSpan.Hours > 1 ? $"{timeSpan.Hours} hours ago" : "1 hour ago";
            }
            if (timeSpan <= TimeSpan.FromDays(30))
            {
                return timeSpan.Days > 1 ? $"{timeSpan.Days} days ago" : "Yesterday";
            }
            if (timeSpan <= TimeSpan.FromDays(365))
            {
                return dateTime.ToString("dd/MM");
            }
            return dateTime.ToString("dd/MM/yyyy");
        }
    }

    <script>
        function showReplyForm(commentId) {
            document.querySelectorAll('[id^="reply-form-"]').forEach(el => el.classList.add('hidden'));
            const form = document.getElementById(`reply-form-${commentId}`);
            if (form) {
                form.classList.remove('hidden');
                const textarea = form.querySelector('textarea');
                if (textarea) textarea.focus();
            }
        }

        function hideReplyForm(commentId) {
            const form = document.getElementById(`reply-form-${commentId}`);
            if (form) {
                form.classList.add('hidden');
            }
        }

        function toggleEditForm(commentId) {
            const form = document.getElementById(`edit-form-${commentId}`);
            const contentDiv = document.getElementById(`comment-content-${commentId}`);
            if (form && contentDiv) {
                if (form.classList.contains('hidden')) {
                    form.classList.remove('hidden');
                    contentDiv.classList.add('hidden');
                    const textarea = form.querySelector('textarea');
                    if (textarea) textarea.focus();
                } else {
                    form.classList.add('hidden');
                    contentDiv.classList.remove('hidden');
                }
            }
        }

        // Listen for messages from iframe Game
        window.addEventListener('message', function (event) {
            const data = event.data;
            if (data && data.type === 'PRACTICE_COMPLETED') {
                fetch('/api/practice/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        lessonId: @Model.Lesson.Id,
                        score: data.score
                    })
                })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        alert('Bạn nhận được ' + res.score + ' điểm và đã được lưu vào hệ thống!');
                    }
                })
                .catch(err => console.error('Error submitting practice score:', err));
            }
        });

        // Hàm phóng to toàn màn hình
        function toggleFullScreen(elementId) {
            var elem = document.getElementById(elementId);
            if (!document.fullscreenElement) {
                if (elem.requestFullscreen) {
                    elem.requestFullscreen();
                } else if (elem.webkitRequestFullscreen) { /* Safari */
                    elem.webkitRequestFullscreen();
                } else if (elem.msRequestFullscreen) { /* IE11 */
                    elem.msRequestFullscreen();
                }
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                } else if (document.webkitExitFullscreen) { /* Safari */
                    document.webkitExitFullscreen();
                } else if (document.msExitFullscreen) { /* IE11 */
                    document.msExitFullscreen();
                }
            }
        }
    </script>
}
