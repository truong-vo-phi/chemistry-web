@model ChemistryV1.ViewModels.LessonViewerViewModel
@{
    Layout = null;
    var chapters = Model.Chapters.OrderBy(c => c.OrderIndex).ToList();

    // ----TV2----
    var currentUserId = User.Identity?.IsAuthenticated == true 
        ? Convert.ToInt32(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value) 
        : 0;
    var currentUserName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Guest";
    var currentUserAvatar = User.FindFirst("AvatarUrl")?.Value ?? "https://via.placeholder.com/150";
    var currentUserRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Student";
    // ----TV2----
}
<!DOCTYPE html>
<html class="h-full" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>ChemLab - @Model.Lesson.Title</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;600;700&amp;family=Quicksand:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "surface-variant": "#e4e3db",
                        surface: "#fbf9f1",
                        tertiary: "#825100",
                        "surface-container-high": "#eae8e0",
                        "on-background": "#1b1c17",
                        "inverse-on-surface": "#f3f1e9",
                        "surface-tint": "#005ac2",
                        "surface-container-lowest": "#ffffff",
                        "on-surface": "#1b1c17",
                        "on-error": "#ffffff",
                        "tertiary-container": "#a36700",
                        "on-primary": "#ffffff",
                        "surface-container": "#f0eee6",
                        "secondary-container": "#6cf8bb",
                        "on-secondary-container": "#00714d",
                        secondary: "#006c49",
                        "inverse-surface": "#30312c",
                        "primary-fixed-dim": "#adc6ff",
                        "on-primary-container": "#fefcff",
                        "surface-dim": "#dcdad2",
                        "on-secondary-fixed": "#002113",
                        "on-error-container": "#93000a",
                        "secondary-fixed": "#6ffbbe",
                        "on-primary-fixed-variant": "#004395",
                        "primary-fixed": "#d8e2ff",
                        "surface-bright": "#fbf9f1",
                        primary: "#0058be",
                        "on-surface-variant": "#424754",
                        "on-tertiary-fixed-variant": "#653e00",
                        "on-primary-fixed": "#001a42",
                        "inverse-primary": "#adc6ff",
                        "on-secondary-fixed-variant": "#005236",
                        "surface-container-low": "#f5f4ec",
                        "error-container": "#ffdad6",
                        "primary-container": "#2170e4",
                        background: "#fbf9f1",
                        "secondary-fixed-dim": "#4edea3",
                        outline: "#727785",
                        "on-tertiary-fixed": "#2a1700",
                        "tertiary-fixed-dim": "#ffb95f",
                        "on-tertiary-container": "#fffbff",
                        "on-secondary": "#ffffff",
                        "outline-variant": "#c2c6d6",
                        "tertiary-fixed": "#ffddb8",
                        "surface-container-highest": "#e4e3db",
                        "on-tertiary": "#ffffff",
                        error: "#ba1a1a"
                    },
                    borderRadius: {
                        DEFAULT: "1rem",
                        lg: "2rem",
                        xl: "3rem",
                        full: "9999px"
                    },
                    spacing: {
                        "margin-desktop": "48px",
                        gutter: "24px",
                        "margin-mobile": "16px",
                        "container-max": "1200px",
                        unit: "8px"
                    },
                    fontFamily: {
                        "label-sm": ["Lexend"],
                        "display-lg": ["Lexend"],
                        "headline-md": ["Lexend"],
                        "body-md": ["Quicksand"],
                        "display-lg-mobile": ["Lexend"],
                        "body-lg": ["Quicksand"]
                    },
                    fontSize: {
                        "label-sm": ["14px", { "lineHeight": "1.2", "fontWeight": "600" }],
                        "display-lg": ["48px", { "lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "headline-md": ["24px", { "lineHeight": "1.4", "fontWeight": "600" }],
                        "body-md": ["16px", { "lineHeight": "1.6", "fontWeight": "500" }],
                        "display-lg-mobile": ["32px", { "lineHeight": "1.2", "fontWeight": "700" }],
                        "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "500" }]
                    }
                }
            }
        }
    </script>
    <style>
        .squishy-btn {
            transition: all 0.15s ease-in-out;
            box-shadow: 0 4px 0 0 var(--tw-shadow-color);
        }
        .squishy-btn:active {
            transform: translateY(4px);
            box-shadow: 0 0 0 0 var(--tw-shadow-color);
        }
        .layer-1-card {
            box-shadow: 0 4px 12px rgba(0, 88, 190, 0.08);
            border: 2px solid rgba(0, 88, 190, 0.15);
        }
    </style>
</head>
<body class="bg-surface text-on-surface h-full flex flex-col md:flex-row overflow-hidden relative">
    <nav class="w-full md:w-80 h-auto md:h-full bg-surface-container-lowest border-r-2 border-primary/10 flex flex-col flex-shrink-0 z-20 layer-1-card rounded-r-xl" id="course-outline">
        <div class="p-6 border-b-2 border-surface-variant flex justify-between items-center bg-surface/50 backdrop-blur-sm">
            <div>
                <h2 class="font-headline-md text-headline-md text-primary mb-1">@Model.Course.Title</h2>
                <p class="font-label-sm text-label-sm text-on-surface-variant">Lesson Viewer</p>
            </div>
        </div>
        <div class="flex-1 overflow-y-auto px-4 pb-6 space-y-2">
            @foreach (var chapter in chapters)
            {
                <div class="mt-4 text-xs uppercase tracking-widest text-on-surface-variant">@chapter.Title</div>
                @foreach (var lesson in chapter.Lessons.OrderBy(l => l.OrderIndex))
                {
                    var isActive = lesson.Id == Model.Lesson.Id;
                    <a class="flex items-center gap-3 @(isActive ? "bg-primary-container/10 text-primary border-2 border-primary/30 layer-1-card" : "text-on-surface-variant hover:bg-surface-variant border-2 border-transparent") rounded-lg p-3 cursor-pointer transition-colors" asp-controller="Lessons" asp-action="Details" asp-route-id="@lesson.Id">
                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">@(isActive ? "play_circle" : "article")</span>
                        <span class="font-body-md text-body-md flex-1">@lesson.Title</span>
                    </a>
                }
            }
        </div>
        <div class="p-4 border-t-2 border-surface-variant bg-surface/50">
            <a class="w-full flex items-center justify-center gap-2 p-3 text-on-surface-variant hover:bg-error-container hover:text-on-error-container rounded-lg transition-colors font-label-sm text-label-sm border-2 border-transparent hover:border-error/20" asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Course.Id">
                <span class="material-symbols-outlined">logout</span>
                Exit to Lab
            </a>
        </div>
    </nav>
    <main class="flex-1 flex flex-col h-full bg-surface relative overflow-y-auto">
        <header class="flex justify-between items-center p-margin-mobile md:px-margin-desktop md:py-6 bg-surface/90 backdrop-blur-md sticky top-0 z-10">
            <div class="flex items-center gap-4">
                <button class="md:hidden p-2 bg-surface-container rounded-full text-primary border-2 border-primary/20 shadow-sm" onclick="document.getElementById('course-outline').classList.toggle('-translate-x-full')">
                    <span class="material-symbols-outlined">menu</span>
                </button>
            </div>
            <div class="flex items-center gap-3">
                <button class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-on-surface hover:bg-surface-variant transition-colors border-2 border-surface-variant">
                    <span class="material-symbols-outlined">help_outline</span>
                </button>
            </div>
        </header>
        <div class="flex-1 px-margin-mobile md:px-margin-desktop pb-24 max-w-container-max mx-auto w-full flex flex-col justify-center">
            <div class="bg-surface-container-lowest rounded-xl layer-1-card p-6 md:p-10 mb-8 relative overflow-hidden">
                <div class="absolute top-0 left-0 right-0 h-2 bg-gradient-to-r from-primary to-secondary-container"></div>
                <h1 class="font-display-lg text-display-lg text-on-background mb-6">@Model.Lesson.Title</h1>
                <p class="font-body-lg text-body-lg text-on-surface-variant mb-8 max-w-3xl">@Model.Lesson.ContentType</p>
                @if (Model.Lesson.ContentType == "virtual_lab" && Model.Lesson.VirtualLabId.HasValue)
                {
                    <div class="w-full aspect-video bg-surface-container rounded-lg border-2 border-primary/20 flex items-center justify-center relative overflow-hidden">
                        <iframe src="@Model.Lesson.VirtualLab?.Url"
                                class="absolute inset-0 w-full h-full border-0"
                                allowfullscreen></iframe>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(Model.Lesson.VideoUrl))
                {
                    <div class="w-full aspect-video bg-surface-container rounded-lg border-2 border-primary/20 flex items-center justify-center relative overflow-hidden group cursor-pointer">
                        <div class="absolute inset-0 bg-primary/10 group-hover:bg-primary/20 transition-colors"></div>
                        <a class="w-20 h-20 bg-surface-container-lowest rounded-full flex items-center justify-center text-primary z-10 layer-1-card squishy-btn shadow-primary"
                           href="@Model.Lesson.VideoUrl" target="_blank">
                            <span class="material-symbols-outlined"
                                  style="font-size: 40px; font-variation-settings: 'FILL' ;">
                                play_arrow
                            </span>
                        </a>
                    </div>
                }
                <div class="mt-8 prose max-w-none text-on-surface">
                    <p>@Model.Lesson.DocumentContent</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Lesson.PdfPath))
                {
                    <div class="mt-10 border-2 border-primary/10 rounded-2xl overflow-hidden bg-surface-container-low shadow-sm">
                        <div class="bg-primary/5 px-6 py-4 border-b border-primary/10 flex items-center justify-between">
                            <h4 class="font-bold text-primary flex items-center gap-2 m-0 text-sm">
                                <span class="material-symbols-outlined">picture_as_pdf</span>
                                Tài liệu đọc trực tuyến (PDF)
                            </h4>
                            <a href="@Model.Lesson.PdfPath" target="_blank" class="text-xs bg-white text-primary border border-primary/30 px-3 py-1.5 rounded-full hover:bg-primary-container transition-all flex items-center gap-1 font-semibold">
                                <span class="material-symbols-outlined text-xs">open_in_new</span> Mở tab mới
                            </a>
                        </div>
                        <div class="w-full h-[600px] bg-white">
                            <iframe src="@Model.Lesson.PdfPath" class="w-full h-full border-none" type="application/pdf"></iframe>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Lesson.AttachmentPath))
                {
                    <div class="mt-8 bg-secondary-container/10 border-2 border-secondary/20 rounded-2xl p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-xl bg-secondary-container flex items-center justify-center text-on-secondary-container shadow-inner">
                                <span class="material-symbols-outlined text-3xl">download</span>
                            </div>
                            <div>
                                <h4 class="font-bold text-on-secondary-container m-0 text-sm">Tài liệu học tập đính kèm</h4>
                                <p class="text-xs text-on-surface-variant m-0">Tải xuống các tệp đính kèm và bài tập về máy để thực hành</p>
                            </div>
                        </div>
                        <a href="@Model.Lesson.AttachmentPath" download class="w-full sm:w-auto px-6 py-3 bg-secondary text-on-secondary rounded-full font-bold shadow-md hover:brightness-110 active:translate-y-0.5 transition-all text-center flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-sm">download_for_offline</span>
                            Tải tài liệu về máy
                        </a>
                    </div>
                }
            </div>


            <!-- ================= DISCUSSION BOARD SECTION ================= -->
            <div class="bg-surface-container-lowest rounded-xl layer-1-card p-6 md:p-10 mb-8 relative overflow-hidden">
                <div class="absolute top-0 left-0 right-0 h-2 bg-gradient-to-r from-secondary to-primary-fixed-dim"></div>
                
                <!-- Feedback Alerts -->
                @if (TempData["CommentError"] != null)
                {
                    <div class="mb-6 p-4 bg-error-container/20 border border-error/20 text-error font-bold text-sm rounded-xl flex items-center gap-2">
                        <span class="material-symbols-outlined">error</span>
                        @TempData["CommentError"]
                    </div>
                }
                @if (TempData["CommentSuccess"] != null)
                {
                    <div class="mb-6 p-4 bg-secondary-container/20 border border-secondary/20 text-on-secondary-container font-bold text-sm rounded-xl flex items-center gap-2">
                        <span class="material-symbols-outlined">check_circle</span>
                        @TempData["CommentSuccess"]
                    </div>
                }

                @if (Model.Lesson.CommentsEnabled == false)
                {
                    <!-- Comments Disabled Glass Card -->
                    <div class="py-10 text-center flex flex-col items-center justify-center">
                        <div class="w-16 h-16 rounded-full bg-surface-container flex items-center justify-center text-outline mb-4 border border-outline-variant/30 shadow-inner">
                            <span class="material-symbols-outlined text-3xl">lock</span>
                        </div>
                        <h3 class="font-headline-md text-xl text-on-surface mb-2 font-bold">Diễn đàn thảo luận đã đóng</h3>
                        <p class="text-sm text-on-surface-variant max-w-md">🔒 Diễn đàn thảo luận của bài học này đã được đóng bởi quản trị viên.</p>
                    </div>
                }
                else
                {
                    <!-- Active Comments Section -->
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="font-headline-md text-xl text-on-surface flex items-center gap-2 font-bold">
                            <span class="material-symbols-outlined text-primary">forum</span>
                            Hỏi đáp & Thảo luận
                        </h2>
                        @{
                            var totalComments = Model.Lesson.Comments?.Count ?? 0;
                        }
                        <span class="px-3 py-1 bg-primary-fixed text-primary rounded-full text-xs font-bold border border-primary/20 shadow-xs">
                            @totalComments Thảo luận
                        </span>
                    </div>

                    <!-- New Primary Comment Form -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Comments" asp-action="Create" method="post" class="mb-8 p-5 bg-surface/30 rounded-2xl border border-outline-variant/30 flex flex-col gap-3">
                            <input type="hidden" name="lessonId" value="@Model.Lesson.Id" />
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-[20px] text-primary">create</span>
                                <label class="text-xs font-bold text-on-surface-variant uppercase tracking-wider block">Đặt câu hỏi hoặc chia sẻ ý kiến của bạn</label>
                            </div>
                            <textarea name="content" rows="3" class="w-full bg-surface-container-lowest border border-outline-variant/40 focus:border-primary/50 focus:ring-0 rounded-xl text-sm p-4 font-medium outline-none resize-none transition-all" placeholder="Nhập nội dung câu hỏi hoặc thảo luận của bạn tại đây..."></textarea>
                            <button type="submit" class="px-5 py-2.5 bg-primary text-on-primary font-label-sm rounded-full border-2 border-primary-container hover:brightness-110 transition-all squishy-btn text-sm shadow-[0_4px_0_0_rgba(0,88,190,0.3)] self-end flex items-center gap-2 font-bold">
                                <span class="material-symbols-outlined text-[18px]">send</span> Gửi thảo luận
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="mb-8 p-6 bg-surface-container rounded-2xl text-center border border-outline-variant/30">
                            <p class="text-sm text-on-surface-variant font-medium mb-3">Vui lòng đăng nhập để tham gia thảo luận bài học này.</p>
                            <a class="px-5 py-2 bg-primary text-on-primary font-label-sm rounded-full border-2 border-primary-container hover:brightness-110 transition-all squishy-btn text-sm inline-flex items-center gap-2 font-bold" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">
                                <span class="material-symbols-outlined text-[18px]">login</span> Đăng nhập ngay
                            </a>
                        </div>
                    }

                    <!-- Nested Comments Thread Container -->
                    <div class="space-y-4">
                        @{
                            var topLevelComments = Model.Lesson.Comments?.Where(c => c.ParentId == null).OrderByDescending(c => c.CreatedAt).ToList() ?? new List<Comment>();
                        }
                        @if (!topLevelComments.Any())
                        {
                            <div class="text-center py-12 text-outline font-medium">
                                <span class="material-symbols-outlined text-4xl block mb-2 opacity-50">forum</span>
                                Chưa có câu hỏi hay thảo luận nào dưới bài học này. Hãy là người đầu tiên thảo luận!
                            </div>
                        }
                        else
                        {
                            <div class="flex flex-col gap-2">
                                @foreach (var comment in topLevelComments)
                                {
                                    <partial name="_CommentThread" model="comment" />
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- JavaScript Toggles Helper -->
            <script>
                function toggleReply(id) {
                    const form = document.getElementById('reply-form-' + id);
                    if (form) {
                        form.classList.toggle('hidden');
                        if (!form.classList.contains('hidden')) {
                            form.querySelector('textarea')?.focus();
                        }
                    }
                }
                function toggleEdit(id) {
                    const form = document.getElementById('edit-form-' + id);
                    const content = document.getElementById('comment-content-' + id);
                    if (form && content) {
                        form.classList.toggle('hidden');
                        content.classList.toggle('hidden');
                        if (!form.classList.contains('hidden')) {
                            form.querySelector('textarea')?.focus();
                        }
                    }
                }
            </script>

        </div>
        <div class="bg-surface-container-lowest border-t-2 border-surface-variant p-4 md:p-6 sticky bottom-0 z-10 w-full">
            <div class="max-w-container-max mx-auto flex justify-between items-center gap-4">
                <a class="px-6 py-3 bg-surface rounded-full text-on-surface-variant border-2 border-outline-variant hover:bg-surface-variant transition-colors flex items-center gap-2 font-label-sm text-label-sm squishy-btn shadow-outline" asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Course.Id">
                    <span class="material-symbols-outlined">arrow_back</span>
                    <span class="hidden md:inline">Back to Course</span>
                </a>
                <button class="flex-1 md:flex-none px-8 py-3 bg-primary text-on-primary rounded-full border-2 border-primary-container hover:bg-primary-container transition-colors flex items-center justify-center gap-2 font-label-sm text-label-sm squishy-btn shadow-primary font-bold">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                    Mark as Complete
                </button>
            </div>
        </div>
    </main>

    <!-- ----TV2---- Discussion functions and javascript -->
    @functions {
        public static string GetTimeAgo(DateTime dateTime)
        {
            var timeSpan = DateTime.Now - dateTime;
            if (timeSpan <= TimeSpan.FromSeconds(60))
            {
                return "Vừa xong";
            }
            if (timeSpan <= TimeSpan.FromMinutes(60))
            {
                return timeSpan.Minutes > 1 ? $"{timeSpan.Minutes} phút trước" : "1 phút trước";
            }
            if (timeSpan <= TimeSpan.FromHours(24))
            {
                return timeSpan.Hours > 1 ? $"{timeSpan.Hours} giờ trước" : "1 giờ trước";
            }
            if (timeSpan <= TimeSpan.FromDays(30))
            {
                return timeSpan.Days > 1 ? $"{timeSpan.Days} ngày trước" : "Hôm qua";
            }
            if (timeSpan <= TimeSpan.FromDays(365))
            {
                return dateTime.ToString("dd/MM");
            }
            return dateTime.ToString("dd/MM/yyyy");
        }
    }

    <script>
        function showReplyForm(commentId) {
            // Ẩn tất cả các form reply khác trước khi mở form hiện tại để tránh rối giao diện
            document.querySelectorAll('[id^="reply-form-"]').forEach(el => el.classList.add('hidden'));
            
            const form = document.getElementById(`reply-form-${commentId}`);
            if (form) {
                form.classList.remove('hidden');
                const textarea = form.querySelector('textarea');
                if (textarea) textarea.focus();
            }
        }

        function hideReplyForm(commentId) {
            const form = document.getElementById(`reply-form-${commentId}`);
            if (form) {
                form.classList.add('hidden');
            }
        }

        function toggleEditForm(commentId) {
            const form = document.getElementById(`edit-form-${commentId}`);
            const contentDiv = document.getElementById(`comment-content-${commentId}`);
            
            if (form && contentDiv) {
                if (form.classList.contains('hidden')) {
                    form.classList.remove('hidden');
                    contentDiv.classList.add('hidden');
                    const textarea = form.querySelector('textarea');
                    if (textarea) textarea.focus();
                } else {
                    form.classList.add('hidden');
                    contentDiv.classList.remove('hidden');
                }
            }
        }

        // Lắng nghe message từ iframe Game (Mock hoặc Unity thực)
        window.addEventListener('message', function (event) {
            const data = event.data;
            if (data && data.type === 'PRACTICE_COMPLETED') {
                // Gửi điểm về API backend
                fetch('/api/practice/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        lessonId: @Model.Lesson.Id,
                        score: data.score
                    })
                })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        alert('Bạn đã nhận được ' + res.score + ' điểm và đã được lưu vào hệ thống!');
                    }
                })
                .catch(err => console.error('Error submitting practice score:', err));
            }
        });
    </script>
</body>
</html>
