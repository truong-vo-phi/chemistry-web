@model ChemistryV1.ViewModels.MissionDetailsViewModel
@{
    Layout = null;
    var currentUserId = User.Identity?.IsAuthenticated == true 
        ? Convert.ToInt32(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value) 
        : 0;
    var currentUserName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Guest";
    var currentUserAvatar = User.FindFirst("AvatarUrl")?.Value ?? "https://via.placeholder.com/150";
    var currentUserRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Student";

    string ToneText(string tone) => tone switch
    {
        "secondary" => "text-secondary",
        "tertiary" => "text-tertiary",
        "outline" => "text-on-surface-variant",
        _ => "text-primary"
    };

    string ToneBg(string tone) => tone switch
    {
        "secondary" => "bg-secondary/10",
        "tertiary" => "bg-tertiary/10",
        "outline" => "bg-surface-container-high",
        _ => "bg-primary/10"
    };

    string ToneBorder(string tone) => tone switch
    {
        "secondary" => "border-secondary/30",
        "tertiary" => "border-tertiary/30",
        "outline" => "border-outline-variant/40",
        _ => "border-primary/30"
    };
}
<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Nhiệm vụ: @Model.Title - ChemLab</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#3b82f6",
                        "secondary": "#10b981",
                        "tertiary": "#f59e0b",
                        "background": "#fdfcf8",
                        "on-background": "#1e293b",
                        "surface": "rgba(255,255,255,0.7)",
                        "surface-variant": "#f1f5f9",
                        "outline": "#cbd5e1",
                        "error": "#ef4444"
                    },
                    borderRadius: {
                        DEFAULT: "1rem",
                        lg: "2rem",
                        xl: "2.5rem",
                        "2xl": "32px",
                        full: "9999px"
                    },
                    spacing: {
                        gutter: "32px",
                        "margin-mobile": "20px",
                        unit: "8px",
                        "margin-desktop": "48px",
                        "container-max": "1300px"
                    },
                    fontFamily: {
                        display: ["Lexend", "sans-serif"],
                        body: ["Lexend", "sans-serif"]
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #FFFDF5; font-family: 'Quicksand', sans-serif; color: #1e293b; overflow-x: hidden; position: relative; }
        body::before { content: ""; position: fixed; top: 0; left: 0; width: 100%; height: 100%; opacity: 0.02; z-index: 100; pointer-events: none; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E"); }
        .blob { position: fixed; width: 600px; height: 600px; background: radial-gradient(circle, rgba(59,130,246,0.06) 0%, transparent 70%); border-radius: 50%; z-index: -1; filter: blur(60px); }
        .glass-card { background: rgba(255,255,255,0.7); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 2px solid rgba(255,255,255,0.9); box-shadow: 0 10px 40px -10px rgba(0,0,0,0.03); border-radius: 32px; }
        .premium-shadow { box-shadow: 0 20px 50px -15px rgba(59,130,246,0.1); }
        .cartoon-card { border: 2px solid rgba(0, 88, 190, 0.08); box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.04); }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .filled-icon { font-variation-settings: 'FILL' 1; }
    </style>
</head>
<body class="min-h-screen">
    <!-- Atmospheric Blobs -->
    <div class="blob -top-48 -left-48"></div>
    <div class="blob top-1/2 -right-48"></div>

    <!-- Sidebar Partial -->
    <partial name="_GamifiedSidebar" />

    <!-- Main Content Area -->
    <main class="lg:ml-72 px-margin-mobile md:px-margin-desktop pt-8 pb-32 max-w-[1200px] mx-auto">
        <!-- Top Navigation Header -->
        <header class="flex justify-between items-center w-full mb-12">
            <div class="flex items-center gap-6">
                <button onclick="openMobileSidebar()" class="p-3 bg-white rounded-2xl border border-slate-100 shadow-sm lg:hidden">
                    <span class="material-symbols-outlined text-primary">menu</span>
                </button>
                <a asp-controller="Profile" asp-action="Index" class="flex items-center gap-2 text-slate-500 hover:text-primary transition-colors font-bold">
                    <span class="material-symbols-outlined">arrow_back</span>
                    Quay lại Tiến trình
                </a>
            </div>
        </header>

        <!-- Dynamic Feedback Alerts -->
        @if (TempData["CommentError"] != null)
        {
            <div class="mb-6 p-4 bg-red-50 border-2 border-red-200 text-red-600 font-bold text-sm rounded-2xl flex items-center gap-2">
                <span class="material-symbols-outlined">error</span>
                @TempData["CommentError"]
            </div>
        }
        @if (TempData["CommentSuccess"] != null)
        {
            <div class="mb-6 p-4 bg-emerald-50 border-2 border-emerald-200 text-emerald-600 font-bold text-sm rounded-2xl flex items-center gap-2">
                <span class="material-symbols-outlined">check_circle</span>
                @TempData["CommentSuccess"]
            </div>
        }

        <!-- Mission Details Main Bento -->
        <div class="glass-card premium-shadow p-8 md:p-12 mb-10 relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-3 bg-gradient-to-r from-primary via-secondary to-tertiary"></div>
            
            <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
                <!-- Mission Icon Badge -->
                <div class="w-24 h-24 rounded-3xl @ToneBg(Model.Tone) border-2 @ToneBorder(Model.Tone) flex items-center justify-center @ToneText(Model.Tone) flex-shrink-0 animate-bounce">
                    <span class="material-symbols-outlined text-5xl filled-icon">@Model.Icon</span>
                </div>

                <!-- Mission Text & Stats -->
                <div class="flex-1 w-full text-center md:text-left">
                    <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 mb-2">
                        <span class="text-xs uppercase font-extrabold tracking-widest px-3.5 py-1 rounded-full @ToneBg(Model.Tone) @ToneText(Model.Tone) border @ToneBorder(Model.Tone)">
                            Nhiệm vụ hệ thống
                        </span>
                        @if (Model.Completed)
                        {
                            <span class="text-xs uppercase font-extrabold tracking-widest px-3.5 py-1 rounded-full bg-emerald-100 text-emerald-600 border border-emerald-200 flex items-center gap-1">
                                <span class="material-symbols-outlined text-xs filled-icon">check_circle</span> Đã hoàn thành
                            </span>
                        }
                    </div>

                    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-800 font-display mb-3">@Model.Title</h1>
                    <p class="text-slate-500 font-medium mb-6">Hoàn thành nhiệm vụ này để nhận phần thưởng danh giá ngay lập tức!</p>

                    <!-- Reward Card -->
                    <div class="inline-flex items-center gap-3 bg-amber-50 border-2 border-amber-200/60 rounded-2xl px-6 py-3.5 mb-6 text-amber-700 font-extrabold">
                        <span class="material-symbols-outlined text-2xl filled-icon">military_tech</span>
                        Phần thưởng: @Model.RewardText
                    </div>

                    <!-- Progress Bar Component -->
                    <div class="w-full bg-slate-100 rounded-full h-4 relative overflow-hidden mb-3.5">
                        <div class="h-full bg-gradient-to-r from-primary to-secondary transition-all duration-700 rounded-full" style="width: @Model.ProgressPercent%"></div>
                    </div>

                    <div class="flex justify-between items-center text-sm font-bold text-slate-600">
                        <span>Tiến độ hiện tại</span>
                        <span class="text-primary">@Model.Current / @Model.Target (@Model.ProgressPercent%)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= SOCIAL / COMMENTS BOARD SECTION ================= -->
        <div class="glass-card premium-shadow p-8 md:p-10 mb-8 relative overflow-hidden">
            <div class="flex justify-between items-center mb-8 border-b-2 border-slate-100 pb-4">
                <h2 class="text-2xl font-bold text-slate-800 font-display flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-3xl">forum</span>
                    Hội thoại nhiệm vụ
                </h2>
                @{
                    var totalComments = Model.Comments.Count;
                }
                <span class="px-4 py-1.5 bg-primary/10 text-primary rounded-full text-xs font-bold border border-primary/20 shadow-sm">
                    @totalComments Bình luận
                </span>
            </div>

            <!-- New Comment Form -->
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Comments" asp-action="Create" method="post" class="mb-10 p-6 bg-slate-50/50 rounded-3xl border-2 border-slate-100 flex flex-col gap-4">
                    <input type="hidden" name="missionId" value="@Model.MissionId" />
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-[20px] text-primary">edit_note</span>
                        <label class="text-xs font-extrabold text-slate-500 uppercase tracking-wider block">Chia sẻ kinh nghiệm hoặc thảo luận về nhiệm vụ này</label>
                    </div>
                    <textarea name="content" rows="3" class="w-full bg-white border-2 border-slate-200 focus:border-primary focus:ring-0 rounded-2xl text-sm p-4 font-medium outline-none resize-none transition-all" placeholder="Nhập nội dung bình luận của bạn tại đây..."></textarea>
                    <button type="submit" class="px-6 py-3 bg-primary text-white font-bold rounded-full hover:brightness-110 transition-all squishy-button self-end flex items-center gap-2 text-sm shadow-md">
                        <span class="material-symbols-outlined text-[18px]">send</span> Gửi bình luận
                    </button>
                </form>
            }
            else
            {
                <div class="mb-10 p-8 bg-slate-50 rounded-3xl text-center border-2 border-slate-100">
                    <p class="text-slate-500 font-bold mb-4">Vui lòng đăng nhập để tham gia thảo luận về nhiệm vụ này.</p>
                    <a class="px-6 py-3 bg-primary text-white font-bold rounded-full hover:brightness-110 transition-all squishy-button inline-flex items-center gap-2" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">
                        <span class="material-symbols-outlined text-[18px]">login</span> Đăng nhập ngay
                    </a>
                </div>
            }

            <!-- Comment Thread Tree Container -->
            <div class="space-y-6">
                @if (!Model.Comments.Any())
                {
                    <div class="text-center py-16 text-slate-400 font-bold">
                        <span class="material-symbols-outlined text-5xl block mb-3 opacity-40">forum</span>
                        Chưa có cuộc thảo luận nào cho nhiệm vụ này. Hãy mở đầu cuộc trò chuyện!
                    </div>
                }
                else
                {
                    <div class="flex flex-col gap-4">
                        @foreach (var comment in Model.Comments)
                        {
                            <partial name="_CommentThread" model="comment" />
                        }
                    </div>
                }
            </div>
        </div>
    </main>

    <!-- Discussion Forms Scripts & Toggles -->
    <script>
        function toggleReply(id) {
            const form = document.getElementById('reply-form-' + id);
            if (form) {
                form.classList.toggle('hidden');
                if (!form.classList.contains('hidden')) {
                    form.querySelector('textarea')?.focus();
                }
            }
        }
        function toggleEdit(id) {
            const form = document.getElementById('edit-form-' + id);
            const content = document.getElementById('comment-content-' + id);
            if (form && content) {
                form.classList.toggle('hidden');
                content.classList.toggle('hidden');
                if (!form.classList.contains('hidden')) {
                    form.querySelector('textarea')?.focus();
                }
            }
        }
    </script>
</body>
</html>
