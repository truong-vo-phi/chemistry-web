@model ChemistryV1.ViewModels.CourseDetailsViewModel
@{
    Layout = null;
    var course = Model.Course;
    var placeholderImage = "https://via.placeholder.com/960x540?text=Course";
    var lessons = Model.Chapters.SelectMany(ch => ch.Lessons.OrderBy(l => l.OrderIndex)).ToList();

    // ----TV2----
    var currentUserId = User.Identity?.IsAuthenticated == true 
        ? Convert.ToInt32(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value) 
        : 0;
    var currentUserName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Guest";
    var currentUserAvatar = User.FindFirst("AvatarUrl")?.Value ?? "https://via.placeholder.com/150";
    var currentUserRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Student";

    var reviews = course.Reviews?.OrderByDescending(r => r.CreatedAt).ToList() ?? new List<Review>();
    var totalReviews = reviews.Count;
    var averageRating = totalReviews > 0 ? Math.Round(reviews.Average(r => r.Rating ?? 0), 1) : 0.0;

    var userReview = User.Identity?.IsAuthenticated == true
        ? reviews.FirstOrDefault(r => r.UserId == currentUserId)
        : null;
    // ----TV2----
}
<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@course.Title | ChemLab 3D</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&amp;family=Quicksand:wght@500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        error: "#ba1a1a",
                        "surface-variant": "#e4e3db",
                        background: "#fbf9f1",
                        surface: "#fbf9f1",
                        "on-tertiary-container": "#fffbff",
                        "on-tertiary": "#ffffff",
                        "on-secondary-container": "#00714d",
                        "on-surface": "#1b1c17",
                        "surface-container-lowest": "#ffffff",
                        "surface-bright": "#fbf9f1",
                        secondary: "#006c49",
                        "surface-tint": "#005ac2",
                        "on-tertiary-fixed-variant": "#653e00",
                        "on-secondary-fixed-variant": "#005236",
                        outline: "#727785",
                        "primary-fixed-dim": "#adc6ff",
                        "surface-container-highest": "#e4e3db",
                        "surface-container-high": "#eae8e0",
                        "error-container": "#ffdad6",
                        "on-secondary-fixed": "#002113",
                        "on-secondary": "#ffffff",
                        "primary-fixed": "#d8e2ff",
                        "outline-variant": "#c2c6d6",
                        "on-primary-fixed": "#001a42",
                        "on-primary-container": "#fefcff",
                        "on-primary": "#ffffff",
                        "inverse-primary": "#adc6ff",
                        "on-error-container": "#93000a",
                        "on-background": "#1b1c17",
                        "surface-container-low": "#f5f4ec",
                        "inverse-surface": "#30312c",
                        "surface-container": "#f0eee6",
                        "secondary-fixed-dim": "#4edea3",
                        "on-primary-fixed-variant": "#004395",
                        "on-error": "#ffffff",
                        "surface-dim": "#dcdad2",
                        primary: "#0058be",
                        "secondary-fixed": "#6ffbbe",
                        "tertiary-container": "#a36700",
                        "on-tertiary-fixed": "#2a1700",
                        "on-surface-variant": "#424754",
                        "inverse-on-surface": "#f3f1e9",
                        "primary-container": "#2170e4",
                        "tertiary-fixed-dim": "#ffb95f",
                        "tertiary-fixed": "#ffddb8",
                        "secondary-container": "#6cf8bb",
                        tertiary: "#825100"
                    },
                    borderRadius: {
                        DEFAULT: "1rem",
                        lg: "2rem",
                        xl: "3rem",
                        full: "9999px"
                    },
                    spacing: {
                        gutter: "24px",
                        "margin-mobile": "16px",
                        unit: "8px",
                        "container-max": "1200px",
                        "margin-desktop": "48px"
                    },
                    fontFamily: {
                        "label-sm": ["Lexend"],
                        "display-lg-mobile": ["Lexend"],
                        "body-md": ["Quicksand"],
                        "body-lg": ["Quicksand"],
                        "display-lg": ["Lexend"],
                        "headline-md": ["Lexend"]
                    },
                    fontSize: {
                        "label-sm": ["14px", { lineHeight: "1.2", fontWeight: "600" }],
                        "display-lg-mobile": ["32px", { lineHeight: "1.2", fontWeight: "700" }],
                        "body-md": ["16px", { lineHeight: "1.6", fontWeight: "500" }],
                        "body-lg": ["18px", { lineHeight: "1.6", fontWeight: "500" }],
                        "display-lg": ["48px", { lineHeight: "1.2", letterSpacing: "-0.02em", fontWeight: "700" }],
                        "headline-md": ["24px", { lineHeight: "1.4", fontWeight: "600" }]
                    }
                }
            }
        };
    </script>
    <style>
        body {
            background-color: #fbf9f1;
            -webkit-font-smoothing: antialiased;
        }
        .squishy-btn {
            box-shadow: 0 4px 0 0 rgba(0, 0, 0, 0.1);
            transition: all 0.1s ease-in-out;
        }
        .squishy-btn:active {
            transform: translateY(2px);
            box-shadow: 0 0 0 0 rgba(0, 0, 0, 0.1);
        }
        .magical-float {
            animation: float 6s ease-in-out infinite;
        }
        @@keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        .card-border {
            border-width: 2px;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="text-on-background font-body-md overflow-x-hidden">
    <header class="bg-background w-full top-0 sticky z-50 border-b-2 border-surface-variant shadow-sm">
        <div class="flex justify-between items-center px-gutter py-4 w-full max-w-container-max mx-auto">
            <div class="flex items-center gap-4">
                <span class="font-display-lg text-display-lg-mobile md:text-display-lg text-primary">ChemLab 3D</span>
            </div>
            <div class="hidden md:flex items-center gap-gutter">
                <nav class="flex gap-6">
                    @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Teacher")))
                    {
                        <a class="text-on-surface-variant hover:bg-surface-container-high transition-colors px-3 py-2 rounded-lg font-label-sm" asp-controller="Dashboard" asp-action="Index">Laboratory</a>
                        <a class="text-on-surface-variant hover:bg-surface-container-high transition-colors px-3 py-2 rounded-lg font-label-sm" asp-controller="TeacherCourses" asp-action="Index">Spellbook</a>
                    }
                    <a class="text-primary font-bold font-label-sm" asp-controller="Courses" asp-action="Library">Academy</a>
                </nav>
                <div class="flex items-center gap-4">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="flex items-center gap-3">
                            <img alt="User profile avatar" class="w-10 h-10 rounded-full border-2 border-primary object-cover" src="@User.FindFirst("AvatarUrl")?.Value" />
                            <div class="text-left hidden lg:block">
                                <p class="text-xs font-bold text-on-surface leading-tight">@User.Identity.Name</p>
                                <p class="text-[9px] uppercase font-bold text-primary tracking-wider leading-none">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</p>
                            </div>
                            <a class="text-xs font-bold text-error hover:bg-error-container/20 px-3 py-1.5 rounded-full border border-error/20 transition-all ml-2" asp-controller="Account" asp-action="Logout">Đăng xuất</a>
                        </div>
                    }
                    else
                    {
                        <a class="bg-primary text-on-primary px-6 py-2 rounded-full font-bold squishy-btn" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                    }
                </div>
            </div>
        </div>
    </header>
    <div class="flex flex-col md:flex-row max-w-container-max mx-auto min-h-screen">
        <aside class="hidden md:flex flex-col h-screen w-64 bg-surface-container-low border-r-2 border-secondary-container p-unit gap-gutter sticky top-[80px]">
            <div class="p-4 flex flex-col gap-2">
                <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center text-white font-bold mb-2">CL</div>
                <h2 class="font-headline-md text-headline-md text-primary">Academy Menu</h2>
                <p class="font-label-sm text-label-sm text-on-surface-variant opacity-70">Magical Learning</p>
            </div>
            <nav class="flex flex-col gap-2 px-2">
                @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Teacher")))
                {
                    <a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-secondary-fixed-dim/20 rounded-lg transition-transform active:scale-95" asp-controller="Dashboard" asp-action="Index">
                        <span class="material-symbols-outlined">science</span>
                        <span class="font-label-sm">Laboratory</span>
                    </a>
                    <a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-secondary-fixed-dim/20 rounded-lg transition-transform active:scale-95" asp-controller="TeacherCourses" asp-action="Index">
                        <span class="material-symbols-outlined">auto_stories</span>
                        <span class="font-label-sm">Spellbook</span>
                    </a>
                }
                <a class="flex items-center gap-3 px-4 py-3 bg-secondary-container text-on-secondary-container rounded-lg font-bold transition-transform active:scale-95" asp-controller="Courses" asp-action="Library">
                    <span class="material-symbols-outlined">school</span>
                    <span class="font-label-sm">Academy</span>
                </a>
                @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Teacher")))
                {
                    <a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-secondary-fixed-dim/20 rounded-lg transition-transform active:scale-95" asp-controller="Categories" asp-action="Index">
                        <span class="material-symbols-outlined">menu_book</span>
                        <span class="font-label-sm">Categories</span>
                    </a>
                }
            </nav>
            <div class="mt-auto border-t border-surface-variant pt-4 px-4 flex flex-col gap-2 mb-8">
                <a class="flex items-center gap-3 text-on-surface-variant font-label-sm" href="#"><span class="material-symbols-outlined">settings</span> Settings</a>
                <a class="flex items-center gap-3 text-on-surface-variant font-label-sm" href="#"><span class="material-symbols-outlined">help</span> Support</a>
            </div>
        </aside>
        <main class="flex-1 px-margin-mobile md:px-margin-desktop py-gutter">
            <section class="relative overflow-hidden rounded-xl bg-primary-container text-on-primary-container p-8 md:p-12 mb-gutter shadow-md magical-float">
                <div class="relative z-10 max-w-2xl">
                    <div class="inline-flex items-center gap-2 bg-secondary-container text-on-secondary-container px-4 py-1 rounded-full mb-6 font-label-sm">
                        <span class="material-symbols-outlined text-sm">stars</span>
                        <span>@(course.CourseCategories.FirstOrDefault()?.Category?.Name ?? "Chemistry")</span>
                    </div>
                    <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg mb-4">@course.Title</h1>
                    <p class="font-body-lg text-body-lg mb-8 opacity-90">@course.Description</p>
                    <div class="flex flex-col sm:flex-row items-center gap-6">
                        <form method="post" asp-action="Enroll" asp-route-id="@course.Id">
                            @Html.AntiForgeryToken()
                            <button class="squishy-btn w-full sm:w-auto bg-secondary-container text-on-secondary-container px-8 py-4 rounded-full font-headline-md border-2 border-secondary font-bold flex items-center justify-center gap-2" type="submit">
                                <span>Enroll Now</span>
                                <span class="material-symbols-outlined">bolt</span>
                            </button>
                        </form>
                        <div class="flex items-center gap-3">
                            <img alt="Instructor avatar" class="w-12 h-12 rounded-full border-2 border-white shadow-sm" src="@(course.Teacher?.AvatarUrl ?? "https://via.placeholder.com/64")" />
                            <div>
                                <p class="font-label-sm leading-none">Instructor</p>
                                <p class="font-bold">@course.Teacher?.FullName</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="absolute top-1/2 right-0 -translate-y-1/2 opacity-20 pointer-events-none transform scale-150">
                    <span class="material-symbols-outlined text-[300px]" style="font-variation-settings: 'FILL' 1;">experiment</span>
                </div>
            </section>
            @if (TempData["EnrollError"] != null)
            {
                <div class="mb-6 rounded-lg bg-error-container p-4 text-on-error-container font-bold">
                    @TempData["EnrollError"]
                </div>
            }
            @if (TempData["EnrollSuccess"] != null)
            {
                <div class="mb-6 rounded-lg bg-secondary-container p-4 text-on-secondary-container font-bold">
                    @TempData["EnrollSuccess"]
                </div>
            }
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-gutter">
                <div class="lg:col-span-2 flex flex-col gap-gutter">
                    <div class="bg-white p-8 rounded-lg card-border border-secondary-container/30 shadow-sm">
                        <h3 class="font-headline-md text-headline-md mb-4 text-secondary flex items-center gap-2">
                            <span class="material-symbols-outlined">menu_book</span>
                            About the Course
                        </h3>
                        <div class="space-y-4 font-body-md text-on-surface-variant">
                            <p>@course.Description</p>
                        </div>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8">
                            <div class="bg-surface-container-low p-4 rounded-lg text-center">
                                <span class="material-symbols-outlined text-primary mb-2">schedule</span>
                                <p class="font-label-sm text-xs opacity-70">Chapters</p>
                                <p class="font-bold">@Model.Chapters.Count()</p>
                            </div>
                            <div class="bg-surface-container-low p-4 rounded-lg text-center">
                                <span class="material-symbols-outlined text-primary mb-2">bar_chart</span>
                                <p class="font-label-sm text-xs opacity-70">Lessons</p>
                                <p class="font-bold">@Model.TotalLessons</p>
                            </div>
                            <div class="bg-surface-container-low p-4 rounded-lg text-center">
                                <span class="material-symbols-outlined text-primary mb-2">videocam</span>
                                <p class="font-label-sm text-xs opacity-70">Type</p>
                                <p class="font-bold">Theory</p>
                            </div>
                            <div class="bg-surface-container-low p-4 rounded-lg text-center">
                                <span class="material-symbols-outlined text-primary mb-2">verified</span>
                                <p class="font-label-sm text-xs opacity-70">Certificate</p>
                                <p class="font-bold">Yes</p>
                            </div>
                        </div>
                    </div>
                    <div class="bg-white p-8 rounded-lg card-border border-primary-container/30 shadow-sm">
                        <div class="flex justify-between items-center mb-6">
                            <h3 class="font-headline-md text-headline-md text-primary flex items-center gap-2">
                                <span class="material-symbols-outlined">list_alt</span>
                                Learning Path
                            </h3>
                            <span class="bg-primary-container/10 text-primary px-3 py-1 rounded-full text-sm font-bold">@Model.TotalLessons Lessons</span>
                        </div>
                        <div class="space-y-4">
                            @{
                                var studentId = User.Identity?.IsAuthenticated == true ? int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0") : 0;
                                var isEnrolled = course.CourseEnrollments?.Any(e => e.StudentId == studentId) == true;
                                var index = 1;
                                foreach (var lesson in lessons)
                                {
                                    var locked = !isEnrolled && lesson.IsPreview != true;
                                    if (locked)
                                    {
                                        <div class="group opacity-75">
                                            <div class="flex items-center gap-4 p-4 rounded-lg border-2 border-transparent">
                                                <div class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant font-bold">@index.ToString("00")</div>
                                                <div class="flex-1">
                                                    <h4 class="font-bold text-on-surface-variant">@lesson.Title</h4>
                                                    <p class="text-sm opacity-60">@lesson.ContentType</p>
                                                </div>
                                                <span class="material-symbols-outlined text-on-surface-variant">lock</span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <a class="group block" asp-controller="Lessons" asp-action="Details" asp-route-id="@lesson.Id">
                                            <div class="flex items-center gap-4 p-4 rounded-lg hover:bg-surface-container-low transition-colors border-2 border-transparent hover:border-surface-variant">
                                                <div class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center text-on-secondary-container font-bold">@index.ToString("00")</div>
                                                <div class="flex-1">
                                                    <h4 class="font-bold">@lesson.Title</h4>
                                                    <p class="text-sm opacity-60">@lesson.ContentType</p>
                                                </div>
                                                <span class="material-symbols-outlined text-primary group-hover:translate-x-1 transition-transform">chevron_right</span>
                                            </div>
                                        </a>
                                    }
                                    index++;
                                }
                            }
                        </div>
                    </div>

                    <!-- ----TV2---- Course Reviews & Ratings Section -->
                    <div class="bg-white p-8 rounded-lg card-border border-primary-container/30 shadow-sm mt-8">
                        <div class="flex flex-col gap-6 mb-8">
                            <h3 class="font-headline-md text-headline-md text-primary flex items-center gap-2 m-0">
                                <span class="material-symbols-outlined font-bold text-[28px]">star</span>
                                Đánh giá & Nhận xét (@totalReviews)
                            </h3>
                            
                            @if (TempData["ReviewError"] != null)
                            {
                                <div class="bg-error-container text-on-error-container p-4 rounded-xl border border-error/20 flex items-center gap-2">
                                    <span class="material-symbols-outlined">error</span>
                                    <span class="font-body-md text-sm">@TempData["ReviewError"]</span>
                                </div>
                            }
                            @if (TempData["ReviewSuccess"] != null)
                            {
                                <div class="bg-secondary-container text-on-secondary-container p-4 rounded-xl border border-secondary/20 flex items-center gap-2">
                                    <span class="material-symbols-outlined">check_circle</span>
                                    <span class="font-body-md text-sm">@TempData["ReviewSuccess"]</span>
                                </div>
                            }

                            <!-- Stats Overview Grid -->
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 bg-surface-container-low p-6 rounded-2xl border border-surface-variant/30">
                                <!-- Left Big Score -->
                                <div class="flex flex-col items-center justify-center text-center md:border-r border-surface-variant/50 pr-0 md:pr-6">
                                    <span class="text-5xl font-extrabold text-primary">@averageRating</span>
                                    <div class="flex items-center gap-1 my-2 text-amber-500">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= Math.Round(averageRating))
                                            {
                                                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
                                            }
                                            else
                                            {
                                                <span class="material-symbols-outlined">star</span>
                                            }
                                        }
                                    </div>
                                    <span class="text-xs font-semibold text-on-surface-variant opacity-75">Điểm trung bình khóa học</span>
                                </div>
                                
                                <!-- Middle Progress bars -->
                                @{
                                    var ratingCounts = new int[6];
                                    foreach (var r in reviews)
                                    {
                                        if (r.Rating.HasValue && r.Rating.Value >= 1 && r.Rating.Value <= 5)
                                        {
                                            ratingCounts[r.Rating.Value]++;
                                        }
                                    }
                                    var percent5 = totalReviews > 0 ? (ratingCounts[5] * 100 / totalReviews) : 0;
                                    var percent4 = totalReviews > 0 ? (ratingCounts[4] * 100 / totalReviews) : 0;
                                    var percent3 = totalReviews > 0 ? (ratingCounts[3] * 100 / totalReviews) : 0;
                                    var percent2 = totalReviews > 0 ? (ratingCounts[2] * 100 / totalReviews) : 0;
                                    var percent1 = totalReviews > 0 ? (ratingCounts[1] * 100 / totalReviews) : 0;
                                }
                                <div class="col-span-2 flex flex-col gap-2 justify-center pl-0 md:pl-2">
                                    <!-- Row 5 star -->
                                    <div class="flex items-center gap-3">
                                        <span class="text-xs font-bold text-on-surface w-10 text-right">5 sao</span>
                                        <div class="flex-grow h-2.5 bg-surface-container rounded-full overflow-hidden">
                                            <div class="h-full bg-amber-500 rounded-full" style="width: @(percent5)%"></div>
                                        </div>
                                        <span class="text-xs font-semibold text-on-surface-variant w-8">@percent5%</span>
                                    </div>
                                    <!-- Row 4 star -->
                                    <div class="flex items-center gap-3">
                                        <span class="text-xs font-bold text-on-surface w-10 text-right">4 sao</span>
                                        <div class="flex-grow h-2.5 bg-surface-container rounded-full overflow-hidden">
                                            <div class="h-full bg-amber-500 rounded-full" style="width: @(percent4)%"></div>
                                        </div>
                                        <span class="text-xs font-semibold text-on-surface-variant w-8">@percent4%</span>
                                    </div>
                                    <!-- Row 3 star -->
                                    <div class="flex items-center gap-3">
                                        <span class="text-xs font-bold text-on-surface w-10 text-right">3 sao</span>
                                        <div class="flex-grow h-2.5 bg-surface-container rounded-full overflow-hidden">
                                            <div class="h-full bg-amber-500 rounded-full" style="width: @(percent3)%"></div>
                                        </div>
                                        <span class="text-xs font-semibold text-on-surface-variant w-8">@percent3%</span>
                                    </div>
                                    <!-- Row 2 star -->
                                    <div class="flex items-center gap-3">
                                        <span class="text-xs font-bold text-on-surface w-10 text-right">2 sao</span>
                                        <div class="flex-grow h-2.5 bg-surface-container rounded-full overflow-hidden">
                                            <div class="h-full bg-amber-500 rounded-full" style="width: @(percent2)%"></div>
                                        </div>
                                        <span class="text-xs font-semibold text-on-surface-variant w-8">@percent2%</span>
                                    </div>
                                    <!-- Row 1 star -->
                                    <div class="flex items-center gap-3">
                                        <span class="text-xs font-bold text-on-surface w-10 text-right">1 sao</span>
                                        <div class="flex-grow h-2.5 bg-surface-container rounded-full overflow-hidden">
                                            <div class="h-full bg-amber-500 rounded-full" style="width: @(percent1)%"></div>
                                        </div>
                                        <span class="text-xs font-semibold text-on-surface-variant w-8">@percent1%</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            if (isEnrolled)
                            {
                                if (userReview == null)
                                {
                                    <!-- Student Form to Add a Review -->
                                    <form asp-controller="Courses" asp-action="AddOrUpdateReview" method="post" class="bg-surface-container-low p-6 rounded-2xl border-2 border-dashed border-primary/20 mb-8">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="courseId" value="@course.Id" />
                                        <input type="hidden" name="rating" id="review-rating-value" value="5" />
                                        
                                        <h4 class="font-bold text-primary mb-2 text-sm flex items-center gap-1.5">
                                            <span class="material-symbols-outlined text-lg">rate_review</span>
                                            Gửi nhận xét & đánh giá của bạn
                                        </h4>
                                        <p class="text-xs text-on-surface-variant mb-4">Chia sẻ trải nghiệm học tập của bạn để giúp các học viên khác lựa chọn khóa học.</p>
                                        
                                        <!-- Interactive Star selector -->
                                        <div class="flex items-center gap-2 mb-4">
                                            <span class="text-xs font-bold text-on-surface">Chọn số sao:</span>
                                            <div class="flex items-center gap-1 text-amber-500" id="star-selector-container">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <button type="button" class="star-btn cursor-pointer transition-transform hover:scale-125 focus:outline-none" data-value="@i">
                                                        <span class="material-symbols-outlined" style="font-size: 32px; font-variation-settings: 'FILL' 1;">star</span>
                                                    </button>
                                                }
                                            </div>
                                            <span class="text-sm font-bold text-amber-500 ml-2" id="star-selector-label">Tuyệt vời (5/5)</span>
                                        </div>
                                        
                                        <textarea class="w-full bg-white border-2 border-outline-variant rounded-xl p-4 font-body-md text-body-md focus:border-primary focus:ring-4 focus:ring-primary/20 transition-all placeholder:text-on-surface-variant/60 resize-none" name="content" placeholder="Khóa học này thế nào? Giảng viên giảng dạy có dễ hiểu không?..." rows="3" required></textarea>
                                        
                                        <div class="flex justify-end mt-3">
                                            <button type="submit" class="bg-primary text-on-primary font-label-sm text-label-sm rounded-full px-6 py-2.5 border-2 border-surface-tint shadow-md hover:brightness-110 active:translate-y-0.5 transition-all font-bold squishy-btn">
                                                Gửi đánh giá
                                            </button>
                                        </div>
                                    </form>
                                }
                            }
                            else
                            {
                                <!-- Student is not enrolled -->
                                <div class="bg-surface-container-low p-6 rounded-2xl border-2 border-dashed border-outline-variant text-center mb-8 flex flex-col items-center justify-center">
                                    <span class="material-symbols-outlined text-primary text-3xl mb-2">lock</span>
                                    <h4 class="font-bold text-sm text-on-surface mb-1">Chưa thể đánh giá khóa học</h4>
                                    <p class="text-xs text-on-surface-variant max-w-md">Bạn cần đăng ký khóa học này để có thể gửi đánh giá và nhận xét.</p>
                                </div>
                            }
                        }
                        else
                        {
                            <!-- Not logged in -->
                            <div class="bg-surface-container-low p-6 rounded-2xl border-2 border-dashed border-outline-variant text-center mb-8 flex flex-col items-center justify-center">
                                <span class="material-symbols-outlined text-primary text-3xl mb-2">vpn_key</span>
                                <h4 class="font-bold text-sm text-on-surface mb-1">Đăng nhập để đánh giá</h4>
                                <p class="text-xs text-on-surface-variant mb-3">Vui lòng đăng nhập tài khoản học viên để viết nhận xét cho khóa học này.</p>
                                <a href="/Account/Login?returnUrl=@Context.Request.Path" class="bg-primary text-on-primary text-xs rounded-full px-5 py-2 font-bold hover:brightness-110 active:translate-y-0.5 transition-all">Đăng nhập ngay</a>
                            </div>
                        }

                        <!-- Review list -->
                        <div class="space-y-6">
                            @if (userReview != null)
                            {
                                <!-- Highlighted User Review at the top -->
                                <div class="bg-primary/5 p-6 rounded-2xl border-2 border-primary/30 relative">
                                    <span class="absolute top-4 right-4 bg-primary text-on-primary text-[10px] px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider">Đánh giá của bạn</span>
                                    <div class="flex gap-4">
                                        <img alt="@currentUserName" class="w-12 h-12 rounded-full border-2 border-primary object-cover shrink-0 shadow-sm" src="@currentUserAvatar" />
                                        <div class="flex-grow">
                                            <div class="flex items-center gap-2 mb-1">
                                                <span class="font-bold text-on-surface text-sm">@currentUserName</span>
                                                <span class="text-xs text-on-surface-variant">@(userReview.CreatedAt.HasValue ? GetTimeAgo(userReview.CreatedAt.Value) : "")</span>
                                            </div>
                                            
                                            <!-- Star rating -->
                                            <div class="flex items-center gap-1 text-amber-500 mb-2">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= (userReview.Rating ?? 0))
                                                    {
                                                        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="material-symbols-outlined text-sm">star</span>
                                                    }
                                                }
                                                <span class="text-xs font-bold text-amber-500 ml-1">(@userReview.Rating/5)</span>
                                            </div>
                                            
                                            <!-- Review Content -->
                                            <p class="font-body-md text-sm text-on-surface m-0 whitespace-pre-line" id="my-review-content">@userReview.Content</p>

                                            <!-- Edit Review Form (Hidden by default) -->
                                            <form id="edit-review-form" class="hidden mt-4 bg-white p-4 rounded-xl border border-outline-variant" asp-controller="Courses" asp-action="AddOrUpdateReview" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="courseId" value="@course.Id" />
                                                <input type="hidden" name="rating" id="edit-review-rating-value" value="@userReview.Rating" />
                                                
                                                <div class="flex items-center gap-2 mb-3">
                                                    <span class="text-xs font-bold text-on-surface">Đánh giá lại:</span>
                                                    <div class="flex items-center gap-1 text-amber-500" id="edit-star-selector-container">
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            var isFilled = i <= (userReview.Rating ?? 0);
                                                            <button type="button" class="edit-star-btn cursor-pointer transition-transform hover:scale-125 focus:outline-none" data-value="@i">
                                                                <span class="material-symbols-outlined" style="font-size: 26px; font-variation-settings: 'FILL' @(isFilled ? "1" : "0");">star</span>
                                                            </button>
                                                        }
                                                    </div>
                                                    <span class="text-xs font-bold text-amber-500 ml-2" id="edit-star-selector-label">
                                                        @{
                                                            var labels = new[] { "", "Rất tệ", "Tệ", "Bình thường", "Tốt", "Tuyệt vời" };
                                                            var lbl = userReview.Rating.HasValue && userReview.Rating.Value >= 1 && userReview.Rating.Value <= 5 ? labels[userReview.Rating.Value] : "Tuyệt vời";
                                                            @($"{lbl} ({userReview.Rating}/5)")
                                                        }
                                                    </span>
                                                </div>
                                                
                                                <textarea class="w-full bg-surface-container border-2 border-outline-variant rounded-xl p-3 font-body-md text-body-md focus:border-primary focus:ring-4 focus:ring-primary/20 transition-all resize-none" name="content" rows="3" required>@userReview.Content</textarea>
                                                
                                                <div class="flex gap-2 justify-end mt-2">
                                                    <button type="button" class="px-4 py-1.5 border border-outline-variant hover:bg-surface-variant text-xs rounded-full font-bold transition-all" onclick="toggleEditReviewForm()">Hủy</button>
                                                    <button type="submit" class="bg-primary text-on-primary text-xs rounded-full px-5 py-1.5 border border-surface-tint shadow-sm hover:brightness-110 transition-all font-bold">Lưu thay đổi</button>
                                                </div>
                                            </form>

                                            <!-- Action Buttons -->
                                            <div class="flex items-center gap-3 mt-3">
                                                <button class="flex items-center gap-1 text-on-surface-variant hover:text-secondary transition-colors text-xs font-label-sm" onclick="toggleEditReviewForm()">
                                                    <span class="material-symbols-outlined text-[16px]">edit</span> Chỉnh sửa
                                                </button>
                                                <form asp-controller="Courses" asp-action="DeleteReview" method="post" class="inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa nhận xét và đánh giá của mình?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="reviewId" value="@userReview.Id" />
                                                    <button type="submit" class="flex items-center gap-1 text-on-surface-variant hover:text-error transition-colors text-xs font-label-sm">
                                                        <span class="material-symbols-outlined text-[16px]">delete</span> Xóa
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- List of other student reviews -->
                            @{
                                var otherReviews = reviews.Where(r => r.UserId != currentUserId).ToList();
                            }

                            @if (!otherReviews.Any() && userReview == null)
                            {
                                <p class="font-body-md text-on-surface-variant text-center py-8 m-0 opacity-70">Khóa học này chưa có nhận xét nào. Hãy là người đầu tiên cảm nhận!</p>
                            }
                            else
                            {
                                foreach (var item in otherReviews)
                                {
                                    var itemAuthorName = item.User?.FullName ?? item.User?.Username ?? "Học viên ẩn danh";
                                    var itemAuthorAvatar = item.User?.AvatarUrl ?? "https://via.placeholder.com/150";
                                    var itemAuthorRole = item.User?.Role ?? "Student";
                                    var itemTimeAgo = item.CreatedAt.HasValue ? GetTimeAgo(item.CreatedAt.Value) : "";

                                    <div class="flex gap-4 border-b border-surface-variant/30 pb-6" id="review-@item.Id">
                                        <img alt="@itemAuthorName" class="w-12 h-12 rounded-full border border-surface-variant object-cover shrink-0 shadow-sm" src="@itemAuthorAvatar" />
                                        <div class="flex-grow">
                                            <div class="flex items-center justify-between gap-2">
                                                <div class="flex items-center gap-2 mb-1">
                                                    <span class="font-bold text-on-surface text-sm">@itemAuthorName</span>
                                                    @if (itemAuthorRole == "Teacher" || itemAuthorRole == "Admin")
                                                    {
                                                        <span class="bg-primary/10 text-primary text-[9px] px-2 py-0.5 rounded-full font-bold">Giảng viên</span>
                                                    }
                                                    <span class="text-xs text-on-surface-variant opacity-75">@itemTimeAgo</span>
                                                </div>
                                                
                                                <!-- Teacher/Admin moderation delete button -->
                                                @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Teacher") || User.IsInRole("Admin")))
                                                {
                                                    <form asp-controller="Courses" asp-action="DeleteReview" method="post" class="inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa nhận xét của học viên này?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="reviewId" value="@item.Id" />
                                                        <button type="submit" class="flex items-center gap-1 text-on-surface-variant hover:text-error transition-colors text-xs font-label-sm border border-error/20 px-2 py-1 rounded-full hover:bg-error-container/20">
                                                            <span class="material-symbols-outlined text-[14px]">delete</span> Xóa (GV)
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                            
                                            <!-- Star rating -->
                                            <div class="flex items-center gap-1 text-amber-500 mb-2">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= (item.Rating ?? 0))
                                                    {
                                                        <span class="material-symbols-outlined text-xs" style="font-variation-settings: 'FILL' 1;">star</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="material-symbols-outlined text-xs">star</span>
                                                    }
                                                }
                                                <span class="text-xs font-bold text-amber-500 ml-1">(@item.Rating/5)</span>
                                            </div>
                                            
                                            <!-- Content -->
                                            <p class="font-body-md text-sm text-on-surface m-0 whitespace-pre-line">@item.Content</p>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    <!-- ----TV2---- -->

                </div>
                <div class="lg:col-span-1">
                    <div class="sticky top-[104px] flex flex-col gap-gutter">
                        <div class="bg-white rounded-lg overflow-hidden card-border border-primary-container shadow-lg">
                            <div class="aspect-video relative bg-surface-container-highest flex items-center justify-center">
                                <img class="w-full h-full object-cover" alt="Course preview" src="@(course.ThumbnailUrl ?? placeholderImage)" />
                                <div class="absolute inset-0 flex items-center justify-center bg-black/20">
                                    <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center text-primary shadow-xl">
                                        <span class="material-symbols-outlined text-4xl" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
                                    </div>
                                </div>
                            </div>
                            <div class="p-6">
                                <div class="flex items-baseline gap-2 mb-4">
                                    <span class="text-3xl font-bold text-on-surface">FREE</span>
                                    <span class="text-on-surface-variant line-through text-sm">Was $49.00</span>
                                </div>
                                @if (isEnrolled)
                                {
                                    var firstLesson = lessons.FirstOrDefault();
                                    if (firstLesson != null)
                                    {
                                        <a class="squishy-btn w-full bg-emerald-500 hover:bg-emerald-600 text-white py-4 rounded-full font-bold mb-4 flex items-center justify-center gap-2 border-2 border-emerald-600 shadow-md text-center" asp-controller="Lessons" asp-action="Details" asp-route-id="@firstLesson.Id">
                                            <span class="material-symbols-outlined">school</span>
                                            Vào Học Ngay
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="bg-secondary-container text-on-secondary-container py-4 rounded-full font-bold text-center mb-4">
                                            Đã Đăng Ký Khóa Học
                                        </div>
                                    }
                                }
                                else
                                {
                                    <form method="post" asp-action="Enroll" asp-route-id="@course.Id">
                                        @Html.AntiForgeryToken()
                                        <button class="squishy-btn w-full bg-primary text-white py-4 rounded-full font-bold mb-4 flex items-center justify-center gap-2" type="submit">
                                            <span class="material-symbols-outlined">person_add</span>
                                            Enroll for Free
                                        </button>
                                    </form>
                                }
                                <p class="text-center text-xs text-on-surface-variant font-medium">Limited time magic academy scholarship</p>
                                <div class="mt-8 pt-6 border-t border-surface-variant space-y-3">
                                    <p class="font-bold text-sm">This course includes:</p>
                                    <div class="flex items-center gap-3 text-sm text-on-surface-variant">
                                        <span class="material-symbols-outlined text-primary text-lg">science</span>
                                        <span>@Model.TotalLessons Theory Lessons</span>
                                    </div>
                                    <div class="flex items-center gap-3 text-sm text-on-surface-variant">
                                        <span class="material-symbols-outlined text-primary text-lg">download</span>
                                        <span>Downloadable Handouts</span>
                                    </div>
                                    <div class="flex items-center gap-3 text-sm text-on-surface-variant">
                                        <span class="material-symbols-outlined text-primary text-lg">all_inclusive</span>
                                        <span>Full Lifetime Access</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="bg-tertiary-fixed text-on-tertiary-fixed p-6 rounded-lg card-border border-tertiary-container shadow-sm">
                            <h4 class="font-bold mb-2 flex items-center gap-2">
                                <span class="material-symbols-outlined">emoji_events</span>
                                Reward Badge
                            </h4>
                            <p class="text-sm opacity-80 mb-4">Complete this course to unlock the "Master of Solutions" 3D badge for your profile!</p>
                            <div class="flex justify-center py-4">
                                <div class="w-24 h-24 bg-white/30 rounded-full flex items-center justify-center magical-float">
                                    <span class="material-symbols-outlined text-6xl text-tertiary-container">rewarded_ads</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- ----TV2---- Course Reviews Scripts and Functions -->
    @functions {
        public static string GetTimeAgo(DateTime dateTime)
        {
            var timeSpan = DateTime.Now - dateTime;
            if (timeSpan <= TimeSpan.FromSeconds(60))
            {
                return "Vừa xong";
            }
            if (timeSpan <= TimeSpan.FromMinutes(60))
            {
                return timeSpan.Minutes > 1 ? $"{timeSpan.Minutes} phút trước" : "1 phút trước";
            }
            if (timeSpan <= TimeSpan.FromHours(24))
            {
                return timeSpan.Hours > 1 ? $"{timeSpan.Hours} giờ trước" : "1 giờ trước";
            }
            if (timeSpan <= TimeSpan.FromDays(30))
            {
                return timeSpan.Days > 1 ? $"{timeSpan.Days} ngày trước" : "Hôm qua";
            }
            if (timeSpan <= TimeSpan.FromDays(365))
            {
                return dateTime.ToString("dd/MM");
            }
            return dateTime.ToString("dd/MM/yyyy");
        }
    }

    <script>
        // Interactive Star Rating for Adding Review
        const ratingInput = document.getElementById('review-rating-value');
        const starButtons = document.querySelectorAll('#star-selector-container .star-btn');
        const starSelectorLabel = document.getElementById('star-selector-label');
        
        const ratingLabels = {
            1: "Rất tệ (1/5)",
            2: "Tệ (2/5)",
            3: "Bình thường (3/5)",
            4: "Tốt (4/5)",
            5: "Tuyệt vời (5/5)"
        };
        
        if (starButtons.length > 0 && ratingInput) {
            function updateStarsState(ratingValue) {
                starButtons.forEach(btn => {
                    const btnVal = parseInt(btn.getAttribute('data-value'));
                    const icon = btn.querySelector('.material-symbols-outlined');
                    if (icon) {
                        if (btnVal <= ratingValue) {
                            icon.style.fontVariationSettings = "'FILL' 1";
                        } else {
                            icon.style.fontVariationSettings = "'FILL' 0";
                        }
                    }
                });
                if (starSelectorLabel) {
                    starSelectorLabel.textContent = ratingLabels[ratingValue];
                }
            }
            
            starButtons.forEach(btn => {
                btn.addEventListener('click', function() {
                    const val = parseInt(this.getAttribute('data-value'));
                    ratingInput.value = val;
                    updateStarsState(val);
                });
                
                btn.addEventListener('mouseenter', function() {
                    const val = parseInt(this.getAttribute('data-value'));
                    updateStarsState(val);
                });
            });
            
            const starContainer = document.getElementById('star-selector-container');
            if (starContainer) {
                starContainer.addEventListener('mouseleave', function() {
                    updateStarsState(parseInt(ratingInput.value));
                });
            }
        }

        // Interactive Star Rating for Editing Review
        const editRatingInput = document.getElementById('edit-review-rating-value');
        const editStarButtons = document.querySelectorAll('#edit-star-selector-container .edit-star-btn');
        const editStarSelectorLabel = document.getElementById('edit-star-selector-label');
        
        if (editStarButtons.length > 0 && editRatingInput) {
            function updateEditStarsState(ratingValue) {
                editStarButtons.forEach(btn => {
                    const btnVal = parseInt(btn.getAttribute('data-value'));
                    const icon = btn.querySelector('.material-symbols-outlined');
                    if (icon) {
                        if (btnVal <= ratingValue) {
                            icon.style.fontVariationSettings = "'FILL' 1";
                        } else {
                            icon.style.fontVariationSettings = "'FILL' 0";
                        }
                    }
                });
                if (editStarSelectorLabel) {
                    editStarSelectorLabel.textContent = ratingLabels[ratingValue];
                }
            }
            
            editStarButtons.forEach(btn => {
                btn.addEventListener('click', function() {
                    const val = parseInt(this.getAttribute('data-value'));
                    editRatingInput.value = val;
                    updateEditStarsState(val);
                });
                
                btn.addEventListener('mouseenter', function() {
                    const val = parseInt(this.getAttribute('data-value'));
                    updateEditStarsState(val);
                });
            });
            
            const editStarContainer = document.getElementById('edit-star-selector-container');
            if (editStarContainer) {
                editStarContainer.addEventListener('mouseleave', function() {
                    updateEditStarsState(parseInt(editRatingInput.value));
                });
            }
        }

        function toggleEditReviewForm() {
            const form = document.getElementById('edit-review-form');
            const content = document.getElementById('my-review-content');
            if (form && content) {
                if (form.classList.contains('hidden')) {
                    form.classList.remove('hidden');
                    content.classList.add('hidden');
                } else {
                    form.classList.add('hidden');
                    content.classList.remove('hidden');
                }
            }
        }
    </script>
    <!-- ----TV2---- -->
</body>
</html>
