@model ChemistryV1.Models.Chapter
@{
    Layout = null;
}
<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Create Chapter - ChemLab 3D</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;600;700&amp;family=Quicksand:wght@500;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "surface-variant": "#e4e3db",
                        surface: "#fbf9f1",
                        tertiary: "#825100",
                        "surface-container-high": "#eae8e0",
                        "on-background": "#1b1c17",
                        "inverse-on-surface": "#f3f1e9",
                        "surface-tint": "#005ac2",
                        "surface-container-lowest": "#ffffff",
                        "on-surface": "#1b1c17",
                        "on-error": "#ffffff",
                        "tertiary-container": "#a36700",
                        "on-primary": "#ffffff",
                        "surface-container": "#f0eee6",
                        "secondary-container": "#6cf8bb",
                        "on-secondary-container": "#00714d",
                        secondary: "#006c49",
                        "inverse-surface": "#30312c",
                        "primary-fixed-dim": "#adc6ff",
                        "on-primary-container": "#fefcff",
                        "surface-dim": "#dcdad2",
                        "on-secondary-fixed": "#002113",
                        "on-error-container": "#93000a",
                        "secondary-fixed": "#6ffbbe",
                        "on-primary-fixed-variant": "#004395",
                        "primary-fixed": "#d8e2ff",
                        "surface-bright": "#fbf9f1",
                        primary: "#0058be",
                        "on-surface-variant": "#424754",
                        "on-tertiary-fixed-variant": "#653e00",
                        "on-primary-fixed": "#001a42",
                        "inverse-primary": "#adc6ff",
                        "on-secondary-fixed-variant": "#005236",
                        "surface-container-low": "#f5f4ec",
                        "error-container": "#ffdad6",
                        "primary-container": "#2170e4",
                        background: "#fbf9f1",
                        "secondary-fixed-dim": "#4edea3",
                        outline: "#727785",
                        "on-tertiary-fixed": "#2a1700",
                        "tertiary-fixed-dim": "#ffb95f",
                        "on-tertiary-container": "#fffbff",
                        "on-secondary": "#ffffff",
                        "outline-variant": "#c2c6d6",
                        "tertiary-fixed": "#ffddb8",
                        "surface-container-highest": "#e4e3db",
                        "on-tertiary": "#ffffff",
                        error: "#ba1a1a"
                    },
                    borderRadius: {
                        DEFAULT: "1rem",
                        lg: "2rem",
                        xl: "3rem",
                        full: "9999px"
                    },
                    spacing: {
                        "margin-desktop": "48px",
                        gutter: "24px",
                        "margin-mobile": "16px",
                        "container-max": "1200px",
                        unit: "8px"
                    },
                    fontFamily: {
                        "label-sm": ["Lexend"],
                        "display-lg": ["Lexend"],
                        "headline-md": ["Lexend"],
                        "body-md": ["Quicksand"],
                        "display-lg-mobile": ["Lexend"],
                        "body-lg": ["Quicksand"]
                    },
                    fontSize: {
                        "label-sm": ["14px", { lineHeight: "1.2", fontWeight: "600" }],
                        "display-lg": ["48px", { lineHeight: "1.2", letterSpacing: "-0.02em", fontWeight: "700" }],
                        "headline-md": ["24px", { lineHeight: "1.4", fontWeight: "600" }],
                        "body-md": ["16px", { lineHeight: "1.6", fontWeight: "500" }],
                        "display-lg-mobile": ["32px", { lineHeight: "1.2", fontWeight: "700" }],
                        "body-lg": ["18px", { lineHeight: "1.6", fontWeight: "500" }]
                    }
                }
            }
        }
    </script>
    <style>
        .squishy-btn:active {
            transform: translateY(2px);
            box-shadow: none !important;
        }
    </style>
</head>
<body class="bg-surface text-on-surface font-body-md antialiased min-h-screen">
    <header class="fixed top-0 left-0 w-full h-20 bg-surface/90 backdrop-blur-md z-40 border-b-2 border-primary/10 flex justify-between items-center px-margin-mobile md:px-margin-desktop shadow-sm">
        <div class="flex items-center gap-4">
            <a class="w-10 h-10 flex items-center justify-center rounded-full bg-surface-container border-2 border-outline-variant hover:bg-surface-variant transition-colors" asp-controller="TeacherCourses" asp-action="Content" asp-route-id="@Model.CourseId">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <div>
                <h1 class="font-headline-md text-headline-md font-bold text-primary">Chapter Forge</h1>
                <p class="font-label-sm text-label-sm text-on-surface-variant">Adding to @ViewBag.CourseTitle</p>
            </div>
        </div>
    </header>

    <main class="pt-32 pb-12 px-margin-mobile md:px-margin-desktop flex justify-center">
        <div class="w-full max-w-2xl">
            <div class="bg-surface-container-lowest rounded-xl border-2 border-outline-variant shadow-lg p-8 relative overflow-hidden">
                <div class="absolute -top-10 -right-10 w-32 h-32 bg-secondary-container/20 rounded-full blur-2xl"></div>
                
                <form asp-action="Create" method="post" class="space-y-8">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CourseId" />

                    <div class="space-y-2">
                        <label class="block font-label-sm text-label-sm text-primary uppercase tracking-widest" asp-for="Title">Chapter Title</label>
                        <input asp-for="Title" class="w-full bg-surface rounded-full border-2 border-outline-variant px-6 py-4 font-body-lg text-on-surface focus:outline-none focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all shadow-inner" placeholder="e.g., Introduction to Alchemical Processes" required />
                        <span asp-validation-for="Title" class="text-error text-xs"></span>
                    </div>

                    <div class="space-y-2">
                        <label class="block font-label-sm text-label-sm text-primary uppercase tracking-widest" asp-for="OrderIndex">Order Index</label>
                        <input asp-for="OrderIndex" class="w-full bg-surface rounded-full border-2 border-outline-variant px-6 py-4 font-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all shadow-inner" type="number" />
                        <span asp-validation-for="OrderIndex" class="text-error text-xs"></span>
                    </div>

                    <div class="flex gap-4 pt-4">
                        <a class="flex-1 px-8 py-4 rounded-full border-2 border-outline-variant text-on-surface-variant font-bold hover:bg-surface-variant transition-all text-center squishy-btn" asp-controller="TeacherCourses" asp-action="Content" asp-route-id="@Model.CourseId">
                            CANCEL
                        </a>
                        <button type="submit" class="flex-[2] bg-primary text-on-primary border-2 border-primary-container rounded-full px-8 py-4 font-bold shadow-lg hover:brightness-110 transition-all squishy-btn">
                            CREATE CHAPTER
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>
</body>
</html>
