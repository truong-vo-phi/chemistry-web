@model ChemistryV1.Models.Chapter
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create Chapter - ChemLab";
    ViewData["Description"] = "Create a new chapter for the course.";
}

<!-- Breadcrumb -->
<nav class="flex items-center gap-2 mb-6 text-sm text-slate-500">
    <a class="hover:text-primary transition-colors" asp-controller="TeacherCourses" asp-action="Content" asp-route-id="@Model.CourseId">Course Content</a>
    <span class="material-symbols-outlined text-sm opacity-50">chevron_right</span>
    <span class="text-primary font-bold">New Chapter</span>
</nav>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-on-background font-display">Create New Chapter</h1>
    <p class="text-slate-500 mt-1">Adding to @ViewBag.CourseTitle</p>
</div>

<!-- Form Card -->
<div class="glass-card max-w-2xl p-8 relative overflow-hidden">
    <div class="absolute -top-10 -right-10 w-32 h-32 bg-secondary/10 rounded-full blur-2xl"></div>
    
    <form asp-action="Create" method="post" class="space-y-6 relative z-10">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CourseId" />

        <div class="space-y-2">
            <label class="block text-xs font-bold text-primary uppercase tracking-widest" asp-for="Title">Tiêu đề chương</label>
            <input asp-for="Title" class="w-full bg-white border-2 border-slate-200 rounded-2xl px-6 py-4 text-lg text-on-background focus:outline-none focus:border-primary focus:ring-4 focus:ring-primary/5 transition-all" placeholder="ví dụ: Giới thiệu về quy trình giả kim" required />
            <span asp-validation-for="Title" class="text-red-500 text-xs"></span>
        </div>

        <div class="space-y-2">
            <label class="block text-xs font-bold text-primary uppercase tracking-widest" asp-for="OrderIndex">Thứ tự</label>
            <input asp-for="OrderIndex" class="w-full bg-white border-2 border-slate-200 rounded-2xl px-6 py-4 text-md text-on-background focus:outline-none focus:border-primary focus:ring-4 focus:ring-primary/5 transition-all" type="number" />
            <span asp-validation-for="OrderIndex" class="text-red-500 text-xs"></span>
        </div>

        <div class="flex gap-4 pt-4">
            <a class="flex-1 px-8 py-4 rounded-full border-2 border-slate-200 text-slate-600 font-bold hover:bg-slate-100 transition-all text-center" asp-controller="TeacherCourses" asp-action="Content" asp-route-id="@Model.CourseId">
                Hủy
            </a>
            <button type="submit" class="flex-[2] bg-primary text-white border-2 border-primary/30 rounded-full px-8 py-4 font-bold btn-glow">
                Tạo chương
            </button>
        </div>
    </form>
</div>
