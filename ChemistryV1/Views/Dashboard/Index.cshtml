@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tổng quan";
    ViewData["Description"] = "Theo dõi người dùng, khóa học, bài học và lượt đăng ký của Chemistry Lab.";

    var weekly = ViewBag.WeeklyActivity as int[] ?? Array.Empty<int>();
    var maxWeekly = weekly.Any() ? Math.Max(1, weekly.Max()) : 1;
    var completionRate = ViewBag.CompletionRate is int rate ? rate : 0;
    var recentCourses = ViewBag.RecentCourses as List<ChemistryV1.Models.Course> ?? new List<ChemistryV1.Models.Course>();
}

<section class="relative overflow-hidden rounded-3xl border border-primary/20 bg-slate-950/80 p-6 shadow-2xl shadow-primary/10 md:p-8">
    <div class="absolute inset-0">
        <div class="absolute -left-24 top-0 h-64 w-64 rounded-full bg-primary/20 blur-3xl"></div>
        <div class="absolute -right-24 bottom-0 h-64 w-64 rounded-full bg-secondary/15 blur-3xl"></div>
        <div class="absolute inset-0 opacity-70 bg-[linear-gradient(rgba(34,211,238,.08)_1px,transparent_1px),linear-gradient(90deg,rgba(34,211,238,.08)_1px,transparent_1px)] bg-[size:32px_32px]"></div>
    </div>

    <div class="relative grid gap-8 lg:grid-cols-[1.15fr_.85fr] lg:items-center">
        <div>
            <span class="inline-flex items-center rounded-full border border-primary/30 bg-primary/10 px-4 py-2 text-sm font-bold text-cyan-200">
                Bảng điều khiển quản trị
            </span>
            <h1 class="mt-5 max-w-3xl text-3xl font-black tracking-tight text-white md:text-5xl">
                Tổng quan Chemistry Lab
            </h1>
            <p class="mt-4 max-w-2xl text-base leading-8 text-slate-200">
                Các chỉ số bên dưới lấy trực tiếp từ cơ sở dữ liệu hiện tại: người dùng, khóa học, bài học, danh mục và lượt đăng ký.
            </p>

            <div class="mt-6 flex flex-wrap gap-3">
                <a asp-controller="TeacherCourses" asp-action="Create" class="btn-gradient inline-flex items-center rounded-2xl px-5 py-3 text-sm font-black text-slate-950">
                    <i class="fas fa-plus mr-2"></i>
                    Tạo khóa học
                </a>
                <a asp-controller="AdminUsers" asp-action="Index" class="inline-flex items-center rounded-2xl border border-cyan-300/30 bg-slate-900/80 px-5 py-3 text-sm font-bold text-slate-100 transition hover:border-cyan-200 hover:bg-cyan-300/10">
                    <i class="fas fa-users mr-2 text-cyan-300"></i>
                    Quản lý người dùng
                </a>
            </div>
        </div>

        <div class="relative mx-auto aspect-square w-full max-w-xs md:max-w-sm">
            <div class="absolute inset-6 rounded-full border border-cyan-300/20 bg-cyan-300/5"></div>
            <div class="absolute inset-14 rounded-full border border-fuchsia-300/20 bg-fuchsia-300/5"></div>
            <div class="absolute inset-0 animate-[spin_18s_linear_infinite] rounded-full border border-dashed border-cyan-300/35"></div>
            <div class="absolute left-1/2 top-1/2 flex h-28 w-28 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-cyan-300/40 bg-slate-900/90 shadow-2xl shadow-cyan-500/20">
                <i class="fas fa-flask text-4xl text-cyan-300"></i>
            </div>
            <div class="absolute left-4 top-12 rounded-2xl border border-cyan-300/25 bg-slate-950/85 px-4 py-3 shadow-xl">
                <p class="text-xs font-bold uppercase tracking-widest text-slate-300">Khóa học</p>
                <p class="mt-1 text-2xl font-black text-white">@ViewBag.TotalCourses</p>
            </div>
            <div class="absolute bottom-10 right-3 rounded-2xl border border-fuchsia-300/25 bg-slate-950/85 px-4 py-3 shadow-xl">
                <p class="text-xs font-bold uppercase tracking-widest text-slate-300">Hoàn thành</p>
                <p class="mt-1 text-2xl font-black text-secondary">@completionRate%</p>
            </div>
        </div>
    </div>
</section>

<section class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <article class="rounded-2xl border border-primary/15 bg-slate-900/80 p-5 shadow-xl shadow-primary/5">
        <div class="flex items-center justify-between">
            <span class="rounded-2xl bg-cyan-300/10 p-3 text-cyan-300"><i class="fas fa-users"></i></span>
            <span class="rounded-full bg-emerald-400/10 px-3 py-1 text-sm font-bold text-emerald-300">@ViewBag.UserGrowth</span>
        </div>
        <p class="mt-5 text-xs font-bold uppercase tracking-wider text-slate-300">Tổng người dùng</p>
        <p class="mt-2 text-3xl font-black text-white">@ViewBag.TotalUsers</p>
    </article>

    <article class="rounded-2xl border border-primary/15 bg-slate-900/80 p-5 shadow-xl shadow-primary/5">
        <div class="flex items-center justify-between">
            <span class="rounded-2xl bg-cyan-300/10 p-3 text-cyan-300"><i class="fas fa-user-graduate"></i></span>
            <span class="text-sm font-bold text-slate-300">học viên</span>
        </div>
        <p class="mt-5 text-xs font-bold uppercase tracking-wider text-slate-300">Học sinh</p>
        <p class="mt-2 text-3xl font-black text-white">@ViewBag.TotalStudents</p>
    </article>

    <article class="rounded-2xl border border-primary/15 bg-slate-900/80 p-5 shadow-xl shadow-primary/5">
        <div class="flex items-center justify-between">
            <span class="rounded-2xl bg-secondary/10 p-3 text-secondary"><i class="fas fa-book-open"></i></span>
            <span class="text-sm font-bold text-slate-300">@ViewBag.TotalLessons bài học</span>
        </div>
        <p class="mt-5 text-xs font-bold uppercase tracking-wider text-slate-300">Khóa học</p>
        <p class="mt-2 text-3xl font-black text-white">@ViewBag.TotalCourses</p>
    </article>

    <article class="rounded-2xl border border-primary/15 bg-slate-900/80 p-5 shadow-xl shadow-primary/5">
        <div class="flex items-center justify-between">
            <span class="rounded-2xl bg-emerald-400/10 p-3 text-emerald-300"><i class="fas fa-chart-line"></i></span>
            <span class="text-sm font-bold text-slate-300">@ViewBag.TotalCategories danh mục</span>
        </div>
        <p class="mt-5 text-xs font-bold uppercase tracking-wider text-slate-300">Lượt đăng ký</p>
        <p class="mt-2 text-3xl font-black text-white">@ViewBag.TotalEnrollments</p>
    </article>
</section>

<section class="mt-6 grid gap-6 xl:grid-cols-[1.1fr_.9fr]">
    <article class="rounded-2xl border border-primary/15 bg-slate-900/80 p-6 shadow-xl shadow-primary/5">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <p class="text-xs font-black uppercase tracking-widest text-cyan-300">Hoạt động tuần</p>
                <h2 class="mt-2 text-2xl font-black text-white">Tài khoản mới theo ngày</h2>
            </div>
            <span class="rounded-full bg-primary/10 px-4 py-2 text-sm font-bold text-cyan-200">7 ngày gần đây</span>
        </div>

        <div class="mt-8 flex h-64 items-end gap-3">
            @for (var i = 0; i < weekly.Length; i++)
            {
                var height = Math.Max(8, weekly[i] * 100 / maxWeekly);
                <div class="flex flex-1 flex-col items-center gap-3">
                    <div class="relative flex h-52 w-full items-end overflow-hidden rounded-2xl bg-slate-950/80">
                        <div class="w-full rounded-2xl bg-gradient-to-t from-cyan-500 via-cyan-300 to-secondary shadow-lg shadow-cyan-500/20" style="height:@height%"></div>
                    </div>
                    <span class="text-xs font-bold text-slate-300">D@(i + 1)</span>
                </div>
            }
        </div>
    </article>

    <div class="space-y-6">
        <article class="rounded-2xl border border-primary/15 bg-slate-900/80 p-6 shadow-xl shadow-primary/5">
            <p class="text-xs font-black uppercase tracking-widest text-cyan-300">Tình trạng dữ liệu</p>
            <h2 class="mt-2 text-2xl font-black text-white">Đang đọc dữ liệu thật</h2>
            <div class="mt-6 space-y-4">
                <div class="flex items-center justify-between rounded-2xl bg-slate-950/70 px-4 py-3">
                    <span class="font-bold text-slate-100">Cơ sở dữ liệu</span>
                    <span class="rounded-full bg-emerald-400/10 px-3 py-1 text-sm font-black text-emerald-300">Kết nối</span>
                </div>
                <div class="flex items-center justify-between rounded-2xl bg-slate-950/70 px-4 py-3">
                    <span class="font-bold text-slate-100">Quản trị viên</span>
                    <span class="rounded-full bg-primary/10 px-3 py-1 text-sm font-black text-cyan-200">@ViewBag.AdminUsers tài khoản</span>
                </div>
                <div class="flex items-center justify-between rounded-2xl bg-slate-950/70 px-4 py-3">
                    <span class="font-bold text-slate-100">Tỉ lệ hoàn thành</span>
                    <span class="rounded-full bg-secondary/10 px-3 py-1 text-sm font-black text-secondary">@completionRate%</span>
                </div>
            </div>
        </article>

        <article class="rounded-2xl border border-primary/15 bg-slate-900/80 p-6 shadow-xl shadow-primary/5">
            <p class="text-xs font-black uppercase tracking-widest text-cyan-300">Hành động nhanh</p>
            <div class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-1">
                <a asp-controller="Categories" asp-action="Index" class="rounded-2xl border border-cyan-300/20 bg-slate-950/70 px-4 py-3 font-black text-slate-100 transition hover:border-cyan-200 hover:bg-cyan-300/10">
                    <i class="fas fa-layer-group mr-2 text-cyan-300"></i>
                    Quản lý danh mục
                </a>
                <a asp-controller="AdminComments" asp-action="Index" class="rounded-2xl border border-cyan-300/20 bg-slate-950/70 px-4 py-3 font-black text-slate-100 transition hover:border-cyan-200 hover:bg-cyan-300/10">
                    <i class="fas fa-comments mr-2 text-cyan-300"></i>
                    Duyệt bình luận
                </a>
            </div>
        </article>
    </div>
</section>

<section class="mt-6 rounded-2xl border border-primary/15 bg-slate-900/80 p-6 shadow-xl shadow-primary/5">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <p class="text-xs font-black uppercase tracking-widest text-cyan-300">Nội dung</p>
            <h2 class="mt-2 text-2xl font-black text-white">Khóa học gần đây</h2>
        </div>
        <a asp-controller="TeacherCourses" asp-action="Index" class="rounded-2xl border border-cyan-300/25 px-4 py-2 text-sm font-black text-cyan-200 transition hover:bg-cyan-300/10">Xem tất cả</a>
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        @if (recentCourses.Any())
        {
            foreach (var course in recentCourses)
            {
                <article class="rounded-2xl border border-primary/10 bg-slate-950/65 p-5">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <h3 class="line-clamp-2 text-lg font-black text-white">@course.Title</h3>
                            <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-300">@course.Description</p>
                        </div>
                        <span class="shrink-0 rounded-2xl bg-cyan-300/10 p-3 text-cyan-300">
                            <i class="fas fa-atom"></i>
                        </span>
                    </div>
                    <div class="mt-5 flex items-center justify-between gap-4 text-sm font-bold text-slate-300">
                        <span class="truncate">@(course.Teacher?.FullName ?? course.Teacher?.Username ?? "Chưa có giáo viên")</span>
                        <a asp-controller="TeacherCourses" asp-action="Content" asp-route-id="@course.Id" class="shrink-0 text-cyan-200 hover:text-white">Chi tiết</a>
                    </div>
                </article>
            }
        }
        else
        {
            <div class="md:col-span-2 xl:col-span-3 rounded-2xl border border-dashed border-cyan-300/20 bg-slate-950/50 p-8 text-center">
                <i class="fas fa-book-open text-3xl text-cyan-300"></i>
                <p class="mt-3 font-black text-white">Chưa có khóa học gần đây.</p>
                <p class="mt-1 text-sm text-slate-300">Tạo khóa học mới để bắt đầu đưa nội dung lên trang học tập.</p>
            </div>
        }
    </div>
</section>
