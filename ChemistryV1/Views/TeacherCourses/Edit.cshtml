@model ChemistryV1.ViewModels.TeacherCourseEditViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Edit Course - ChemLab</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel="stylesheet" href="~/css/academy.css" asp-append-version="true" />
    <script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              colors: {
                      "surface-variant": "#e4e3db",
                      surface: "#fbf9f1",
                      tertiary: "#825100",
                      "surface-container-high": "#eae8e0",
                      "on-background": "#1b1c17",
                      "inverse-on-surface": "#f3f1e9",
                      "surface-tint": "#005ac2",
                      "surface-container-lowest": "#ffffff",
                      "on-surface": "#1b1c17",
                      "on-error": "#ffffff",
                      "tertiary-container": "#a36700",
                      "on-primary": "#ffffff",
                      "surface-container": "#f0eee6",
                      "secondary-container": "#6cf8bb",
                      "on-secondary-container": "#00714d",
                      secondary: "#006c49",
                      "inverse-surface": "#30312c",
                      "primary-fixed-dim": "#adc6ff",
                      "on-primary-container": "#fefcff",
                      "surface-dim": "#dcdad2",
                      "on-secondary-fixed": "#002113",
                      "on-error-container": "#93000a",
                      "secondary-fixed": "#6ffbbe",
                      "on-primary-fixed-variant": "#004395",
                      "primary-fixed": "#d8e2ff",
                      "surface-bright": "#fbf9f1",
                      primary: "#0058be",
                      "on-surface-variant": "#424754",
                      "on-tertiary-fixed-variant": "#653e00",
                      "on-primary-fixed": "#001a42",
                      "inverse-primary": "#adc6ff",
                      "on-secondary-fixed-variant": "#005236",
                      "surface-container-low": "#f5f4ec",
                      "error-container": "#ffdad6",
                      "primary-container": "#2170e4",
                      background: "#fbf9f1",
                      "secondary-fixed-dim": "#4edea3",
                      outline: "#727785",
                      "on-tertiary-fixed": "#2a1700",
                      "tertiary-fixed-dim": "#ffb95f",
                      "on-tertiary-container": "#fffbff",
                      "on-secondary": "#ffffff",
                      "outline-variant": "#c2c6d6",
                      "tertiary-fixed": "#ffddb8",
                      "surface-container-highest": "#e4e3db",
                      "on-tertiary": "#ffffff",
                      error: "#ba1a1a"
              },
              borderRadius: {
                      DEFAULT: "1rem",
                      lg: "2rem",
                      xl: "3rem",
                      full: "9999px"
              },
              spacing: {
                      "margin-desktop": "48px",
                      gutter: "24px",
                      "margin-mobile": "16px",
                      "container-max": "1200px",
                      unit: "8px"
              },
              fontFamily: {
                      "label-sm": ["Lexend"],
                      "display-lg": ["Lexend"],
                      "headline-md": ["Lexend"],
                      "body-md": ["Quicksand"],
                      "display-lg-mobile": ["Lexend"],
                      "body-lg": ["Quicksand"]
              },
              fontSize: {
                      "label-sm": ["14px", { "lineHeight": "1.2", "fontWeight": "600" }],
                      "display-lg": ["48px", { "lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                      "headline-md": ["24px", { "lineHeight": "1.4", "fontWeight": "600" }],
                      "body-md": ["16px", { "lineHeight": "1.6", "fontWeight": "500" }],
                      "display-lg-mobile": ["32px", { "lineHeight": "1.2", "fontWeight": "700" }],
                      "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "500" }]
              }
            },
          }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .icon-fill {
            font-variation-settings: 'FILL' 1;
        }
        .btn-primary-squishy {
            box-shadow: 0 4px 0 #004395;
        }
        .btn-primary-squishy:active {
            box-shadow: 0 0px 0 #004395;
            transform: translateY(4px);
        }
        .btn-outline-squishy {
            box-shadow: 0 4px 0 #c2c6d6;
        }
        .btn-outline-squishy:active {
            box-shadow: 0 0px 0 #c2c6d6;
            transform: translateY(4px);
        }
    </style>
</head>
<body class="academy-shell bg-surface text-on-surface font-body-md text-body-md antialiased min-h-screen">
    <header class="academy-topbar fixed top-0 left-0 w-full h-20 bg-surface/90 backdrop-blur-md z-40 border-b-2 border-primary/10 flex justify-between items-center px-margin-mobile md:px-margin-desktop shadow-sm">
        <div class="flex items-center gap-4">
            <a class="w-10 h-10 flex items-center justify-center rounded-full bg-surface-container border-2 border-outline-variant hover:bg-surface-variant transition-colors btn-outline-squishy" asp-action="Index">
                <span class="material-symbols-outlined text-on-surface-variant">arrow_back</span>
            </a>
            <div>
                <h1 class="font-headline-md text-headline-md font-bold text-primary">Lab Forge</h1>
                <p class="font-label-sm text-label-sm text-on-surface-variant">Update Experiment</p>
            </div>
        </div>
        <div class="hidden md:flex items-center gap-4">
            <button form="course-form" class="squishy-button button-confirm bg-primary text-on-primary border-2 border-primary-fixed-dim rounded-full px-6 py-3 font-label-sm text-label-sm flex items-center gap-2 hover:brightness-110 transition-all" type="submit">
                <span class="material-symbols-outlined icon-fill">save</span>
                Save Changes
            </button>
        </div>
    </header>
    <main class="pt-28 pb-12 px-margin-mobile md:px-margin-desktop flex justify-center">
        <form id="course-form" asp-action="Edit" method="post" class="glass-form w-full max-w-container-max grid grid-cols-1 lg:grid-cols-12 gap-gutter">
            <input type="hidden" asp-for="Id" />
            <div class="lg:col-span-8 space-y-gutter">
                <div class="bg-surface-container-lowest rounded-lg border-2 border-outline-variant shadow-[0_4px_0_rgba(114,119,133,0.1)] p-6 md:p-8 relative overflow-hidden">
                    <div class="absolute -top-10 -right-10 w-32 h-32 bg-primary-fixed rounded-full opacity-50 blur-2xl"></div>
                    <h2 class="font-headline-md text-headline-md text-primary font-bold mb-6 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">menu_book</span>
                        Experiment Blueprint
                    </h2>
                    <div class="space-y-6">
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface mb-2">Experiment Title</label>
                            <input asp-for="Title" class="w-full bg-surface rounded-full border-2 border-outline-variant px-6 py-4 font-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-4 focus:ring-primary/20 transition-all shadow-inner" type="text" />
                        </div>
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface mb-2">Hypothesis &amp; Instructions</label>
                            <textarea asp-for="Description" class="w-full bg-surface rounded-DEFAULT border-2 border-outline-variant px-6 py-4 font-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-4 focus:ring-primary/20 transition-all shadow-inner resize-none" rows="4"></textarea>
                        </div>
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface mb-3">Academic Categories</label>
                            <div class="flex flex-wrap gap-3">
                                @foreach (var category in Model.Categories)
                                {
                                    var selected = Model.SelectedCategoryIds.Contains(category.Id);
                                    <label class="cursor-pointer group">
                                        <input class="peer sr-only" name="SelectedCategoryIds" type="checkbox" value="@category.Id" @(selected ? "checked" : null) />
                                        <div class="bg-surface border-2 border-outline-variant text-on-surface-variant font-label-sm text-label-sm rounded-full px-5 py-2 group-hover:bg-surface-variant transition-colors peer-checked:bg-secondary-container peer-checked:text-on-secondary-container peer-checked:border-secondary shadow-[0_2px_0_#c2c6d6] peer-checked:shadow-[0_2px_0_#005236] flex items-center gap-2">
                                            <span class="material-symbols-outlined text-[18px]">category</span>
                                            @category.Name
                                        </div>
                                    </label>
                                }
                            </div>
                        </div>
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface mb-2">Slug (optional)</label>
                            <input asp-for="Slug" class="w-full bg-surface rounded-full border-2 border-outline-variant px-6 py-3 font-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-4 focus:ring-primary/20 transition-all shadow-inner" type="text" />
                            <span asp-validation-for="Slug" class="text-error text-sm"></span>
                        </div>
                    </div>
                </div>
                <div class="bg-surface-container-lowest rounded-lg border-2 border-outline-variant shadow-[0_4px_0_rgba(114,119,133,0.1)] p-6 md:p-8">
                    <h2 class="font-headline-md text-headline-md text-primary font-bold mb-6 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">image</span>
                        2D Lab Preview
                    </h2>
                    <div class="relative w-full h-64 bg-surface rounded-xl border-4 border-dashed border-primary/30 flex flex-col items-center justify-center transition-all group overflow-hidden">
                        <div class="absolute inset-0 opacity-20 bg-cover bg-center transition-transform group-hover:scale-105 duration-500" style="background-image: url('@(Model.ThumbnailUrl ?? "https://lh3.googleusercontent.com/aida-public/AB6AXuBuzYyPxBIHzRjakSddvr7Be3JXTj0TYC5S788E-VUztNu3Nt-hmAarj4bpimXojbWkrNtU6aITXLcp8Y9JpAYftz9Kmyq4d6kU3pp6NUC3jBrreJykkinIpFuNi1s3hsMBWKx-TZuyXviHS2oI5lRNWBT0k4NYvWCEPof-41uWCG-9MUhyu4f513AaxsrBuBJeYeFNP-jNXbUH5xwrWJLHo7yYd2wKUqU-movkTsueZ_cIVAgQMnDkDEv2P5iqNFL3kyGP7X0VCSg")');">
                        </div>
                        <div class="z-10 flex flex-col items-center text-center p-4 bg-surface-container-lowest/80 backdrop-blur-sm rounded-lg border-2 border-outline-variant shadow-sm">
                            <span class="material-symbols-outlined text-4xl text-primary mb-2">upload_file</span>
                            <p class="font-label-sm text-label-sm text-on-surface">Cover Image URL</p>
                            <input asp-for="ThumbnailUrl" class="mt-3 w-full bg-surface rounded-full border-2 border-outline-variant px-4 py-2 text-sm focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" placeholder="https://..." type="text" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="lg:col-span-4 space-y-gutter">
                <div class="bg-surface-container-lowest rounded-lg border-2 border-outline-variant shadow-[0_4px_0_rgba(114,119,133,0.1)] p-6">
                    <h2 class="font-headline-md text-headline-md text-primary font-bold mb-6 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">settings</span>
                        Lab Settings
                    </h2>
                    <div class="space-y-6">
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface mb-2">Admin</label>
                            <select asp-for="TeacherId" class="w-full bg-surface rounded-full border-2 border-outline-variant px-4 py-3 text-sm focus:ring-primary focus:border-primary">
                                <option value="">Select admin</option>
                                @foreach (var teacher in Model.Teachers)
                                {
                                    <option value="@teacher.Id" selected="@(Model.TeacherId == teacher.Id)">@teacher.FullName</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface mb-2">Status</label>
                            <select asp-for="Status" class="w-full bg-surface rounded-full border-2 border-outline-variant px-4 py-3 text-sm focus:ring-primary focus:border-primary">
                                <option value="draft">Draft</option>
                                <option value="published">Published</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="bg-secondary-container rounded-lg border-2 border-secondary shadow-[0_4px_0_#005236] p-6 text-on-secondary-container">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="font-label-sm text-label-sm font-bold">Current Status</h3>
                        <span class="bg-surface text-secondary border-2 border-secondary rounded-full px-3 py-1 text-[12px] font-bold">@Model.Status?.ToUpperInvariant()</span>
                    </div>
                    <p class="font-body-md text-sm mb-4">This experiment is hidden from students until you publish it.</p>
                </div>
            </div>
        </form>
    </main>
</body>
</html>
