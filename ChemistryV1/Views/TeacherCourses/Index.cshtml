@model ChemistryV1.ViewModels.TeacherCoursesIndexViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý khóa học";
    ViewData["Description"] = "Quản lý chương trình học, bài học, tài liệu và game thực hành của học sinh.";
}

<section class="cinematic-hero glass-card premium-shadow overflow-hidden p-6 md:p-8 mb-8">
    <div class="lab-stage"><div class="stage-city"></div><div class="lab-orbit"></div></div>
    <div class="molecule-field"><span></span><span></span><span></span><span></span></div>
    <div class="relative z-10 flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
        <div class="max-w-3xl">
            <p class="font-label text-secondary text-xs mb-3">Không gian giáo viên</p>
            <h1 class="font-display text-4xl md:text-5xl font-extrabold leading-tight text-glow-primary">Upload nội dung, gắn game, xuất bản lab cho học sinh.</h1>
            <p class="text-on-surface-variant mt-4 leading-relaxed">
                Đây là nơi giáo viên quản lý khóa học đang hoạt động, điều chỉnh bài học và bật trạng thái xuất bản.
            </p>
        </div>
        <div class="flex flex-wrap gap-3">
            <a class="px-5 py-3 glass-panel text-secondary border border-secondary/30 font-label font-bold rounded-xl flex items-center gap-2 hover:scale-[1.02] active:scale-[0.98] transition-all" asp-controller="Categories" asp-action="Index">
                <span class="material-symbols-outlined">category</span>
                Danh mục
            </a>
            <a class="px-5 py-3 bg-primary text-on-primary font-label font-bold rounded-xl btn-glow flex items-center gap-2 hover:scale-[1.02] active:scale-[0.98] transition-all" asp-controller="TeacherCourses" asp-action="Create">
                <span class="material-symbols-outlined">add</span>
                Tạo khóa học
            </a>
        </div>
    </div>
</section>

<form class="mb-6" method="get" asp-action="Index">
    <div class="relative max-w-lg">
        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-primary">search</span>
        <input class="w-full rounded-xl pl-12 pr-4 py-3 text-sm outline-none transition-all" name="search" placeholder="Tìm kiếm khóa học..." type="text" value="@Model.Search" />
    </div>
</form>

<div class="glass-card overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead class="border-b border-primary/15 bg-white/60">
                <tr>
                    <th class="px-6 py-4 text-xs font-label text-on-surface-variant">Tên khóa học</th>
                    <th class="px-6 py-4 text-xs font-label text-on-surface-variant">Danh mục</th>
                    <th class="px-6 py-4 text-xs font-label text-on-surface-variant text-center">Trạng thái</th>
                    <th class="px-6 py-4 text-xs font-label text-on-surface-variant">Ngày tạo</th>
                    <th class="px-6 py-4 text-xs font-label text-on-surface-variant text-right">Hành động</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-primary/10">
                @foreach (var course in Model.Courses)
                {
                    var primaryCategory = course.CourseCategories.FirstOrDefault()?.Category?.Name ?? "Chưa phân loại";
                    var isPublished = course.Status == "published";
                    <tr class="hover:bg-primary/5 transition-colors group">
                        <td class="px-6 py-5">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center border border-primary/25 shadow-neon-blue">
                                    <span class="material-symbols-outlined text-primary">auto_stories</span>
                                </div>
                                <div>
                                    <div class="font-display font-bold text-lg">@course.Title</div>
                                    <div class="text-sm text-on-surface-variant">@course.Chapters.Sum(ch => ch.Lessons.Count) bài học</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-5">
                            <span class="px-3 py-1 bg-primary/10 text-primary border border-primary/25 rounded-full text-xs font-bold">@primaryCategory</span>
                        </td>
                        <td class="px-6 py-5">
                            <div class="flex flex-col items-center gap-1">
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input class="sr-only status-checkbox" type="checkbox" data-course-id="@course.Id" @(isPublished ? "checked" : "") onchange="toggleCourseStatus(this)" />
                                    <div class="toggle-switch"></div>
                                </label>
                                <span class="status-label text-[10px] font-label @(isPublished ? "text-secondary" : "text-on-surface-variant")">
                                    @(isPublished ? "Đã xuất bản" : "Nháp")
                                </span>
                            </div>
                        </td>
                        <td class="px-6 py-5 text-on-surface-variant text-sm">@course.CreatedAt?.ToString("dd/MM/yyyy")</td>
                        <td class="px-6 py-5 text-right">
                            <div class="flex justify-end gap-2">
                                <a class="p-2 rounded-xl hover:bg-tertiary/10 text-tertiary transition-colors" asp-controller="TeacherCourses" asp-action="Content" asp-route-id="@course.Id" title="Quản lý nội dung">
                                    <span class="material-symbols-outlined">list_alt</span>
                                </a>
                                <a class="p-2 rounded-xl hover:bg-secondary/10 text-secondary transition-colors" asp-controller="TeacherCourses" asp-action="Edit" asp-route-id="@course.Id" title="Chỉnh sửa">
                                    <span class="material-symbols-outlined">edit</span>
                                </a>
                                <a class="p-2 rounded-xl hover:bg-red-500/10 text-error transition-colors" asp-controller="TeacherCourses" asp-action="Delete" asp-route-id="@course.Id" title="Xóa">
                                    <span class="material-symbols-outlined">delete</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="flex flex-col sm:flex-row justify-between items-center gap-4 mt-4">
    <span class="text-sm text-on-surface-variant">Hiển thị @Model.Courses.Count() khóa học</span>
</div>

@section Head {
    <style>
        .toggle-switch {
            width: 48px;
            height: 26px;
            background-color: rgba(169, 191, 210, 0.22);
            border: 1px solid rgba(99, 218, 255, 0.2);
            border-radius: 999px;
            position: relative;
            cursor: pointer;
            transition: background-color 0.25s, box-shadow 0.25s;
        }
        .toggle-switch::after {
            content: "";
            position: absolute;
            top: 2px;
            left: 2px;
            width: 20px;
            height: 20px;
            background-color: #e8f6ff;
            border-radius: 50%;
            transition: left 0.25s;
            box-shadow: 0 2px 8px rgba(0,0,0,0.28);
        }
        input:checked + .toggle-switch {
            background-color: #75ff6a;
            box-shadow: 0 0 20px rgba(117, 255, 106, 0.35);
        }
        input:checked + .toggle-switch::after {
            left: 23px;
            background-color: #06230a;
        }
    </style>
}

@section Scripts {
    <script>
        async function toggleCourseStatus(checkbox) {
            const courseId = checkbox.getAttribute('data-course-id');
            const parentDiv = checkbox.closest('div');
            const labelSpan = parentDiv.querySelector('.status-label');

            try {
                const response = await fetch(`/TeacherCourses/ToggleStatus/${courseId}`, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/json'
                    }
                });

                if (response.ok) {
                    const result = await response.json();
                    if (result.success) {
                        const isPub = result.newStatus.toLowerCase() === 'published';
                        checkbox.checked = isPub;
                        labelSpan.textContent = isPub ? 'Đã xuất bản' : 'Nháp';
                        labelSpan.classList.toggle('text-secondary', isPub);
                        labelSpan.classList.toggle('text-on-surface-variant', !isPub);
                    } else {
                        alert('Không thể cập nhật trạng thái.');
                        checkbox.checked = !checkbox.checked;
                    }
                } else {
                    alert('Lỗi máy chủ.');
                    checkbox.checked = !checkbox.checked;
                }
            } catch (error) {
                console.error(error);
                alert('Đã xảy ra lỗi.');
                checkbox.checked = !checkbox.checked;
            }
        }
    </script>
}
