@model ChemistryV1.ViewModels.UserProfileViewModel
@{
    Layout = null;

    string ToneText(string tone) => tone switch
    {
        "secondary" => "text-secondary",
        "tertiary" => "text-tertiary",
        "outline" => "text-on-surface-variant",
        _ => "text-primary"
    };

    string ToneBg(string tone) => tone switch
    {
        "secondary" => "bg-secondary/10",
        "tertiary" => "bg-tertiary/10",
        "outline" => "bg-surface-container-high",
        _ => "bg-primary/10"
    };

    string ToneBorder(string tone) => tone switch
    {
        "secondary" => "border-secondary/30",
        "tertiary" => "border-tertiary/30",
        "outline" => "border-outline-variant/40",
        _ => "border-primary/30"
    };
}
<!DOCTYPE html>
<html class="light" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>@Model.UserName - ChemLab Profile</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800&amp;family=Quicksand:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .filled-icon {
            font-variation-settings: 'FILL' 1;
        }
        body {
            font-family: 'Quicksand', sans-serif;
            background-color: #FFFDF5;
        }
        .font-lexend { font-family: 'Lexend', sans-serif; }
        .squishy-button {
            transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 0 0 rgba(0, 0, 0, 0.1);
        }
        .squishy-button:active {
            transform: translateY(2px);
            box-shadow: 0 0px 0 0 rgba(0, 0, 0, 0.1);
        }
        .cartoon-card {
            border: 2px solid rgba(0, 88, 190, 0.08);
            box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.04);
        }
        .element-chip {
            box-shadow: 0 4px 0 0 rgba(0, 0, 0, 0.05);
            border: 3px solid #ffffff;
        }
    </style>
<script id="tailwind-config">
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#0058be",
                        "primary-container": "#2170e4",
                        "secondary": "#006c49",
                        "secondary-container": "#6cf8bb",
                        "tertiary": "#825100",
                        "background": "#fbf9f1",
                        "surface": "#fbf9f1",
                        "surface-container-low": "#f5f4ec",
                        "surface-container-high": "#eae8e0",
                        "surface-container-highest": "#e4e3db",
                        "on-surface": "#1b1c17",
                        "on-surface-variant": "#424754",
                        "outline-variant": "#c2c6d6",
                        "primary-fixed": "#d8e2ff",
                        "on-primary-container": "#fefcff"
                    },
                    borderRadius: {
                        "DEFAULT": "1rem",
                        "lg": "2rem",
                        "xl": "3rem"
                    },
                    spacing: {
                        "unit": "8px",
                        "gutter": "24px",
                        "margin-desktop": "48px"
                    },
                    fontFamily: {
                        "headline-md": ["Lexend"],
                        "body-md": ["Quicksand"],
                        "label-md": ["Lexend"]
                    },
                    fontSize: {
                        "headline-md": ["24px", {"lineHeight": "1.4", "fontWeight": "600"}],
                        "body-md": ["16px", {"lineHeight": "1.6", "fontWeight": "500"}],
                        "label-md": ["14px", {"lineHeight": "1.2", "fontWeight": "600"}]
                    }
                }
            }
        }
    </script>
</head>
<body class="text-on-surface">
<nav class="fixed w-full top-0 z-50 bg-surface/80 backdrop-blur-xl border-b border-outline-variant/30 shadow-sm h-16 flex justify-between items-center px-[24px] md:px-margin-desktop">
<div class="flex items-center gap-8">
<a asp-controller="Home" asp-action="Index" class="text-headline-md font-headline-md font-bold text-primary">ChemLab</a>
<div class="hidden md:flex gap-6">
<a class="text-on-surface-variant hover:text-primary transition-colors text-label-md font-label-md" asp-controller="Home" asp-action="Index">Dashboard</a>
<a class="text-on-surface-variant hover:text-primary transition-colors text-label-md font-label-md" asp-controller="Courses" asp-action="Library">Curriculum</a>
<a class="text-on-surface-variant hover:text-primary transition-colors text-label-md font-label-md" asp-controller="Lessons" asp-action="Details" asp-route-id="1">Resources</a>
<a class="text-on-surface-variant hover:text-primary transition-colors text-label-md font-label-md" asp-controller="Account" asp-action="VerifyEmail">Support</a>
</div>
</div>
<div class="flex items-center gap-4">
<button class="material-symbols-outlined p-2 text-on-surface-variant hover:bg-primary-container/10 rounded-full transition-all">notifications</button>
<div class="h-10 w-10 rounded-full bg-primary-fixed flex items-center justify-center border-2 border-white shadow-sm overflow-hidden">
<img alt="User Profile" class="w-full h-full object-cover" src="@Model.AvatarUrl"/>
</div>
<a asp-controller="Home" asp-action="Index" class="bg-primary text-on-primary-container px-6 py-2 rounded-full font-label-md squishy-button flex items-center gap-2">
                Launch Lab
                <span class="material-symbols-outlined text-sm">rocket_launch</span>
</a>
</div>
</nav>

<main class="pt-24 pb-20 px-[24px] md:px-margin-desktop max-w-[1400px] mx-auto">
<div class="grid grid-cols-12 gap-gutter">
<section class="col-span-12 lg:col-span-8">
<div class="cartoon-card bg-white rounded-xl p-8 relative overflow-hidden flex flex-col md:flex-row items-center gap-8">
<div class="absolute -top-24 -right-24 w-64 h-64 bg-primary/5 rounded-full blur-3xl"></div>
<div class="relative w-48 h-48 md:w-64 md:h-64 flex-shrink-0 bg-surface-container-low rounded-xl border-2 border-primary/10 shadow-inner flex items-center justify-center overflow-hidden">
<img alt="@Model.UserName Character Avatar" class="w-full h-full object-cover transform hover:scale-105 transition-transform duration-500" src="@Model.AvatarUrl"/>
<div class="absolute -bottom-3 bg-primary text-white text-[12px] font-bold px-4 py-1 rounded-full shadow-md uppercase tracking-wider">Level @Model.Level</div>
</div>
<div class="flex-grow text-center md:text-left">
<div class="mb-1 flex flex-col md:flex-row md:items-center gap-2">
<h1 class="text-display-lg font-headline-md text-on-surface text-3xl">@Model.UserName</h1>
<span class="bg-secondary-container text-secondary text-xs font-bold px-3 py-1 rounded-full w-max mx-auto md:mx-0">@Model.Role</span>
</div>
<p class="text-on-surface-variant font-body-md mb-6 italic">"Next Milestone: @Model.XpToNextLevel XP to Level @(Model.Level + 1) - You're on a roll!"</p>
<div class="w-full space-y-2">
<div class="flex justify-between text-label-md font-lexend text-primary mb-1">
<span>@Model.TotalXp.ToString("N0") XP Collected</span>
<span>@Model.NextLevelXp.ToString("N0") XP</span>
</div>
<div class="h-4 w-full bg-surface-container-high rounded-full overflow-hidden border border-outline-variant/20">
<div class="h-full bg-gradient-to-r from-primary to-primary-container rounded-full shadow-[0_0_12px_rgba(33,112,228,0.3)] transition-all duration-1000 ease-out" style="width:@Model.LevelProgressPercent%;"></div>
</div>
</div>
</div>
</div>

<div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-gutter">
<div class="cartoon-card bg-white p-6 rounded-xl flex flex-col items-center text-center group hover:border-primary/30 transition-all cursor-default">
<div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-3 group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined filled-icon">menu_book</span>
</div>
<span class="text-2xl font-bold font-lexend">@Model.TotalCompletedLessons</span>
<span class="text-label-md text-on-surface-variant">Lessons</span>
</div>
<div class="cartoon-card bg-white p-6 rounded-xl flex flex-col items-center text-center group hover:border-secondary/30 transition-all cursor-default">
<div class="w-12 h-12 bg-secondary/10 rounded-lg flex items-center justify-center text-secondary mb-3 group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined filled-icon">fact_check</span>
</div>
<span class="text-2xl font-bold font-lexend">@Model.TotalQuizResults</span>
<span class="text-label-md text-on-surface-variant">Quizzes</span>
</div>
<div class="cartoon-card bg-white p-6 rounded-xl flex flex-col items-center text-center group hover:border-tertiary/30 transition-all cursor-default">
<div class="w-12 h-12 bg-tertiary/10 rounded-lg flex items-center justify-center text-tertiary mb-3 group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined filled-icon">local_fire_department</span>
</div>
<span class="text-2xl font-bold font-lexend">@Model.DayStreak Day</span>
<span class="text-label-md text-on-surface-variant">Streak</span>
</div>
<div class="cartoon-card bg-white p-6 rounded-xl flex flex-col items-center text-center group hover:border-primary/30 transition-all cursor-default">
<div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-3 group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined filled-icon">military_tech</span>
</div>
<span class="text-2xl font-bold font-lexend">@Model.TotalXp.ToString("N0")</span>
<span class="text-label-md text-on-surface-variant">Total XP</span>
</div>
</div>

<div class="cartoon-card bg-white rounded-xl p-8 mt-gutter">
<div class="flex justify-between items-center mb-6">
<h2 class="text-headline-md font-headline-md text-on-surface">Periodic Collection</h2>
<button class="text-primary font-bold text-label-md hover:underline">View All</button>
</div>
<div class="flex flex-wrap gap-6 justify-center md:justify-start">
@foreach (var element in Model.Elements)
{
    if (element.Unlocked)
    {
        <div class="element-chip w-20 h-20 rounded-xl @ToneBg(element.Tone) flex flex-col items-center justify-center @ToneBorder(element.Tone) transition-transform hover:-translate-y-1 cursor-help" title="@element.Name">
            <span class="@ToneText(element.Tone) font-bold text-xl">@element.Symbol</span>
            <span class="text-[10px] uppercase font-bold text-on-surface-variant">@element.Name</span>
        </div>
    }
    else
    {
        <div class="w-20 h-20 rounded-xl bg-surface-container flex flex-col items-center justify-center border-2 border-dashed border-outline-variant/40 opacity-50 grayscale">
            <span class="material-symbols-outlined text-on-surface-variant">lock</span>
            <span class="text-[10px] uppercase font-bold mt-1">@element.Name</span>
        </div>
    }
}
</div>
</div>
</section>

<aside class="col-span-12 lg:col-span-4 flex flex-col gap-gutter">
<div class="cartoon-card bg-white rounded-xl p-6">
<h2 class="text-headline-md font-headline-md text-on-surface mb-6 flex items-center gap-2">
<span class="material-symbols-outlined text-tertiary">military_tech</span>
                        Achievements
                    </h2>
<div class="grid grid-cols-3 gap-4">
@foreach (var badge in Model.Badges)
{
    var mutedClass = badge.Earned ? string.Empty : "opacity-40 grayscale";
    <div class="flex flex-col items-center gap-2 text-center @mutedClass">
        <div class="w-16 h-16 rounded-full @ToneBg(badge.Tone) @ToneText(badge.Tone) flex items-center justify-center border-2 @ToneBorder(badge.Tone) shadow-[0_4px_0_rgba(0,0,0,0.08)]">
            <span class="material-symbols-outlined text-3xl">@badge.Icon</span>
        </div>
        <span class="text-[10px] font-bold uppercase leading-tight">@badge.Title</span>
    </div>
}
</div>
</div>

<div class="cartoon-card bg-white rounded-xl p-6">
<h2 class="text-headline-md font-headline-md text-on-surface mb-6 flex items-center gap-2">
<span class="material-symbols-outlined text-primary">assignment</span>
                        Daily Missions
                    </h2>
<div class="space-y-4">
@if (Model.Missions.Any())
{
    @foreach (var mission in Model.Missions)
    {
        <div class="p-4 rounded-2xl border @ToneBorder(mission.Tone) @ToneBg(mission.Tone)">
            <div class="flex items-start gap-4">
                <div class="w-11 h-11 rounded-xl bg-white/80 flex items-center justify-center border border-white shadow-sm @ToneText(mission.Tone)">
                    <span class="material-symbols-outlined">@mission.Icon</span>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between gap-3 mb-1">
                        <p class="font-bold text-sm text-on-surface">@mission.Title</p>
                        <span class="text-[10px] font-bold uppercase text-on-surface-variant">@mission.RewardText</span>
                    </div>
                    <div class="h-2 bg-white/80 rounded-full overflow-hidden border border-white/60">
                        <div class="h-full @ToneBg(mission.Tone)" style="width:@mission.ProgressPercent%;"></div>
                    </div>
                    <div class="flex justify-between text-[10px] text-on-surface-variant font-bold mt-2 uppercase tracking-wider">
                        <span>@mission.Current/@mission.Target</span>
                        <span>@(mission.Completed ? "Completed" : "In Progress")</span>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="p-4 rounded-2xl bg-surface-container-low border border-outline-variant/30 text-sm text-on-surface-variant">
        No active missions right now.
    </div>
}
</div>
</div>

<div class="cartoon-card bg-white rounded-xl p-6">
<h2 class="text-headline-md font-headline-md text-on-surface mb-6">Alchemy Skills</h2>
<div class="space-y-4">
@foreach (var skill in Model.Skills)
{
    <div class="p-4 bg-surface-container-low rounded-xl border @ToneBorder(skill.Tone) flex items-center gap-4">
        <div class="w-10 h-10 rounded-lg @ToneBg(skill.Tone) @ToneText(skill.Tone) flex items-center justify-center">
            <span class="material-symbols-outlined">@skill.Icon</span>
        </div>
        <div class="flex-grow">
            <div class="flex justify-between items-center mb-1">
                <span class="font-bold text-label-md">@skill.Name</span>
                <span class="@ToneText(skill.Tone) font-bold">@skill.ValueLabel</span>
            </div>
            <div class="h-2 bg-white rounded-full overflow-hidden">
                <div class="h-full rounded-full @ToneBg(skill.Tone)" style="width:@skill.ProgressPercent%;"></div>
            </div>
        </div>
    </div>
}
</div>
</div>

<div class="cartoon-card bg-white rounded-xl p-6">
<h2 class="text-headline-md font-headline-md text-on-surface mb-6">Recent Activity</h2>
<ul class="space-y-6 relative before:absolute before:left-[19px] before:top-2 before:bottom-2 before:w-0.5 before:bg-outline-variant/30">
@foreach (var activity in Model.RecentActivity)
{
    <li class="relative flex items-center gap-4 pl-10">
        <div class="absolute left-0 w-10 h-10 rounded-full border-4 border-white shadow-sm flex items-center justify-center z-10 @ToneBg(activity.Tone) @ToneText(activity.Tone)">
            <span class="material-symbols-outlined text-lg">@activity.Icon</span>
        </div>
        <div>
            <p class="font-bold text-label-md leading-tight">@activity.Title</p>
            <p class="text-on-surface-variant text-xs">@activity.TimeLabel</p>
        </div>
    </li>
}
</ul>
</div>
</aside>
</div>

<section class="mt-gutter">
<div class="cartoon-card bg-white rounded-xl p-8 overflow-hidden relative">
<div class="absolute top-0 right-0 p-8 opacity-5">
<span class="material-symbols-outlined text-[120px]">map</span>
</div>
<h2 class="text-headline-md font-headline-md text-on-surface mb-8">Learning Journey Roadmap</h2>
<div class="flex flex-col md:flex-row items-center justify-between gap-6 relative">
<div class="hidden md:block absolute top-1/2 left-0 right-0 h-1 bg-surface-container-high -translate-y-1/2 z-0"></div>
@foreach (var step in Model.RoadmapSteps)
{
    var cardClass = step.State == "active"
        ? "z-10 bg-primary-fixed p-6 rounded-xl border-4 border-primary flex flex-col items-center w-full md:w-64 text-center shadow-xl transform scale-110"
        : step.State == "done"
            ? "z-10 bg-white p-4 rounded-xl border-2 border-secondary flex flex-col items-center w-full md:w-56 text-center shadow-lg"
            : "z-10 bg-surface-container-low p-4 rounded-xl border-2 border-outline-variant/40 flex flex-col items-center w-full md:w-56 text-center opacity-60";

    var iconClass = step.State == "active"
        ? "w-12 h-12 bg-primary rounded-full flex items-center justify-center text-white mb-3"
        : step.State == "done"
            ? "w-10 h-10 bg-secondary rounded-full flex items-center justify-center text-white mb-2"
            : "w-10 h-10 bg-outline-variant rounded-full flex items-center justify-center text-white mb-2";

    <div class="@cardClass">
        <div class="@iconClass">
            <span class="material-symbols-outlined text-xl">@step.Icon</span>
        </div>
        <h4 class="font-bold text-sm @(step.State == "active" ? "text-primary" : string.Empty)">@step.Title</h4>
        <p class="text-[10px] text-on-surface-variant">@step.Subtitle</p>
        @if (step.State == "active")
        {
            <div class="mt-3 h-1.5 w-full bg-white rounded-full overflow-hidden">
                <div class="h-full bg-primary" style="width:@Model.LevelProgressPercent%;"></div>
            </div>
        }
    </div>
}
</div>
</div>
</section>
</main>

<footer class="bg-surface-container-highest border-t border-outline-variant w-full relative bottom-0 py-10 px-[24px] md:px-margin-desktop mt-auto">
<div class="max-w-[1400px] mx-auto flex flex-col md:flex-row justify-between items-center">
<div class="mb-6 md:mb-0">
<span class="text-label-md font-headline-md font-bold text-primary">ChemLab</span>
<p class="text-on-surface-variant text-body-md mt-2 max-w-sm">© 2024 ChemLab. All rights reserved. Molecular Learning Systems.</p>
</div>
<div class="flex flex-wrap gap-6 justify-center">
<a class="text-on-surface-variant hover:text-primary hover:underline transition-all text-label-sm font-label-sm" href="#">Privacy Policy</a>
<a class="text-on-surface-variant hover:text-primary hover:underline transition-all text-label-sm font-label-sm" href="#">Terms of Service</a>
<a class="text-on-surface-variant hover:text-primary hover:underline transition-all text-label-sm font-label-sm" href="#">Safety Guidelines</a>
<a class="text-on-surface-variant hover:text-primary hover:underline transition-all text-label-sm font-label-sm" href="#">Research Paper</a>
</div>
</div>
</footer>
</body>
</html>
