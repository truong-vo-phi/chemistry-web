<!DOCTYPE html>
<html class="dark" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - Chemistry Lab</title>
    <meta name="description" content="@ViewData["Description"]" />
    <link rel="icon" type="image/png" href="~/images/LogoChemistry.png" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <partial name="_StudentDesignSystem" />
    @RenderSection("Head", required: false)
</head>
<body class="neon-lab-shell min-h-screen overflow-x-hidden">
    <div class="blob -top-48 -left-48"></div>
    <div class="blob top-1/2 -right-48"></div>
    <div class="blob -bottom-48 left-1/3"></div>
    <div class="labos-global-3d" aria-hidden="true">
        <span class="labos-3d-object"></span>
        <span class="labos-3d-object"></span>
        <span class="labos-3d-object"></span>
    </div>
    <div id="lab-auth-3d" class="lab-auth-3d" aria-hidden="true">
        <canvas id="lab-auth-3d-canvas"></canvas>
    </div>

    <main class="min-h-screen grid place-items-center px-4 py-5 md:px-8 md:py-8">
        <div class="w-full max-w-[980px]">
            @RenderBody()
        </div>
    </main>

    <partial name="_LabOsScripts" />
    <script type="module">
        import * as THREE from "https://unpkg.com/three@0.160.0/build/three.module.js";

        const mount = document.getElementById("lab-auth-3d");
        const canvas = document.getElementById("lab-auth-3d-canvas");
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        if (mount && canvas && !reduceMotion) {
            const isMobile = window.matchMedia("(max-width: 767px)").matches;
            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(44, 1, 0.1, 80);
            camera.position.set(0, 0, isMobile ? 9.8 : 8.2);

            const renderer = new THREE.WebGLRenderer({
                canvas,
                alpha: true,
                antialias: !isMobile,
                powerPreference: "high-performance"
            });
            renderer.setClearColor(0x000000, 0);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, isMobile ? 1 : 1.25));

            const rig = new THREE.Group();
            rig.position.set(isMobile ? 1.9 : -2.6, isMobile ? -0.4 : 0.2, 0);
            scene.add(rig);

            scene.add(new THREE.AmbientLight(0x9df8ff, 0.45));
            const cyanLight = new THREE.PointLight(0x38e8ff, 22, 20);
            cyanLight.position.set(-3, 2.5, 4);
            scene.add(cyanLight);
            const violetLight = new THREE.PointLight(0x8b5cf6, 16, 18);
            violetLight.position.set(4, -2, 3);
            scene.add(violetLight);

            const glass = new THREE.MeshPhysicalMaterial({
                color: 0x38e8ff,
                emissive: 0x0aa8ff,
                emissiveIntensity: 0.8,
                roughness: 0.16,
                metalness: 0.12,
                transparent: true,
                opacity: 0.72,
                transmission: 0.25
            });
            const core = new THREE.Mesh(new THREE.OctahedronGeometry(1.2, 3), glass);
            rig.add(core);

            const torusMaterial = new THREE.MeshBasicMaterial({ color: 0x38e8ff, transparent: true, opacity: 0.38 });
            const torusA = new THREE.Mesh(new THREE.TorusGeometry(2.4, 0.018, 10, 150), torusMaterial);
            const torusB = new THREE.Mesh(new THREE.TorusGeometry(3.25, 0.012, 10, 180), torusMaterial.clone());
            torusB.material.color.set("#ff4fd8");
            torusA.rotation.x = 1.15;
            torusB.rotation.x = 0.72;
            torusB.rotation.y = 0.7;
            rig.add(torusA, torusB);

            const nodeGeometry = new THREE.SphereGeometry(0.13, isMobile ? 12 : 18, isMobile ? 8 : 14);
            const nodeMaterial = new THREE.MeshBasicMaterial({ color: 0x7dffea });
            const nodeCount = isMobile ? 7 : 12;
            const nodes = [];
            for (let i = 0; i < nodeCount; i++) {
                const node = new THREE.Mesh(nodeGeometry, nodeMaterial.clone());
                node.material.color.set(i % 3 === 0 ? "#ff4fd8" : i % 3 === 1 ? "#38e8ff" : "#ff9f43");
                node.userData = {
                    radius: 2.1 + Math.random() * 1.5,
                    speed: 0.24 + Math.random() * 0.34,
                    phase: Math.random() * Math.PI * 2
                };
                nodes.push(node);
                rig.add(node);
            }

            const particlesCount = isMobile ? 70 : 140;
            const positions = new Float32Array(particlesCount * 3);
            for (let i = 0; i < particlesCount; i++) {
                positions[i * 3] = (Math.random() - 0.5) * 12;
                positions[i * 3 + 1] = (Math.random() - 0.5) * 8;
                positions[i * 3 + 2] = (Math.random() - 0.5) * 6;
            }
            const particleGeometry = new THREE.BufferGeometry();
            particleGeometry.setAttribute("position", new THREE.BufferAttribute(positions, 3));
            const particles = new THREE.Points(
                particleGeometry,
                new THREE.PointsMaterial({ color: 0x9df8ff, size: isMobile ? 0.032 : 0.024, transparent: true, opacity: 0.5, depthWrite: false })
            );
            scene.add(particles);

            const resize = () => {
                const rect = mount.getBoundingClientRect();
                renderer.setSize(Math.max(1, rect.width), Math.max(1, rect.height), false);
                camera.aspect = Math.max(1, rect.width) / Math.max(1, rect.height);
                camera.updateProjectionMatrix();
            };
            window.addEventListener("resize", resize, { passive: true });
            resize();

            let visible = document.visibilityState === "visible";
            let lastFrame = 0;
            const frameInterval = 1000 / (isMobile ? 30 : 42);
            document.addEventListener("visibilitychange", () => {
                visible = document.visibilityState === "visible";
            });

            const clock = new THREE.Clock();
            const animate = (now = 0) => {
                requestAnimationFrame(animate);
                if (!visible || now - lastFrame < frameInterval) return;
                lastFrame = now;
                const t = clock.getElapsedTime();
                core.rotation.set(t * 0.18, t * 0.28, t * 0.12);
                torusA.rotation.z = t * 0.18;
                torusB.rotation.z = -t * 0.12;
                rig.rotation.y = Math.sin(t * 0.24) * 0.22;
                nodes.forEach((node) => {
                    const d = node.userData;
                    const a = t * d.speed + d.phase;
                    node.position.set(Math.cos(a) * d.radius, Math.sin(a * 1.35) * 1.15, Math.sin(a) * d.radius * 0.5);
                });
                particles.rotation.y = t * 0.012;
                renderer.render(scene, camera);
            };
            animate();
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
