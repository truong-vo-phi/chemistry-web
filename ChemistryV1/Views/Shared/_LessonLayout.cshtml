@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLowerInvariant() ?? "";
}
<!DOCTYPE html>
<html class="dark h-full" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - Neon Lab</title>
    <meta name="description" content="@ViewData["Description"]" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    @Html.Partial("_StudentDesignSystem")
    @RenderSection("Head", required: false)
</head>
<body class="neon-lab-shell bg-background text-on-background h-full flex flex-col md:flex-row overflow-hidden relative">

    <div id="mobile-overlay" class="fixed inset-0 bg-black/60 z-40 backdrop-blur-sm md:hidden hidden" onclick="closeMobileSidebar()"></div>

    <nav id="lesson-mobile-sidebar" class="neon-sidebar w-full md:w-80 h-auto md:h-full flex flex-col flex-shrink-0 z-50 fixed left-0 top-0 transition-transform duration-300 -translate-x-full md:translate-x-0 md:static">
        <div class="p-6 border-b border-outline/50 flex justify-between items-center">
            <div>
                <h2 class="text-lg font-bold text-primary font-display mb-1 text-glow-primary">@ViewData["CourseTitle"]</h2>
                <p class="text-sm text-on-surface-variant font-label">Trình xem bài học</p>
            </div>
            <button onclick="closeMobileSidebar()" class="md:hidden p-2 rounded-lg hover:bg-surface-container-high text-on-surface-variant">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div class="flex-1 overflow-y-auto px-4 pb-6 space-y-2 custom-scrollbar">
            @RenderSection("LessonOutline", required: true)
        </div>
        <div class="p-4 border-t border-outline/50">
            <a class="w-full flex items-center justify-center gap-2 p-3 text-on-surface-variant hover:text-error hover:bg-red-500/10 rounded-lg transition-colors font-bold text-sm border border-transparent hover:border-error/30" href="@ViewData["CourseDetailsUrl"]">
                <span class="material-symbols-outlined">logout</span>
                Thoát khỏi khóa học
            </a>
        </div>
    </nav>

    <main class="flex-1 flex flex-col h-full relative overflow-y-auto">
        <header class="flex justify-between items-center p-4 md:px-8 md:py-6 glass-panel sticky top-0 z-10 mx-0 md:mx-4 md:mt-4 rounded-none md:rounded-xl border-x-0 md:border-x">
            <div class="flex items-center gap-4">
                <button onclick="openMobileSidebar()" class="md:hidden p-2 bg-surface-container-high rounded-lg text-primary border border-primary/30">
                    <span class="material-symbols-outlined">menu</span>
                </button>
                <span class="font-display font-bold text-primary text-glow-primary hidden sm:block">Neon Lab</span>
            </div>
            <div class="flex items-center gap-3">
                <button class="w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center text-on-surface-variant hover:text-primary border border-outline/50 transition-colors">
                    <span class="material-symbols-outlined">help_outline</span>
                </button>
            </div>
        </header>
        <div class="flex-1 px-4 md:px-8 pb-24 max-w-5xl mx-auto w-full flex flex-col justify-center">
            @RenderBody()
        </div>
        <div class="glass-panel border-t border-outline/50 p-4 md:p-6 sticky bottom-0 z-10 w-full md:mx-4 md:mb-4 md:rounded-xl">
            <div class="max-w-5xl mx-auto flex justify-between items-center gap-4">
                <a class="px-6 py-3 bg-surface-container-high rounded-xl text-on-surface-variant border border-outline/50 hover:border-primary/40 hover:text-primary transition-colors flex items-center gap-2 font-bold text-sm" href="@ViewData["CourseDetailsUrl"]">
                    <span class="material-symbols-outlined">arrow_back</span>
                    <span class="hidden md:inline">Quay lại khóa học</span>
                </a>
                @{
                    var isLessonCompleted = ViewData["IsLessonCompleted"] as bool? ?? false;
                }
                @if (isLessonCompleted)
                {
                    <button class="flex-1 md:flex-none px-8 py-3 bg-secondary text-on-secondary rounded-xl border border-secondary/40 btn-glow-green transition-colors flex items-center justify-center gap-2 font-label font-bold text-sm" disabled>
                        <span class="material-symbols-outlined fill-1">check_circle</span>
                        Đã hoàn thành
                    </button>
                }
                else
                {
                    <form asp-controller="Lessons" asp-action="MarkAsComplete" method="post" class="flex-1 md:flex-none">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="lessonId" value="@ViewData["LessonId"]" />
                        <button type="submit" class="w-full px-8 py-3 bg-primary text-on-primary rounded-xl border border-primary/40 hover:brightness-110 transition-all flex items-center justify-center gap-2 font-label font-bold text-sm btn-glow">
                            <span class="material-symbols-outlined fill-1">check_circle</span>
                            Đánh dấu hoàn thành
                        </button>
                    </form>
                }
            </div>
        </div>
    </main>

    <script>
        function openMobileSidebar() {
            document.getElementById('lesson-mobile-sidebar').classList.remove('-translate-x-full');
            document.getElementById('mobile-overlay').classList.remove('hidden');
            document.getElementById('mobile-overlay').style.display = 'block';
        }
        function closeMobileSidebar() {
            document.getElementById('lesson-mobile-sidebar').classList.add('-translate-x-full');
            document.getElementById('mobile-overlay').classList.add('hidden');
            document.getElementById('mobile-overlay').style.display = 'none';
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
