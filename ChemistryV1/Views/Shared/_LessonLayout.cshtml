@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLowerInvariant() ?? "";
}
<!DOCTYPE html>
<html class="dark h-dvh" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - Chemistry Lab</title>
    <meta name="description" content="@ViewData["Description"]" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    @Html.Partial("_StudentDesignSystem")
    @RenderSection("Head", required: false)
</head>
<body class="neon-lab-shell bg-background text-on-background h-dvh min-h-dvh flex flex-col md:flex-row overflow-hidden relative">

    <div id="mobile-overlay" class="fixed inset-0 bg-black/60 z-40 backdrop-blur-sm md:hidden hidden" onclick="closeMobileSidebar()"></div>

    <nav id="lesson-mobile-sidebar" class="neon-sidebar w-[min(100%,20rem)] md:w-80 h-dvh max-h-dvh flex flex-col flex-shrink-0 z-50 fixed left-0 top-0 transition-transform duration-300 -translate-x-full md:translate-x-0 md:static md:min-h-0 min-h-0">
        <div class="shrink-0 p-4 md:p-5 border-b border-outline/50 flex justify-between items-start gap-3">
            <div class="min-w-0 flex-1">
                <h2 class="text-base font-bold text-primary font-display leading-snug text-glow-primary line-clamp-2">@ViewData["CourseTitle"]</h2>
                <p class="text-[11px] text-on-surface-variant font-label mt-1">Trình xem bài học</p>
            </div>
            <button type="button" onclick="closeMobileSidebar()" class="md:hidden shrink-0 p-2 rounded-lg hover:bg-surface-container-high text-on-surface-variant" aria-label="Đóng menu">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div id="lesson-outline-scroll" class="lesson-outline-scroll flex-1 min-h-0 overflow-y-auto overflow-x-hidden px-3 py-3 custom-scrollbar">
            @RenderSection("LessonOutline", required: true)
        </div>
        @if (User.IsInRole("Admin"))
        {
            <div class="shrink-0 p-3 border-t border-outline/50 bg-surface-container/80">
                <a class="w-full flex items-center justify-center gap-2 p-2.5 text-on-surface-variant hover:text-error hover:bg-red-500/10 rounded-lg transition-colors font-bold text-xs border border-transparent hover:border-error/30" href="@ViewData["CourseDetailsUrl"]" data-turbo="false">
                <span class="material-symbols-outlined text-lg">logout</span>
                Thoát khỏi khóa học
                </a>
            </div>
        }
    </nav>

    <main class="flex-1 flex flex-col min-h-0 h-dvh md:h-full relative overflow-y-auto">
        <header class="flex justify-between items-center p-4 md:px-8 md:py-6 glass-panel sticky top-0 z-10 mx-0 md:mx-4 md:mt-4 rounded-none md:rounded-xl border-x-0 md:border-x">
            <div class="flex items-center gap-4">
                <button onclick="openMobileSidebar()" class="md:hidden p-2 bg-surface-container-high rounded-lg text-primary border border-primary/30">
                    <span class="material-symbols-outlined">menu</span>
                </button>
                <div class="font-display font-bold text-primary text-glow-primary hidden sm:flex items-center gap-2">
                    <img src="/images/LogoChemistry.png" alt="Chemistry Lab Logo" class="w-8 h-8" />
                    Chemistry Lab
                </div>
            </div>
            <div class="flex items-center gap-3">
                <button class="w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center text-on-surface-variant hover:text-primary border border-outline/50 transition-colors">
                    <span class="material-symbols-outlined">help_outline</span>
                </button>
            </div>
        </header>
        <div class="flex-1 px-4 md:px-8 pb-36 max-w-5xl mx-auto w-full min-h-0">
            @RenderBody()
        </div>
    </main>

    @{
        var isLessonCompleted = ViewData["IsLessonCompleted"] as bool? ?? false;
    }
    @if (User.IsInRole("Student"))
    {
        <footer id="lesson-action-bar" class="fixed bottom-0 left-0 right-0 md:left-80 z-50 border-t border-primary/30 bg-surface-container/95 backdrop-blur-md shadow-[0_-8px_32px_rgba(0,0,0,0.45)]">
            <div class="max-w-5xl mx-auto p-4 md:px-8 flex flex-col sm:flex-row justify-between items-stretch sm:items-center gap-3">
                <a class="px-5 py-3 bg-surface-container-high rounded-xl text-on-surface-variant border border-outline/50 hover:border-primary/40 hover:text-primary transition-colors flex items-center justify-center gap-2 font-bold text-sm shrink-0" href="@ViewData["CourseDetailsUrl"]" data-turbo="false">
                    <span class="material-symbols-outlined">arrow_back</span>
                    <span>Quay lại khóa học</span>
                </a>
                @if (isLessonCompleted)
                {
                    <button type="button" class="flex-1 sm:flex-none sm:min-w-[220px] px-8 py-3.5 bg-secondary text-on-secondary rounded-xl border-2 border-secondary/50 btn-glow-green flex items-center justify-center gap-2 font-label font-bold text-sm cursor-default" disabled aria-label="Đã hoàn thành">
                        <span class="material-symbols-outlined fill-1">check_circle</span>
                        Đã hoàn thành
                    </button>
                }
                else
                {
                    <form asp-controller="Lessons" asp-action="MarkAsComplete" method="post" class="flex-1 sm:flex-none sm:min-w-[220px] w-full">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="lessonId" value="@ViewData["LessonId"]" />
                        <button type="submit" class="w-full px-8 py-3.5 bg-primary text-[#003642] rounded-xl border-2 border-primary/60 hover:brightness-110 transition-all flex items-center justify-center gap-2 font-label font-bold text-sm btn-glow shadow-neon-blue">
                            <span class="material-symbols-outlined fill-1">check_circle</span>
                            Xác nhận đã hoàn thành
                        </button>
                    </form>
                }
            </div>
        </footer>
    }
    <script>
        function openMobileSidebar() {
            document.getElementById('lesson-mobile-sidebar').classList.remove('-translate-x-full');
            document.getElementById('mobile-overlay').classList.remove('hidden');
            document.getElementById('mobile-overlay').style.display = 'block';
        }
        function closeMobileSidebar() {
            document.getElementById('lesson-mobile-sidebar').classList.add('-translate-x-full');
            document.getElementById('mobile-overlay').classList.add('hidden');
            document.getElementById('mobile-overlay').style.display = 'none';
        }
        document.addEventListener('DOMContentLoaded', function () {
            var active = document.querySelector('#lesson-outline-scroll .lesson-outline-item--active');
            if (active) {
                active.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
