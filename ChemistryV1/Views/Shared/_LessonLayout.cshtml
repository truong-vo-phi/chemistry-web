<!DOCTYPE html>
<html class="dark h-dvh" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - ChemLab</title>
    <meta name="description" content="@ViewData["Description"]" />
    <link rel="icon" type="image/png" href="~/images/LogoChemistry.png" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <partial name="_StudentDesignSystem" />
    @RenderSection("Head", required: false)
</head>
<body class="neon-lab-shell bg-background text-on-background h-dvh min-h-dvh flex flex-col md:flex-row overflow-hidden relative">
    <div class="labos-global-3d" aria-hidden="true">
        <span class="labos-3d-object"></span>
        <span class="labos-3d-object"></span>
        <span class="labos-3d-object"></span>
    </div>
    <div id="mobile-overlay" class="fixed inset-0 bg-black/60 z-40 backdrop-blur-sm md:hidden hidden" onclick="closeMobileSidebar()"></div>

    <nav id="lesson-mobile-sidebar" class="neon-sidebar w-[min(100%,21rem)] md:w-[21rem] h-dvh max-h-dvh flex flex-col flex-shrink-0 z-50 fixed left-0 top-0 transition-transform duration-300 -translate-x-full md:translate-x-0 md:static md:min-h-0 min-h-0">
        <div class="shrink-0 p-4 md:p-5 border-b border-primary/15 flex justify-between items-start gap-3">
            <div class="min-w-0 flex-1">
                <p class="text-[10px] text-secondary font-label mb-1">Khoang b&#224;i h&#7885;c</p>
                <h2 class="text-base font-bold text-primary font-display leading-snug text-glow-primary line-clamp-2">@ViewData["CourseTitle"]</h2>
            </div>
            <button type="button" onclick="closeMobileSidebar()" class="md:hidden shrink-0 p-2 rounded-lg hover:bg-surface-container-high text-on-surface-variant" aria-label="&#272;&#243;ng menu">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div id="lesson-outline-scroll" class="lesson-outline-scroll flex-1 min-h-0 overflow-y-auto overflow-x-hidden px-3 py-3 custom-scrollbar">
            @RenderSection("LessonOutline", required: true)
        </div>
    </nav>

    <main class="flex-1 flex flex-col min-h-0 h-dvh md:h-full relative overflow-y-auto custom-scrollbar">
        <header class="flex justify-between items-center p-4 md:px-8 md:py-5 glass-panel sticky top-0 z-10 mx-0 md:mx-4 md:mt-4 rounded-none md:rounded-xl border-x-0 md:border-x">
            <div class="flex items-center gap-4">
                <button onclick="openMobileSidebar()" class="md:hidden p-2 bg-surface-container-high rounded-lg text-primary border border-primary/30">
                    <span class="material-symbols-outlined">menu</span>
                </button>
                <a asp-controller="Home" asp-action="Index" class="font-display font-bold text-primary text-glow-primary hidden sm:flex items-center gap-2">
                    <img src="/images/LogoChemistry.png" alt="Logo ChemLab" class="w-8 h-8" />
                    ChemLab
                </a>
            </div>
            <div class="flex items-center gap-3">
                <div class="hidden md:flex items-center gap-2 px-3 py-2 rounded-xl bg-secondary/10 text-secondary border border-secondary/20 text-xs font-label">
                    <span class="material-symbols-outlined text-base">sports_esports</span>
                    Ch&#7871; &#273;&#7897; luy&#7879;n t&#7853;p
                </div>
            </div>
        </header>
        @{
            var isLessonCompleted = ViewData["IsLessonCompleted"] as bool? ?? false;
            var returnUrl = ViewData["ReturnUrl"] as string;
            var showReturnToEditor = !string.IsNullOrWhiteSpace(returnUrl) && (User.IsInRole("Admin") || User.IsInRole("Teacher"));
        }
        <div class="lesson-body-content px-4 md:px-8 pt-5 pb-8 max-w-6xl mx-auto w-full min-h-0">
            @if (showReturnToEditor)
            {
                <div class="mb-5">
                    <a class="inline-flex items-center gap-2 px-5 py-3 rounded-xl glass-panel border border-primary/25 text-primary hover:border-primary/60 hover:text-on-background transition-colors font-bold text-sm" href="@returnUrl" data-turbo="false">
                        <span class="material-symbols-outlined">arrow_back</span>
                        Quay lại chỉnh sửa bài học
                    </a>
                </div>
            }

            @RenderBody()

            @if (User.IsInRole("Student"))
            {
                <footer id="lesson-action-bar" class="lesson-action-bar w-full mt-6">
                    <div class="lesson-action-bar-inner glass-panel p-3 md:p-4 flex flex-col sm:flex-row justify-between items-stretch sm:items-center gap-3">
                        <a class="lesson-action-secondary px-5 py-3 bg-surface-container-high rounded-xl text-on-surface-variant border border-outline/50 hover:border-primary/40 hover:text-primary transition-colors flex items-center justify-center gap-2 font-bold text-sm shrink-0" href="@ViewData["CourseDetailsUrl"]" data-turbo="false">
                            <span class="material-symbols-outlined">arrow_back</span>
                            <span>Quay l&#7841;i kh&#243;a h&#7885;c</span>
                        </a>
                        @if (isLessonCompleted)
                        {
                            <button type="button" class="lesson-action-primary sm:min-w-[220px] px-8 py-3.5 bg-secondary text-on-secondary rounded-xl border-2 border-secondary/50 btn-glow-green flex items-center justify-center gap-2 font-label font-bold text-sm cursor-default" disabled aria-label="&#272;&#227; ho&#224;n th&#224;nh">
                                <span class="material-symbols-outlined fill-1">check_circle</span>
                                &#272;&#227; ho&#224;n th&#224;nh
                            </button>
                        }
                        else
                        {
                            <form asp-controller="Lessons" asp-action="MarkAsComplete" method="post" class="lesson-complete-form sm:min-w-[260px] w-full sm:w-auto">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="lessonId" value="@ViewData["LessonId"]" />
                                <button type="submit" class="lesson-action-primary w-full px-8 py-3.5 bg-primary text-on-primary rounded-xl border-2 border-primary/60 hover:brightness-110 transition-all flex items-center justify-center gap-2 font-label font-bold text-sm btn-glow">
                                    <span class="material-symbols-outlined fill-1">check_circle</span>
                                    X&#225;c nh&#7853;n &#273;&#227; ho&#224;n th&#224;nh
                                </button>
                            </form>
                        }
                    </div>
                </footer>
            }
        </div>
    </main>

    <script>
        function openMobileSidebar() {
            document.getElementById('lesson-mobile-sidebar').classList.remove('-translate-x-full');
            document.getElementById('mobile-overlay').classList.remove('hidden');
            document.getElementById('mobile-overlay').style.display = 'block';
        }
        function closeMobileSidebar() {
            document.getElementById('lesson-mobile-sidebar').classList.add('-translate-x-full');
            document.getElementById('mobile-overlay').classList.add('hidden');
            document.getElementById('mobile-overlay').style.display = 'none';
        }
        document.addEventListener('DOMContentLoaded', function () {
            var active = document.querySelector('#lesson-outline-scroll .lesson-outline-item--active');
            if (active) {
                active.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            }

            document.querySelectorAll('textarea, input, [contenteditable="true"]').forEach(function (field) {
                field.addEventListener('focus', function () {
                    setTimeout(function () {
                        field.scrollIntoView({ block: 'center', behavior: 'smooth' });
                    }, 120);
                });
            });
        });
    </script>

    <partial name="_LabOsScripts" />
    @RenderSection("Scripts", required: false)
</body>
</html>
