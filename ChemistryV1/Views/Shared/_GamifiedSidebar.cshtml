@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLowerInvariant() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString()?.ToLowerInvariant() ?? "";

    var currentUserId = User.Identity?.IsAuthenticated == true 
        ? Convert.ToInt32(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value) 
        : 0;
    var currentUserName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Guest";
    var currentUserAvatar = User.FindFirst("AvatarUrl")?.Value ?? "https://via.placeholder.com/150";
    var currentUserRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Student";

    bool IsActive(string c, string a = "")
    {
        if (string.IsNullOrEmpty(a))
            return controller == c.ToLowerInvariant();
        return controller == c.ToLowerInvariant() && action == a.ToLowerInvariant();
    }
}

<!-- Mobile Sidebar Overlay -->
<div id="mobile-sidebar-overlay" class="fixed inset-0 bg-black/30 z-40 backdrop-blur-sm lg:hidden hidden" onclick="closeMobileSidebar()"></div>

<!-- SideNavBar -->
<aside id="mobile-sidebar" class="flex flex-col w-72 fixed left-0 top-0 h-full bg-white/70 backdrop-blur-xl border-r border-white/60 z-50 lg:flex py-10 px-8 shadow-xl transition-transform duration-300 -translate-x-full lg:translate-x-0">
    <div class="mb-10">
        <a asp-controller="Home" asp-action="Index" class="text-3xl font-bold text-primary tracking-tight font-display block">ChemLab</a>
    </div>

    <!-- User Profile Card -->
    <div class="flex items-center gap-4 p-4 mb-8 bg-white/60 rounded-2xl border border-white/80 shadow-sm">
        <div class="relative flex-shrink-0">
            <img alt="@currentUserName" class="w-12 h-12 rounded-full object-cover border-2 border-primary/20" src="@currentUserAvatar" />
            <div class="absolute bottom-0 right-0 w-3 h-3 bg-secondary border-2 border-white rounded-full"></div>
        </div>
        <div class="min-w-0">
            <p class="font-bold text-sm text-on-background leading-none mb-1 truncate">@currentUserName</p>
            <p class="text-[10px] text-slate-500 uppercase font-semibold tracking-widest">@currentUserRole</p>
        </div>
    </div>

    <nav class="flex-1 space-y-1 overflow-y-auto pr-1">
        <a class="flex items-center gap-4 p-4 transition-all duration-300 rounded-l-xl @(IsActive("Home", "Index") ? "sidebar-active text-primary font-bold" : "text-slate-500 hover:text-primary hover:translate-x-2 hover:bg-primary/5")" asp-controller="Home" asp-action="Index">
            <span class="material-symbols-outlined @(IsActive("Home", "Index") ? "fill-1" : "")">science</span>
            <span class="font-semibold text-sm">Lab Bench</span>
        </a>
        <a class="flex items-center gap-4 p-4 transition-all duration-300 rounded-l-xl @(IsActive("Courses") ? "sidebar-active text-primary font-bold" : "text-slate-500 hover:text-primary hover:translate-x-2 hover:bg-primary/5")" asp-controller="Courses" asp-action="Library">
            <span class="material-symbols-outlined @(IsActive("Courses") ? "fill-1" : "")">apps</span>
            <span class="font-semibold text-sm">Curriculum</span>
        </a>
        <a class="flex items-center gap-4 p-4 transition-all duration-300 rounded-l-xl @(IsActive("Profile") ? "sidebar-active text-primary font-bold" : "text-slate-500 hover:text-primary hover:translate-x-2 hover:bg-primary/5")" asp-controller="Profile" asp-action="Index">
            <span class="material-symbols-outlined @(IsActive("Profile") ? "fill-1" : "")">stars</span>
            <span class="font-semibold text-sm">My Progress</span>
        </a>
        <a class="flex items-center gap-4 p-4 transition-all duration-300 rounded-l-xl @(IsActive("Leaderboard") ? "sidebar-active text-primary font-bold" : "text-slate-500 hover:text-primary hover:translate-x-2 hover:bg-primary/5")" asp-controller="Leaderboard" asp-action="Index">
            <span class="material-symbols-outlined @(IsActive("Leaderboard") ? "fill-1" : "")">leaderboard</span>
            <span class="font-semibold text-sm">Leaderboard</span>
        </a>
        @if (User.IsInRole("Admin"))
        {
            <div class="h-px bg-slate-100 my-4"></div>
            <a class="flex items-center gap-4 p-4 transition-all duration-300 rounded-l-xl @(IsActive("Dashboard") ? "sidebar-active text-primary font-bold" : "text-slate-500 hover:text-primary hover:translate-x-2 hover:bg-primary/5")" asp-controller="Dashboard" asp-action="Index">
                <span class="material-symbols-outlined @(IsActive("Dashboard") ? "fill-1" : "")">dashboard</span>
                <span class="font-semibold text-sm">Admin Dashboard</span>
            </a>
            <a class="flex items-center gap-4 p-4 transition-all duration-300 rounded-l-xl @(IsActive("TeacherCourses") ? "sidebar-active text-primary font-bold" : "text-slate-500 hover:text-primary hover:translate-x-2 hover:bg-primary/5")" asp-controller="TeacherCourses" asp-action="Index">
                <span class="material-symbols-outlined @(IsActive("TeacherCourses") ? "fill-1" : "")">auto_stories</span>
                <span class="font-semibold text-sm">Manage Courses</span>
            </a>
        }
    </nav>

    <div class="mt-4 space-y-3">
        <form asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="w-full text-slate-500 hover:text-error flex items-center gap-3 p-3 rounded-2xl hover:bg-red-50 transition-all text-sm font-semibold">
                <span class="material-symbols-outlined text-lg">logout</span>
                Đăng xuất
            </button>
        </form>
        <a asp-controller="Courses" asp-action="Library" class="w-full bg-primary text-white font-bold text-sm py-4 rounded-2xl flex items-center justify-center gap-3 transition-all hover:scale-[1.02] active:scale-[0.98] btn-glow">
            <span class="material-symbols-outlined text-xl">add_circle</span>
            New Experiment
        </a>
    </div>
</aside>

<script>
    function openMobileSidebar() {
        const sidebar = document.getElementById('mobile-sidebar');
        const overlay = document.getElementById('mobile-sidebar-overlay');
        if (sidebar && overlay) {
            sidebar.classList.remove('-translate-x-full');
            overlay.classList.remove('hidden');
            overlay.classList.add('active');
        }
    }

    function closeMobileSidebar() {
        const sidebar = document.getElementById('mobile-sidebar');
        const overlay = document.getElementById('mobile-sidebar-overlay');
        if (sidebar && overlay) {
            sidebar.classList.add('-translate-x-full');
            overlay.classList.add('hidden');
            overlay.classList.remove('active');
        }
    }
</script>
