        border-radius: 1rem;
        color: var(--labos-cyan);
        background: rgba(6,18,40,.68);
        border: 1px solid rgba(56,232,255,.24);
        box-shadow: 0 18px 48px rgba(0,0,0,.28), 0 0 30px rgba(56,232,255,.13);
        backdrop-filter: blur(16px);
