    @@keyframes lab-grid-drift { to { background-position: 54px 54px; } }
    @@keyframes blob-orbit { from { transform: translate3d(0,0,0) scale(1); } to { transform: translate3d(34px,-26px,0) scale(1.08); } }
    @@keyframes panel-sheen { to { transform: translateX(110%); } }
    @@keyframes ridge-float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
    @@keyframes floor-scan { to { background-position: 44px 38px; } }
    @@keyframes city-glow { 0%,100% { opacity: .62; } 50% { opacity: .94; } }
    @@keyframes orbit-spin { to { transform: rotate(360deg); } }
    @@keyframes particle-rise { 0% { transform: translateY(0) scale(.7); opacity: 0; } 18% { opacity: 1; } 100% { transform: translateY(-18rem) scale(1.2); opacity: 0; } }
    @@keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
    @@keyframes title-rise { from { opacity: 0; transform: translateY(22px); filter: blur(8px); } to { opacity: 1; transform: translateY(0); filter: blur(0); } }
