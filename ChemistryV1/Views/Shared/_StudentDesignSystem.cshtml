    /* LabOS v2: Futuristic Chemistry Command Center design system.
       Tokens: deep navy substrate, cyan primary energy, ultraviolet depth, magenta/orange reaction accents.
       Motion: short, soft, physically plausible; hover lifts are subtle, glow responds like emitted light. */
    :root {
        --labos-void: #020617;
        --labos-navy: #061128;
        --labos-panel: rgba(8, 18, 39, .72);
        --labos-panel-strong: rgba(10, 24, 52, .92);
        --labos-cyan: #38e8ff;
        --labos-blue: #3b82ff;
        --labos-violet: #8b5cf6;
        --labos-magenta: #ff4fd8;
        --labos-amber: #ff9f43;
        --labos-line: rgba(104, 232, 255, .24);
        --labos-line-hot: rgba(56, 232, 255, .58);
        --labos-text: #f4fbff;
        --labos-muted: #a9bed6;
        --labos-radius-sm: .75rem;
        --labos-radius-md: 1rem;
        --labos-radius-lg: 1.35rem;
        --labos-shadow-soft: 0 24px 80px rgba(0,0,0,.42);
        --labos-shadow-glow: 0 0 34px rgba(56,232,255,.22), 0 0 86px rgba(139,92,246,.12);
        --labos-ease: cubic-bezier(.2,.8,.2,1);
    }

    body.neon-lab-shell {
        background:
            radial-gradient(circle at 18% 8%, rgba(56,232,255,.20), transparent 28rem),
            radial-gradient(circle at 82% 2%, rgba(139,92,246,.24), transparent 30rem),
            radial-gradient(circle at 78% 72%, rgba(255,79,216,.12), transparent 26rem),
            radial-gradient(circle at 18% 92%, rgba(255,159,67,.10), transparent 28rem),
            linear-gradient(145deg, #020617 0%, #061128 48%, #030716 100%);
        color: var(--labos-text);
    }

    body.neon-lab-shell::before {
        background-image:
            linear-gradient(rgba(56,232,255,.055) 1px, transparent 1px),
            linear-gradient(90deg, rgba(56,232,255,.055) 1px, transparent 1px),
            radial-gradient(circle at 50% 50%, rgba(255,255,255,.08) 0 1px, transparent 1px);
        background-size: 56px 56px, 56px 56px, 120px 120px;
        opacity: .9;
    }

    .neon-lab-shell::selection {
        background: rgba(56,232,255,.28);
        color: white;
    }

    .neon-lab-shell .glass-card,
    .neon-lab-shell .glass-panel,
    .neon-lab-shell .collectible-border,
    .neon-lab-shell table,
    .neon-lab-shell .rounded-xl,
    .neon-lab-shell .rounded-2xl,
    .neon-lab-shell .rounded-3xl {
        position: relative;
    }

    .neon-lab-shell .glass-card,
    .neon-lab-shell .glass-panel {
        background:
            linear-gradient(145deg, rgba(255,255,255,.105), rgba(255,255,255,.026) 38%, rgba(56,232,255,.035)),
            radial-gradient(circle at 18% 0%, rgba(56,232,255,.13), transparent 16rem),
            var(--labos-panel);
        border: 1px solid var(--labos-line);
        border-radius: var(--labos-radius-lg);
        box-shadow: var(--labos-shadow-soft), inset 0 1px 0 rgba(255,255,255,.10), var(--labos-shadow-glow);
        backdrop-filter: blur(24px) saturate(145%);
        -webkit-backdrop-filter: blur(24px) saturate(145%);
    }

    .neon-lab-shell .glass-card::after,
    .neon-lab-shell .glass-panel::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        pointer-events: none;
        background:
            linear-gradient(135deg, rgba(255,255,255,.18), transparent 18% 78%, rgba(56,232,255,.16)),
            linear-gradient(90deg, transparent, rgba(56,232,255,.10), transparent);
        opacity: .46;
        mix-blend-mode: screen;
    }

    .neon-lab-shell .cinematic-card,
    .neon-lab-shell .glass-card,
    .neon-lab-shell .collectible-border,
    .neon-lab-shell article {
        transition: transform .36s var(--labos-ease), border-color .36s var(--labos-ease), box-shadow .36s var(--labos-ease), filter .36s var(--labos-ease);
    }

    .neon-lab-shell .cinematic-card:hover,
    .neon-lab-shell .glass-card:hover,
    .neon-lab-shell .collectible-border:hover,
    .neon-lab-shell article:hover {
        transform: perspective(900px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg)) translateY(-7px);
        border-color: var(--labos-line-hot);
        box-shadow: 0 34px 100px rgba(0,0,0,.48), 0 0 46px rgba(56,232,255,.22), 0 0 90px rgba(139,92,246,.13);
    }

    .neon-lab-shell main {
        animation: labos-page-in .52s var(--labos-ease) both;
    }

    .neon-lab-shell .neon-sidebar {
        background:
            linear-gradient(180deg, rgba(9, 20, 43, .96), rgba(3, 7, 18, .94)),
            radial-gradient(circle at 0% 0%, rgba(56,232,255,.16), transparent 18rem);
        border-right: 1px solid rgba(56,232,255,.24);
        box-shadow: 18px 0 80px rgba(0,0,0,.42), inset -1px 0 0 rgba(255,255,255,.04);
    }

    .neon-lab-shell .sidebar-active,
    .neon-lab-shell .neon-nav-link:hover {
        background:
            linear-gradient(90deg, rgba(56,232,255,.22), rgba(139,92,246,.10), transparent),
            rgba(56,232,255,.04);
        color: var(--labos-cyan) !important;
        border-color: rgba(56,232,255,.42);
        box-shadow: inset 0 0 28px rgba(56,232,255,.10), 0 0 24px rgba(56,232,255,.08);
    }

    .neon-lab-shell .cinematic-topbar,
    .neon-lab-shell header.glass-panel {
        background:
            linear-gradient(135deg, rgba(255,255,255,.12), rgba(255,255,255,.035)),
            rgba(4, 10, 25, .66);
        border-color: rgba(104,232,255,.24) !important;
        box-shadow: 0 18px 70px rgba(0,0,0,.36), inset 0 1px 0 rgba(255,255,255,.10);
    }

    .neon-lab-shell button,
    .neon-lab-shell .btn-glow,
    .neon-lab-shell .glow-button,
    .neon-lab-shell a.bg-primary,
    .neon-lab-shell button.bg-primary,
    .neon-lab-shell input[type="submit"] {
        border-radius: var(--labos-radius-md);
        transition: transform .26s var(--labos-ease), box-shadow .26s var(--labos-ease), filter .26s var(--labos-ease), background .26s var(--labos-ease);
    }

    .neon-lab-shell .bg-primary,
    .neon-lab-shell a.bg-primary,
    .neon-lab-shell button.bg-primary {
        background:
            linear-gradient(135deg, #77f4ff 0%, #38e8ff 34%, #4f8cff 100%) !important;
        color: #03111f !important;
        box-shadow: 0 0 30px rgba(56,232,255,.34), 0 18px 44px rgba(0,0,0,.24);
    }

    .neon-lab-shell button:hover,
    .neon-lab-shell a.bg-primary:hover,
    .neon-lab-shell button.bg-primary:hover {
        transform: translateY(-2px) scale(1.012);
        filter: saturate(1.08) brightness(1.04);
    }

    .neon-lab-shell input,
    .neon-lab-shell select,
    .neon-lab-shell textarea {
        min-height: 2.75rem;
        border-radius: var(--labos-radius-md) !important;
        background:
            linear-gradient(180deg, rgba(255,255,255,.055), rgba(255,255,255,.018)),
            rgba(3, 9, 22, .76) !important;
        border-color: rgba(104,232,255,.24) !important;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.06);
    }

    .neon-lab-shell label {
        color: #c7d9ef;
        font-weight: 700;
    }

    .neon-lab-shell table {
        width: 100%;
        overflow: hidden;
        border-collapse: separate;
        border-spacing: 0;
        border: 1px solid rgba(104,232,255,.20);
        border-radius: var(--labos-radius-lg);
        background: rgba(5, 13, 30, .70);
        box-shadow: var(--labos-shadow-soft);
    }

    .neon-lab-shell thead,
    .neon-lab-shell th {
        background: linear-gradient(90deg, rgba(56,232,255,.13), rgba(139,92,246,.10));
        color: #eaf9ff;
        font-family: "Be Vietnam Pro", sans-serif;
        letter-spacing: 0;
        text-transform: none;
        font-size: .72rem;
        line-height: 1.35;
    }

    .neon-lab-shell th,
    .neon-lab-shell td {
        border-bottom: 1px solid rgba(104,232,255,.12);
        padding: .9rem 1rem;
    }

    .neon-lab-shell tbody tr {
        transition: background .24s ease, transform .24s ease;
    }

    .neon-lab-shell tbody tr:hover {
        background: rgba(56,232,255,.065);
    }

    .neon-lab-shell .progress,
    .neon-lab-shell [class*="rounded-full"][class*="bg-surface-container"],
    .neon-lab-shell [class*="rounded-full"][class*="bg-slate"] {
        box-shadow: inset 0 0 18px rgba(0,0,0,.32);
    }

    .neon-lab-shell .xp-glow,
    .neon-lab-shell [style*="width:"] {
        transition: width 1s var(--labos-ease), filter .3s ease;
    }

    .neon-lab-shell .labos-skeleton {
        overflow: hidden;
        background: linear-gradient(90deg, rgba(255,255,255,.04), rgba(56,232,255,.10), rgba(255,255,255,.04));
        background-size: 240% 100%;
        animation: labos-skeleton 1.8s ease-in-out infinite;
    }

    .neon-lab-shell .cinematic-hero {
        box-shadow: 0 50px 140px rgba(0,0,0,.58), 0 0 90px rgba(56,232,255,.20), inset 0 1px 0 rgba(255,255,255,.12);
    }

    .neon-lab-shell .lab-hero-3d {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
        opacity: .96;
    }

    .neon-lab-shell .lab-hero-3d canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        filter: saturate(1.1) contrast(1.05);
    }

    .neon-lab-shell .lab-hero-3d::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 2;
        pointer-events: none;
        background:
            radial-gradient(circle at 68% 40%, transparent 0 18rem, rgba(3,7,18,.18) 28rem),
            linear-gradient(90deg, rgba(3,7,18,.82) 0 36%, transparent 62%),
            linear-gradient(180deg, rgba(3,7,18,.18), rgba(3,7,18,.62));
    }

    .neon-lab-shell .lab-hero-3d-fallback {
        position: absolute;
        right: 7%;
        top: 10%;
        width: min(38rem, 60vw);
        aspect-ratio: 1;
        opacity: .72;
        transform-style: preserve-3d;
        perspective: 900px;
    }

    .neon-lab-shell .fallback-core {
        position: absolute;
        inset: 35%;
        border-radius: 999px;
        background: radial-gradient(circle, #8ff8ff, #38e8ff 46%, rgba(139,92,246,.2));
        box-shadow: 0 0 42px rgba(56,232,255,.66), 0 0 120px rgba(139,92,246,.26);
        animation: labos-pulse-core 2.8s ease-in-out infinite;
    }

    .neon-lab-shell .fallback-ring {
        position: absolute;
        inset: 15%;
        border: 1px solid rgba(56,232,255,.34);
        border-radius: 999px;
        box-shadow: inset 0 0 36px rgba(56,232,255,.12), 0 0 42px rgba(56,232,255,.12);
        animation: labos-ring-spin 12s linear infinite;
    }

    .neon-lab-shell .lab-auth-3d {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
        opacity: .9;
    }

    .neon-lab-shell > main {
        position: relative;
        z-index: 1;
    }

    .neon-lab-shell .lab-auth-3d canvas {
        width: 100%;
        height: 100%;
        display: block;
    }

    .neon-lab-shell .lab-auth-3d::after {
        content: "";
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at 24% 44%, transparent 0 18rem, rgba(3,7,18,.24) 28rem),
            linear-gradient(90deg, rgba(3,7,18,.26), rgba(3,7,18,.72) 58%, rgba(3,7,18,.36)),
            linear-gradient(180deg, rgba(3,7,18,.20), rgba(3,7,18,.64));
    }

    .neon-lab-shell .labos-visual-stage {
        position: absolute;
        right: clamp(1rem, 5vw, 5rem);
        top: 50%;
        width: min(31rem, 42vw);
        aspect-ratio: 1.05;
        transform: translateY(-50%);
        pointer-events: none;
        perspective: 900px;
        opacity: .88;
    }

    .neon-lab-shell .labos-visual-stage::before {
        content: "";
        position: absolute;
        inset: 16%;
        border-radius: 999px;
        border: 1px solid rgba(56,232,255,.32);
        box-shadow: 0 0 46px rgba(56,232,255,.18), inset 0 0 36px rgba(139,92,246,.12);
        transform: rotateX(68deg) rotateZ(-18deg);
        animation: labos-stage-spin 18s linear infinite;
    }

    .neon-lab-shell .labos-visual-stage::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: 2%;
        width: 86%;
        height: 28%;
        transform: translateX(-50%) rotateX(72deg);
        background:
            repeating-linear-gradient(90deg, rgba(56,232,255,.22) 0 1px, transparent 1px 28px),
            repeating-linear-gradient(0deg, rgba(139,92,246,.18) 0 1px, transparent 1px 24px);
        border: 1px solid rgba(56,232,255,.18);
        border-radius: 1rem;
        filter: drop-shadow(0 0 24px rgba(56,232,255,.20));
        opacity: .68;
    }

    .neon-lab-shell .labos-visual-core {
        position: absolute;
        inset: 32%;
        border-radius: 1.45rem;
        background:
            linear-gradient(145deg, rgba(255,255,255,.22), rgba(56,232,255,.18)),
            radial-gradient(circle at 32% 24%, rgba(255,255,255,.7), transparent 22%),
            linear-gradient(135deg, rgba(56,232,255,.72), rgba(139,92,246,.5));
        border: 1px solid rgba(255,255,255,.24);
        box-shadow: 0 0 52px rgba(56,232,255,.42), 0 0 120px rgba(139,92,246,.22);
        transform: rotateX(58deg) rotateZ(45deg);
        animation: labos-core-float 5.2s ease-in-out infinite;
    }

    .neon-lab-shell .labos-visual-chip {
