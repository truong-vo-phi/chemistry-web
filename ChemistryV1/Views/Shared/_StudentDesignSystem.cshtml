        .neon-lab-shell .stage-city,
        .neon-lab-shell .lab-orbit,
        .neon-lab-shell .molecule-field span,
        .neon-lab-shell .animate-float {
            animation: none !important;
        }
        .neon-lab-shell [data-reveal] {
            opacity: 1 !important;
            transform: none !important;
            filter: none !important;
        }
