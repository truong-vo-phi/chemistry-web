@model ChemistryV1.ViewModels.CategoryCreateEditViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Category - @Model.Category.Name";
    ViewData["Description"] = "Edit category details and settings.";
}

<!-- Breadcrumb -->
<nav class="flex items-center gap-2 mb-6 text-sm text-slate-500">
    <a class="hover:text-primary transition-colors" asp-controller="Categories" asp-action="Index">Categories</a>
    <span class="material-symbols-outlined text-sm opacity-50">chevron_right</span>
    <span class="text-primary font-bold">Edit @Model.Category.Name</span>
</nav>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-on-background font-display">Edit Category</h1>
    <p class="text-slate-500 mt-1">Update category details and manage accessibility settings.</p>
</div>

<form asp-action="Edit" asp-route-id="@Model.Category.Id" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Category.Id" />
    <input type="hidden" id="category-icon" name="Category.Icon" value="@Model.Category.Icon" />
    <input type="hidden" id="category-isactive" name="Category.IsActive" value="@Model.Category.IsActive.ToString().ToLower()" />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Left Column - Form -->
        <div class="lg:col-span-5 space-y-6">
            <section class="glass-card p-6 relative overflow-hidden">
                <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-full blur-3xl -mr-16 -mt-16"></div>
                <h3 class="text-lg font-bold text-on-background mb-6 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">edit_note</span>
                    Category Details
                </h3>
                <div class="space-y-6 relative z-10">
                    <div class="space-y-2">
                        <label class="text-xs font-bold text-slate-600 uppercase tracking-widest">Category Name</label>
                        <input class="w-full h-14 bg-white border-2 border-slate-200 focus:border-primary focus:ring-4 focus:ring-primary/5 rounded-2xl px-6 text-lg text-on-background transition-all" type="text" asp-for="Category.Name" oninput="generateSlug(this.value)" required />
                        <span class="text-red-500 text-xs">@Html.ValidationMessageFor(m => m.Category.Name)</span>
                    </div>

                    <div class="space-y-2">
                        <label class="text-xs font-bold text-slate-600 uppercase tracking-widest">Slug</label>
                        <input class="w-full h-14 bg-white border-2 border-slate-200 focus:border-primary focus:ring-4 focus:ring-primary/5 rounded-2xl px-6 text-md text-on-background transition-all bg-slate-50 cursor-not-allowed" type="text" id="cat-slug" asp-for="Category.Slug" readonly required />
                        <span class="text-red-500 text-xs">@Html.ValidationMessageFor(m => m.Category.Slug)</span>
                    </div>

                    <div class="space-y-3">
                        <label class="text-xs font-bold text-slate-600 uppercase tracking-widest">Assigned Icon</label>
                        <div id="category-icon-grid" class="grid grid-cols-4 gap-3 p-4 bg-slate-50 rounded-2xl border border-slate-200">
                            @foreach (var icon in Model.AvailableIcons)
                            {
                                <button type="button" class="flex flex-col items-center justify-center p-3 rounded-xl border-2 border-transparent overflow-hidden transition-all group active:scale-95 @(Model.Category.Icon == icon ? "icon-aura-active" : "bg-white hover:bg-white hover:shadow-md text-slate-400 border-slate-200")" onclick="setIcon('@icon', this)">
                                    <span class="material-symbols-outlined block leading-none text-[28px]">@icon</span>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-xs font-bold text-slate-600 uppercase tracking-widest">Description</label>
                        <textarea class="w-full bg-white border-2 border-slate-200 focus:border-primary focus:ring-4 focus:ring-primary/5 rounded-2xl px-6 py-4 text-md text-on-background transition-all resize-none" rows="4" asp-for="Category.Description"></textarea>
                    </div>

                    <div class="flex flex-col gap-3 pt-4">
                        <button type="submit" class="h-14 w-full text-white rounded-2xl font-bold flex items-center justify-center gap-2 btn-glow">
                            <span class="material-symbols-outlined">save</span>
                            Lưu thay đổi
                        </button>
                        <a class="h-14 w-full text-red-600 rounded-2xl font-bold flex items-center justify-center gap-2 border-2 border-red-200 hover:bg-red-50 transition-colors" asp-action="Delete" asp-route-id="@Model.Category.Id">
                            <span class="material-symbols-outlined">delete</span>
                            Xóa danh mục
                        </a>
                    </div>
                </div>
            </section>

            <section class="glass-card p-6">
                <h4 class="text-lg font-bold text-slate-600 mb-6 flex items-center gap-2">
                    <span class="material-symbols-outlined text-secondary">analytics</span>
                    Tương tác danh mục
                </h4>
                <div class="grid grid-cols-2 gap-6">
                    <div class="flex flex-col items-center text-center space-y-3">
                        <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center border-2 border-primary/20">
                            <span class="font-bold text-primary text-sm">100%</span>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Khả năng hiển thị</p>
                            <p class="text-lg font-bold text-primary">Công khai</p>
                        </div>
                    </div>
                    <div class="flex flex-col items-center text-center space-y-3">
                        <div class="w-16 h-16 rounded-full bg-secondary/10 flex items-center justify-center border-2 border-secondary/20">
                            <span class="font-bold text-secondary text-sm">@Model.CourseCount</span>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Khóa học</p>
                            <p class="text-lg font-bold text-secondary">Đã liên kết</p>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- Right Column - Status & Metadata -->
        <div class="lg:col-span-7">
            <section class="glass-card h-full flex flex-col overflow-hidden">
                <div class="p-6 border-b-2 border-slate-200 flex justify-between items-center">
                    <div>
                        <h3 class="text-lg font-bold text-on-background">Category Status</h3>
                        <p class="text-sm text-slate-500">Control accessibility for students</p>
                    </div>
                    <div class="flex items-center gap-4">
                        <span class="text-xs font-bold text-slate-500 uppercase tracking-widest" id="status-label">@(Model.Category.IsActive ? "Active" : "Draft")</span>
                        <button class="relative inline-flex h-10 w-16 items-center rounded-full @(Model.Category.IsActive ? "bg-secondary" : "bg-slate-300") transition-colors focus:outline-none shadow-inner" id="status-toggle" onclick="toggleStatus()" type="button">
                            <span class="inline-block h-7 w-7 @(Model.Category.IsActive ? "translate-x-7" : "translate-x-1") transform rounded-full bg-white shadow-md transition-transform" id="toggle-circle"></span>
                        </button>
                    </div>
                </div>
                <div class="p-6 flex-grow">
                    <div class="bg-primary/10 p-6 rounded-2xl border border-primary/20 mb-6">
                        <h4 class="font-bold text-primary mb-2 flex items-center gap-2">
                            <span class="material-symbols-outlined text-sm">info</span>
                            Didactic Tip
                        </h4>
                        <p class="text-sm text-slate-600 leading-relaxed">
                            Grouping your experiments into clear categories helps students progress faster through the curriculum. Ensure your names are evocative and descriptive!
                        </p>
                    </div>
                    
                    <div>
                        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4">Metadata</h4>
                        <div class="space-y-3">
                            <div class="flex justify-between items-center p-4 bg-slate-50 rounded-xl border border-slate-200">
                                <span class="text-sm font-medium text-slate-600">Created On</span>
                                <span class="text-sm font-bold text-on-background">@Model.CreatedDate?.ToString("MMM dd, yyyy")</span>
                            </div>
                            <div class="flex justify-between items-center p-4 bg-slate-50 rounded-xl border border-slate-200">
                                <span class="text-sm font-medium text-slate-600">Last Updated</span>
                                <span class="text-sm font-bold text-on-background">@Model.Category.UpdatedAt?.ToString("MMM dd, yyyy HH:mm")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</form>

@section Head {
    <style>
        .icon-aura-active {
            background: #0058be;
            color: #ffffff;
            box-shadow: 0 10px 20px -5px rgba(0, 88, 190, 0.3);
            transform: scale(1.1);
        }
    </style>
}

@section Scripts {
    <script>
        let isActive = @Model.Category.IsActive.ToString().ToLower();
        function toggleStatus() {
            isActive = !isActive;
            const toggle = document.getElementById('status-toggle');
            const circle = document.getElementById('toggle-circle');
            const label = document.getElementById('status-label');
            const hiddenInput = document.getElementById('category-isactive');
            
            hiddenInput.value = isActive;
            label.textContent = isActive ? "Active" : "Draft";
 
            if (isActive) {
                toggle.classList.remove('bg-slate-300');
                toggle.classList.add('bg-secondary');
                circle.classList.add('translate-x-7');
                circle.classList.remove('translate-x-1');
            } else {
                toggle.classList.remove('bg-secondary');
                toggle.classList.add('bg-slate-300');
                circle.classList.add('translate-x-1');
                circle.classList.remove('translate-x-7');
            }
        }

        function setIcon(icon, btn) {
            const iconGrid = document.getElementById('category-icon-grid');
            iconGrid.querySelectorAll('button').forEach(b => {
                b.classList.remove('icon-aura-active');
                b.classList.add('bg-white', 'text-slate-400', 'border-slate-200');
            });
            btn.classList.add('icon-aura-active');
            btn.classList.remove('bg-white', 'text-slate-400', 'border-slate-200');
            document.getElementById('category-icon').value = icon;
        }

        function generateSlug(name) {
            let str = name.toLowerCase();
            str = str.replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g, "a");
            str = str.replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ/g, "e");
            str = str.replace(/ì|í|ị|ỉ|ĩ/g, "i");
            str = str.replace(/ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ/g, "o");
            str = str.replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g, "u");
            str = str.replace(/ỳ|ý|ỵ|ỷ|ỹ/g, "y");
            str = str.replace(/đ/g, "d");
            
            str = str.replace(/[^a-z0-9\s-]/g, "");
            str = str.replace(/\s+/g, "-");
            str = str.replace(/-+/g, "-");
            str = str.trim().replace(/^-+|-+$/g, "");
            
            document.getElementById('cat-slug').value = str;
        }

        document.addEventListener('DOMContentLoaded', () => {
            const nameInput = document.getElementById('Category_Name');
            generateSlug(nameInput ? nameInput.value : '');
        });
    </script>
}
