@model ChemistryV1.ViewModels.CategoryCreateEditViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@Model.PageTitle - ChemLab 3D</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;600;700&amp;family=Quicksand:wght@500;600;700&amp;family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-variant": "#e4e3db",
                        "surface": "#fbf9f1",
                        "tertiary": "#825100",
                        "surface-container-high": "#eae8e0",
                        "on-background": "#1b1c17",
                        "inverse-on-surface": "#f3f1e9",
                        "surface-tint": "#005ac2",
                        "surface-container-lowest": "#ffffff",
                        "on-surface": "#1b1c17",
                        "on-error": "#ffffff",
                        "tertiary-container": "#a36700",
                        "on-primary": "#ffffff",
                        "surface-container": "#f0eee6",
                        "secondary-container": "#6cf8bb",
                        "on-secondary-container": "#00714d",
                        "secondary": "#006c49",
                        "inverse-surface": "#30312c",
                        "primary-fixed-dim": "#adc6ff",
                        "on-primary-container": "#fefcff",
                        "surface-dim": "#dcdad2",
                        "on-secondary-fixed": "#002113",
                        "on-error-container": "#93000a",
                        "secondary-fixed": "#6ffbbe",
                        "on-primary-fixed-variant": "#004395",
                        "primary-fixed": "#d8e2ff",
                        "surface-bright": "#fbf9f1",
                        "primary": "#0058be",
                        "on-surface-variant": "#424754",
                        "on-tertiary-fixed-variant": "#653e00",
                        "on-primary-fixed": "#001a42",
                        "inverse-primary": "#adc6ff",
                        "on-secondary-fixed-variant": "#005236",
                        "surface-container-low": "#f5f4ec",
                        "error-container": "#ffdad6",
                        "primary-container": "#2170e4",
                        "background": "#fbf9f1",
                        "secondary-fixed-dim": "#4edea3",
                        "outline": "#727785",
                        "on-tertiary-fixed": "#2a1700",
                        "tertiary-fixed-dim": "#ffb95f",
                        "on-tertiary-container": "#fffbff",
                        "on-secondary": "#ffffff",
                        "outline-variant": "#c2c6d6",
                        "tertiary-fixed": "#ffddb8",
                        "surface-container-highest": "#e4e3db",
                        "on-tertiary": "#ffffff",
                        "error": "#ba1a1a"
                    },
                    "borderRadius": {
                        "DEFAULT": "1rem",
                        "lg": "2rem",
                        "xl": "3rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "margin-desktop": "48px",
                        "gutter": "24px",
                        "margin-mobile": "16px",
                        "container-max": "1200px",
                        "unit": "8px"
                    },
                    "fontFamily": {
                        "label-sm": ["Lexend", "sans-serif"],
                        "display-lg": ["Lexend", "sans-serif"],
                        "headline-md": ["Lexend", "sans-serif"],
                        "body-md": ["Quicksand", "sans-serif"],
                        "display-lg-mobile": ["Lexend", "sans-serif"],
                        "body-lg": ["Quicksand", "sans-serif"]
                    },
                    "fontSize": {
                        "label-sm": ["14px", { "lineHeight": "1.2", "fontWeight": "600" }],
                        "display-lg": ["48px", { "lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "headline-md": ["24px", { "lineHeight": "1.4", "fontWeight": "600" }],
                        "body-md": ["16px", { "lineHeight": "1.6", "fontWeight": "500" }],
                        "display-lg-mobile": ["32px", { "lineHeight": "1.2", "fontWeight": "700" }],
                        "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "500" }]
                    }
                }
            }
        }
    </script>
    <style>
        .premium-glass {
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            box-shadow: 0 8px 32px 0 rgba(0, 88, 190, 0.05);
        }

        .squishy-button {
            transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.2s;
        }
        .squishy-button:active {
            transform: scale(0.95) translateY(2px);
            box-shadow: none;
        }

        .icon-aura-active {
            background: radial-gradient(circle, #d8e2ff 0%, #fbf9f1 100%);
            border: 2px solid #0058be;
            box-shadow: 0 10px 20px -5px rgba(0, 88, 190, 0.3), inset 0 -4px 0 0 rgba(0, 88, 190, 0.2);
            transform: translateY(-4px);
        }

        .floating-element {
            animation: float 6s ease-in-out infinite;
        }
        @@keyframes float {
            0% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(5deg); }
            100% { transform: translateY(0px) rotate(0deg); }
        }

        .sparkle-slow {
            animation: sparkle 4s ease-in-out infinite;
        }
        @@keyframes sparkle {
            0%, 100% { opacity: 0.3; transform: scale(1); }
            50% { opacity: 0.8; transform: scale(1.2); }
        }

        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #fbf9f1;
        }
        ::-webkit-scrollbar-thumb {
            background: #c2c6d6;
            border-radius: 4px;
        }

        .refined-heading {
            letter-spacing: -0.015em;
        }
    </style>
</head>
<body class="bg-background text-on-background font-body-md min-h-screen relative overflow-x-hidden">
    <div class="fixed inset-0 pointer-events-none z-0">
        <div class="absolute top-20 left-[10%] opacity-20 floating-element text-primary">
            <span class="material-symbols-outlined text-[64px]">hub</span>
        </div>
        <div class="absolute bottom-40 right-[15%] opacity-15 floating-element text-secondary" style="animation-delay: -2s;">
            <span class="material-symbols-outlined text-[80px]">blur_on</span>
        </div>
        <div class="absolute top-1/2 right-[5%] opacity-10 sparkle-slow text-tertiary">
            <span class="material-symbols-outlined text-4xl">auto_awesome</span>
        </div>
    </div>

    <aside class="h-screen w-64 fixed left-0 top-0 hidden md:flex flex-col bg-surface-container-low dark:bg-inverse-surface border-r-2 border-outline-variant dark:border-outline shadow-md z-40 p-gutter gap-unit">
        <div class="mb-gutter flex items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-primary flex items-center justify-center shadow-lg">
                <span class="material-symbols-outlined text-on-primary">school</span>
            </div>
            <div>
                <h2 class="font-display-lg text-headline-md text-primary leading-tight refined-heading">Academy</h2>
                <p class="font-label-sm text-label-sm text-on-surface-variant">Master Alchemist</p>
            </div>
        </div>
        <nav class="flex flex-col gap-2">
            <a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-container-high rounded-xl hover:translate-x-1 transition-transform duration-200" asp-controller="Home" asp-action="Index">
                <span class="material-symbols-outlined">science</span>
                <span class="font-label-sm text-label-sm">Laboratory</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 bg-secondary-container text-on-secondary-container rounded-xl shadow-md border-2 border-secondary" asp-controller="TeacherCourses" asp-action="Index">
                <span class="material-symbols-outlined">auto_stories</span>
                <span class="font-label-sm text-label-sm">Spellbook</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-container-high rounded-xl hover:translate-x-1 transition-transform duration-200" asp-controller="Courses" asp-action="Library">
                <span class="material-symbols-outlined">school</span>
                <span class="font-label-sm text-label-sm">Academy</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-container-high rounded-xl hover:translate-x-1 transition-transform duration-200" asp-controller="Categories" asp-action="Index">
                <span class="material-symbols-outlined">menu_book</span>
                <span class="font-label-sm text-label-sm">Categories</span>
            </a>
        </nav>
        <div class="mt-auto flex flex-col gap-2 pt-4 border-t border-outline-variant">
            <a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-container-high rounded-xl" href="#">
                <span class="material-symbols-outlined">help</span>
                <span class="font-label-sm text-label-sm">Support</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-container-high rounded-xl" href="#">
                <span class="material-symbols-outlined">logout</span>
                <span class="font-label-sm text-label-sm">Log Out</span>
            </a>
        </div>
    </aside>

    <header class="w-full sticky top-0 z-50 bg-surface/70 dark:bg-surface-dim/70 backdrop-blur-xl border-b border-white/40 shadow-sm flex justify-between items-center px-margin-mobile md:pl-[calc(16rem+48px)] md:pr-margin-desktop h-20">
        <h1 class="font-display-lg text-display-lg-mobile text-primary dark:text-inverse-primary refined-heading md:text-headline-md lg:text-display-lg">ChemLab 3D</h1>
        <div class="flex items-center gap-4">
            <div class="hidden md:flex bg-white/40 backdrop-blur-md rounded-full px-4 py-2 border border-white/60 items-center gap-2">
                <span class="material-symbols-outlined text-on-surface-variant">search</span>
                <input class="bg-transparent border-none focus:ring-0 text-body-md w-48" placeholder="Search potions..." type="text" />
            </div>
            <button class="w-10 h-10 rounded-full hover:bg-primary-container/20 flex items-center justify-center transition-colors">
                <span class="material-symbols-outlined text-primary">notifications</span>
            </button>
            <div class="w-10 h-10 rounded-full bg-secondary-container border-2 border-secondary flex items-center justify-center overflow-hidden shadow-sm">
                <span class="material-symbols-outlined text-on-secondary-container">person</span>
            </div>
        </div>
    </header>

    <main class="relative z-10 md:ml-64 p-margin-mobile md:p-margin-desktop min-h-[calc(100vh-80px)] pb-32">
        <div class="max-w-4xl mx-auto">
            <nav class="flex items-center gap-2 mb-8 text-on-surface-variant font-label-sm">
                <a class="hover:text-primary transition-colors" asp-controller="Home" asp-action="Index">Academy</a>
                <span class="material-symbols-outlined text-sm opacity-50">chevron_right</span>
                <a class="hover:text-primary transition-colors" asp-controller="Categories" asp-action="Index">Categories</a>
                <span class="material-symbols-outlined text-sm opacity-50">chevron_right</span>
                <span class="text-primary font-semibold">New Category</span>
            </nav>

            <div class="mb-10">
                <h2 class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-2 refined-heading">Create New Category</h2>
                <p class="text-body-lg text-on-surface-variant max-w-xl">Define a fresh scientific domain for your students to explore within the magical curriculum.</p>
            </div>

            <div class="premium-glass rounded-xl p-8 md:p-12 shadow-2xl relative overflow-hidden">
                <div class="absolute -top-24 -right-24 w-64 h-64 bg-primary-container/20 rounded-full blur-[80px]"></div>
                <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-secondary-container/20 rounded-full blur-[80px]"></div>
                
                <form class="relative z-10 space-y-10" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="category-icon" name="Icon" value="@Model.Category.Icon" />
                    <input type="hidden" id="category-isactive" name="IsActive" value="@Model.Category.IsActive.ToString().ToLower()" />

                    <div class="space-y-3">
                        <label class="font-label-sm text-primary tracking-widest flex items-center gap-2" for="cat-name">
                            <span class="material-symbols-outlined text-lg">label</span>
                            CATEGORY NAME
                        </label>
                        <input class="w-full rounded-full border-2 border-outline-variant/50 bg-white/40 px-8 py-5 text-body-lg font-semibold focus:border-primary focus:ring-8 focus:ring-primary/5 transition-all outline-none placeholder:text-outline-variant" id="cat-name" name="Name" value="@Model.Category.Name" placeholder="e.g. Quantum Alchemy" type="text" oninput="generateSlug(this.value)" required />
                        <span class="text-error text-xs">@Html.ValidationMessageFor(m => m.Category.Name)</span>
                    </div>

                    <div class="space-y-3">
                        <label class="font-label-sm text-primary tracking-widest flex items-center gap-2" for="cat-slug">
                            <span class="material-symbols-outlined text-lg">link</span>
                            SLUG
                        </label>
                        <input class="w-full rounded-full border-2 border-outline-variant/50 bg-white/40 px-8 py-5 text-body-md font-semibold focus:border-primary focus:ring-8 focus:ring-primary/5 transition-all outline-none placeholder:text-outline-variant" id="cat-slug" name="Slug" value="@Model.Category.Slug" placeholder="quantum-alchemy" type="text" required />
                        <span class="text-error text-xs">@Html.ValidationMessageFor(m => m.Category.Slug)</span>
                    </div>

                    <div class="space-y-5">
                        <label class="font-label-sm text-primary tracking-widest flex items-center gap-2">
                            <span class="material-symbols-outlined text-lg">grid_view</span>
                            SYMBOLIC ICON
                        </label>
                        <div class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 gap-5">
                            @foreach (var icon in Model.AvailableIcons)
                            {
                                <button class="@(Model.Category.Icon == icon ? "icon-aura-active" : "bg-white/40 border-2 border-outline-variant/30") w-16 h-16 rounded-2xl flex items-center justify-center hover:border-primary-container hover:bg-white/60 transition-all squishy-button group" type="button" onclick="setIcon('@icon', this)">
                                    <span class="material-symbols-outlined @(Model.Category.Icon == icon ? "text-primary" : "text-on-surface-variant/70 group-hover:text-primary") text-3xl">@icon</span>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="space-y-3">
                        <label class="font-label-sm text-primary tracking-widest flex items-center gap-2" for="cat-desc">
                            <span class="material-symbols-outlined text-lg">description</span>
                            DESCRIPTION
                        </label>
                        <textarea class="w-full rounded-2xl border-2 border-outline-variant/50 bg-white/40 px-8 py-5 text-body-md focus:border-primary focus:ring-8 focus:ring-primary/5 transition-all outline-none resize-none placeholder:text-outline-variant" id="cat-desc" name="Description" placeholder="Briefly describe the mystical secrets hidden within this category..." rows="5">@Model.Category.Description</textarea>
                    </div>

                    <div class="flex flex-col md:flex-row gap-gutter md:items-center justify-between p-6 bg-white/60 rounded-2xl border border-white/80 shadow-inner">
                        <div class="flex items-center gap-4">
                            <div class="p-4 bg-secondary-container/30 rounded-2xl shadow-sm">
                                <span class="material-symbols-outlined text-secondary">visibility</span>
                            </div>
                            <div>
                                <h4 class="font-label-sm text-on-surface tracking-wide">CATEGORY STATUS</h4>
                                <p class="text-sm text-on-surface-variant">Set visibility for the entire academy.</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
                            <span class="font-label-sm text-on-surface-variant uppercase tracking-widest text-xs" id="status-label">@(Model.Category.IsActive ? "Active" : "Draft")</span>
                            <button class="relative inline-flex h-10 w-16 items-center rounded-full @(Model.Category.IsActive ? "bg-secondary" : "bg-outline-variant/30") transition-colors focus:outline-none shadow-inner" id="status-toggle" onclick="toggleStatus()" type="button">
                                <span class="inline-block h-7 w-7 @(Model.Category.IsActive ? "translate-x-7.5" : "translate-x-1.5") transform rounded-full bg-white shadow-md transition-transform" id="toggle-circle"></span>
                            </button>
                        </div>
                    </div>

                    <div class="flex flex-col sm:flex-row items-center gap-6 pt-6">
                        <a class="w-full sm:w-auto px-10 py-5 rounded-full border-2 border-primary/40 text-primary font-bold squishy-button hover:bg-primary/5 hover:border-primary transition-all text-center" asp-action="Index">
                            CANCEL
                        </a>
                        <button class="w-full sm:w-auto px-12 py-5 rounded-full bg-primary text-white font-bold shadow-xl shadow-primary/30 border border-primary-container squishy-button hover:brightness-110 transition-all" type="submit">
                            CREATE CATEGORY
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <script>
        let isActive = @Model.Category.IsActive.ToString().ToLower();
        function toggleStatus() {
            isActive = !isActive;
            const toggle = document.getElementById('status-toggle');
            const circle = document.getElementById('toggle-circle');
            const label = document.getElementById('status-label');
            const hiddenInput = document.getElementById('category-isactive');
            
            hiddenInput.value = isActive;
            label.textContent = isActive ? "Active" : "Draft";

            if (isActive) {
                toggle.classList.remove('bg-outline-variant/30');
                toggle.classList.add('bg-secondary');
                circle.classList.add('translate-x-7.5');
                circle.classList.remove('translate-x-1.5');
            } else {
                toggle.classList.remove('bg-secondary');
                toggle.classList.add('bg-outline-variant/30');
                circle.classList.add('translate-x-1.5');
                circle.classList.remove('translate-x-7.5');
            }
        }

        function setIcon(icon, btn) {
            document.querySelectorAll('.grid button').forEach(b => {
                b.classList.remove('icon-aura-active');
                b.classList.add('bg-white/40', 'border-outline-variant/30');
                b.querySelector('span').classList.remove('text-primary');
                b.querySelector('span').classList.add('text-on-surface-variant/70');
            });
            btn.classList.add('icon-aura-active');
            btn.classList.remove('bg-white/40', 'border-outline-variant/30');
            btn.querySelector('span').classList.add('text-primary');
            btn.querySelector('span').classList.remove('text-on-surface-variant/70');
            document.getElementById('category-icon').value = icon;
        }

        function generateSlug(name) {
            const slug = name.toLowerCase()
                .replace(/[^\w\s-]/g, '')
                .replace(/\s+/g, '-');
            document.getElementById('cat-slug').value = slug;
        }
    </script>
</body>
</html>
